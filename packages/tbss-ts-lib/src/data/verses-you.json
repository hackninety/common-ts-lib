忧一喜。",48],[10090,"一胎生二子，定于此年。",53],[10091,"双亲同亡，一年二孝。",12],[10092,"鸡年父六十华诞。"],[10093,"伤哉妻亡，痛哉子死。",29,30],[10094,"父猴母猪，易数先知。"],[10095,"母命癸酉年生方合。"],[10096,"武学而选左堂。"],[10097,"妻命庚午生，数定前缘。"],[10098,"再娶丁巳之妻，方得偕老。"],[10099,"哀哉母亡，喜得生子。",49],[10100,"一胎生双子，定在此年。",54],[10101,"重孝临门，父母双亡。",13],[10102,"狗年父六十华诞。"],[10103,"妻死子亡，二度刑伤。",31,32],[10104,"父母同属鸡，数中注定。"],[10105,"母命狗命生方合。"],[10106,"金木之外而选左堂。"],[10107,"妻命壬午生，姻缘注定。"],[10108,"再娶癸巳之妻，方得齐眉。"],[10109,"哀哉父亡，喜也生子。",50],[10110,"门临双喜，一胎生二子。",55],[10111,"双亲同亡，一年二孝。",14],[10112,"猪年父六十华诞。"],[10113,"鼓盆歌未了，哭子又丧明。",33,34],[10114,"父鸡母鼠，数中注定。"],[10115,"母命丙戌年生方合。"],[10116,"木火之年而选知州。"],[10117,"妻命乙未生，天所定也。"],[10118,"再娶甲午之妻，方免其刑。"],[10119,"父亡生子，一忧一喜。",51],[10120,"天喜临门，一胎生二子。",56],[10121,"重孝临门，父母双亡。",15],[10122,"鼠年夫五十华诞。"],[10123,"喜盆歌款，哭子又丧明。",35,36],[10124,"父属鸡母属牛，先天定数。"],[10125,"母命戊戌年生方合。"],[10126,"金火之年进痒，土木之年拔贡。"],[10127,"妻命丁巳生，姻缘注定。"],[10128,"玉人有刑，再娶丙午。"],[10129,"悲中有喜，父亡生子。",52],[10130,"双喜临门，一胎生二子。",57],[10131,"父亡母死，同在一年。",16],[10132,"牛年夫五十华诞。"],[10133,"子死妻亡，二度刑伤。",37,38],[10134,"父属鸡母属虎，一定之数。"],[10135,"母命庚戌年生方合。"],[10136,"久雨天晴精神爽。",19],[10137,"妻命己未生，姻缘注定。"],[10138,"玉人有刑，再娶戊午。"],[10139,"悲喜同至，父亡生子。",53],[10140,"一胎生二子，定在此年。",58],[10141,"一年重孝，父母双亡。",27],[10142,"寅年夫五十华诞。"],[10143,"哭子痛未了，又接鼓盆歌。",39,40],[10144,"父鸡母兔，一定之数。"],[10145,"母命壬戌年生方合。"],[10146,"中年夫妻，晚年失子。"],[10147,"妻命生于辛未年方合。"],[10148,"玉人有刑，再娶庚午。"],[10149,"父亡生子，一忧一喜。",53],[10150,"一胎生二子，定于此年。",59],[10151,"父母同亡，在此一年。",18],[10152,"兔年夫五十华诞。"],[10153,"子死妻亡，两度悲伤。",41],[10154,"父属鸡母属龙，数定其中。"],[10155,"母命猪年生方合。"],[10156,"荫祖父而得州官，数由前定。"],[10157,"妻命癸未生，姻缘注定。"],[10158,"玉人有刑，再娶壬午。"],[10159,"父亡生子，一忧一喜。",55],[10160,"其年双喜，一胎二子。",60],[10161,"双亲同亡，重孝临门。",19],[10162,"龙年夫五十华诞。"],[10163,"子死妻亡，两度悲伤。",43,44],[10164,"父鸡母蛇，易数先知。"],[10165,"母命丁亥年生方合。"],[10166,"金水之年，初任知州方合。"],[10167,"妻命甲申生，姻缘注定。"],[10168,"玉人有刑，再娶乙未。"],[10169,"悲喜同临，父亡生子。",56],[10170,"荫祖父而得贡，数由前定。"],[10171,"父母双亡，一年二孝。",20],[10172,"蛇年夫五十华诞。"],[10173,"丧明哀未了，又叹鼓盆歌。",43,44],[10174,"父鸡母马，易数无差。"],[10175,"母命己亥年生方合。"],[10176,"木火之年，初任知县。"],[10177,"妻命丙申生方合。"],[10178