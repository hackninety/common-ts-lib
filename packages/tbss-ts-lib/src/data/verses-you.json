527,"有弄璋弄瓦之喜。",30],[10528,"重舟滩头费扒移，移过滩头有好溪。",31,32],[10529,"母亡生子，悲中有喜。",47],[10530,"时来堪凑巧，门第生光辉。",43],[10531,"双亲俱有寿，不幸同年亡。",56],[10532,"子孙芹香，门庭生晖。",32],[10533,"夫命己卯生，先天定数。"],[10534,"虽无埋救蝼蚁德，也有济人利物心。"],[10535,"命照武曲，弓马入泮。",29,30],[10536,"玉骨冰肌瑕玷绝，信如天上一蝉娟。"],[10537,"项庄舞剑，意在沛公。"],[10538,"运筹帷幄，决胜千里。",29,30],[10539,"可哀者母亡，可喜者生子。",48],[10540,"木火之年，任司职方合。"],[10541,"椿萱俱有寿，同年而亡命。",57],[10542,"子当入泮。",33],[10543,"夫命辛卯生，姻缘注定。"],[10544,"且享平安福，莫管门外扰。",63],[10545,"水火之年，以财而捐正堂。"],[10546,"生计勃然兴，东西南北任君生。",29,30],[10547,"有弄璋弄瓦之喜。",32],[10548,"闲看牧童横牛背，静听农歌热闹声。",63,64],[10549,"一悲一喜，母亡生子。",49],[10550,"天恩下及，草木皆荣。",45,46],[10551,"父母双亡，同在一年。",58],[10552,"子当入泮。",34],[10553,"夫命癸卯生，数定前缘。"],[10554,"姊妹并无，方合此卦。"],[10555,"艺学泥水，沙石难当。"],[10556,"多因风雨花零落，欲渡清溪欠便船。",48],[10557,"有弄璋弄瓦之喜。",33],[10558,"谋事有巧，定有光辉。",36],[10559,"母亡生子，定在此年。",50],[10560,"劝君安心，重整家园。",39,40],[10561,"父母同年丧，双孝临门。"],[10562,"子当入泮。",35],[10563,"夫命甲辰生，数定前缘。"],[10564,"辟雍泮水，绿柳桃花喜吐红。"],[10565,"大厦巍峨，惟有赖饰以金羡。"],[10566,"人事无求，安估不用忧。",37,38],[10567,"有弄璋弄瓦之喜。",34],[10568,"复任学政。"],[10569,"母亡生子，一忧一喜。",51],[10570,"以举人而授儒学，数由前定。"],[10571,"双孝临门，父母俱亡。",60],[10572,"子当入泮。",36],[10573,"夫命丙辰生，数定前缘。"],[10574,"百载科场难遂，一声乡荐即滕身。"],[10575,"创业发财终有望，只争来早与来迟。"],[10576,"数当生子，老来见喜。",72],[10577,"有弄璋弄瓦之喜。",35],[10578,"金水之年，进文学方合。"],[10579,"哀哉母亡，喜也生子。",52],[10580,"意外之色勿贪，省却多少麻烦。"],[10581,"甲子己周双孝临，严慈连袂丧归阴。",61],[10582,"子当入泮。",37],[10583,"夫命戊辰生，数定前缘。"],[10584,"才术不亚陶朱志，性质何如管仲先。"],[10585,"国学标名，黄金满屋。"],[10586,"衙门多少不平事，君须仔细同官喧。"],[10587,"有弄璋弄瓦之喜。",36],[10588,"修真功果，功养生成。"],[10589,"悲中见喜，母亡生子。",53],[10590,"恩星拱照，官职高升。",33,34],[10591,"父母双亡，同在一年。",62],[10592,"子当入泮。",38],[10593,"夫命庚辰生，姻缘注定。"],[10594,"双喜临门科场，得意兆熊罴。",39,40],[10595,"七十有余子，世上难逢。",76],[10596,"不过而遇，攸往皆利。",45,46],[10597,"有弄璋弄瓦之喜。",37],[10598,"恩星照命，官职高升。",35,36],[10599,"母亡生子，一忧一喜。",54],[10600,"入春独是无多少，寒气侵入未及回。",39,40],[10601,"椿萱俱有寿，何竟一年亡。",63],[10602,"子入泮池。",39],[10603,"夫命壬辰生，姻缘定数。"],[10604,"祥光拥护画堂前，瑞气融和海屋新。",59,60],[10605,"惟有公门易赚钱，呼奴饮酒乐无边。"],[10606,"财源有分终须有，空业兴隆到处通。"],[10607,"有弄璋弄瓦之喜。",38],[10608,"错趾招悔吝，指日保初终。",33,34],[10609,"母亡生子，一忧一喜。",55],[10610,"水土之年，初任教官方合。"],[10611,"双亲辞世日，同在一年中。",64],[10612,"子采芹香。",40],[10613,"夫命己已生，数由前定。"],[10614,"土年中举，木年会试方合。"],[10615,"严亲年高，数入天曹。",83],[10616,"逢灾无咎，遇难一恩。",62],[10617,"有弄璋弄瓦之喜。",39],[10618,"钦命典试。",39,40],[10619,"悲中有喜，母亡生子。",56],[10620,"独足高楼上，更上一层楼。",53,54],[10621,"双亲年事高，何竟年同丧。",65],[10622,"一妻一妻又一妻，三妻鼠命得相宜"],[10623,"夫命丁巳生，姻缘定数。"],[10624,"克勤克俭从妇道，三从四德两兼全。"],[10625,"沐恩食禄居知县，职位琴堂气象新。"],[10626,"妻期死矣，何用多延。",64],[10627,"有弄璋弄瓦之喜。",40],[10628,"志堪武路，勇冠三军。"],[10629,"母亡生子，一忧一喜。",57],[10630,"身荣登黄甲，天佑吉人。"],[10631,"双亲原有寿，同在一年亡。",66],[10632,"三妻牛命，方可偕老。"],[10633,"夫妻同己巳生，姻缘定数。"],[10634,"有子成人增门楣，晚来享福乐无边。"],[10635,"愁眠杨柳梢头月，雨湿桃花梦里云。"],[10636,"二喜临门，乡科皆仲。",42],[10637,"有弄璋弄瓦之喜。",41],[10638,"清风明月，运至时行。",55,56],[10639,"母亡生子，一忧一喜。",58],[10640,"以财而得县丞，数由前定。"],[10641,"父母年高，何竟一年同死。",67],[10642,"三妻虎命生，始得相宜。"],[10643,"夫命辛巳生，数由前定。"],[10644,"最苦为人尝独立，不堪羞见雁双飞。"],[10645,"家业财源生瑞气，绮罗席上日融融。"],[10646,"淡淡凝烟迷远路，斜风细雨折春花。",27,28],[10647,"有弄璋弄瓦之喜。",42],[10648,"一曲鸦啼还送上，夕阳蝉噪劝君行。",63,64],[10649,"母亡生子，忧喜同至。",59],[10650,"荫父而县丞，数由前定。"],[10651,"双亲原有寿，全在一年亡。",68],[10652,"三妻兔命，方可偕老。"],[10653,"夫命癸巳生，数有前定。"],[10654,"吏部大堂，数由前定。"],[10655,"急波滩流天上月，狂风难打画上船。",47,48],[10656,"工部尚书，志理国政。"],[10657,"有弄璋弄瓦之喜。",43],[10658,"水土佃官入命，中得之子命归期。"],[10659,"悲喜同临，母亡生子。",60],[10660,"祸去还有灾，阴雨渡阴天。",17],[10661,"占稀将满丧双亲，世上难逢百岁人。",69],[10662,"三妻龙命，方得相宜。"],[10663,"夫命甲午生，姻缘注定。"],[10664,"名镇三边，威权英显。"],[10665,"青灯白守三更水，银烛高烧半夜长。"],[10666,"招得金水之子，配得土木之妻。"],[10667,"有弄璋弄瓦之喜。",44],[10668,"乍暗乍明云里月，半开半落雨中花。",29,30],[10669,"子游泮水。",41],[10670,"金水之年得子，土木之年失子。"],[10671,"双亲虽有寿，同在一年亡。",70],[10672,"三妻蛇命，始得偕老。"],[10673,"夫命丙午生，姻缘注定。"],[10674,"都察院职，数由前定。"],[10675,"自怨红颜甘寂寞，不能脂粉污坚贞。"],[10676,"走遍江山千万里，徒劳心事想西东。"],[10677,"有弄璋弄瓦之喜。",45],[10678,"犹如天和照日新，阳回宇宙尽沾恩。",41,42],[10679,"子采芹香。",42],[10680,"其妻亡命，人之不幸。",70],[10681,"金土年入泮，水土年出贡。"],[10682,"三妻马命，始得相宜。"],[10683,"夫命戊午生，姻缘定数。"],[10684,"风折儿伤愁寂寞，恼人无语夜偏长。"],[10685,"成名得遂鱼龙变，膺贵还同爵禄华。"],[10686,"一生行藏多不利，恼人情绪正偏长。"],[10687,"有弄璋弄瓦之喜。",46],[10688,"不是松筠有节操，多因月老度姻缘。"],[10689,"子采芹香。",43],[10690,"是年恩荣翰林职，数由前定。"],[10691,"有孙入