{"volume":"卯集","verses":[[4001,"斯时运已通，做事必成功。",33,34],[4002,"自成自立自支持，可谓须眉大丈夫。"],[4003,"公道世间为白发，贵人头上不曾饶。",65,66],[4004,"寒暖不寻常，小处终不免。",37],[4005,"惟知务礼宜，家晏安然乐。"],[4006,"盈盈秋水，淡淡青山。",29],[4007,"而今撑过羊肠道，周道倭迟事不难。",45,46],[4008,"束之高阁，莫为儿孙。",67,68],[4009,"学宗朱程术出场，曾为人祜富寿增。",6],[4010,"万象更新，韶光明媚。",44],[4011,"鸾凤和谐，中在一笑，",31,32],[4012,"由熙由广，利涉大川。",43,44],[4013,"君子嘉遁，古无不利。",31,32],[4014,"万卉正芳菲，韶光处处宜。",53,54],[4015,"拨山超海，缘木求鱼。",35,36],[4016,"君子谋道，小人谋食。",21,22],[4017,"兄弟八人，数有三贵。"],[4018,"独彼无处有清流，来喜应求来破愁。",43,44],[4019,"没有规范，不成方圆。",31,32],[4020,"子命属水方合此刻。"],[4021,"名登龙虎榜。",21,22],[4022,"满腹文章贯斗牛，乡榜题名独占先。"],[4023,"项庄舞剑，意在沛公。"],[4024,"运逢佳境，如花遇春。",32],[4025,"老来无恙是多福。",69,70],[4026,"龙德相扶，大吉大象。",45,46],[4027,"仲伯之德，由德正直。"],[4028,"名登金榜。",16],[4029,"劫杀相逢，死于刀下。"],[4030,"兄弟五人，中断离群。"],[4031,"名登虎榜。",23,24],[4032,"方当出仕又阻抑。",25,26],[4033,"人坐春风，其乐融融。",37],[4034,"乡榜题名。",15,16],[4035,"为人依本分，言行两无亏。"],[4036,"胸中锦绣人难及，曾魁天下是君子。"],[4037,"涵濡五露荣，花信有春色。",31,32],[4038,"宴饮鹿鸣。",37,38],[4039,"度过崎岖路，攸往是坦夷。",15,16],[4040,"坤人之运造化奇，一天星斗见光辉。",59,60],[4041,"不假推移，安然进步。",54],[4042,"春时日日好，深闺淑气佳。"],[4043,"刘郎莫恨蓬山远，驿使传书已到门。",29,30],[4044,"颜回之寿，少四年而归。",27,28],[4045,"暮年为政，从心所欲。",69,70],[4046,"月在水中，可玩不可捉。",13,14],[4047,"父命木年生方合此刻。"],[4048,"深院锁黄昏，阵阵芭蕉雨。",31,32],[4049,"烟暖初出冥，晚来景色新。",1],[4050,"龙逢浅水，虎落平壤。",47,48],[4051,"数该生子。",57],[4052,"解神切莫听凶神，破去钱财又费心。",47,48],[4053,"进取帑梁施，贵人得扶持。",21,22],[4054,"此数推为性最华，身近候伯早堪夸。"],[4055,"天毓其才人，莫并金谐选。"],[4056,"瑞气融融，景象非前。",69,70],[4057,"佳人有正副，正副不和睦。"],[4058,"父子千总，人生在幸。"],[4059,"南院枯枝，复发其荣。",55,56],[4060,"喜气盈门，物色更新。",15],[4061,"朱雀衔符至，勿引是非来。",36],[4062,"分有前母，生我是庶。"],[4063,"百总升千总，祖庇有余德。"],[4064,"见龙在田，普其润泽。",37,38],[4065,"年年事事通，枯枝槁木皆发荣。",61,62],[4066,"风行水面，旋起波涛。",67,68],[4067,"公义以行为，一方之保障。"],[4068,"得人与他为活计，傍个贵人发大家。"],[4069,"犬有两口，哭泣之哀。",19,20],[4070,"伐木丁丁莒求友，直谅多闻同气求。",47,48],[4071,"瑞气凝于庭，休微交应中。",37,38],[4072,"武曲照命，把总升守备。"],[4073,"事事从容，眉头喜色。",43],[4074,"徒弟五人，三个送老。"],[4075,"从事从容，谋略有功。",25,26],[4076,"水年克妻，木年再娶。"],[4077,"檐前喜鹊噪，报喜又报晴。",52],[4078,"保固业精练，兵器以御甲。"],[4079,"父母水年生方合此刻。"],[4080,"四字切忌：暗箭难防。"],[4081,"安居为福，幽人贞吉。",41,42],[4082,"母命金年生方合此刻。"],[4083,"夫妻偕老，数由前生定。"],[4084,"鸟呜嘤嘤，饮啄自得时。",77,78],[4085,"密云不雨，烦闷人心。",43],[4086,"花开未久春光尽，可惜枝头一旦倾。",33,34],[4087,"一轮明月，光照九州。"],[4088,"一轮明月映秋林，无边风景爽气生。",44],[4089,"不须卜甲子，五旬之外人。",59],[4090,"雌雄相守岁，林稳得优游。"],[4091,"笥有衣仓，粟生食足。",43,44],[4092,"甲子之年，乡榜题名。"],[4093,"志在四方，锦衣归故里。"],[4094,"磐石之安，言其未动。",53,54],[4095,"艺术依人显，能得福自臻。"],[4096,"振基业于当时，播芳名于后世。"],[4097,"不许千金数，实许七百数。"],[4098,"一贡成名，少年得意。",13,14],[4099,"如金如锡，如圭如壁。"],[4100,"风清日丽，山静禅闲。",11,12],[4101,"辟雍成名，祖宗荫德。",13,14],[4102,"深秋黄菊，晚节馨香。"],[4103,"夫当入泮。",13,14],[4104,"四岁无父，难免泣血。",4],[4105,"韩信受跨下之时。",35,36],[4106,"无登科甲，坤人之幸。",55,56],[4107,"驿使传消息，门庭喜色新。",15,16],[4108,"花开胜似去年红，满院丛中铺锦绣。",37,38],[4109,"时哉不可失，时乎不再来。",15,16],[4110,"明月清风，人情舒畅听钟声。",23,24],[4111,"少年辟雍，乐莫大焉。",41,42],[4112,"山外青山名可求，前程进步在他州。"],[4113,"夫当入泮。"],[4114,"舟人不备。",77,78],[4115,"父亡矣陡岐生悲。",36,37],[4116,"他年平地风波起，远避桃源免祸殃。",13,14],[4117,"夫登科甲。",15,16],[4118,"昨夜征夫路上来，梅花千里护楼台。",45,46],[4119,"少年依贡世难逢。"],[4120,"世事不明，谬迷于性。",23,24],[4121,"数有三母之称。"],[4122,"姻缘有跷蹊，不合明媒娶。"],[4123,"人寿年来有动摇，定名不足莫心高。",49],[4124,"特立扬媚日，人将何取笑。"],[4125,"数该生子。",51],[4126,"升迁千总。"],[4127,"根深蒂固，有为之时。",47,48],[4128,"龙年生子。"],[4129,"春光在日，无日不足。",60],[4130,"夫当登科。",63,64],[4131,"花棉衬雕鞍，日月春光定。",35],[4132,"月色放青光，遍体精神爽。",64],[4133,"复补百总。"],[4134,"飞檐为祸又为灾，啾唧无端水破财。",33],[4135,"四龄一跃成文士。",39,40],[4136,"夫当入泮。",17,18],[4137,"寿喜年高一百余。",100],[4138,"寿余百岁有三春，悠悠一梦。",103],[4139,"月中仙子，可望不可及。"],[4140,"迷于穷途，转之路通。",31,32],[4141,"母命木年生方合此刻。"],[4142,"夫登科甲。",17],[4143,"金珠为质画为饰，写出丹青凤羽仪。"],[4144,"温温恭人，维德之基。"],[4145,"命中注定七女。"],[4146,"数年立志鸡窗下，一旦标名性字香。"],[4147,"父母生土年终于水年。"],[4148,"辉宗祖之基，扬子孙之名。"],[4149,"一生做事，粗晓有失。"],[4150,"深秋黄菊，晚节馨香。",61,62],[4151,"夫当入泮。",19,20],[4152,"不思游泮青云路，只图家业乐终身。"],[4153,"秉性常清净，存心碣慈和。",19,20],[4154,"夫登科甲。",19,20],[4155,"勿得因人屡变迁，后悔无边。",50],[4156,"运际其亨，无往不利。",25],[4157,"寿域同登九十年，寿星昨夜现中天",90],[4158,"金鳞不是池中物，一遇风云化作龙"],[4159,"波平风静，正当行舟。",47,48],[4160,"豕前牛后，弟先终命。"],[4161,"崎岖路漫，推车停留马足斜。"],[4162,"享现成福，任意逍遥。",22],[4163,"夫当入泮。",21,22],[4164,"运逢知命，何期镜钗分。"],[4165,"终日蹙眉头，愁怀准解救。",35],[4166,"家室安宁，心字意稳。",38],[4167,"夫当登科。",21,22],[4168,"履丝织编，任意逍遥。",23,24],[4169,"辟雍成名。",23,24],[4170,"人在中途，飘飘雨中。",20,21],[4171,"当依贡期。",23,24],[4172,"美景良辰君莫负，及时行乐且安然。",25],[4173,"知己相遇，足慰离愁。",47,48],[4174,"是非未有停，财帛多破耗。",49,50],[4175,"饱食暖衣，无求之乐。",73,74],[4176,"名当登科。",23,24],[4177,"濡濡仅固得自如，少年常似老来时。"],[4178,"瑞气护兰芬，其年大吉庆。",43,44],[4179,"命照文星，夫当入泮。",23,24],[4180,"心慈好善，福禄诸缘。"],[4181,"辟雍成名。",27],[4182,"安常处顺，入纳桢祥。",43,44],[4183,"少年依贡。",25,26],[4184,"项王欲转江东去，谁想乌江不渡人。",67],[4185,"夫当入泮。",25,26],[4186,"兄弟三人，奏楚不同盟。"],[4187,"科名之星，独当步文场。",53],[4188,"以监而经历，数由前定。"],[4189,"五子原是金水火.若生土命是虚花"],[4190,"存慈悲心，获修齐志。"],[4191,"风前之烛，光摇不定。",89,90],[4192,"夫登科甲。",25,26],[4193,"兄弟三人，同父不同母。"],[4194,"万紫千红，更新有兴。",3,4],[4195,"命中有七子送老。"],[4196,"朝耕夕织，勤俭持家。"],[4197,"披麻无情，门庭开乱。",59,60],[4198,"春风得意，利禄盈盈。",40],[4199,"鼓盆之歌，再见于斯。",53],[4200,"国学题名。",27,28],[4201,"当页之期。",27,28],[4202,"兄弟九人，数有三贵。"],[4203,"疯病之灾，宿年有咎。"],[4204,"三子属土与木金，若生水年亦不真"],[4205,"祸去还有灾，阴雨渡阴天。",17],[4206,"当贡之期。",25,26],[4207,"数有三妻。"],[4208,"身处叔季，俨然律吉。"],[4209,"数有六子，三子送老。"],[4210,"月上栏杆，半明半暗。",21],[4211,"生长名门，不愧曹族。"],[4212,"一段愁怀入莫识，空留明月与人知。",43,44],[4213,"命当繁华，一世安康。"],[4214,"结子开花树有根，春风蔼蔼快人情。",23,24],[4215,"夫入泮宫。",51],[4216,"运至时行，诸事凑巧。",27,28],[4217,"风卷浮云，中天月色。",31,32],[4218,"四时佳处，如春如花。",3,4],[4219,"韶光新景，足畅我怀。",69],[4220,"蝉声断续送人矣，一去无踪莫计程。",65],[4221,"兄弟五人，乐奏几般音。"],[4222,"青年朱弦断，鸳鸯再会难。",25],[4223,"云横秦岭家何在，雪拥蓝关马不前。",39,40],[4224,"夫当登科。",27,28],[4225,"愁难作解苍茫人，病人不怜人次第。",50],[4226,"日尽歌呼在，高山流水足逍遥。",45,46],[4227,"新竹成竿，扶摇直上。",11,12],[4228,"趋吉避凶，须知吉里藏凶。",21],[4229,"纳宠须知，色重贪花。",22],[4230,"八卦加一，大数止矣。",65],[4231,"国学标名。",29,30],[4232,"言行不谨慎，有意外之危。",29,30],[4233,"火年木年生三子，若生金年是虚花。"],[4234,"洋洋自得，旁若无人。",57,58],[4235,"骑马渐且高，勿想上高楼。",35,36],[4236,"多福多禄，斯年寿足。",93,94],[4237,"姐作商人，妹入侯门。"],[4238,"一若求珠沧海上，纵不虚求也是难。",39,40],[4239,"当贡之期。",29,30],[4240,"有子还无字，无遣讨债儿。"],[4241,"泮池之年。",29,30],[4242,"避嫌思退，不堕猜疑。",55,56],[4243,"扁舟一叶在江中，顷刻溟溟烟霞红。",33,34],[4244,"花开正当赏，风雨又相催。",67],[4245,"知心相负，暗地有戈。",49,50],[4246,"一百零六，不食人间。",106],[4247,"以受道书君馨香，长安城内姓名扬。"],[4248,"许进勿退，退得其胜。",41],[4249,"吉庆重来，门庭纳福。",59,60],[4250,"虽有浮云，不掩明月。",21,22],[4251,"姊妹三人，先损其一。"],[4252,"存心仁慈，立志修齐。"],[4253,"缓步徐行福自随，室中空信几危灾。",27,28],[4254,"鲲鹏展翼，扶摇直上。",55],[4255,"夫登科第。",29,30],[4256,"高下无求，往来春秋。",65],[4257,"鸟集高枝，无烦啄食。",41,42],[4258,"通往直前，却无阻挡。",54],[4259,"妻命属金。"],[4260,"辟雍成名。",34],[4261,"为人忠通，慷慨大方。"],[4262,"甲午之年，乡科及第。"],[4263,"冤愁纷纷，抄扰不宁。",55,56],[4264,"官至学院尊，尚未心满足。"],[4265,"当依贡期。",31,32],[4266,"以监而选州官，数由前定。"],[4267,"正路入问福，忽做南柯梦。",64],[4268,"口舌交争，昼夜不宁。",57,58],[4269,"大椿八千岁，庄子游仙境。",64],[4270,"夫当入泮。",31,32],[4271,"风息云收，阳和日暖。",48],[4272,"官星相照身，近内台天子。"],[4273,"仁慈好善，广种福田。"],[4274,"行年人事齐，春色草姜萋。",38],[4275,"天哭催人事，有伤骨肉情。",57,58],[4276,"姻缘前定，必然亲上加亲。"],[4277,"春深莫恨无颜色，最喜葵榴映日红。",60],[4278,"三岁丧父，义方之训恨无人。"],[4279,"数该生子。",35],[4280,"晓日紫云上绿楼。",17],[4281,"几点疏星照，南楼见太阳。",63,64],[4282,"快乐又无边，风月春光满目前。",93,94],[4283,"寂寞有余，财产地僻。",43,44],[4284,"夫当登科。",31,32],[4285,"夫妻反目，乖戾不和。",25,26],[4286,"以监而选知州，数注由前定。"],[4287,"黄甲传宣，春间奏捷。",23],[4288,"莫道天常晴，霎时又生风。",14],[4289,"恩星相照，福自随人。",82],[4290,"内外顺和，深得夫唱妇随义。"],[4291,"削发为僧，脱却当年景。"],[4292,"辟雍成名。",33,34],[4293,"时亨运济，无往不利。",25,26],[4294,"当依贡期。",33,34],[4295,"正途而近贵，自有前程路。"],[4296,"东风送和气，花柳媚春辉。"],[4297,"早岁沉淹运通，梅花只到雪奇中。"],[4298,"中运经营，家室饱暖。",53,54],[4299,"乙西拜师方合此刻。"],[4300,"落地喊三声，未喊父已逝。"],[4301,"曲曲冈路通行人，行人急急赴春回",45,46],[4302,"危转为安，祸消为福。",57,58],[4303,"嫩柳不经三月雨，奇花曾耐社前霜。",13],[4304,"搔首问青天，人事得周全。",63,64],[4305,"夫当入泮。",33,34],[4306,"忧以消除，得来凑巧。",35,36],[4307,"一轮新皎月，数朵乌云遮。",13,14],[4308,"五马翩翩，人羡阳春。",55,56],[4309,"夫登科第。",33,34],[4310,"初任知府，转身部属。",55,56],[4311,"名列辟雍。",35,36],[4312,"出门图活计，活计水中生。",41,42],[4313,"一步高来一步低，高低之处有忧疑。",29],[4314,"六合多相得，春风到处清。",21,22],[4315,"虽然未遂青云志，只图事业作富翁。"],[4316,"数载科场，一朝得志。",35,36],[4317,"求则得之，颇遂其志。",17,18],[4318,"其安其顺，乐境相忘。",17,18],[4319,"门庭寂寞转兴隆，南北东西处处同。",43,44],[4320,"不利而利，无往不利。",39,40],[4321,"亲戚无缘，朋友胜亲。"],[4322,"欢娱度年，万事乃合。",47,48],[4323,"父死玄武有变。"],[4324,"谢却人间事，常纳祯祥福。",71,72],[4325,"所遇老境，忧中扰病。",61,62],[4326,"举人终身，一生乐事。"],[4327,"父不父子不子，中间有个不完妻。"],[4328,"祯祥叠见阳，无日不从容。",51,52],[4329,"长安世上，姓名飘香。"],[4330,"乡科独步。",55,56],[4331,"夫当入泮。",35,36],[4332,"财帛莫强求，宽然不用忧。",41,42],[4333,"水年克妻，木年再娶。"],[4334,"假如三场客，今人作故人。"],[4335,"癸亥拜师方合此刻。"],[4336,"洋江之水伏龙蛇，家室康宁财禄多。",27,28],[4337,"超升重任，参于政事。",51,52],[4338,"花间酌酒邀明月，石上题诗扫绿苔。",63,64],[4339,"夫登科第。",35,36],[4340,"事事强扶持，酩酊醉他乡。",33,34],[4341,"一点银灯照路来，循循而走问行藏。",77,78],[4342,"辟雍成名。",37,38],[4343,"鸟音助人乐好音。",41,42],[4344,"劳心劳力苦奔驰，究竟奔驰力已疲。",37,38],[4345,"当贡之期。",37,38],[4346,"鼠楼梁上，须忧其耗。",53,54],[4347,"夫入泮宫。",37,38],[4348,"机会得来事偶然，童年入泮占人先。",11,12],[4349,"进取无功，退守为高。",41,42],[4350,"夫当入泮。",37,38],[4351,"日沉西坠云又暗，长夜迢迢无处光。",67,68],[4352,"芳草遍郊原，喜气上眉端。",75,76],[4353,"兄弟九人，数有七贵。"],[4354,"虫声四壁，凄凉之状。"],[4355,"逢兔年成名，宫墙稳步。"],[4356,"丧门照命，哭泣之哀。",55,56],[4357,"前妻生水之子，后妻生土木之儿。"],[4358,"解神有情，灾害消除。",17],[4359,"官至提督，全家食禄。"],[4360,"蹉跎岁月，一过坦夷。",22],[4361,"不当进步且盘桓，事到之中次第开。",29,30],[4362,"一入院门空物色，悠悠美景乐无边。",21,22],[4363,"鸟集秋隅，得其所止。",25,26],[4364,"乖违不济，步履错趾。"],[4365,"满目韶光观不尽，一旦无常作故人。",44],[4366,"酣梦方醒，神清气爽。",23,24],[4367,"妻命属金方合。"],[4368,"暖风融融，朝笙夕簧。",61,62],[4369,"东风律律好年华，次第开时有好花。",83],[4370,"兄弟决无双，安享荣华出身苦"],[4371,"问舍求田，家业兴隆。",43],[4372,"数有一子，得以送老。"],[4373,"一犬一犬又一犬，命里犯刑孤"],[4374,"辟雍成名。",39,40],[4375,"劳心劳力，总成画饼。",22],[4376,"喜气洋洋，德义两全。",63,64],[4377,"兄弟十人，数有五贵。"],[4378,"熙熙人物，不啻梁灏之壮怀。"],[4379,"有子不相合，各自营生计。",67,68],[4380,"祥光掩映画堂明，锦绣铺张物色新。",11,12],[4381,"黄莺出谷，载迁乔木。",39],[4382,"丙子之年，秋闱得意。"],[4383,"谋之事事非，相助强扶持。",26],[4384,"当贡之期。",39,40],[4385,"人生春光，乐意融融。",12],[4386,"夫入泮宫。",39,40],[4387,"顺水行舟，顺风相送。",51,52],[4388,"好德兼好善，修身又齐家。"],[4389,"红烛照画堂，喜气甚非常。",75,76],[4390,"事业守其常，进退几无变。",21,22],[4391,"桃李笑春风，扶苏绿荫浓。",79],[4392,"夫登金榜，妇之幸也。",39,40],[4393,"位转有司，事宜斟酌。",35,36],[4394,"绣花开处棉将成，照耀华堂物色新。",73,74],[4395,"傲画栋雕梁春日迟，主人歌酒有相知。",57,58],[4396,"傲物气高，不仁不求。"],[4397,"数该生子。",24],[4398,"得时亲驾驭，左右相周旋。",21],[4399,"春风有佳信，长安十里杏花香。",23],[4400,"年限将喜，事自相挠。",37],[4401,"辟雍成名，一命之贵。"],[4402,"图利又图名，利就名亦成。",40],[4403,"祖业消耗，另创家园。"],[4404,"恩星相照，八座之荣。"],[4405,"恩星照命，当贡之期。",45,46],[4406,"再任盐道。",41,42],[4407,"色心难淡，竟立偏房。",31,32],[4408,"当贡之期。",41,42],[4409,"真假七子，三子送老。"],[4410,"夫当入泮。",41,42],[4411,"吉星相照，官职高升。",27,28],[4412,"夫当科甲。",41,42],[4413,"过却迷津又坦夷，村庄到处有招寻。",29,30],[4414,"己酉之年，乡科及第。"],[4415,"又升知府。"],[4416,"雪遍琼瑶，白玉楼台十丈高。",57,58],[4417,"轻余袅袅一炉香。",67,68],[4418,"子命属土方合此刻。"],[4419,"金玉之君，社稷良臣。"],[4420,"公门谋依食，不亦乐乎。"],[4421,"天涯无可休，春去又复秋。",49,50],[4422,"当贡之期。",85,86],[4423,"不入泮宫，定为辟雍。",43,44],[4424,"苍蝇点破无瑕玉，不费钱财也费心。",15,16],[4425,"当贡之期。",43,44],[4426,"奔走艰辛总是虚，从朝至夕却支持。",26],[4427,"夫当入泮。",43,44],[4428,"枯杨生花之象。",57,58],[4429,"初授知县。"],[4430,"安守有余，事事隆通。",31,32],[4431,"夫登科甲。",43,44],[4432,"夫入泮宫。",65,66],[4433,"春风鸟声，赏心乐事。",21],[4434,"读诗书成名，少游国学列诸生。"],[4435,"金土之年入泮方合，"],[4436,"妻命属火方合。"],[4437,"此刻生人，父亡金年。"],[4438,"子当入泮。",61,62],[4439,"数有九子，送老难齐。"],[4440,"先男后女，先天定数。"],[4441,"国学标名。",45,46],[4442,"一轮明月照，羽化便登仙。",83,84],[4443,"数该生子。",25],[4444,"舟行浅水，多费移力。",23,24],[4445,"当依贡期。",45,46],[4446,"夫当登科，老来之荣。",65,66],[4447,"破财不吉，老来之荣。",75,76],[4448,"梦香不理赠间事，一点禅心自秘藏。",25,26],[4449,"安乐度流年，暗里祯祥转。",75],[4450,"夫当入泮。",45,46],[4451,"花结果蕊，喜事频来。",45,46],[4452,"迷云渺渺归何处，贵留物业与阳人。",41,42],[4453,"命带阎王关，解破得安然。"],[4454,"一樽美酒送行人，竟往仙乡作故人。",33,34],[4455,"官至守备，不能高耀。"],[4456,"夫登科甲。",45,46],[4457,"有衣有食堪曳裾，无事无求乐安然。",53,54],[4458,"进有可为，及时猛进。",27],[4459,"运至时行，无往不利。",27,28],[4460,"道通路达，可喜可乐。",49,50],[4461,"世事犹如春，梦浮生倏忽以尽。",43,44],[4462,"无究春色，收拾笑颜。",85,86],[4463,"颠沛有灾，宫非又来。",72],[4464,"运未亨通，履之皆错。",20],[4465,"太平无事无征伐，臣民共乐大有年。",51,52],[4466,"人事安然，门庭吉庆。",35],[4467,"行门到水处，指日见波涛。",38],[4468,"一生行善，必有旌荣。"],[4469,"紫气洋洋，恩至超迁。",47,48],[4470,"运至高强，图谋顺利。",23,24],[4471,"辟雍成名。",47,48],[4472,"花蕊初红，不荣而荣。",11,12],[4473,"春风满目，歌酒倘佯。",43],[4474,"俯仰无虞，安然快乐。",80],[4475,"吉星解救，灾星未央。",21,22],[4476,"送老二子，花开到树。"],[4477,"跛其一号，前生所定。"],[4478,"浮云掩月光，风卷云收藏。",39,40],[4479,"徒弟三人，得以送老。"],[4480,"婚姻奇缘，亲上加亲。"],[4481,"安乐无忧常，享清平之福。",72],[4482,"北堂萱草得长年，风折春枝定在先。"],[4483,"一梦归西，飘然不返。",33],[4484,"恩星相照，当依贡期。",47,48],[4485,"玉兔催人投宿处，金鸡唤客束行装。",25,26],[4486,"曲径推车，进退两难。",32],[4487,"家室康宁，门庭吉庆。",85,86],[4488,"少年登科第，秋闱得意回。",16],[4489,"生子之年。",40],[4490,"为人谋图，自立成家。"],[4491,"壬午之年，乡科及第。"],[4492,"真假二子，得以送老。"],[4493,"人坐春风中，名花锦绣丛。",17,18],[4494,"一字曰蛇，欣欣然然。"],[4495,"严霜欺嫩草，幸喜有根存。",11,12],[4496,"莫笑冯唐无晚景，还期老运享荣华",53,54],[4497,"生计得优游，朝夕享安舒。",41,42],[4498,"名著当时，文章超达。",36],[4499,"静守空门业，闲栖丈室间。",73,74],[4500,"文昌照命，擢升御史。"],[4501,"犬当登科。",47,48],[4502,"命带天吊关，解救自灾然。"],[4503,"无灾无祸，其年大吉。",57,58],[4504,"敏而好学，有质有文。"],[4505,"官至癸酒，解组林下。"],[4506,"以捐纳而选典史，数由前定。"],[4507,"际遇相逢喜事业，无边晚景任徘徊。",73,74],[4508,"天意拂人心，问利总无恁。",21,22],[4509,"国学标名。",49,50],[4510,"一年又一年，无日不蝙跹。",67,68],[4511,"池边杨柳，春日舞风。",79],[4512,"兄弟六人，数有五贵。"],[4513,"庭前芳草，春日融融。",22],[4514,"半夜风息，扁舟稳渡。",36],[4515,"熙熙攘攘，安康抵足。",74],[4516,"福从意外，东西南北任徘徊。",45,46],[4517,"客渡江山易，指日满载还。",45,46],[4518,"数该生子。",19],[4519,"一池荷花，亭亭直上。",47],[4520,"举头初见太阳升，左右求谋事事成。",33,34],[4521,"数年立志鸡窗下，一贡成名得显扬。",49,50],[4522,"老运康宁，福自安然。",95,96],[4523,"心意安于室，克享老成福。",75,76],[4524,"命犯落进关，解破得安然。"],[4525,"风卷浮云，日现中天。",33,34],[4526,"整顿琴声，不负良辰美景。",15,16],[4527,"入山樵童，得地得时。",33,34],[4528,"人事无求，风顺水流。",64],[4529,"一水又二山，高低步步难。",18],[4530,"名花得雨生春色，满目红颜入画堂。",38],[4531,"阴雨连宵至，眉头交蹙未开颜。",43,44],[4532,"子当辟雍。",63],[4533,"意外之财，不求自来。",25,26],[4534,"慷慨热心肠，为人无鄙吝。"],[4535,"真假四子，三子送老。"],[4536,"父死于水年，母死于火年方合。"],[4537,"村村遍布绿杨阴，绿杨阴处可消停。",35,36],[4538,"天德相扶，家门吉庆。",51,52],[4539,"叶新林换绿，花落地生香。",5,6],[4540,"夫当入泮。",49,50],[4541,"苟合如缘，数由前业。"],[4542,"虎豹晋星临，千里迢迢作充军"],[4543,"数该生子。",25],[4544,"命带短命关，解破得安然。"],[4545,"命入文昌，有学堂份。"],[4546,"曲径山蹊，桃源之景。",31,32],[4547,"安步至前途，不必费踌躇。",41,42],[4548,"不特无灾，相庆寿增。",67,68],[4549,"兄弟十人，数有四贵。"],[4550,"江头昨夜报潮生，两岸轻烟水自平。"],[4551,"夫登黄甲，妇人之幸。",49,50],[4552,"安其常分守其成，福犹防有不虞悲。"],[4553,"流年欠顺，急唤杨枝。",35,36],[4554,"乐意忘忧，其蓄也实。",65,66],[4555,"乐意从容，善能知足。",69,70],[4556,"风雨凄凄正愁人，窗前寂寞有谁知。"],[4557,"有子能述，可以忘忧。",65,66],[4558,"子当辟雍。",64],[4559,"三辅颂鸿庥，二羽旌歌胜。",61,62],[4560,"身入玄门，玄门相亲。"],[4561,"辟雍成名。",51,52],[4562,"数中不幸，死于非命。"],[4563,"科场未得遂，一贡难成名。",51],[4564,"风雨无恁，梨花飞舞。",51,52],[4565,"前山深处，树木烟浓。",43,44],[4566,"内无乖戾气，外有恺悌风",51,52],[4567,"夫入泮宫。",51,52],[4568,"出于幽谷，迁于乔木。"],[4569,"其人之亡，定在九月。"],[4570,"枯木再荣，全仗东风。",49],[4571,"夫登科甲。",51],[4572,"黄甲传宣数，卯辰报亲捷。"],[4573,"子贵自贵，流年之庆。",47,48],[4574,"妻命属木方合。"],[4575,"衣禄木盈，内外清平。",43,44],[4576,"见机而进，不招耻辱。",55,56],[4577,"功勋著社稷，名声震华夏",23,24],[4578,"缓舒莺羽翼，轻举蝶精神。",9,10],[4579,"风卷荷珠，圆又复碎。",25,26],[4580,"不登庠序，不得辟雍。",53,54],[4581,"风拂禅灯，注重晦滞。",25],[4582,"子当辟雍。",57],[4583,"威仪郑重，德存流芳。",50,51],[4584,"雷声虽大全无雨，放下心肠且宽宏。",57,58],[4585,"兄弟二人，志向不同。"],[4586,"图谋凑合，财帛勃发。",47,48],[4587,"三更滴漏夜未央，子规啼血断人怀。",52],[4588,"事事可求，求之必得。",57,58],[4589,"理应生子。",33],[4590,"依贡之期。",53,54],[4591,"黄乌乔木，舌如笙簧。",35,36],[4592,"夫入泮宫。",53,54],[4593,"寂寞看更长，疏星送太阳。",55,56],[4594,"暖风拂拂来，正当十月天。",47,48],[4595,"吉曜相照，碎又复圆。",13,14],[4596,"花开正当赏；不觉风雨来。",27,28],[4597,"夫登科甲。",53,54],[4598,"命带雷公打脑关，数云解救得安然。"],[4599,"按辔徐行，步步亨通。",53,54],[4600,"无是无非，随缘度日。",25,26],[4601,"辟雍成名。",55,56],[4602,"夫入泮宫。",55,56],[4603,"事业隆隆，瑞气门庭。",53],[4604,"羊肠路上几盘桓，一转危坡任坦夷。",57],[4605,"徒弟三人，二人送老。"],[4606,"运至时行，谋事顺利。",51,52],[4607,"淹淹限有事，东风飘飘寒。",71],[4608,"初任把总，却有变幻。"],[4609,"官职高擢，八座之尊。",22],[4610,"当依贡期。",55,56],[4611,"坐安车驱，当有险处。",79,80],[4612,"昔年多愁苦，今日得安舒。",45,46],[4613,"家室不宁，流年有咎。",19],[4614,"作事多反覆，行之未遇时。",25,26],[4615,"走过前途多息肩，绿阴深处得周旋。",46],[4616,"好花将开，清风徐来。",11,12],[4617,"百姓无咎，共乐太平。",47,48],[4618,"运行南方地，功名成就时。"],[4619,"忧喜相逢，愁颜变笑容。",26],[4620,"未遇其时，莫与有为。",42],[4621,"夫当登科，晚年之福。",55,56],[4622,"职司高爵，事宜项其斟酌。",27,28],[4623,"瑞气隆隆，门庭喜庆。",23,24],[4624,"辟雍成名。",57,58],[4625,"此刻生人必刑妻。"],[4626,"官至春坊，不能拜相。"],[4627,"命拱耀星，职司通政。",45,46],[4628,"月缺易圆，镜破难合。"],[4629,"身带疾厄，解禳得安。"],[4630,"当依贡朝。",57],[4631,"竟梦黄梁，异乎痛哉。",35],[4632,"生计庸常，宽然有度。",27,28],[4633,"六阴停极，消长不一。",67,68],[4634,"身心舒泰，福禄骈臻。",97,98],[4635,"运至高强，图谋异常。",39,40],[4636,"丁卯之年，乡科及第。"],[4637,"财帛随人来，图谋必周全。",37,38],[4638,"夫当入泮。",57,58],[4639,"数当此尽。",36],[4640,"财帛逐日进，物色更从新。",41,42],[4641,"新绿枝头可问禅。",27,28],[4642,"夫登科第。",57,58],[4643,"半作生涯半作田，一生衣禄靠心坚。"],[4644,"数该生子。",35],[4645,"犬当入泮。",69,70],[4646,"满园花茂盛，事来称人怀。",62],[4647,"母先故于木年，父后故于土年。"],[4648,"两妻生双子，双喜临门。"],[4649,"一枯一荣，二子送老。"],[4650,"夫登科甲。",59,60],[4651,"洛阳花似锦，清风送佳音。",39,40],[4652,"朝歌夕乐，克享成福。",61],[4653,"数该生子。",62],[4654,"妻命属火。"],[4655,"春风依旧到江城，又见江城锦绣丛。",45],[4656,"慕廉颇李牧之风，学孙武穰苴之术。"],[4657,"琼林之宴，抡元之职。"],[4658,"当依贡期。",59,60],[4659,"让得前头一人口，杏花十里马蹄轻。"],[4660,"事事添花锦，荣华自可夸。",33,34],[4661,"衣钵一身。"],[4662,"衣钵一身闲，四时尘不染。",27,28],[4663,"流年顺遂，谋事有功。",41,42],[4664,"朝起遇顺风，随时帆挂到江东。",58],[4665,"俭约守之犹不足，过而不改其能乎。"],[4666,"和气洋溢，室家吉庆。",75,76],[4667,"朝烟夕霞，转眼淹留。",9,10],[4668,"只宜守已，不可妄为。",53,54],[4669,"日日笑颜开，财通福自来。",31,32],[4670,"此刻生人必刑夫。"],[4671,"夫当入泮。",61,62],[4672,"一梦归西别阳台。",37],[4673,"家室安乐，事事更新。",53,54],[4674,"谋事有喜意，年来迥不同。",35,36],[4675,"夫登科甲。",61,62],[4676,"顺水行舟，瞬息千里。",39,40],[4677,"喜事祯祥天意来，阴阳调合百花开。",13,14],[4678,"稳足无求，往来春秋。",56],[4679,"夫当入泮。",63,64],[4680,"当依贡期。",63,64],[4681,"春寒秋热，光景无多。",63,64],[4682,"桃红柳绿薏春风。"],[4683,"巧利巧利，不逢自达。",53],[4684,"兄弟怡怡，又入泮宫。"],[4685,"行到桃源流水处，绿扬阴里任君眠。",45,46],[4686,"合卺杯中浮绿蚁，玉栏杆上醉春风。",32],[4687,"尘埃掩镜台，母先赴瑶池。"],[4688,"新月挂松梢，清风送佳音。",7,8],[4689,"早岁平安，将来大垢。"],[4690,"春到自然花烂熳，花开随处月光辉。",31,32],[4691,"春风依阳到阳城，处处花开锦绣明。",37,38],[4692,"退险而夷，逢凶化吉。",38],[4693,"数刻生子。",38],[4694,"皓月当空，清光不同。",37],[4695,"囊橐中宜检点。"],[4696,"金枝玉叶大家女。",45,46],[4697,"金枝毓秀，玉树生春。",27,28],[4698,"无事无求安乐业。",83,84],[4699,"事业不专，进三退四。"],[4700,"问利三旬之外，取之左右逢原"],[4701,"小小兴家自富，微微立业有成。"],[4702,"别却阳间长，往西方而短。",38],[4703,"一生无患处，底事自安然。"],[4704,"美貌佳人难共老，琵琶拨出数肠声。",37],[4705,"年照文昌，领得青衫换布衣"],[4706,"家无但石之储，忽起万金之富。",45,46],[4707,"登山有路，沿级而上。",22],[4708,"苍松石柏，难免根枯。",83,84],[4709,"身居翰苑紫微宿。"],[4710,"一阵暖风，消除寒气。",11,12],[4711,"荷花出水，风来飘动不相宜。",11],[4712,"虽然未遂青云志，姓字终沾雨露深。"],[4713,"珠沉沧海，镜破钗分。",75],[4714,"真假三子，二子送老。"],[4715,"虽然未遂青云志，终须国学列诸生。"],[4716,"二九之年丧，母先天定数。",18],[4717,"数该生子。",65],[4718,"晚年暮景宁，无茕独之忧。",79,80],[4719,"得上贵之大挈，可力图其大用。"],[4720,"得内室而助家，隆隆兴起。"],[4721,"风雨溟蒙，杨柳失色。",65],[4722,"子当辟雍。",59],[4723,"问文无益，问武有余。"],[4724,"摇曳轻风，不劳自举。",35],[4725,"管弦歌里度春风，兆民欢呼乐意浓。",45,46],[4726,"擢星相照，非科即道。"],[4727,"子当辟雍。",58],[4728,"年迈五旬，诰命相赠。",49,50],[4729,"气象峥嵘，门庭赫奕。",45,46],[4730,"不劳心力，谋事克济。",36],[4731,"成家多握掌，立志无息肩。"],[4732,"琴瑟调和，一弦忽断。",46],[4733,"景能无边一一收，春山秋水醉高楼。",37],[4734,"晚景融融，自作笙歌。"],[4735,"不须卜甲子，甲子有余零。"],[4736,"少乐多忧，常处不足。",21,22],[4737,"困于蔟藜，不见其妻。",25],[4738,"披麻相照，孝服临身。",33,34],[4739,"七八年未有小晦，九十之时日已晴。",56],[4740,"行人休息绿阴中，前去桃花处处同。",59,60],[4741,"出身平常百姓家。"],[4742,"财多堆积，事多相得。",39,40],[4743,"其人数尽，定在十月。"],[4744,"春到自然花烂熳，秋来随处月光辉。",39],[4745,"操舟遇风，江心颠倒。",51],[4746,"父母全死于火年方合。"],[4747,"事事添花锦，荣华可富身。",34],[4748,"门中龙虎，阁上麒麟。"],[4749,"运至北方地，功名重于时。"],[4750,"辛卯之年，乡科及第。"],[4751,"闷苦无事，正可谈经。",37,38],[4752,"大道推车，坦然进步。",32],[4753,"怀抱安舒，际遇相安。",61,62],[4754,"大限已尽。",85,86],[4755,"晚景更高强，东篱黄菊自生香。",81,82],[4756,"再升县令。"],[4757,"随取随足，老运安康。",73,74],[4758,"年年景色不相同，欢笑声中乐意浓。",61,62],[4759,"际会荣景，寅天之福。",33,34],[4760,"子当辟雍。",60],[4761,"正副佳人，欢娱老景。"],[4762,"试问寿光何日尽，九旬已上有余年。"],[4763,"光景非前日，内外总安然。",53,54],[4764,"天喜照临，宜室宜家。",16],[4765,"往来康庄，洋洋自得。",51,52],[4766,"龙归大海，虎入深山。",33,34],[4767,"春台日永，宝鼎生香。",29,30],[4768,"数该生子。",58],[4769,"妻生命属木。"],[4770,"春来万物生，天地造化融。",39,40],[4771,"享万年衽席之安，释上方焦劳之苦",33,34],[4772,"初任选庶吉，翰林声价值千金。"],[4773,"文星照命，自然成名。"],[4774,"母逝父在，方合此刻。"],[4775,"疾病相缠，神佑得安全。",13,14],[4776,"金谷园中秋色老，繁华洞里世间花。",15],[4777,"迷场不可入，易散而难聚。",63,64],[4778,"走到亲肠，得人指引。",13,14],[4779,"萱花茂盛，谁知今日孝服来。",65],[4780,"娶得相如妇，方合此刻。"],[4781,"三更漏尽早收星，便见东方日已明。",62],[4782,"闲得每相侵，晨昏未得寝。",49,50],[4783,"其中有刑克，俱是先天数。"],[4784,"子当辟雍。",53],[4785,"到底赁虚总是空，几度凄凉雨又蒙。",16],[4786,"散步重山去，山奇水亦奇。",33,34],[4787,"年将六秩，破耗其财。",15],[4788,"登楼未有梯，举步却徘徊。",15,16],[4789,"初任守备。"],[4790,"爽气生秋色，烦器顿解除。",43,44],[4791,"风雨凄凄，桃红柳绿减精神。",37,38],[4792,"数该生子。",70],[4793,"破军星入限，流年有咎。"],[4794,"仁途变幻，官讼交加。",35,36],[4795,"洗净菱花暗锁烟，翻然光景倍光明。",59,60],[4796,"芙蓉秋菊，晚景生春。",53,54],[4797,"思难图易，事乃克济。",65,66],[4798,"莫恨妻儿无缘分，命中惟带一孤神。"],[4799,"但遇东方远，功名垂千古。"],[4800,"相逢知己言，日日笑颜开。",43,44],[4801,"命中注定六女。"],[4802,"无是无非，安闲岁月。",51,52],[4803,"春入三阳，万物荣昌。",55],[4804,"拨贡终身，以结一生之局。"],[4805,"回也之寿，君亦如之。",32],[4806,"人度峡山，挣持之力。",41],[4807,"少年登科。",17],[4808,"路逢曲径人心迷，视日便知东与西。",20],[4809,"舟行浅滩，午潮正落。",51],[4810,"时运未通，事多反复。",25,26],[4811,"父无多娶，家门之幸。"],[4812,"月德星临门，庭前嘉气新。",61,62],[4813,"渐赌已破，输中难胜。",16],[4814,"谋事多反覆，大运未遇时。",30],[4815,"水土之年，纳八品方合。"],[4816,"学纯而粹，气大而刚。"],[4817,"谋事皆通，不劳心力也成功。",53,54],[4818,"山桥曲转，鼎新路阻。",38],[4819,"中天物色，照耀光华。",13,14],[4820,"寿止于此矣。",49],[4821,"出水荷花，亭亭直上。",13,14],[4822,"其人之亡，定在十一月。",55],[4823,"财帛破盗耗，无奈天数定。",55,56],[4824,"财帛辐臻暗中来，坦然安乐笑颜开"],[4825,"好花正赏，岂期夜雨又风吹。",31,32],[4826,"好事多磨，有情人终成眷属。",41],[4827,"草色萋萋，东风吹绿。",17],[4828,"姻缘长短皆前定，月缺花残数不饶。",20],[4829,"母命水年生，方合此刻。",52],[4830,"当入泮宫。",25,26],[4831,"夫当登甲。"],[4832,"无事平安。",61,62],[4833,"子命土年生，方合此刻。",16],[4834,"全凭筋骨力，断取一生财。",30],[4835,"绍忠孝传家之宝，干谋略建国之心。"],[4836,"喜气上眉端，其年事事安。"],[4837,"白发遮黄老，银须新紫袍。",53,54],[4838,"财散因好博，此地不可乐。",38],[4839,"数尽于此。",13,14],[4840,"犬当入泮。",49],[4841,"运已从人事，不妨猛图而遂事。",29],[4842,"韶光荏苒易长生。",12],[4843,"财帛定有耗，预知免一半。",18],[4844,"仁义有亏，减寿减禄。"],[4845,"阳和春景称人怀，花洒满园次第开。",22],[4846,"兄弟三人，折了一个。"],[4847,"帆遇顺风，瞬息千里。",32],[4848,"未知袁颜道，不胜又输人。",18],[4849,"新竹成竿，凌空而上。",24],[4850,"文星照命，当入泮宫。",19,20],[4851,"此日多得成，贵人指引喜盈盈。",55,56],[4852,"流年容易度，相遇乐平安。",45,46],[4853,"曲路推车，进退两难。",29],[4854,"依贡终身，以结一生之局。"],[4855,"本艺学成归发达，半为生理半为田。"],[4856,"喜气盈盈，家室安宁。",61],[4857,"乡榜题名。",19,20],[4858,"风急卷波涛，扁舟已近岸。",63,64],[4859,"但行西方运，名就利亦成。"],[4860,"子命金年生方合此刻。"],[4861,"春宵夜长，空闺悱恻。"],[4862,"名登金榜。",19,20],[4863,"以监而选州官数由前定。"],[4864,"犬生两口，白染罗巾。",17,18],[4865,"风宪行台，得意之时。",33,34],[4866,"慎固卦守，以康四海。",27,28],[4867,"四字切记：莫失良机。"],[4868,"乐事从容，日日笑颜。",75,76],[4869,"幼年登科。",15,16],[4870,"祸生意外，岂知意外不成空。",39,40],[4871,"仗尔辛勤力，依人小利财。"],[4872,"勃然而兴，门庭吉庆。",39,40],[4873,"财帛破耗，留之不住。",19],[4874,"不暖不寒，平和景色。",31,32],[4875,"楼头砧杵已无声，滴漏壶中曙色明。",41],[4876,"癸酉之年，乡科及第。"],[4877,"货殖通名利，资财日发兴。"],[4878,"九苞瑞气凤，五色麒麟祥。",63,64],[4879,"暖日融融，流光迅速。",11,12],[4880,"诗文为生，方合此刻。"],[4881,"春风布暖，和气称怀。",11],[4882,"潇潇洒洒图欢乐，货财耗去悔过迟",19],[4883,"财退如潮去，神亦不能资。",20],[4884,"弃去功名志，朝夕作闲人。"],[4885,"癸酉之年，乡科及第。"],[4886,"发财凭运至，货物自生辉。"],[4887,"子木年生方合此刻。"],[4888,"听凯歌于载路，嘉卓异于九重。",53,54],[4889,"未出胎而亡父，抱天之恨。"],[4890,"恩星相照，光明福随。",31,32],[4891,"为人深怀，修养已到。"],[4892,"丁酉之年，鹿鸣宴饮。"],[4893,"招牌原写公平字，银钱交接便生心。"],[4894,"财在吾身何等稳，鬼催人睹散如何。",20],[4895,"王事靡监，不遑将父。",25,26],[4896,"财帛勃发，天意从人。",53,54],[4897,"大顺小逆，顺逆不一。",40,41],[4898,"财星居官禄，纳粟成名声。"],[4899,"散财无常，霪雨遇风。",15,16],[4900,"数尽于此。",50],[4901,"朝夕费踌躇，从劳亦空虚。",51,52],[4902,"时运财散，有口不言。",23],[4903,"数该生子。",15],[4904,"推车周旋，辗转如意。",65,66],[4905,"落落市廛中，经营限未通。"],[4906,"举步皆得意，求谋事事通。",37,38],[4907,"雨足郊原草，萌芽尽舒展。",45,46],[4908,"融融三月景，萋萋百草芳。",77],[4909,"巨船出大海，布帆无恙挂西风。",48],[4910,"场中散白壁，因心是贪玩。",21],[4911,"行舟遇风，无往不利。",37,38],[4912,"沉滞不解，两眉强舒。",55,56],[4913,"腾腾散财，何耗之速。",21],[4914,"年华始尽.大数已终。",39,40],[4915,"伉居稳地，可去无咎。",37,38],[4916,"市尘微利好，但恨富难成。"],[4917,"月出南楼，光明照耀。",23,24],[4918,"怀断断休休之度，仕巍巍荡荡之朝。"],[4919,"锦绣丛中，事乐融融。",67,68],[4920,"报晓梦初醒，枝头听鸟鸣。",39,40],[4921,"莫道世无神，输钱皆是鬼。",21],[4922,"寻常同一样，不必别姻缘。"],[4923,"手艺惟精熟，人求福自生。"],[4924,"淑人君子，其德不渝。"],[4925,"如鸟伤翼，不能远举。",31,32],[4926,"甘雨和风三月天，游人乐无边。",25,26],[4927,"未识为人好与丑，但看行事假和真。",11,12],[4928,"名登金榜。",17,18],[4929,"数有五子，三子送老。"],[4930,"月至初弦，其光半掩。",81,82],[4931,"一堆金与银，场中一半入人手。",22],[4932,"否转为泰事更新，残冬去后有阳春。",41,42],[4933,"流年悲星照，破我许多财。",63],[4934,"明月正当空，弯弯曲曲转西东。",73,74],[4935,"到处是追随，祥光映紫微。",65,66],[4936,"花落又花开，春风次第来。",45,46],[4937,"莫恼繁华不到年，早安淡薄后来荣。",11,12],[4938,"退财只为想人财。",63],[4939,"风紧遇波浪，波浪几番愁。",53,54],[4940,"大怀开展，繁华耀目。",59,60],[4941,"十事谋来九事空，年年踪迹若飘蓬。",58],[4942,"官事相探，所为有咎。",67,68],[4943,"万里晴空，光明大道。",47,48],[4944,"双新辞世在何年，他日哀哉母为年。",59,60],[4945,"数该生子。",45],[4946,"数定有灾缠，神祜度流年。"],[4947,"谋为顺遂，万事呈祥。",26],[4948,"高楼擢司，进退而审。",37,38],[4949,"原是恨不可，所以退此财。",65,66],[4950,"心好事烦，家终朝复。",39,40],[4951,"一湾春水，溶溶无穷活计开。",37,38],[4952,"天上转星临，试赌散黄金。",24],[4953,"燕鸟于飞哺，出巢而堪宿。",35,36],[4954,"欲东而欲西，心中多少事。",53],[4955,"日月初光华，宇宙景色新。",13,14],[4956,"得失皆前定，已失不须恨。",25],[4957,"忘想他人财，自己反成破。",25],[4958,"玉蕴于荆山，未得圭璋选。",47,48],[4959,"泉清松影瘦，月白李花香，",39,40],[4960,"读书应有分，白发始逢升。"],[4961,"四字切记：当机立断。",58],[4962,"好将善决传儿辈，乐我消闲一片心。",67,68],[4963,"饮酒茹荤无我份，数中注定一道人。"],[4964,"小往大来，中正和平。",59,60],[4965,"破耗忽生，数所定也。",26],[4966,"超升部属，会转京堂。"],[4967,"阴阳颠倒，财迷场散。",26],[4968,"极止千红万紫，七零八落。",27,28],[4969,"行到桃源流水处，绿杨影里任君眠。",45,46],[4970,"劳而有功，能事克济。",39,40],[4971,"龙泉利器，淬锋未试。",27,28],[4972,"富来有基业，不必费踌躇。",45,46],[4973,"芬芳春将尽，南枝鸟倦啼。",69,70],[4974,"火罗入限，流年有咎。",27],[4975,"父故于木年方合。"],[4976,"文章入泮。",41,42],[4977,"博绿呼红不是好，定数输了始彷徨。",27],[4978,"鸟呼树枝上，乘时乐意来。",35,36],[4979,"不必问行藏，老运不安康。",59,60],[4980,"韶光明媚，物色文章。",44],[4981,"有利攸往，甘愿如今。"],[4982,"华盖相逢刑克重，数定披头去修行。"],[4983,"物色逢春至，桃源正及时。",56],[4984,"财帛自然发，运行天凑合。"],[4985,"莫闲微致恨，只作未闻香。",33,34],[4986,"安乐无惊人，舒畅听钟声。",86,87],[4987,"无祸无灾，明星璀灿。",17,18],[4988,"文明之象，时当有为。",41,42],[4989,"骨肉相刑，西风洒泪。",31,32],[4990,"妻妾子众神仙难，断子仪命世上有。"],[4991,"出家除俗累，解脱入空门。",23,24],[4992,"官至兵部，以乐终身。"],[4993,"天祐吉人，乐事有功。",25,26],[4994,"幼年行事实难为，逆水行舟又遇风。"],[4995,"财帛勃发，谋事凑合。",47,48],[4996,"村村花柳，到处吹呼。",53,54],[4997,"利物利平，生意兴隆。",34],[4998,"恩星相照，闺中福随。",42],[4999,"重重如关锁，进退不得意。",65,66],[5000,"儿女有喜，满门炽昌。"]]}
