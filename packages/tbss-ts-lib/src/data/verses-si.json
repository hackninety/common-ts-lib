{"volume":"巳集","verses":[[6001,"一生衣禄勤俭，钱财广于晚年。"],[6002,"柏舟自失，心坚似冰。"],[6003,"几点芭蕉雨，一声愁闷不堪开。",41,42],[6004,"祥光映画堂，获福自思量。",21],[6005,"熟读萧公律，功深自可求。"],[6006,"云里月，雨中花。",39,40],[6007,"官至尚书，至尊至贵。"],[6008,"命中多内助，家室有孟光。"],[6009,"壮年劳老年闲，名利场中不用贪。"],[6010,"心本太虚，一尘不染。"],[6011,"数有三子。"],[6012,"前妻一子，后妻无儿。"],[6013,"为所当为，独之大利。",35,36],[6014,"凶神为吉吉又凶，凶之无害吉成功。",25,26],[6015,"徒弟四人，许具送老。"],[6016,"无害有益，无劳心力。",45,46],[6017,"上承下接，财帛广积。"],[6018,"庆父已死，云开见日。"],[6019,"有针无线用，欲穿未成衣。",23,24],[6020,"易乎其易，事功有济。",31,32],[6021,"无甚灾凶恶难，亦是常年之喜。",7,8],[6022,"四业读书，陶情花涵。"],[6023,"前途尽是坦夷路，一任邀游自在行。",31,32],[6024,"经父纬母，独把之财。"],[6025,"如圭如譬，如金如锡。",55,56],[6026,"君子是则，永受其福。",45,46],[6027,"与人亦求佣，检身若不及。"],[6028,"腾文则野，先进之风。"],[6029,"川下火起，灾毒不减。",63,64],[6030,"伯牛有疾，君亦如之。",55,56],[6031,"景色晴明，芙蓉开展。",49,50],[6032,"兄弟二人，其乐融融。"],[6033,"有箭无弓，欲射不能。",21,22],[6034,"月上初弦渐光明，若到中旬倍十分。",25,26],[6035,"云里月，雨中花。",39,40],[6036,"碧天万里浮无云，月对栏杆水有阴。",37,38],[6037,"梦魂不扰，际遇相安。",53,54],[6038,"眉头开展，事得施为。",37,38],[6039,"有斐君子，终不可喧。",63,64],[6040,"伊耕于有萃，野未逢汤聘。",23,24],[6041,"数有三子，得以送老。"],[6042,"坎坷度流年，机会几变迁。",39,40],[6043,"发福千秋至，运广积财帛。"],[6044,"流年更不同，桃花与柳浓。",31,32],[6045,"喜庆得相逢，谋之便有功。",57,58],[6046,"乡科及第。",65],[6047,"始忧终悦，良辰美景。",67,68],[6048,"背有曲驼，前生恶报。"],[6049,"犬生两口，请君详之。",59,60],[6050,"爵虽武曲，业本儒行。"],[6051,"财帛耗散，积蓄为难。"],[6052,"成家贵人扶，一身安乐永无忧。"],[6053,"悉闻啼鸟叫，跃马过檀溪。",55,56],[6054,"芙蓉未了变忧容，花正开时忽遇风。",17],[6055,"春风桃李花开日，秋雨梧桐叶落时。",81,82],[6056,"手艺要高九流内，都在人间第二流。"],[6057,"几年撑过安宁日，将来自有佳景图。",45,46],[6058,"血光潮热时年气，五六前后不能容。",5,6],[6059,"有为之时，事及克济。",37,38],[6060,"洞房之喜。",26],[6061,"东风转西风，昼夜暖寒自不同",25,26],[6062,"恩星照命，吉利安宁。",39,40],[6063,"香生帘幕清风转，花覆宫墙淑气多。",31,32],[6064,"问利问名，两收其益。",41,42],[6065,"离合春光老已无，颜色逢秋又槁枯。",57,58],[6066,"精传茅山法，普救世间人。",65],[6067,"刚断而任，气象峥嵘。",67,68],[6068,"恩星相扶，增福进爵。",51,52],[6069,"祸去祸来，灾毒尽梢。",59,60],[6070,"不须忧虑，守分安常。"],[6071,"缥缈梦魂，蝴蝶分飞。",63,64],[6072,"烦恼无人识，惟欠东风个人知。",44,45],[6073,"匪直也人，秉心塞渊。",55,56],[6074,"葵花偏爱日，掩映不为光。",17],[6075,"惆怅关山外运限，有奇灾神力可保。",31,32],[6076,"不意之中福自臻，恩星相照福来临。",53,54],[6077,"命带文昌，名登金榜。",45,46],[6078,"时运不通，连遭几度。",5,6],[6079,"金风除暑气，心舒喜自如。",37,38],[6080,"嫡母庶母，命中注定。"],[6081,"偶因行事徒差错，误了终身识未知"],[6082,"半为儒者半为医。"],[6083,"妻早子亦早，人生大幸好。"],[6084,"华年凋谢天地老，人生多情偏悲思。"],[6085,"蟋蟀最无知，亦悲年运穷。",76],[6086,"超然物外时，时梅月松风。",63,64],[6087,"闷闷不堪言，蹑足不知前。",1],[6088,"一往因飘蓬，俯仰又似悲。",27,28],[6089,"东西任所之，宇宙何其宽。"],[6090,"时乖命亦乖，浑沌无心绪。"],[6091,"用之帝王师，不用岩谷叟。",50],[6092,"烦恼认人识，惟欠东风个人知。",46],[6093,"问之父母全，卜他之年父先去。"],[6094,"严霜上鬓，东风吹去。",65],[6095,"童子五岁，难免灾晦。",5],[6096,"此刻生人，兄弟有疾。"],[6097,"穷通皆由命，切莫强求谋。"],[6098,"达将连驷骋，穷即蓬荜行。"],[6099,"凉风暑气除，心安舒自如。",55,56],[6100,"妇命能操持，生涯能安居。"],[6101,"五彩绳牵月老话，画眉京兆许张郎。",19],[6102,"灾星相照，啾唧自知。",69,70],[6103,"仕途变迁，正当郑重明。",39,40],[6104,"不必问行藏、进五而退十。",21,22],[6105,"乘车而往按徐行。",41,42],[6106,"莫道少年淡，自然光景辉。"],[6107,"游神问名利，自叹费无成。",53,54],[6108,"川下火起，灾殃自至。",41,42],[6109,"童子五六岁，香芬物色新。",5,6],[6110,"照光正阳和，定和景物多。",15,16],[6111,"寒窗之苦皆经历，何时案上姓名香。"],[6112,"亢龙有悔，勿用于时。",62],[6113,"安心乐意，出人头地。",49,50],[6114,"有弓无箭，欲射不能。",20],[6115,"恼烦无端好忧心，自知自立自沉吟。",45,46],[6116,"财帛有余，一生足用。"],[6117,"平安可保，不问行藏。",19,20],[6118,"犬生两口，孝服之忧。",61,62],[6119,"一曰修好德，二曰利大川。",25,26],[6120,"际遇有主张，行人遇羊肠。",45,46],[6121,"数注其人，田园万顷。"],[6122,"枯苗得雨，家业光隆。",39,40],[6123,"腰缠万贯，一生足用。"],[6124,"庭前草色知君早，暗里栽培透毓新。",27,28],[6125,"数注其人福禄臻，心逸身劳得千金。"],[6126,"登科及第。",41],[6127,"前村遥望杏花红，指引来时有牧童。",31,32],[6128,"仕途变幻，举动多变。",41,42],[6129,"绿林深处有渔舟，漫卷丝纶着意收。",73,74],[6130,"衡门之下可栖迟，泌水洋洋可乐饥。",47,48],[6131,"小宋应熊罴，三子喜可见。",29,30],[6132,"炊臼梦回伤寂莫，中流不见采苹人。",59],[6133,"际遇渐亨通，轻风送转蓬。",25,26],[6134,"发创千金富，儿孙世代昌。"],[6135,"烦恼结心头，愁绪满眉端。",23,24],[6136,"雨遇增山色，云散月华明。",7,8],[6137,"利不可求，动而见忧。",33,34],[6138,"兄弟四人，同父不同母。"],[6139,"古稀欠三春，夫死泪沾襟。",67],[6140,"数注其人富，白手发千金。"],[6141,"皓首风波。",77,78],[6142,"君子坦荡荡，小人常嘁嘁。",39,40],[6143,"欲知几度蟠桃熟，七九加二数已尽。",65],[6144,"一字切忌曰黑，不利矣。"],[6145,"一品当朝，名扬四海。"],[6146,"瑞气重重至，门庭吉庆多。",24,25],[6147,"乐昌破镜难再会，珠沉合浦几时还。",25],[6148,"迷途而得转，好花深处有盘旋。",63,64],[6149,"圆缺因时有不同，主张头上有天公。",39],[6150,"真假四子，三子送老。"],[6151,"待人真诚，受人欺侮。"],[6152,"苗而不秀，秀而不实。",23,24],[6153,"愁怀未可言，因为皆有恨相连。",25,26],[6154,"啾唧不免，一暗一明。",5,6],[6155,"乡科及第，天赐麟儿。"],[6156,"夫妇寡绿，弃妻重妾。"],[6157,"造化有循环，剥极自然复。",49,50],[6158,"好花开芍药，一泓秋水浸芙蓉。",25,26],[6159,"难聚易散名日津。"],[6160,"吉凶不由人，可知次第行。",19],[6161,"翩翩足五行，重水必然有。"],[6162,"走至逆横，事事皆闷。",57,58],[6163,"财帛有余，当年不必问踌躇。",45],[6164,"苍蝇点破无瑕玉，不费财钱也费心。",87,88],[6165,"阴气盘桓晦气催，灾之不已又还灾。",63,64],[6166,"生子之年。",39],[6167,"患难遍相随，为祸又为灾。",31,32],[6168,"道路难行，前荆后棘。",37,38],[6169,"兄弟九人，数有一贵。"],[6170,"荫祖公道，少年荣华。",11,12],[6171,"失怙光嗟情惨切，断机惟笑孟母前。"],[6172,"盘旋复盘旋，渔郎引路前。",55,56],[6173,"福寿双全，精神倍爽。",89,90],[6174,"一生多博学，性情守已乐。"],[6175,"太阳出沧海，欢呼乐意浓。",47,48],[6176,"每日乐优游，寻常不用求。",19,20],[6177,"日日乐优游，安常乐忘忧。",41,42],[6178,"兄弟九人，数有二贵。"],[6179,"既乘其时，当长其志。",39,40],[6180,"今年胜去年，人事幸无愆。",23,24],[6181,"家藏干金，勤俭所积。"],[6182,"明月到中天，画堂自光辉。",42],[6183,"以监而司职，数由此定。"],[6184,"舍了一场灾，几度忧警害。"],[6185,"一品当朝，声扬四海尽知名。"],[6186,"祥光叠叠现，偏照锦堂春。",69,70],[6187,"妻生一子，妾生二儿。"],[6188,"春寒秋熟，光景无多。",71,72],[6189,"君生六子土水金，若生火星便为去。"],[6190,"好花将开，风雨又来。",15,16],[6191,"葵花偏向日，浮去半掩不为凶。",41,42],[6192,"官至都堂，荣归华堂。"],[6193,"瑞气隆隆起，家门吉庆多。",31,32],[6194,"人中龙虎，阁上麒麟。"],[6195,"荫受知州，数由前定。"],[6196,"人逢美运，花放遇春。",35],[6197,"吉庆临门，乐意相从。",31,32],[6198,"荟苔雨遇滑如油，行人仔细便无忧。",47,48],[6199,"兄弟五人，先损一丁。"],[6200,"不用劳力，安然衣食。",61,62],[6201,"双亲同白鬓，父母定其宗。"],[6202,"坎坷有风流，数定几变迁。",42],[6203,"为知白壁方为宝，更起黄金又交接。"],[6204,"流年更不同，桃花映日新。"],[6205,"柳媚花明，赏心时节。",27,28],[6206,"乡科及第。",69,70],[6207,"喜事更相逢，谋之便有功。"],[6208,"锦绣花丛发，开放满园红。",71,72],[6209,"童亦安舒，无甚别事。"],[6210,"桃红柳绿，略称心怀。",15,16],[6211,"兄弟九人，中断离群。",41,42],[6212,"真假六子，四子送老。"],[6213,"灾毒不生，流年之庆。",31,32],[6214,"人逢美景地，花开又遇春。",34],[6215,"自有高人轻借力，两台门户尽光辉。"],[6216,"福履悠悠，家门迪吉。",35,36],[6217,"春光冉冉，物色交新。",31,32],[6218,"财帛骤发，好运时行。",47,48],[6219,"荷花出水，亭亭玉立。"],[6220,"生来欠发达，儿孙创田园。"],[6221,"佛祖降生，方人扳依。"],[6222,"无是无非，三春花柳。",45,46],[6223,"恩星照命，吉利相从。",47,48],[6224,"花申欠二春，夫花泪沾襟。",58],[6225,"凶星夹党，居安虑危。",75,76],[6226,"高山路可通，费力定成功。",43,44],[6227,"乡科及第。",32],[6228,"官至试院而致仕。"],[6229,"数该生子。",59],[6230,"事就怕有人，相欺恨无依。",53,54],[6231,"龙德相扶，必有所获。",53,54],[6232,"数该生子。",43],[6233,"瑞气融融，景象非凡。",47,48],[6234,"徒弟四人，三人送老。"],[6235,"哀哀泣泣，正是刑伤。",11,12],[6236,"喜事临门，事业更新。",29,30],[6237,"月明不怕云遮掩，花艳何妨蝶乱飞。"],[6238,"事事添花锦，荣华自可夸。",71,72],[6239,"步步履泥途，挣挫费踌躇。",27,28],[6240,"遇马之年方进步。"],[6241,"羊刃重逢，刀兵之害。"],[6242,"为所欲为，美利巨获。"],[6243,"官至吏部尚书。",21,22],[6244,"三旬外入泮，方合此刻。",33],[6245,"前途尽是通行路，一任逍遥自在行。",45,46],[6246,"瑞气隆隆，门庭吉庆。",37,38],[6247,"数有不幸，应死非命。"],[6248,"好鸟鸣春，东风暖人。",23,24],[6249,"老来丧母之年。",74],[6250,"虎榜题名，熊罴叶梦。",45,46],[6251,"无伎无求，终身悠悠福有余。",47,48],[6252,"君子日更新，相逢大吉人。",31,32],[6253,"波浪铉息，正好行舟。",37,38],[6254,"不岐不求，安乐悠悠。",63,64],[6255,"进士及第。",21],[6256,"闲度余岁月，不管落花飞。",67,68],[6257,"登科之年。",45],[6258,"谢却忧颜转花容，时来无物不相同。",39,40],[6259,"清明花发正芳菲，恨杀无情风雨催。",67,68],[6260,"金水之年，弓马入泮。"],[6261,"运至时行，知君获福。"],[6262,"安心乐意，出人头地。",40,41],[6263,"倚马雄才到午年，运程发韧泮池边。"],[6264,"数该生子。",51],[6265,"进士及第。",52],[6266,"兄弟十人，中断离群。"],[6267,"十事谋来九事成，春风得意马蹄轻。",45],[6268,"金水之年，国学成名。"],[6269,"当道有荆棘，举步有滞碍。",39],[6270,"木火之年，弓马入泮。"],[6271,"红日上三竿，前程有庆幸。",29],[6272,"兄弟三人，同父不同母。"],[6273,"路遇一知音，携手相扶物色新。"],[6274,"兄弟五人，秦楚不同盟。"],[6275,"荣枯提失皆前定，何必怨天又尤人。",29],[6276,"前妻生四子，后妻竟无儿。"],[6277,"财帛蓄积不求人，上下欢然物色新。",55,56],[6278,"哀哀泣血几经年，原来母先父后亡。"],[6279,"数注双喜，一胎生二子。"],[6280,"父母离巽方生，方合此刻。"],[6281,"历尽几年奇学术，不如终作一星巫。"],[6282,"太岁当头，流年稳妥。",47],[6283,"一岁为泉客，徒增父母悲。"],[6284,"数有偏枯，子当发疾。"],[6285,"真假六子，三子送老。"],[6286,"水中捞月事皆空，尽精神也枉功。",25,26],[6287,"图谋顺遂，足畅所怀。",69,70],[6288,"老来丧母之年。",75],[6289,"祖业命当招，田基莫摇动。"],[6290,"五彩绳牵月老话，画眉京兆许张郎。",21],[6291,"一隙之光可借明，隙光难比月华明。",75,76],[6292,"四宫吉曜奇，数注一胎生二子。"],[6293,"利不可求，动而招尤。",21,22],[6294,"犬生两口，主有哀声。",21,22],[6295,"半吉半凶，吉凶难倚。",39],[6296,"徒弟六人，得以送老。"],[6297,"生计得安然，何劳忧兴煎。",49,50],[6298,"当有三母之称。"],[6299,"山蹊久矣路盘桓，行遇山蹊路坦夷",39,40],[6300,"兄土年生，方合此刻。"],[6301,"乍暖还寒，心常不乐"],[6302,"事有攸理，千头万绪。",55,56],[6303,"牝难晨鸣，由雄不惧。"],[6304,"灾晦消除福自臻，烟云卷尽碧空云",67,68],[6305,"父母故于犬年。"],[6306,"并蒂双莲出，风光共白头。",33,34],[6307,"大数将停莫可为，一朝春尽红颜老。",80],[6308,"白虎照命，是年有灾。",4],[6309,"异路功名，授吏之职"],[6310,"乡科及第。",24],[6311,"初任知县，再升钦取。"],[6312,"徒弟五人，一人送老。"],[6313,"阴暗既分，方可言行。",37,38],[6314,"红莲初水来，花发正阳春",13,14],[6315,"闲坐松阴，乘阴纳凉。",63,64],[6316,"阴云敝日，能使人愁。",41,42],[6317,"虽然富贵，子嗣艰难。"],[6318,"贤儿成鼎志，终身可无虞。"],[6319,"西风忽东风，昨夜今朝事不同",37,38],[6320,"兄弟三人，乐奏几般音。"],[6321,"且沉且浮，事物纷纷未有头。",43,44],[6322,"到处花开春色新，洛阳不比寻常景。",51,52],[6323,"家资百万休嫌少，斗稍之辈我还高。"],[6324,"命中四子，得以送老。"],[6325,"鸟得其所，饮啄自如。",71],[6326,"花蕊初红，风雨相催。",8],[6327,"天光机会，物有祥云。",21,22],[6328,"祖父倍增荣，晚年兴发增。"],[6329,"七岁少三春，萱花落暗尘。",4],[6330,"数有偏枯，妻当眼目不甚明。"],[6331,"兄弟十人，数有二贵。"],[6332,"衣巾遂愿，不必他求。",35,36],[6333,"父母生于火年方合。"],[6334,"一子午年生。"],[6335,"既望之月，其光渐减。",67,68],[6336,"蛊命丧身，前生注定。"],[6337,"当年之事不堪闻，弹出新声别有音。",77,78],[6338,"轻舟飘大浪，时有浮沉惊。",3,4],[6339,"欲上高楼未有梯，不能举步上扳跻。",11,12],[6340,"急流勇退，晚景逍遥。"],[6341,"指引得以相，应转折人心。",29,30],[6342,"风寒消除暖风生，梅花枝头见阳春。",57,58],[6343,"官至千总，不能高摧。"],[6344,"兄弟两家祀，不离本族宗。"],[6345,"事机宜谨慎，方免是非忧。",29,30],[6346,"次第花枝雪里开，梦魂应不染尘埃。",31,32],[6347,"百事和谐，五音叶律。",37,38],[6348,"有子先弃世，赖孙而送终。"],[6349,"平静无风雪。",7,8],[6350,"黄泉无客店，今夜宿谁家。",66],[6351,"谢却人间事，红尘不染心。"],[6352,"粟陈贯朽几年余，富似陶朱苦拮据。"],[6353,"闲看棋杆消白昼，觉来经卷脱红尘。",39,40],[6354,"烛影辉煌，照耀画堂。",69,70],[6355,"其人田园广，一生乐无边。"],[6356,"好运交来事得宜，无心财聚可乘机。",23,24],[6357,"时气相侵，流年不利。",41,42],[6358,"可怜白壁染风尘，仰问苍天惧不平。",43,44],[6359,"人事相通，内呼外应。",39,40],[6360,"创之规模总是勤，十年前事一书生。"],[6361,"钦命典试。",49,50],[6362,"钦授千总，数由前定。"],[6363,"吉星照文场，领袖青矜换紫衣。"],[6364,"以贡而选经历，数由前定。"],[6365,"登山力却，犬有挣挫。",61,62],[6366,"到此停秋风，无限别离情。",45,46],[6367,"座中无物不清凉，别是人间洞府香。",59,60],[6368,"小桥泮藜，书香门第。",27,28],[6369,"左财右财，心神自佑。",41,42],[6370,"治家有法，冰清玉洁。"],[6371,"整顿行装，不负良辰美景。",41,42],[6372,"田财二曜，精奇数享万全福。"],[6373,"困道未可言，步步若流连。",41,42],[6374,"步步履泥途，挣挫费踌躇。",45,46],[6375,"结鬓未能同并老，再婚夫妇得齐眉。"],[6376,"精于医道，不亚儒术。"],[6377,"一品之元老，莲花座上仙。"],[6378,"逆风而摇撸，天转其风帆。",31,32],[6379,"春而复夏又秋冬，寒暑更迁事不同。",11,12],[6380,"一生好学，功成名就。",40],[6381,"盂姜送罢寒衣后，万盏金樽醉自知。"],[6382,"去路茫茫不可知，贵人指引不迷途。",13,14],[6383,"官到知州，不能高摧。"],[6384,"时至出头地，膳自从天来。",49],[6385,"结发未能同并老，重婚夫妇许生儿。"],[6386,"德厚饶施，政平公理。",49,50],[6387,"文昌祠畔有猿啼，一领青衫换布衣。"],[6388,"命如浮蚁，死在一周。"],[6389,"春寒秋热，光景无多。",77,78],[6390,"其人有心，善医济人。"],[6391,"海棠着雨，泪湿胭脂。",24],[6392,"数该生子。",70],[6393,"虽是庶出，兄弟最长。"],[6394,"兄弟九人，同父不同母。"],[6395,"交差交差，门前绿竹尽生花。",49,50],[6396,"福曜相扶，当展其用。",49,50],[6397,"光点红灯灯已阑，长途暗里有艰难。",55,56],[6398,"惟听鸟燕啼，春雨泪沾衣。",42],[6399,"朱提无足自至，青蛱无翅也飞来。",49],[6400,"人随天意，万事周济。"],[6401,"知足漫无足，鬼神驱使悠悠福。",49,50],[6402,"君家要出人头地，异路功名可称怀。"],[6403,"年年花卉春光放，花卉今朝开得早。",27,28],[6404,"藜杖相扶得过桥，昨朝霜露未曾消。",59],[6405,"安常之福，无日不足。",15,16],[6406,"问文不足，问武有余。"],[6407,"兄弟十二人，终断惜离群。"],[6408,"命带将军箭，十二便身亡。",12],[6409,"前妻生二子，后妻竟无儿。"],[6410,"虽喜还无喜，逢凶不见凶。",21,22],[6411,"灾晦潜消官事伏，平安有度无拘束。",75,76],[6412,"承荫父业，仕途可望。"],[6413,"造化有循环，春风吹牡丹。"],[6414,"乡试中式。",40],[6415,"不从文武科中出，应升总督一大厅。",44],[6416,"朱衣点头，得意琼林。",55],[6417,"弥缝不及又弥缝，纵若谋成总是空。",47],[6418,"和气克临，流年顺利。",65,66],[6419,"子息未必运俱齐，有人蹇滞有人宜。"],[6420,"春深鱼游，跳跃自如。",41,42],[6421,"守持之戒，名曰上僧。"],[6422,"登山足跛，力喘而上。",59,60],[6423,"官至总督，不能相拜。"],[6424,"举动迷路，恶梦风起。",20],[6425,"颜子少一春，一梦见阎君。",31],[6426,"芍药开时又遇风，凋残无限锦丛中。",65,66],[6427,"运至时来，富丽顿开。",27],[6428,"名登金榜。",28],[6429,"路可通修，行乃有功。",27,28],[6430,"驳杂无常，进退有损。",27,28],[6431,"财帛虽有，满而不溢。"],[6432,"年逢古稀零有四，谢却阳间去。",74],[6433,"兄弟十一人，数有五贵。"],[6434,"无事得安舒，欢然得自如。",57,58],[6435,"无是无非，光阴渐移。",5,6],[6436,"虽然武终须革去。"],[6437,"父故于金年方合。"],[6438,"一子虎年生方合。"],[6439,"江村三月景，处处绿阴浓。",11,12],[6440,"栖止得所，轻风日午。",23,24],[6441,"莫笑冯唐无晚景，斯君老运享荣华。",57,58],[6442,"命犯白虎，夫当受克。",15],[6443,"天喜命相逢，往来最有功。",7],[6444,"晋升千总。"],[6445,"山坡前有挺，杖几为所害。"],[6446,"翁姑先死，妇之不幸。",75,76],[6447,"进不过进退不退，进退无常以醉。",8],[6448,"著意图谋总是虚，无心之处得成功。"],[6449,"枯木逢春之象。",66],[6450,"兄弟十二人，同父不同母。",54],[6451,"上菀春花遍锦丛，日日追风随马蹄。",35],[6452,"数遇纯阳，文娄尽去。",49,50],[6453,"心之忧戚，履步未舒。",57,58],[6454,"亦算平稳。",8],[6455,"露色溟朦雨，远人未及回。",59,60],[6456,"中年采芹青云路，再积阴功人钦敬。"],[6457,"安然无事纳祯祥，几朵梅花扑鼻香",77,78],[6458,"云收风静，日照深闺。",69,70],[6459,"问君阳年何日止，六旬加五是归期",65],[6460,"经史饱餐归国学，阴功积可到中宫"],[6461,"兄弟虽众，助人却寡。"],[6462,"得个渔翁指路迷，天台不远又何疑。",15,16],[6463,"天生天夺，父母之悲。",7],[6464,"问利三旬之外，方得遂意。",36],[6465,"千古作文家，泰山北斗星。"],[6466,"家室欢乐，事纳祯祥。",75,76],[6467,"冻已消除日渐融，池边杨柳弄轻风。",8],[6468,"初任百总之职。"],[6469,"鸳鸯一对两分飞，自恨良人不齐眉。",66],[6470,"流年顺利，一帆风顺。",54],[6471,"常蹙眉头，欠利多忧。",42],[6472,"兄弟十一人，乐奏几般音。"],[6473,"立元坚固，未可摇动。",89,90],[6474,"兄弟四人，中断离群。"],[6475,"做事蹉跎，其年破局多。",65,66],[6476,"一手伤残，命中带来。"],[6477,"一番好雨应阳春，眼见江城景色新。",62],[6478,"妻命木金年生方合。"],[6479,"春色正可人，依依轻青绿。",3],[6480,"难逃七九之数。",63],[6481,"金土之年国学，木火之年得贡。",11,12],[6482,"江山春色未全来，满树桂花风雨催。",55,56],[6483,"日破财耗，神接踵来。"],[6484,"蹙君多逢蹇，西风泪几行。",36],[6485,"半作田东半作渔，一生衣禄自无穷。"],[6486,"官讼相连，破耗忧煎。",67,68],[6487,"数有七子，得以送老。"],[6488,"劳力劳心勤且俭，半为儒生半为农。"],[6489,"文章入泮，弓马为先。"],[6490,"缓步而行，默然无阻。",35],[6491,"南陌田畴耕暇日，生涯着力得营谋。"],[6492,"喜气盈门，家室安宁。",55,56],[6493,"知君加一岁，卜君是行程。",51],[6494,"王都色带春，得意马蹄径。",65,66],[6495,"再任催官。"],[6496,"求所不当求，空余未了愁。",41,42],[6497,"一生竭力躬耕去，南陌西畴望岁农。"],[6498,"杨柳依依绕绿堤。",5],[6499,"忿气莫伸，终为丧身。"],[6500,"积喜之家，千般吉祥。"],[6501,"年逢古稀零有四，夫别阳关去。",74],[6502,"九天开雾，干山秀色。",48,49],[6503,"晚景亨通，一生幸运。",49,50],[6504,"徒弟七人，得以送老。"],[6505,"再转京台登大用，官归传阁肃风霜。",57,58],[6506,"创立规模总是勤，十年前是一书生。"],[6507,"难逃五十二，明说与君知。",52],[6508,"吉利拥门，财源日进。",35,36],[6509,"以监终身结，一生之结局"],[6510,"数有六子，得以送老。"],[6511,"勤俭持家衣禄足，旺夫益子寿元长。"],[6512,"将军一箭最难当，三岁孩儿身便亡。",3],[6513,"夫虽有寿，别之亦苦。",71],[6514,"老来又精神，枯木又逢春。",91],[6515,"举人任知县，数由前定。"],[6516,"父故于水年，母生于火年。"],[6517,"妻生二子，妾生一儿"],[6518,"数该生子。",36],[6519,"子规啼落楼头月，一枕鸳鸯梦不成",43],[6520,"不出户庭，福自来寻。",79,80],[6521,"不足不驳难相逐。",43,44],[6522,"命带暗杀，三岁而亡。"],[6523,"有子惟宣先抱女，原来有数定先知。"],[6524,"人有黄金满玉楼，我有妙术度春秋。"],[6525,"当宴鹿鸣。",45],[6526,"兔走鸟飞，领袖青衿换布衣。"],[6527,"未嫁夫先死，女之不幸。"],[6528,"前妻三子，后妻无儿。"],[6529,"希宇遇寒风，时当有等待。",61],[6530,"古镜尘蒙，晦而不明。",62],[6531,"再升知县。"],[6532,"谢却人间世，常纳祯祥福。",53],[6533,"洛阳三月景色新，满日繁华应接忙。",47,48],[6534,"五旬外丧亲，方合此刻。"],[6535,"时至出头食禀禄，运逢释褐宴鹿鸣。"],[6536,"夫别阳关去，千愁万泪行。",60],[6537,"春日凝妆上翠楼，幽人无事乐优游。",11,12],[6538,"小雨暗前山，春风尚乍寒。",7,8],[6539,"时行平稳，微恙不志。",2],[6540,"天道旋转，人将随之。",11,12],[6541,"骑驴望马，心竟未定。"],[6542,"夫君早忙碌，淑贤得安康。"],[6543,"兄弟九人，中断离群。"],[6544,"福来有根基，光阴无处不相宜。"],[6545,"兄弟四人，先损一丁。"],[6546,"初夏来时绿阴浓，荷花出水见芙蓉。",23,24],[6547,"一卷残经诵未完，疏林月色满蒲团。",59,60],[6548,"经历之职，名垂异路。"],[6549,"以贡知县，数由前定。"],[6550,"危桥之下险难言，柱杖相接得周旋。",74],[6551,"谋事不吉，谨慎行事。",27,28],[6552,"数中有二室，乃结红紫衣。"],[6553,"百事谋来总是空，数中逢绝必倾身。",45],[6554,"晴光烈烈日已升，无限春光在江滨。",31,32],[6555,"桂子结成有一枝，江风吹折在空中。"],[6556,"断而不断有汕铞，一线有路莫残圆。",71,72],[6557,"喜事从天降，桂子结成双。",27,28],[6558,"路无常直，运有得失。",45,46],[6559,"服劳皇家，厥有成绩。",17,18],[6560,"红颜薄命，好事多磨。"],[6561,"且自庆晚年，春光在眼前。",57],[6562,"雁阵成群，非一母所生。"],[6563,"祖宗庇荫，百总之职。"],[6564,"五十零四，当止则止。",54],[6565,"立志坚刚，不随流俗。"],[6566,"武泮而选，数由前定。"],[6567,"天符相照，是非不宁。",65],[6568,"得傍贵人可成家，原来数定注不差。"],[6569,"轻裘带上，威权足重。",67,68],[6570,"腐草得雨，生意自成。",63,64],[6571,"桃花流水透天台，得个渔翁指路来。",39,40],[6572,"茫茫风尘路，红拂敬知音。",27,28],[6573,"身作白云客，子当拜圣君。"],[6574,"父故于水年方合。"],[6575,"名登金榜，身宴琼林。",23],[6576,"浮云卷尽日生阴，转眼云开月复明。",57,58],[6577,"财帛有余，勤俭此得。"],[6578,"菽粟有余，财广地僻。",43,44],[6579,"房考之年。",49,50],[6580,"夫别阳关去，亦是难为情。",72],[6581,"数有八子，得以送老。"],[6582,"金水之年，同学方合。"],[6583,"破财不安，流年不利。",34],[6584,"勤俭创业，财帛自足。"],[6585,"不费精神事也成，运来相奏喜相连。",45,46],[6586,"真入之道，济世之才。"],[6587,"喜逢黄道日，禀膳姓名香。"],[6588,"千金定从俭里得，裕后儿孙福自绵。",45,46],[6589,"时来相通，人转笑容。",34],[6590,"运有伤残，刑及妻房。",42],[6591,"能刚能柔，万事之乐。"],[6592,"母逝于鸡年方合。"],[6593,"幕年为政，渐入佳景。",61,62],[6594,"先禀后贡，前生注定。"],[6595,"极力经营虚，顺时是良图。",41,42],[6596,"乡科及第。",58],[6597,"一子兔年生方合。"],[6598,"天喜地德，家门吉庆。",25,26],[6599,"复任知县。"],[6600,"水流花落，多少忧愁。",65,66],[6601,"乐极反忧，云行水流。",35,36],[6602,"数有九子，八子送老。"],[6603,"当有四母之称。"],[6604,"前途沉吟天心来，必合人心中途事。",21],[6605,"兄弟十二人，数有二贵。"],[6606,"福白天来，不自人为。",21,22],[6607,"春秋依旧，日月如常。",43,44],[6608,"鼓盆之悲，知命之年。",50],[6609,"兄弟八人，秦楚不同盟。"],[6610,"祸患接踵来，幸有吉人扶。",29,30],[6611,"平常百姓人家。",53,54],[6612,"初任有司，再升钦取。"],[6613,"若问阳生何日止，一程直至六旬余。"],[6614,"风卷灯花暗又明，摇摇不定影纵横。",71,72],[6615,"晚年生子，人之大幸。",55],[6616,"为招为运有不济。",23,24],[6617,"谢却人间事，常纳祯祥福。",73],[6618,"安步前驱，一必问路。",51,52],[6619,"命有千金数，享得终生。"],[6620,"贵时出嫁，命中注定。",26],[6621,"柳上不舒眉，度日强支持。",35,36],[6622,"天折数中定，黄金买不还。",2],[6623,"和丸有义方，当作贵人母。",43,44],[6624,"水火之年克妻方合。"],[6625,"居易以俟，行险以求。",42],[6626,"命中杀重，当刑克夫。"],[6627,"日行中天，何期罗计掩其光。",25,26],[6628,"数中不幸，兄弟死于非命。"],[6629,"新竹苍苍嫩柳丛，庭前茫茫物正蒙。",19,20],[6630,"雪压椿枝，三年泣血。",44],[6631,"妄意空花，难以入手。",15,16],[6632,"岁月亭碧天，冰壶之灿烂。",59,60],[6633,"大风拔树木，灾害并至此。",67,68],[6634,"以监而选知县，数由前定。"],[6635,"灾毒相侵，吉神化解。",31,32],[6636,"其年夫死，妇之不幸。",63],[6637,"知已所托可息肩，不用心神问往年。",77,78],[6638,"兄弟五人，数有三贵。"],[6639,"兔中巢中夜有光，主人不必问行藏",45,46],[6640,"财帛有余，勤俭所得。"],[6641,"问君阳年有几许，百有余矣。",103],[6642,"以贡而先知县，数由前定。"],[6643,"子结二枝。",31],[6644,"花开遍锦丛，无物不从容。",37,38],[6645,"子结七枝，三枝送老。"],[6646,"寿数今朝不可延，幽魂恐坠入黄泉。",36],[6647,"雁阵成行，非一母所生。"],[6648,"晚年生子。",80],[6649,"为人夜眠早，勤俭兴家。"],[6650,"斯人庶母所生。"],[6651,"命生不辰，幼年失恃。"],[6652,"舟楫波涛涌，人在危险行。",59,60],[6653,"好事多逢君子道，是非莫听小人言。",29,30],[6654,"拨开天上云千里，捧出波心月一轮。",57,58],[6655,"缭乱鬓发无心理，沉吟朱户懒重开。",51,52],[6656,"一生几成败，幸亏筋骨铮。"],[6657,"父死骨肉相争。"],[6658,"命已去矣，何用再查。",55],[6659,"好花未开，连遭风雨。",13],[6660,"清净无为时，胜似神仙日。",43,44],[6661,"前途波浪未恬静，吩咐舟人慢着篙。",25,26],[6662,"雨足溪涧象，青山绿水行。",29,30],[6663,"眉头欢笑颜，禄马相扶福自来。",61,62],[6664,"花前月下听高歌，平坦康宁安意多。",55,56],[6665,"阳年有几许，一百多有余。",101],[6666,"耳顺之年事不安，忧怀未可对人言。",59,60],[6667,"叶新林换绿，花落地生香。",21,22],[6668,"一步高来一步低，高低之处在忧疑。",41,42],[6669,"骨肉相辞恨无凭，幼年洒泪漫沾衣。",11,12],[6670,"财星照命，聚成巨富。"],[6671,"子死妻亡实可伤，临门二孝断肝肠。",51,52],[6672,"乍雨乍晴云里月，半开半落雨中花。",61,62],[6673,"十岁母亡，幼年之象。",10],[6674,"时逢恩星，当贡之期。",61,62],[6675,"恐尔之寿，未满三旬。",29],[6676,"鹊噪鸦鸣，吉凶未定。",45],[6677,"兄弟十二人，数中有定。"],[6678,"雨滴花阶，风毁蕊房。",15,16],[6679,"途有荆棘，进退难行。",14],[6680,"忧惊成病总堪悲，独行迟迟不见归。",65],[6681,"大利岁宁，春光可人。",39,40],[6682,"历尽崎岖径，多少虚耗人。",41,42],[6683,"瞻前顾后，索位无咎。",49,50],[6684,"兄弟五人，数有一贵。"],[6685,"犬生两口，孝服之忧。",59,60],[6686,"时来君宜守，何必徒劳心。",33],[6687,"官至府门，不见高擢。"],[6688,"十件谋略九件成，人逢好运便前行。",43,44],[6689,"生子之年。",28],[6690,"名登九州，四海传颂。",50],[6691,"牡丹开得精神足，会见同妆富贵春。",35,36],[6692,"前有罗后有网，行人进步有彷徨。",71,72],[6693,"大道烟笼，行人徘徊。",31,32],[6694,"求鱼过清水，未能快人怀。"],[6695,"衣食有余过岁月，看来暇豫乐晨昏。",29,30],[6696,"数该生子。",69],[6697,"项庄舞剑，意在沛公。",65],[6698,"安分求谋不用贪，动则悔尤静则安。",51,52],[6699,"钦命典试。",29,30],[6700,"陈弦换当年，旧曲不如新。"],[6701,"春风入我户，百事俱叶吉。"],[6702,"生有结乳腊，世家手艺有高低。"],[6703,"春夏秋冬财源广，不西南北路皆通",31,32],[6704,"寒热无定，喜惧同庆。",5,6],[6705,"宝镜前妆，晓日紫云上绣香。",77,78],[6706,"风卷禅灯暗又明，一明一暗心皆通。",55,56],[6707,"夫别阳关去，千愁泪万行。",64],[6708,"数该生子。",40],[6709,"年逢七八，恐度鬼门关。",56],[6710,"花残月缺，寿穷数尽。",61],[6711,"颠沛转为安，赖有吉神佑。",53,54],[6712,"人亦安然，何必问往年。",73,74],[6713,"再任知县，数由前定。"],[6714,"吉凶本在天遵道，人行自无咎。",53,54],[6715,"三旬外入泮方合。"],[6716,"无无有有不须闻，闷闷愁愁自在天。",53,54],[6717,"小盈大亏，得不如失。",59,60],[6718,"妻生二子，妾自无儿。"],[6719,"财从勤生，利从广积。",51,52],[6720,"数该生子。",46],[6721,"大限入黄泉。",50],[6722,"瑞气洋洋，门阑迪吉。",57,58],[6723,"寿元百有余岁。"],[6724,"常纳祯祥，永吉无疆。",61,62],[6725,"霜落风吹，花无芳色。",45,46],[6726,"丰盈得安然，不必问往年。",55,56],[6727,"乡科及第。",47],[6728,"夫死之年，妇之不幸。",65],[6729,"勤俭持家，衣禄无亏。"],[6730,"巳年蛇走文场，泮池芹草生香。"],[6731,"强梁纵强粱，安稳自安然。",59,60],[6732,"贞足于事，自保其宁。",26],[6733,"刑克为期，忧及克妻。"],[6734,"数有七子，得以送老。"],[6735,"当宴膺扬。",48],[6736,"无定今有定，前作当捷径。",55,56],[6737,"钦命典试。",50],[6738,"行尽泥泞多少难，将来安步渡关山。",45,46],[6739,"数止于此矣。"],[6740,"千里崎岖千里平，行人跋涉慢消停。",55,56],[6741,"吉星相照，流年顺利。",49,50],[6742,"山高水深，到此难行。",51],[6743,"春回阳谷暖，万物自生辉。",13],[6744,"命有八子，三子送老。"],[6745,"福禄天降，财源日新。",71,72],[6746,"花正开时风雨多，冷落凄凉多挫折。",19,20],[6747,"得逢知己好相求，宽裕营谋不用忧。",33,34],[6748,"初阳出林表，曙色照堂前。",15,16],[6749,"先无慈母缝针线，惟有严亲在后归。"],[6750,"洞房花烛之年。",19],[6751,"得之有心，失之无意。",15,16],[6752,"老年丧妇，夫之不幸。",69],[6753,"退才归林，安然乐意。",45,46],[6754,"齿德俱尊，必入乡饮。",45,46],[6755,"升迁知县，贵人提携。"],[6756,"一子送老，偏房所生。",41,42],[6757,"紫微高照，官至迁升。",40],[6758,"骨肉有刑伤，秋风泪两行。"],[6759,"君家注定四旬零，数到黄泉恐不回。",41],[6760,"暖侣初一日，前来景色新。",13,14],[6761,"结婚自有梁鸿遇，双锁佳人到白头。"],[6762,"断弦之忧。",47],[6763,"三岁丧母，莫大刑伤。"],[6764,"未满三旬，不幸短命。",29],[6765,"吐气扬眉，纵横如意。",29,30],[6766,"勿以风光比旧年，风光不与旧年同。",33,34],[6767,"朱颜温润，绿鬓更新。",27,28],[6768,"此年有乔迁之喜。",31],[6769,"红贡而选知县，人之大幸。"],[6770,"劳心劳力，总成画饼。",47],[6771,"有子当及第。",43,44],[6772,"不须问后来，已是浑天数。",57],[6773,"兄弟七人，同父不同母。"],[6774,"光阴普照，失常可叹。",47],[6775,"兄弟七人，中断惜离群。"],[6776,"快乐无极，毫无费力。",23,24],[6777,"风卷花暗又明媚，摇摆无定影纵横。"],[6778,"数有四子，得以送老。"],[6779,"财帛随人，勃然兴发。",53,54],[6780,"黄泉无客店，今夜宿谁家。",66],[6781,"大运分明就转来，因人事有研究。",23,24],[6782,"一子龙年生方合。"],[6783,"未满四旬，竟往西行。"],[6784,"一重欢喜一重惊，道是无情却有情。"],[6785,"吉星高照，喜事重来。",35,36],[6786,"三阳方来，气运相转。",45,46],[6787,"祗园实树，晚景生春。",61,62],[6788,"荣华乐意，福禄悠然。",35,36],[6789,"骨肉有刑伤，西风泪两行。",17],[6790,"花甲欠二春，大数止矣。",58],[6791,"初任巡抚大厅。"],[6792,"今日清明整钓丝，得鱼沾江西歹怡。",48],[6793,"东手弥缝，西手颠倒。"],[6794,"防御之职，数由前定。"],[6795,"家室康宁，事纳祯祥。",37],[6796,"风卷灯花暗又明，飘摇无定影纵横。"],[6797,"敬以造事，克享厥成。",27],[6798,"五十年来事未消，如何我寿寂寥寥。"],[6799,"碎不多时却又圆，几番挫折在身边。",51,52],[6800,"时运未来，进退不如。",35,36],[6801,"啾唧不免愁。",2],[6802,"勿嫌祸有胎，穷通命所该。",47],[6803,"六岁丧母，幼年不幸。"],[6804,"硕果不食君子得，小人剥庐尚有汤。",51,52],[6805,"持竿东海已数年，一旦无心得巨鳌。",27,28],[6806,"惆怅复惆怅，时运未堪羡。",57,58],[6807,"一别万古愁，绿水青山空悠悠。",65],[6808,"兄弟术年生，方合此刻。",33],[6809,"雁行有序，非一母所生。"],[6810,"官不休来私不休，安常处顺福悠悠。",21,22],[6811,"兄弟八人，同父不同母。"],[6812,"时逢大有，内外安宁。",39,40],[6813,"时到中秋月朗圆，云生簇簇恨无凭。",15,16],[6814,"春残花老，景物忧愁。",63,64],[6815,"生父属牛，继父属羊。"],[6816,"道路泥泞，行人彷徨。",27,28],[6817,"六岁丧父，幼年不幸。"],[6818,"芳草遇春风，前村绿阴浓。",11,12],[6819,"水土之年宜配妻方合。"],[6820,"斐然成章，未遇朱衣。",23,24],[6821,"杨柳风前最可思，迷离烟雨锁杨枝。",73,74],[6822,"数该生子。",47],[6823,"当时有为，事乃克济。",43,44],[6824,"循分而动，动无不吉。",33,34],[6825,"独子送终天注定。"],[6826,"无喜无乐，名曰寂寞。",13,14],[6827,"本年吉星照，姓名列痒序。",13,14],[6828,"数注命丧虎，狼狈死其身。"],[6829,"日月并明，万物从容。",61],[6830,"软风吹小舟，安稳可无忧。",25,26],[6831,"一字切忌日黄，可免则免。"],[6832,"一子举老，先天注定。"],[6833,"流年有坎坷，人事可奈何。",27,28],[6834,"六九加一数将完。",55],[6835,"大小安康，福禄天降。",47,48],[6836,"年满一百，命恐不留。",100],[6837,"运限转时，眉头开展。",31,32],[6838,"妻生二子，妾亦如之。"],[6839,"不满二十，不幸短命。",19],[6840,"逢子年必可发越。"],[6841,"数止于此。",45],[6842,"富贵如金昨夜看，五色眩目守偏长。",31],[6843,"机会顺偶然，今年胜旧年。",38],[6844,"晓日五云高，华筵集仙桃。",79,80],[6845,"数该生子。",67],[6846,"际遇非常，春风到处香。",32],[6847,"数有十子，六子送老。"],[6848,"解放愁眉，春风绿柳。",41,42],[6849,"乡榜题名。",49],[6850,"频频遇吉祥，流年之庆。",19,20],[6851,"谋之有功，日日春风。",25,26],[6852,"命犯孤刑。"],[6853,"风雨花冷落，欲渡清溪船。",20],[6854,"驳杂无端眉，交蹙未开颜。",52],[6855,"操守有节，行藏不苟。"],[6856,"本身出家，原来数定。"],[6857,"喜气上眉，太平乐事。",31],[6858,"兄弟六人，数有三贵。"],[6859,"人生坎坷，谨慎为是。"],[6860,"和气纳祯祥，遐龄庆有常。",55,56],[6861,"人到中年运亨通。"],[6862,"喜气盈盈，家室和平。",57,58],[6863,"暮景多忧，心不安然。",68],[6864,"木凋奈若何，涕洒泪彷徨。",18],[6865,"花甲欠一春，此君归期去。",59],[6866,"高山又一重，融和景色浓。",13,14],[6867,"文昌照命，数诀入泮。",31,32],[6868,"古稀之年，官非耗财。",69,70],[6869,"房考之年。",29,30],[6870,"福曜正照，粲然光耀。",45,46],[6871,"享平安之福，绝门外之嚣。",73,74],[6872,"动静有常，好景相送。",59,60],[6873,"兄弟十人，乐奏几般音。"],[6874,"生子克子，好坏同庆。",21],[6875,"几阵香风生绣户，一轮明月照闺门。",51],[6876,"寻师访友，无往不利。",43,44],[6877,"甲子一周必寿数。",60],[6878,"子登黄甲。",51],[6879,"太平官职，眼前奏捷。",25,26],[6880,"逢运之年方进步。"],[6881,"春风阳气，景物自如。",51],[6882,"日转南楼夜未光，子规啼处断肝肠。",48],[6883,"若远若近，依稀行程。",35,36],[6884,"学得一技好手艺，从无人敢问前行。"],[6885,"云开见太阳，行人乐无疆。",17,18],[6886,"时乎顺时乎，逆主灾晦遇。",51,52],[6887,"克子生子，喜惧同庆。"],[6888,"房考之年。",29,30],[6889,"东君一夜转阳和，惟报今年喜气多。",45,46],[6890,"炉中伏火，黄金消瘦。",23,24],[6891,"演武及第。",29,30],[6892,"韶光得失，人事往来。",27,28],[6893,"乡科及第。",63],[6894,"一个青龙共白虎，数声鹊噪与鸦鸣。",63,64],[6895,"穷睇盼于中天，极游于暇日。",49,50],[6896,"金年克妻，火年再娶方合。"],[6897,"癫疯之疾，前生恶报。"],[6898,"不足于心，事多拂意。",28],[6899,"少年克妻，闷之如何。",20],[6900,"数尽归西日，花甲加一春。",61],[6901,"悠然无事饶生趣。",73,74],[6902,"暮诵朝歌，太平之曲。",59,60],[6903,"叹君寿上，花甲有二春。",62],[6904,"流年不利，多困多滞。",36],[6905,"时逢底绩，家门赫奕。"],[6906,"命带文昌，夫登金榜。"],[6907,"啾唧不免，灵童之戏。",8],[6908,"辛勤日夜费精神，转发如今物色新。",41,42],[6909,"注定参真入道，水土年方合"],[6910,"春风鼓舞，意相从舒。",25,26],[6911,"祖业淡薄，数内先注。"],[6912,"腐艇休从沧海过，颠车莫向大街行。"],[6913,"数该生子。",68],[6914,"四子送老，三子挺秀。"],[6915,"九岁十岁路坦夷，春日迟乐意。",9,10],[6916,"忧闷既觉为安乐，梦忆昏昏今始明。",39,40],[6917,"坐钓渭溪，财官着手。"],[6918,"际遇际亨，事多就绪。",25],[6919,"贵人提携，事乃克济。",47],[6920,"数该生子。",25],[6921,"悠然无事，饶有生趣。",60],[6922,"梅花吐秀，万卉争妍。",15,16],[6923,"数中注定，职受异子。"],[6924,"事乖从意外，破财不安然。",71,72],[6925,"花蕊初红，不怕风雨。",11,12],[6926,"兄弟十人，同父各母。"],[6927,"惆怅复惆怅，年来运未来。",59,60],[6928,"命有刑伤，妇之不幸。",48],[6929,"兄弟五人，同父各母。"],[6930,"虽然子来晚，亦可作家珍。",50],[6931,"画饼难充饥，行人不相宜。"],[6932,"征马板桥霜露冷，行人巫峡波浪涛。",21,22],[6933,"连宵风雨阻行人，今日晴明趁早行。"],[6934,"若问寿元事，六旬有二是归期。"],[6935,"遇良医大痛不死。",21,22],[6936,"吉曜相照，人物和畅。",23,24],[6937,"姐妹同胎，相貌同近。"],[6938,"才展丝纶，羽扇纶巾。",25,26],[6939,"否极泰来，万象更新。"],[6940,"命带血迹关，祈祷自安然。"],[6941,"流年不利，当有灾晦。"],[6942,"一去不能返，幽魂入黄泉。",53],[6943,"三岁啾唧，不安宁兮。"],[6944,"谋事顺利，谋之有益。",23,24],[6945,"啭哒之职，必有变迁。",31],[6946,"有妻当活离，缘薄不相宜。"],[6947,"无端百舌闹枝头，恨报东风人在楼。",45,46],[6948,"年寿七十而止。",70],[6949,"房考之年。",51,52],[6950,"乡科及第。",50],[6951,"数该生子。"],[6952,"运转时来，图谋有益。",13,14],[6953,"父死之年，三年泣血。",57,58],[6954,"青矜有分，得失无常。",55,56],[6955,"喜吉之象，天道还转。",40],[6956,"歌舞楼中声寂寂，今朝别去旧龙亭。",41,42],[6957,"职授学校，荣任之誉。",64],[6958,"数有徒弟，得以送老。"],[6959,"堂上自有老慈亲。"],[6960,"福来人共庆，咸道好春光。",44],[6961,"官至执事。"],[6962,"朦朦胧胧，安胞之中。",21,22],[6963,"数止矣。"],[6964,"小宋应占，二子何得。",21,22],[6965,"物情得宜，春风桃李。",21,22],[6966,"天上玉书照，地下失英雄。",62],[6967,"有利无害，其人吉祥。",40],[6968,"老年生于，数有所致。",68],[6969,"官至御史，荣归画堂。"],[6970,"知心可托堪息肩，不必忧闷问往年。",54],[6971,"数止矣。"],[6972,"解甲归田，文君当炉。"],[6973,"数该生子。",57],[6974,"快乐无求，顺利图谋。",23,24],[6975,"吉亨之象，喜庆重来。",31],[6976,"帝中一王侯，犀象军宣谋。"],[6977,"劲节苍松，历霜不改。",77,78],[6978,"造化颛蒙起，设帐训生徒。"],[6979,"寿止矣。",61],[6980,"瑞气融和，景象非前。",53],[6981,"甲子入户，春风重来。"],[6982,"人间五个字，断送少年人。",13,14],[6983,"闭户静坐，避凶始宜。",57,58],[6984,"数该生子。",55,56],[6985,"祖业难守，离祖兴家。"],[6986,"南柯一梦。",63,64],[6987,"温温恭人德，仁厚丈夫心。"],[6988,"无边红紫，大地阳春。",33],[6989,"否泰相逢，大往小来。",38],[6990,"已司空中色，方知色是空。"],[6991,"南柯一梦，此年丧命。",61],[6992,"吉星照闺门，动止皆有则。",35],[6993,"择贤无方，出身偏房。"],[6994,"大数宜天命，加一是归期。",51],[6995,"柔能克刚，斟酌而行便有功。",37,38],[6996,"贵人相逢，事事有益。",43,44],[6997,"野酒香花处处香，风流常醉乐村庄。",27,28],[6998,"受太上老君之诀，斩阴间邪鬼之魂。"],[6999,"性急作事是非多，倚赖高人奈若何。"],[7000,"命如文君，再嫁也美。"]]}
