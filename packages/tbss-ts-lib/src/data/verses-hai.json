,[12921,"得无断弦之悲乎。",39],[12922,"白天佑之，吉无不利。",49],[12923,"琴失其音，皆因弦断。",58],[12924,"进徒之喜。",37,38],[12925,"科岁之年，名必高列。",65,66],[12926,"再嫁戊戌夫，命中注定。"],[12927,"老年妻故，亦足悲也。",74],[12928,"朝说法来晚谈经，红尘物色不关心。",45,46],[12929,"命犯白虎，难免刑夫。",45],[12930,"一女嫁三夫，数中注定。"],[12931,"流年不利，未免刑妻。",40],[12932,"大小吉庆，福自天来。",51],[12933,"老年妻故，何用悲乎。",64],[12934,"进徒之喜。",39,40],[12935,"遇考之年，必获其意。",67,68],[12936,"再嫁庚戌夫：方免再刑。"],[12937,"老来丧妻之年。",75],[12938,"五服不分，帏绣有染。"],[12939,"夫死之年，妇之不幸。",46],[12940,"东坡向禅寺，云龙山上色。"],[12941,"妻死之年，人生不幸。",41],[12942,"夜月移花影，春风报佳音。",52],[12943,"华林日月长，伏虎尽焚香。",29,30],[12944,"进徒之喜。",41,42],[12945,"遇考之年，名必高列。",69,70],[12946,"再嫁壬戌夫，数中注定。"],[12947,"老年妻故，悲也何如。",76],[12948,"耳顺之年，妻死泪涟涟。",60],[12949,"命带伤刑，必克其夫。",47],[12950,"夫死再嫁，人之常情。"],[12951,"夫妻有离别之忧。",42],[12952,"一堤杨柳摇新绿，几处桃花映日红。",37],[12953,"名标榜首，天生娇子。"],[12954,"进徒之喜。",43,44],[12955,"遇考之年，名必高列。",71,72],[12956,"再嫁乙亥夫，数中注定。"],[12957,"老年丧妻之悲。",77],[12958,"鸳失其鸯，悲也孔伤。",65],[12959,"夫死之年，女子不幸。",48],[12960,"三旬加入载，竟然西归也。",38],[12961,"妻死之年，不幸之悲伤。",42],[12962,"平安叶吉，一生太平。",38],[12963,"摆脱牢狱，获得自由。",39],[12964,"进徒之喜。",45,46],[12965,"遇考之年，定必标名。",73,74],[12966,"再嫁丁亥夫，数中注定。"],[12967,"卜卦之时，未有儿女。"],[12968,"贵人相扶，化险为夷。"],[12969,"夫死之年，大不幸也。",49],[12970,"此刻生人，一生孤寡。"],[12971,"困于蒺藜，不见其妻。",43,44],[12972,"行藏集福，坤入之幸。",39],[12973,"亲疏不分，痛苦乱伦。"],[12974,"进徒之喜。",47,48],[12975,"与弟有染，数中注定。"],[12976,"重嫁己亥夫，方免刑夫。"],[12977,"老景得安康，不料中馈亡。",69,70],[12978,"童运未坚，寒热多沾。",1],[12979,"夫死之年，老来之悲。",50],[12980,"命中无儿，不必强求子。"],[12981,"妻死之年，人生不幸。",45],[12982,"家室安泰，其乐融融。",40],[12983,"独木桥头休跨马，千层浪里莫行舟。",23,24],[12984,"进徒之喜。",49,50],[12985,"舟中重重险，扬子江头苦叫天。",3,4],[12986,"再配辛亥夫，数中注定。"],[12987,"信是栽培阴骘好，雨滋花萼得荣华。",69,70],[12988,"苏小妹前休纵酒，谢公城内莫内游。",83,84],[12989,"夫死之年，人生不幸。",51],[12990,"命中无女，数中注定。"],[12991,"妻死之年，人生不幸。",46],[12992,"享平安福，乐大有年。",41],[12993,"一周二岁生荆棘，西风吹动子猷舟。",1],[12994,"进徒之喜。",51,52],[12995,"花开正苑香犹扑，笋长名园苗更长。",65,66],[12996,"再嫁癸亥夫，姻缘注定。"],[12997,"克己从人防得失，安心谨慎获行藏。",65,66],[12998,"运交胜从前，积玉堆金广置田。",63,64],[12999,"夫死之年，人生不幸。",52],[13000,"万象更新，周而复始。"]]}
