{"volume":"亥集","verses":[[12001,"一周而父亡，女之不幸。"],[12002,"玉人有刑，四娶甲子妻。"],[12003,"子年有婚配之喜。"],[12004,"翩翩黄鸟，入于泮林。",40],[12005,"桂籍板登难重遂，桥关由发心高飞。"],[12006,"出门交友有功无咎。",21,22],[12007,"是年子，不幸妻亡。",25],[12008,"母死妻又亡，命带两度刑伤。",15,16],[12009,"理达阴阳，隆恩宠赐。"],[12010,"一品夫人贵，人间国学妻。"],[12011,"二岁父亡，女之不幸。"],[12012,"玉人有刑，四娶丙子。"],[12013,"丑年有婚配之喜。"],[12014,"名进宫墙，弓马入泮。",41],[12015,"夜寒鸳帐衾懒展，日锁妆台镜少开。"],[12016,"琅圩竹照平安日，禅室幽闲祸不生。",23,24],[12017,"喜生一人，不幸妻亡。",26],[12018,"不幸萱花坠，谁知镜破分。",17,18],[12019,"云鬓蓬松心懒整，玉颜消瘦有忧疑。"],[12020,"人生由命，富贵在天。"],[12021,"三岁父亡，女之不幸。"],[12022,"玉人有刑，四娶戊子。"],[12023,"寅年有婚配之喜。"],[12024,"名进贤关，身沐皇恩。",42],[12025,"姓名芳香传万古，君门彪炳最英奇。"],[12026,"上苑奇花呈富贵，禅门翠竹绿云华。",25,26],[12027,"喜生一子，不幸妻亡。",27],[12028,"母赴瑶池，妻游阆苑。",19,20],[12029,"日丽野梅犹带雪，风和杨柳更含烟。",29,30],[12030,"克俭克勤称淑女，内助持家数有方。",30],[12031,"四岁父亡，女之不幸。"],[12032,"玉人有刑，四配庚子。"],[12033,"卯年有婚配之喜。"],[12034,"名登学册，身沐皇恩。",43],[12035,"平生慈善乐天真，磨节流芳启后人。",43],[12036,"访友寻师，有吉有利。",27,28],[12037,"喜生一子，又见妻亡。",28],[12038,"不幸母广，妻又见伤。",27,28],[12039,"阴籴阳籴非可效，插沙入水必招灾。"],[12040,"岁在甲子，天下大吉。"],[12041,"五岁父亡，女之不幸。"],[12042,"玉人有刑，四娶壬子。"],[12043,"辰年有婚配之喜。"],[12044,"名进贤关，身沐皇恩。",44],[12045,"清风明月夜，涧边听猿声。"],[12046,"寂寂入空门，徜徉自得乐。",29,30],[12047,"是年生子，谁料妻亡。",29],[12048,"母赴瑶池，三年泣血。",23,24],[12049,"鹿鸣沾宠宴，桃花浪暖听春雷。"],[12050,"岁在甲子，天下大吉。"],[12051,"六岁父亡，女之不幸。"],[12052,"玉人有刑，四娶乙丑。"],[12053,"巳年有婚配之喜。"],[12054,"名进贤关，身沐皇恩。",45],[12055,"圭璋自是清闲福，格局偏谐治世音。"],[12056,"福享安然清风，明月乐无边。",31,32],[12057,"喜生一子，不幸妻亡。",30],[12058,"母死妻亡，两度悲伤。",25,26],[12059,"春风荡万里，迎来百花香。"],[12060,"岁在甲子，天下大吉。"],[12061,"七岁父亡，女之不幸。"],[12062,"四娶丁丑之妻，方免刑克。"],[12063,"午年有婚配之喜。"],[12064,"身登泮宫，名入贤关。",46],[12065,"少年生计未全成，中道运来必是荣。"],[12066,"清闲浑无事，卓立出风尘。",23,24],[12067,"是年生子，不幸妻亡。",31],[12068,"母死妻亡，两度悲伤。",27,28],[12069,"妻命宜配小，方可得白头。"],[12070,"一周刑母，女之不幸。"],[12071,"父亡于八岁，女命带刑。"],[12072,"四娶己丑之妻，方免刑克。"],[12073,"未年有婚配之喜。"],[12074,"名登泮林，身沐皇恩。",47],[12075,"日离海角千山秀，月到中天分外明。",35,36],[12076,"如松之盛，兆瑞祯祥。",36],[12077,"喜生一子，又见妻亡。",32],[12078,"萱草凋琴音，两度刑伤人。",29,30],[12079,"此刻逢长生，发财得鸿运。"],[12080,"二岁母亡，女之不幸。"],[12081,"数未满旬，女刑父亲。",9],[12082,"四配辛丑妻，先天注定。"],[12083,"申年婚配之喜。"],[12084,"名进贤关，身沐皇恩。",48],[12085,"此刻生人，兄弟不多。"],[12086,"日清月静，禅林心怡。",47,48],[12087,"喜生一子，谁料妻亡。",32],[12088,"二杀相临，母妻俱故。",31,32],[12089,"公平正直，冠带临身。"],[12090,"三岁母亡，女命刑伤。"],[12091,"白虎照闺门，父死泪涟涟。",20],[12092,"四配癸丑妻，方免再刑。",54],[12093,"酉年有婚配之喜。"],[12094,"名列贤关，身游泮水。"],[12095,"云髻梳困凤折，又无男女孤身。"],[12096,"诸吉悉至，光被四表。",34],[12097,"喜生一子，不幸妻亡。",33,34],[12098,"母妻俱死，一年两刑。"],[12099,"辰时贵人逢，财运必盈盈。"],[12100,"四岁刑母，女之不幸。"],[12101,"白虎照闺门，父死女不幸。",11],[12102,"四配甲寅妻，方得到老。"],[12103,"戌年有婚配之喜。"],[12104,"足步青云，名列庠序。",50],[12105,"良人割断中天路，孤身青春守节人。"],[12106,"朝功暮课，享福悠悠。",23,24],[12107,"喜生一子，不幸妻亡。",35],[12108,"二杀临门，母妻俱故。",35,36],[12109,"午时贵人逢，财运必丰盈。"],[12110,"五岁母亡，女之不幸。"],[12111,"白虎临门，女刑父亲。",12],[12112,"四配丙寅妻，先天注定。"],[12113,"亥年有婚配之喜。"],[12114,"名列贤关，身沐皇恩。",50],[12115,"幽冥有路途，茫茫入西京。",43,44],[12116,"天官地符，禅僧作福。",43,44],[12117,"喜生一子，不幸妻亡。",36],[12118,"母妻俱故，命带两刑。",37,38],[12119,"未时贵人逢，财运必丰盈。"],[12120,"六岁克母，女之不幸。"],[12121,"白虎临门，女刑父亲。"],[12122,"四配戊寅妻，先天注定。"],[12123,"子属鼠，先天定数。"],[12124,"身列黄宫，名挂青衿。",52],[12125,"官居极品，东西南北总兵权。"],[12126,"良宵有景皆堪羡，满院谈经伴月明。",45,46],[12127,"是年生子，谁料钗分。",37],[12128,"风落萱花，琴弦又断。",39,40],[12129,"申时贵人逢，财运必丰盈。"],[12130,"七岁刑母，女失所依。"],[12131,"白虎照闺门，父死女不幸。",14],[12132,"四娶庚寅妻，方免再刑。"],[12133,"子属牛，先天定数。"],[12134,"高登天榜，鸿案标名。",53],[12135,"身赴翰苑，明星璀烁。",27],[12136,"不但师徒无厄难，更言福寿又加增。",47,48],[12137,"喜生一子，不幸妻亡。",38],[12138,"母死妻亡，两度刑伤。",41,42],[12139,"操生杀之权，寄封疆之职。"],[12140,"八岁母亡，女之不幸。"],[12141,"白虎临门，女刑父亲。",15],[12142,"四娶壬寅妻，方免刑克。"],[12143,"子属虎，先天定数。"],[12144,"身入泮林，芹香可美。",54],[12145,"燕子未逢旧故主，黄泥衔尽不成巢。"],[12146,"禅林寂静处，红尘哪里来。",49,50],[12147,"喜生一子，悲亡其妻。",39],[12148,"萱花琴弦断，悲中加悲。",43,44],[12149,"无缘祖业，自创成家。"],[12150,"岁未满旬，闺中失母。"],[12151,"白虎临门，女刑其父。",16],[12152,"玉人屡刑，四娶乙卯妻。"],[12153,"子属兔，先天定数。"],[12154,"数当入泮，老来之荣。",55],[12155,"历事能干持家有，火性治事最温良。"],[12156,"及时花果献，风到佛堂前。",51,52],[12157,"喜生一子，不幸妻亡。",40],[12158,"母死妻亡，两度刑伤。",45,46],[12159,"羡君毕世路坦夷，宛然春色满皇州。"],[12160,"少年刑母，女之不幸。",10],[12161,"白虎照命，女刑父亲。",17],[12162,"主人屡刑，四娶丁卯妻。"],[12163,"子属龙，先天定数。"],[12164,"老年入泮，晚运通达。",56],[12165,"所行正大，人道之义。"],[12166,"寻师访友，泉流岩畔遇知音。",53,54],[12167,"喜生一子，谁料妻亡。",41],[12168,"母死妻亡，两度刑伤。",47,48],[12169,"本是方寸地，能画虎雕龙。"],[12170,"少年母死，人之不幸。",11],[12171,"父死之年，女之不幸。",18],[12172,"玉人多刑，四娶己卯妻。"],[12173,"子属蛇，先天定数。"],[12174,"数该入泮，晚运通达。",57],[12175,"酉时贵人逢，财运必丰盈。"],[12176,"内处康宁，师徒亨福。",55,56],[12177,"喜生一子，不料钗分。",42],[12178,"母死妻亡，一年两伤。",49,50],[12179,"清夜不闻芹香雨，东风时凑五弦琴。"],[12180,"是年丧母，女之不幸。",12],[12181,"父死之年，女之不幸。",19],[12182,"玉人有刑，四娶辛卯妻。"],[12183,"子属马，先天定数。"],[12184,"身当入泮，得挂青衿。",58],[12185,"继业更新业，财广二字重圭璋。"],[12186,"内外安宁师徒庆，芒鞋踏破没处寻。",57,58],[12187,"喜生一子，悲也妻亡。",43],[12188,"不幸萱花萎，谁知又断弦。",52],[12189,"夕阳故道谁人识，禾黍秋风听马嘶。"],[12190,"是年母死，女之不幸。",13],[12191,"父死之年，女之不幸。",20],[12192,"四配癸卯妻，先天注定。"],[12193,"子属羊，先天定数。"],[12194,"老年入泮，喜也何如。",59],[12195,"生平多巧计，白手自兴家。"],[12196,"好将善诀传徒弟，乐我逍遥一片心。",59,60],[12197,"喜生一子，不料妻亡。",44],[12198,"母死妻亡，两度悲伤。",53,54],[12199,"一生富贵命荣华，无刑无灾锦中花。"],[12200,"母死之年，女之不幸。",14],[12201,"父死之年，女之不幸。",21],[12202,"四娶甲辰妻，先天注定。"],[12203,"子属猴，先天定数。"],[12204,"花甲入泮，老当益壮。",60],[12205,"鸳鸯酒醉心未死，鸾台重下换新衣。",60],[12206,"兴家创业人财旺，锦上添花气象新"],[12207,"喜生一子，不幸妻亡。",45],[12208,"母死妻亡，两度之悲。",55,56],[12209,"宏开利路，十几年来大发财。"],[12210,"母死之年，女之不幸。",15],[12211,"父死之年，女之不幸。",22],[12212,"四娶壬辰妻，先天注定。"],[12213,"子属鸡，先天定数。"],[12214,"有子先生女，数注于前。"],[12215,"彭城白璧出蓝田，丹凤高翔上九天。"],[12216,"壮观出门从此显，那空那色上人名。"],[12217,"喜生一子，谁料妻亡。",46],[12218,"母死妻亡，悲中见伤。",57,58],[12219,"戌时贵人逢，财运必丰盈。"],[12220,"母死之年，女之不幸。"],[12221,"父死之年，女之不幸。",23],[12222,"四娶戊辰妻，先天注定。"],[12223,"子属狗，先天定数。"],[12224,"借老二春足，古稀之数。"],[12225,"双亲归世在何日，数定母先赴瑶池，"],[12226,"丧门相照，忧及于师。",25,26],[12227,"喜生一子，谁料妻亡。",47],[12228,"母死妻亡，两度刑伤。",59,60],[12229,"不求名达受奔波，啸傲林泉乐意多。"],[12230,"母死之年，女之不幸。",17],[12231,"父死之年，女之不幸。",24],[12232,"四娶庚辰妻，先天注定。"],[12233,"子属猪，先天定数。"],[12234,"卜君阳年，终于八九。"],[12235,"房内闻香。",41],[12236,"荒村客路眠宜早，野店风霜起要迟。"],[12237,"喜生一子，谁料妻亡。",48],[12238,"母死妻亡，一年两伤。",61],[12239,"亥时贵人逢，财运必丰盈。"],[12240,"母死之年，女之不幸。",18],[12241,"父死之年，女之不幸。",25],[12242,"四娶壬辰妻，先天注定。"],[12243,"女属鼠，数中注定。"],[12244,"一窗明月供孤灯。"],[12245,"此刻生人，夫妇必齐眉。"],[12246,"不敛生涯不耕田，一生常在贵人边。"],[12247,"产儿妻故，两处生悲。",49],[12248,"母死妻亡，两不幸也。",63,64],[12249,"秋月梧桐经夜雨，春风桃李一番新。"],[12250,"母死之年，女之不幸。",19],[12251,"父死之年，女之不幸。",26],[12252,"四娶乙巳妻，先天注定。"],[12253,"女属牛，数中注定。"],[12254,"善始善终，天报善人。"],[12255,"父先母后，数前注定。"],[12256,"利夫益子，正助夫贤。"],[12257,"喜生一子，不幸妻亡。",50],[12258,"母死妻亡，一年两悲。",57,58],[12259,"驿马照命，早离乡井。"],[12260,"母死之年，女之不幸。",20],[12261,"父死之年，女之不幸。",27],[12262,"四娶丁巳妻，先天注定。"],[12263,"女属虎，数中注定。"],[12264,"卜君之寿，古稀欠一春。",69],[12265,"贵人逢之，鸿运亨达。"],[12266,"节干青春如玉洁，老艳乌云乱惹飞。"],[12267,"喜生一子，不幸妻亡。",51],[12268,"母死妻亡，不幸之甚。",57,58],[12269,"专在衙门手，有余钱妻子光辉。"],[12270,"母死之年，女之不幸。",21],[12271,"父死之年，女之不幸。",28],[12272,"四娶己巳妻，先天注定。"],[12273,"女属兔，数中注定。"],[12274,"借老三春，以足古稀。"],[12275,"贵人逢之，鸿运亨达。"],[12276,"数注腰横犀角带，金花衔洒沐皇恩。"],[12277,"喜生一子，谁知妻亡。",52],[12278,"母死妻亡，一年两度刑伤。",69,70],[12279,"贵人逢之，鸿运亨达。"],[12280,"母死之年，女之不幸。",22],[12281,"父死之年，女之不幸。",29],[12282,"四娶辛巳妻，先天注定。"],[12283,"女属龙，数中注定。"],[12284,"借老三春，凑成花甲。"],[12285,"贵人逢之，鸿运亨通。"],[12286,"师传涅槃，雪衣临身。",37,38],[12287,"喜生一子，不幸妻亡。",53],[12288,"吉人必有天相。"],[12289,"辟雍成名，琼林夺锦。"],[12290,"母死之年，女之悲也。",23],[12291,"父死之年，女之不幸。",30],[12292,"四娶癸巳妻，先天注定。"],[12293,"女属蛇，数中注定。"],[12294,"为人言行笃信中，堂堂活泼聪俊人。"],[12295,"时来运至精神爽，好向蟾宫折桂枝。"],[12296,"乍雨乍晴犹未雪，东风布暖不生寒。"],[12297,"妙风生一子，哀哉妻又亡。",54],[12298,"吉人天相，恶人暴光。"],[12299,"有禄有财过晚景，无忧无虑乐升平。"],[12300,"母死之年，女之不幸。",24],[12301,"父死之年，女之不幸。",31],[12302,"四娶甲午妻，先天注定。"],[12303,"女属马，数中注定。"],[12304,"云鬓宁无重整理，娥眉应有再加妆。"],[12305,"道衿承命，宠赐荣身。"],[12306,"禄到生长兼才印，任君加官入朝堂。"],[12307,"喜生一子，不幸妻亡。",55],[12308,"鸾风和谐，难免中天笑。",43,44],[12309,"贵人逢之，鸿运亨达。"],[12310,"母死之年，女之不幸。",25],[12311,"父死之年，女之不幸。",32],[12312,"四娶丙午妻，先天注定。"],[12313,"女属羊，数中注定。"],[12314,"寿元何日止，须待七旬终。",70],[12315,"以财发身曰吉。"],[12316,"暖风初报朝雨，凉雪迷于隔岁梅。"],[12317,"喜生一子，不幸妻亡。",56],[12318,"为人慷慨气宇昂，无方无骄不岐求。"],[12319,"气宇轩昂，超出寻常。"],[12320,"母赴瑶池，深阁悲伤。",26],[12321,"父死之年，女之不幸。",33],[12322,"四娶戊午妻，先天注定。"],[12323,"女属猴，数中注定。"],[12324,"卜君之寿，未满五旬。"],[12325,"一生之苦受他方，有甘有苦有高低。"],[12326,"为人夫死之年，人生不幸。"],[12327,"喜生一子，不幸妻亡。",57],[12328,"有高俅之技艺，无高俅之性情。"],[12329,"明伦堂上文风蔼，诗学窗前化雨新。"],[12330,"母死之年，女之悲饬。",27],[12331,"父死之年，女之悲也。",34],[12332,"四娶庚午妻，先天注定。"],[12333,"女属鸡，数中注定。"],[12334,"知君寿数，八旬有余。"],[12335,"巫峡云高峰十二，栏杆风静水无痕"],[12336,"送至时逢泮水融，才华滚滚送秋香。"],[12337,"喜生一子，不幸妻亡。",58],[12338,"虎头蛇尾须当忌。"],[12339,"识见机谋有性情，不同如雷怒顺风。"],[12340,"母死之年，女之悲也。",28],[12341,"父死之年，女之悲也。",35],[12342,"四娶壬午妻，先天注定。"],[12343,"女属狗，数中注定。"],[12344,"数定官居北阙，宝剑锋气莫遮。"],[12345,"术数绍岐黄，皇恩赐一命。"],[12346,"中年时运几风光，历尽风光梅始香"],[12347,"喜生一子，悲没荆花。",59],[12348,"借问寿元何日尽，七旬之年是归期。"],[12349,"索履轻裳甘寂静，齐心洗性语长生。"],[12350,"母死之年，女之不幸。"],[12351,"父死之年，女之不幸。",36],[12352,"四娶乙未妻，先天注定。"],[12353,"女属猪，数中注定。"],[12354,"古稀欠三春，无病入黄泉。",67],[12355,"舞低杨柳台前月，歌尽桃花扇底风"],[12356,"济世无婆心，恩光有意后。"],[12357,"喜生一子，不幸妻亡。",60],[12358,"马背扬威，富也甚绔。"],[12359,"万绿丛中红一点，动人春色不须疑。"],[12360,"母死之年，女之不幸。",30],[12361,"父死之年，女之不幸。",37],[12362,"四娶丁未妻，先天注定。"],[12363,"净地何须扫，空门不用关。"],[12364,"如花向日枝枝秀，似草穿林节节高。"],[12365,"为人机智且喜，暗渡陈仓彪炳。"],[12366,"一生气焰摩星斗，品格威严振雷霆。"],[12367,"心善到头身心善，风亭复整钓鱼竿。"],[12368,"维持屋里春风满，织锦机中夜月寒。"],[12369,"修真悟道，恩自九重。"],[12370,"母死之年，女之不幸。",31],[12371,"父死之年，女之不幸。",38],[12372,"四娶己未妻，先天注定。"],[12373,"谈经翻见叶，扫石落旗杆。"],[12374,"志气尚同唐李杜，轩昂不让汉班超。"],[12375,"五行秉德中和气，烈烈轰轰迥出群。"],[12376,"掌握貅秉节钺，惟从边塞播声名。"],[12377,"后运正兴家业盛，光风霁月乐悠悠。"],[12378,"双喜临门，聚家欢乐。"],[12379,"斜倚花街迎客惯，笑生桃李可人怜。"],[12380,"母死之年，女之不幸。",32],[12381,"父死之年，女之不幸。",39],[12382,"四娶辛未妻，先天注定。"],[12383,"了性无他意，常对一炉香。"],[12384,"母先父后亡，易数无差。"],[12385,"暗来暗去，有失君子雅。"],[12386,"客相触命，已西游去。",57,58],[12387,"理人曲直排，难解纷冠带临身。"],[12388,"克勤克俭能内助。"],[12389,"财源交接声名重，家业兴隆气象新。"],[12390,"母死之年，女之不幸。",33],[12391,"父死之年，女之不幸。",40],[12392,"四娶癸未妻，先天注定。"],[12393,"已脱浮尘生，是非哪里来。"],[12394,"财源金珠满案前，绿窗朱户稳神仙。"],[12395,"一生运限实亨通，卓荦才华气吐新。"],[12396,"为人广运，识见高明。"],[12397,"大运前来人易交，明伦堂上笑呵呵。"],[12398,"云髻无心整，喜进不敌忧。",20],[12399,"我生不幸，幼年丧父。"],[12400,"母死之年，女之悲也。",34],[12401,"父死之年，女之不幸。",41],[12402,"四娶甲申妻，先天注定。"],[12403,"弄月吟风，山高气爽。"],[12404,"丰姿飘逸，文武皆迪。"],[12405,"智多而优柔，果断失黄金。"],[12406,"良人有刑，再嫁甲子。"],[12407,"一贵当权群魔伏，马头带俞镇边疆。"],[12408,"莫谓平生未称情，遇犬骑龙始见亨。"],[12409,"为人忠厚满面春，胸如宝镜似花朝。"],[12410,"母死之年，女之伤也。",35],[12411,"父死之年，女之不幸。",42],[12412,"四娶丙申妻，先天注定。"],[12413,"已脱浮尘生，是非哪来。"],[12414,"父子同属鼠，先天注定。"],[12415,"禅室根基厚，衣钵助荣身。"],[12416,"良人有刑，再嫁丙子妻。"],[12417,"人愿如此如此，天理未然未然。"],[12418,"门纳天下士，春风满面生。"],[12419,"老而无子曰独君，命所当然。"],[12420,"母死之年，女之不幸。",36],[12421,"父死之年，女之不幸。",43],[12422,"四娶戊申妻，先天注定。"],[12423,"一窗明月供孤灯。"],[12424,"父子同属牛，先天注定。"],[12425,"学术儒宗，洪恩荣赐。"],[12426,"良人有刑，再嫁戊子。"],[12427,"善修齐做会，仁慈亦成佛。"],[12428,"好把阴功祈善保，怨字无心一在头。",59],[12429,"数该生子，枯杨生芽。",71],[12430,"母死之年，女之悲也。",37],[12431,"父死之年，女之不幸。",44],[12432,"四娶庚申妻，先天注定。"],[12433,"七星伴日，福祉锦延。"],[12434,"父子同属虎，先天注定。"],[12435,"好义轻财平生志，东西南北任徘徊。"],[12436,"良人有刑，再嫁庚子夫。"],[12437,"半文半俗土财主，或真或假半斯文。"],[12438,"从前事业总徒劳，回首东风泣楚骚。",50],[12439,"大征出旅威赫赫，清光入阵志扬扬。"],[12440,"母死之年，女之不幸。",38],[12441,"父死之年，女之不幸。",45],[12442,"四娶壬申妻，先天注定。"],[12443,"一路平坦骑骏马，清宁四海建勋业。"],[12444,"父子同属兔，先天注定。"],[12445,"博绿红为牟，钱财或有无。"],[12446,"良人有刑，再嫁壬子夫。"],[12447,"此刻生人，夫妻同白发。"],[12448,"南柯梦入华胥国，人忆英雄笑语中。",59,60],[12449,"度量宽宏，满腹兵甲。"],[12450,"母死之年，女之不幸。",39],[12451,"父死之年，女之不幸。",46],[12452,"四娶乙酉妻，先天注定。"],[12453,"紫园春日暖，宝树发光辉。",37,38],[12454,"父子同属，先天注定。"],[12455,"窗前竭力扬威武，峥嵘气象振开庭。"],[12456,"良人有刑，再嫁乙丑夫。"],[12457,"花发上林，锦绣眩目。",27,28],[12458,"从前乐业总徒劳，回首西风泣书楚骚。",62],[12459,"历尽江山千万转，兴家创业日兴隆。"],[12460,"母死之年，女之悲也。"],[12461,"父死之年，女之不幸。",47],[12462,"四娶丁酉妻，先天注定。"],[12463,"椿树谢时萱又萎，当年泣血父为先。"],[12464,"父子同属蛇，先天注定。"],[12465,"观花早去洛阳楼，刀笔前程遇沛公。"],[12466,"良人有刑，再嫁丁丑。"],[12467,"秋风桂子花开晚，海上蟠桃结子迟。"],[12468,"俄然遂成梦，六亲牖增悲哀。",63],[12469,"试问双亲辞世日，先天注定父行期。"],[12470,"母死之年，女之不幸。",41],[12471,"父死之年，女之不幸。",48],[12472,"四娶己酉妻，先天注定。"],[12473,"处事临机应变才，交友有周急济贫。"],[12474,"父子同属马，先天定数。"],[12475,"芹宫读罢鸡鸣月，还要秋闱占桂香。"],[12476,"良人有刑，再嫁已丑夫。"],[12477,"财源来万里，富厚胜为宫。"],[12478,"大数已定，一杯鲁酒送行程。",65,66],[12479,"结发未从谐老愿，夫妻三配得齐眉。"],[12480,"母死之年，女之不幸。",42],[12481,"父死之年，女之不幸。",49],[12482,"四娶辛酉妻，先天注定。"],[12483,"专在赌博场中，阴阳颠倒如何。"],[12484,"父子同属羊，先天注定。"],[12485,"龙韬何必陈三略，虎帐升来振万方。"],[12486,"良人有刑，再嫁辛丑夫。"],[12487,"双喜临门，虎门生威。"],[12488,"洞里无人春寂寞，幽冥有路去茫茫。",67,68],[12489,"善枝超绝人称羡。"],[12490,"母死之年，女之悲也。",43],[12491,"父死之年，女之不幸。",50],[12492,"四娶癸酉妻，先天注定。"],[12493,"五谷生财源，纵非巨富也无忧。"],[12494,"父子同属猴，先天注定。"],[12495,"人逢好运精神爽，花遇风和瑞气香。",26],[12496,"良人有刑，再嫁癸丑夫。"],[12497,"食素看经虽美意，不如心善更为高。"],[12498,"年至古稀，一梦归西。",69,70],[12499,"他人扫娥眉，何顾自家缘。"],[12500,"母死之年，女之不幸。"],[12501,"父死之年，女之不幸。",51,52],[12502,"玉人屡刑，四娶甲戌妻。"],[12503,"时来兴发至，运到财源似水流。"],[12504,"父子同属鸡，先天注定。"],[12505,"添丁未久又逢凶。",21,22],[12506,"良人有刑，再嫁甲寅夫。"],[12507,"只身无系累，快活在优游。"],[12508,"水尽山穷处，茫茫别一天。",71],[12509,"臂健尚嫌弓力软，眼明犹识阵云高。"],[12510,"母死之年，女之悲也。",45],[12511,"父死之年，女之不幸。",52],[12512,"玉人多刑，四娶丙午妻。"],[12513,"逍遥无疑，万法皈依。"],[12514,"父子同属狗，先天注定。"],[12515,"添丁未久又逢凶。",23,24],[12516,"良人有刑，再嫁丙寅夫，"],[12517,"习文习武皆精通，数定标名耀祖宗。",53],[12518,"驾鹤乘云去，飘然竟不回。",73],[12519,"父命土年生方合。"],[12520,"母死之年，女之不幸。",46],[12521,"父死之年，女之不幸。",53],[12522,"玉人多刑，四娶戊戌妻。"],[12523,"休说六韬三略，只图异路扬名。"],[12524,"父子同属猪，先天注定。"],[12525,"添丁未久又逢凶。",25,26],[12526,"良人有刑，再嫁戊寅夫。"],[12527,"此刻生人，手脚不周全。"],[12528,"一春鱼雁无消息，万里关山梦断魂。",75],[12529,"娴韬武略游圣泮，将来将相可兼全。"],[12530,"母死之年，女之不幸。",47],[12531,"父死之年，女之悲伤。",54],[12532,"玉人屡刑，四娶庚戌妻。"],[12533,"雌先其雄，数注妻亡。",40],[12534,"兄弟同属鼠方合。"],[12535,"添丁未久又逢凶。",27,28],[12536,"良人有刑，再嫁庚寅夫。"],[12537,"绿水青山随笑傲，玉泉金井任涵融。",77,78],[12538,"驾鹤乘云去，飘然竟不归。",87,88],[12539,"姐妹数人，一入空门。"],[12540,"母死之年，女之不幸。",48],[12541,"父死之年，女之不幸。",55],[12542,"玉人屡刑，四娶壬戌妻。"],[12543,"能甘淡薄闲中乐，不向繁华分外求。"],[12544,"兄弟同属牛方合。"],[12545,"添丁未久又逢凶。",29,30],[12546,"良人有刑，再嫁壬寅夫。"],[12547,"五行秉得刚柔性，仁心仁慈。"],[12548,"寿元止于此，一去竟不回。",79,80],[12549,"九姐妹数人，二入空门。"],[12550,"此年失母，女之不幸。",49],[12551,"父死之年，女之不幸。",56],[12552,"玉人有刑，四娶乙亥妻。"],[12553,"休羡春光美，风雨又相摧。",29],[12554,"兄弟同属虎方合。"],[12555,"添丁未久又逢凶。",31,32],[12556,"良人有刑，再嫁乙卯妻。"],[12557,"娴韬武略游圣泮，翱翔万里上青云。"],[12558,"驾鹤乘云去，天上多一仙。",81,82],[12559,"秋风声到，宝镜尘深。",39],[12560,"母死之年，女之不幸。",50],[12561,"此年父死，女之不幸。",57],[12562,"四娶丁亥，得免其刑。"],[12563,"百般皆可做，劝君莫做屠。"],[12564,"兄弟同属兔方合。"],[12565,"添丁未久又逢凶。",33,34],[12566,"良人有刑，再嫁丁卯夫。"],[12567,"为人拔萃超群黄，卷精通青云得路。"],[12568,"天上玉书召，地下失英雄。",83,84],[12569,"流年胸滞，闺中凄凉。",32],[12570,"母死之年，女之不幸。",51],[12571,"是年父死，女之不幸。",58],[12572,"玉人有刑，四娶己亥妻。"],[12573,"前妻生一子，后妻生二儿。"],[12574,"兄弟同属龙方合。"],[12575,"添丁未久又逢凶。",35,36],[12576,"良人有刑，再嫁己卯夫。"],[12577,"妻赴幽冥地，夫当在阳台。",71],[12578,"八旬加五六，一去莫哭之。",85,86],[12579,"欲想八十二，谁知欠一春。",81],[12580,"母死之年，女之不幸。",52],[12581,"父死之年，女之不幸。",59],[12582,"四娶辛亥，免刑主人。"],[12583,"一胎生二子又逢凶。"],[12584,"兄弟同属蛇方合。"],[12585,"生子逢凶。一喜一忧。",37,38],[12586,"良人有刑，再嫁辛卯夫。"],[12587,"他年气运摩星斗，饱食孙吴要性宁。"],[12588,"天地常存，年华始尽。",87,88],[12589,"汝熟孙吴秘，必作青云客。"],[12590,"母死之年，女之不幸。",53],[12591,"父死之年，女之不幸。",60],[12592,"玉人多刑，再娶癸亥妻。"],[12593,"禅林寂静时，时明月清风。",51,52],[12594,"兄弟同属马方合。"],[12595,"添丁未久逢凶。",39,40],[12596,"良人有刑，再嫁癸卯夫。"],[12597,"夫妻应谐老，齐眉到白头。"],[12598,"虽然阳台路不通，好从阴路觅行踪。",89,90],[12599,"妻宜硬命，方得皆老。"],[12600,"母死之年，女之不幸。",54],[12601,"父死之年，女之不幸。",61],[12602,"卜君阳寿，许得古稀。"],[12603,"子貌相父，儒风可佳。"],[12604,"兄弟同属羊方合。"],[12605,"添丁未久又逢凶。",41,42],[12606,"良人有刑，再嫁甲辰夫。"],[12607,"偏房虽多不结子，娶得鼠命许生儿。"],[12608,"其年生子，又入泮林。",15,16],[12609,"未嫁夫先死，命带刑伤。",13],[12610,"母死之年，女之不幸。",55],[12611,"父死之年，女之悲伤。",62],[12612,"卜君阳寿，许于七九。"],[12613,"子貌相母，性慈心善。"],[12614,"兄弟同属猴方合。"],[12615,"添丁未久又逢凶。",43,44],[12616,"良人有刑，再嫁丙辰夫。"],[12617,"偏房虽多不结子，娶得牛命许生儿"],[12618,"其年生子，又唱采芹歌。",17,18],[12619,"幼年刑夫，女之不幸。",14],[12620,"母死之年，女子悲伤。",56],[12621,"父死之年，女之不幸。",63],[12622,"花甲还可，难望古稀。"],[12623,"咏关雎诗，乐君子逑。",25],[12624,"兄弟同属鸡方合。"],[12625,"添丁未久又逢凶。",45,46],[12626,"良人有刑，再嫁戊辰夫。"],[12627,"偏房虽多，虎命生子。"],[12628,"其年生子，正喜入泮。",19,20],[12629,"幼年克夫，女子不幸。",15],[12630,"母死之年，女之悲也。",57],[12631,"父死之年，女之不幸。",64],[12632,"命中注定八女。"],[12633,"女貌相父，英雄大度。"],[12634,"兄弟同属狗方合。"],[12635,"添丁未久又逢凶。",47,48],[12636,"良人有刑，再嫁庚辰夫。"],[12637,"偏房虽多不结子，娶得兔命许生儿。"],[12638,"采芹生子，同在此年。",21,22],[12639,"幼年克夫，女之不幸。",16],[12640,"母死之年，女之悲伤。",58],[12641,"父死之年，女之不幸。",65],[12642,"命中注定生九女。"],[12643,"女貌相母，秀气可佳。"],[12644,"兄弟同属猪方合。"],[12645,"添丁未久又逢凶。",49,50],[12646,"良人有刑，再嫁壬辰夫。"],[12647,"偏房虽多不结子，娶得龙命许生儿。"],[12648,"采芹生子，同在此刻。",23,24],[12649,"夫死之年，女之不幸。",17],[12650,"母死之年，女之不幸。",59],[12651,"父死之年，女之不幸。"],[12652,"命中注定生十女。"],[12653,"兄弟二人，一模一样。"],[12654,"姊妹同属鼠方合。"],[12655,"添丁未久又逢凶。",51,52],[12656,"良人有刑，再嫁乙巳夫。"],[12657,"侧室虽多，蛇命生儿。"],[12658,"是年生子，又当入泮。"],[12659,"克夫之年，刑伤莫重。",18],[12660,"此年伤母，女之不幸。",60],[12661,"父死之年，女之不幸。",67],[12662,"命中注定生十一女。"],[12663,"天上为仙，地下为鬼。",61],[12664,"姊妹同属牛方合。"],[12665,"添丁未久又逢凶。",53,54],[12666,"良人有刑，再嫁丁巳夫。"],[12667,"偏房虽多不结子，娶得马命许生儿。"],[12668,"目前生子，又入泮林。",27,28],[12669,"此年克夫，女之不幸。",19],[12670,