{"volume":"辰集","verses":[[5001,"姊妹二人，木年生方合。"],[5002,"兄弟九人，数有二贵。"],[5003,"欲借杨枝水，几尘不染心。"],[5004,"翰林而拜相，老来衣锦还乡"],[5005,"灾晦缠身，有犯太岁。",61,62],[5006,"先得而后失，秋色更朦胧。",59,60],[5007,"水中月色可玩，不可狎计多无成",21,22],[5008,"积德数注全，兄弟庆同年"],[5009,"旱草焦枯，俄然复苏。",67,68],[5010,"力能创业耐艰辛，不是萎靡不振人。"],[5011,"君弃世从此，红尘不沾巾。",63],[5012,"一日言再曰昌。",39,40],[5013,"如日之升，如月永恒。",47,48],[5014,"兄弟十人，数有六贵。"],[5015,"公平正直，力担重任。"],[5016,"人事有不足，日月有盈亏。",69,70],[5017,"有子先折，赖孙送终。"],[5018,"如川之方，可保平安。",49,50],[5019,"数有二子，一子送老。"],[5020,"徒弟六人，一人送老。"],[5021,"金风一起枝头动，欲渡清溪欠便舟。",35,36],[5022,"周道坦坦，进可安全。",39,40],[5023,"阳菊生秋色，无日不悠悠。",31,32],[5024,"寒山秋浦月，肠断杜鹃声。",61,62],[5025,"官至巡抚而致仕。"],[5026,"薄伐独狁，以奏谓公。",21,22],[5027,"日进无疆，与时偕行。",43,44],[5028,"无语对芳樽，肠断到黄昏。",53,54],[5029,"座中无物不清凉，别是人门洞府仙。",57,58],[5030,"长江避风波，一水万里长。",57,58],[5031,"片时欢娱且相亲，阴暗阴晴无定处。",27],[5032,"暗中福人庇，终始得安康。",43,44],[5033,"事有成局，利禄从心。",45,46],[5034,"百尺竿头堪进步，君能辗转莫迟回。",31,32],[5035,"一曰平再曰安。",47,48],[5036,"三阳方始泰，君子道亨通。",35,36],[5037,"数有三子，一子送老。"],[5038,"泰利顺贞，君子攸行。",41],[5039,"安居思危，凡事顺遂。",43,44],[5040,"福享安然，事无阻碍。",51],[5041,"不岐不求，终日悠悠。",35,36],[5042,"门外声嚎嚎，垂帘不高照。",39,40],[5043,"云开日出自光辉，进步前程有渡舟。",31,32],[5044,"时有可为，乘机敏锐。",61,62],[5045,"富彩日新，位至品卿。",37,38],[5046,"一家和气运兴隆，谋事多成财自丰。",21,22],[5047,"君子日更新，相逢大吉人。",43,44],[5048,"肥马轻裘，少年行乐。",13,14],[5049,"浪平风静，正好行舟。",37,38],[5050,"平安之福，门庭之器。",77,78],[5051,"如饮醇醪，其味深厚。",37,38],[5052,"三边提督，将相威振。",43,44],[5053,"进退咸宁，东西有得。",45,46],[5054,"德润于身，无往不吉。",31,32],[5055,"优游闲岁月，不管落花飞。",47,48],[5056,"乘驹千里行，风帆指顾中。",35,36],[5057,"利有攸往，昔愿如今。"],[5058,"凿井未得泉，弃之而废力。",41,42],[5059,"终朝啸傲南窗下，自是羲皇上古人。",43,44],[5060,"宜享日前福，莫虚日后忧。",51,52],[5061,"享其寿福，自在逍遥。",63,64],[5062,"有弓无箭，欲射不能。",54],[5063,"沟中有深味，不与别人同。",57,58],[5064,"龙剑出尘射斗牛，财源辐利亨通。",50,51],[5065,"人有福泽前生定，不必迟疑自己行。",61,62],[5066,"君子受祯，其旋元吉。",31,32],[5067,"俾而富贵，昌且大吉。",55,56],[5068,"君子日更新，相逢大吉人。",27,28],[5069,"衣禄丰盈，室家安宁。",49,50],[5070,"满目韶光观不尽，一旦无常作故人。",59],[5071,"终日经营，吉利相从。",47,48],[5072,"心闲身乐，宜室宜家。",31,32],[5073,"独守孤灯，心步月疏。",47,48],[5074,"凤凰来仪，祯祥之兆。",55,56],[5075,"皇道荡荡，君子贞吉。",37,38],[5076,"不为世所累，享平安之福。",63,64],[5077,"萱花先萎，椿树后折。"],[5078,"绿竹猗猗，清风明月。",37,38],[5079,"视履考祥，其旋元寺。",33,34],[5080,"际遇亨通，所谋皆遂。",31,32],[5081,"荷花出水，亭亭玉立。",19,20],[5082,"东处得来西处失，得失不一。",51,52],[5083,"泪欲尽时人难语，情关骨肉恨如何。",55,56],[5084,"官至将军禄位高，光前裕后显富豪。"],[5085,"原来无事费心机，还是君家运未齐。",55,56],[5086,"忽然而贵忽然贱，运有高低月缺圆。",37,38],[5087,"欲作表心福，清晨一炷香。",59,60],[5088,"鸠一声鹃一声，鸠鹃好伤情。",42],[5089,"母先故于金年。"],[5090,"三子送老，一枝挺秀。"],[5091,"大人豹变，文人之炳。",35,36],[5092,"数有四子，一子送老。"],[5093,"忽闻鹊噪两三声，声里藏凶未有音。",55,56],[5094,"既往蹉跎，将来顺利。",37,38],[5095,"鱼游涸辙，但望时雨而升阳。",55,56],[5096,"得福且福，莫为儿孙劳碌。",78],[5097,"何时方可得见非，无是也无非。",78],[5098,"东风初送暖，春草绿生光。"],[5099,"数有五子，一子送老。"],[5100,"兄弟九人，数有六贵。"],[5101,"贤惠迪吉，随从逆凶。",47,48],[5102,"波浪虽高，孤舟系得牢。",59,60],[5103,"人事从容，家门迪吉。"],[5104,"数有六子，一子送老。"],[5105,"官至都统，威权重职。"],[5106,"亭午日光，文明之象。",57,58],[5107,"兄弟八人，数有七贵。"],[5108,"礼蔽文章，温良得度。"],[5109,"兰亭修楔高，贤醉寻花乐。",51,52],[5110,"指挥如意待时亨，万物峥嵘福自随。",31,32],[5111,"借问一生身外事，遇虎之年是归期。"],[5112,"无福无灾，安身福来。",75,76],[5113,"靡芜秋色，一阳初动便生芽。",41,42],[5114,"门庭任从容，花鸟禽鱼曲槛中。",21,22],[5115,"机会相从，安康惟兆。",23,24],[5116,"数有七子，一子送老。"],[5117,"性淡意坚，贞节之妇。"],[5118,"火年金年两克夫，金年三配属羊鼠。"],[5119,"数有八子，一子送老。"],[5120,"妻配马命，庶免其刑。"],[5121,"拾得琼花第一枝，长安城里马蹄驰。",33,34],[5122,"光景气滔滔，好过旧时机。",47,48],[5123,"洞房花烛。",34],[5124,"旺夫益子，衣禄丰盈。"],[5125,"入限无关，津江寂寞断行人。",47,48],[5126,"狡兔投林，灾晦相侵。",27,28],[5127,"幼年入泮，人生大幸。",13,14],[5128,"学礼学诗，知东道西。",37],[5129,"事未可料当，因祸而得福。",60],[5130,"天哭催人，刑克老母。"],[5131,"官至总河而致仕。"],[5132,"数有九子，一子送老。"],[5133,"朝欢暮乐及歌诗，鼓舞春风又及时。",53,54],[5134,"此年丧母，二年泣血。",48],[5135,"计功图利，得失相兼。",65,66],[5136,"时运称怀，顺福自来。",29,30],[5137,"化日舒长，人民乐意。",55,56],[5138,"数有十子，一子送老。"],[5139,"民安物阜咸，均平人得全。",55,56],[5140,"中年失妻，蓄宾教子。"],[5141,"老年丧母，三年泣血。",53],[5142,"吉利相从，鸢飞鱼跃。",57,58],[5143,"情疏种有年，疾风莫相催。",70],[5144,"徒弟四人，得以送老。"],[5145,"无是无非，安闲岁月。",73,74],[5146,"无本生意，厚福悠悠。"],[5147,"远务近为事，事成及时进。",33,34],[5148,"命与道相同，独子送终天注定。"],[5149,"入户春风送和气。",37,38],[5150,"一举成名，天降麟儿。",29,30],[5151,"北堂一夜却秋霜，萱草离披忧未忘。",45],[5152,"上高楼而顾后，还恐失其足。",25,26],[5153,"女金年生，方合此刻。"],[5154,"财聚成家，从此立业。",33,34],[5155,"牛背有金珠，春风遍草庐。",75,76],[5156,"冷落离披，雨中桃李。",47,48],[5157,"强把悉怀变笑容，心中烦闷不堪言。",55],[5158,"一妻一妻又一妻，四度见佳妻。",41,42],[5159,"炎气薰人，楼上风生。",57,58],[5160,"未婚之前，已谙人事。"],[5161,"数有三子，二子送老。"],[5162,"椿萱何日萎，母先赴瑶池。"],[5163,"蹇马滔泥沙，步步当头难。",55,56],[5164,"扁舟一叶江鸟少，寄语舟人把舵穿。",36],[5165,"兄弟八人，数当尽贵。"],[5166,"安居处世，纳福呈祥。",69,70],[5167,"衣锦更藏珠，年年物色如。",52],[5168,"巧语阳春，音谐律吕。",49,50],[5169,"诩负冲天志未伸，不如坚守待新春。",37,38],[5170,"春风得意桃花红，上下楼台物色浓。",37,38],[5171,"椿树风吹折，定于耳顺年。",60],[5172,"挥已定规模，逮方来阀阅。"],[5173,"生计顺相从，行之无不和。",43,44],[5174,"忧心事多，强为欢笑。",53,54],[5175,"行路事危险，相逢不善人。",55,56],[5176,"兄弟九人，数有八贵。"],[5177,"不须磨刮镜中尘，日照颜容色倍新。",39,40],[5178,"数有四子.二子送老。"],[5179,"夙夜惟寅，直哉惟清。",39,40],[5180,"真假六子，得以送老。"],[5181,"数该生子。",27],[5182,"桃李近清明，荣华足乐意。",37,38],[5183,"长子不孝，数内先知。"],[5184,"真假三子，送老两儿。"],[5185,"为御从征束晚妆，从今不必问行藏。",68],[5186,"屈指年来命运乖，解眉今日得欢怀。",49,50],[5187,"人意周旋天意差，红梅消瘦不成花。",59,60],[5188,"一品皇候，岂寻物色。"],[5189,"际遇有乘，黄昏到处迷。",38],[5190,"数有三子，二子送老。"],[5191,"数有六子，二子送老。"],[5192,"重可双亲不一名，数定依旧祝亲生。"],[5193,"运至时行，进退有益。",47],[5194,"妻配蛇命，方能白手和谐。"],[5195,"古曜相扶免祸殃，平安度日福如常。",27,28],[5196,"寒气消除，大吉之象。",39,40],[5197,"数有七子，二子送老。"],[5198,"圆碎无穷荷叶珠，轻风吹动不相宜。",15,16],[5199,"椿萱俱已谢，椿树受灾先。"],[5200,"兄火年生方合此刻。"],[5201,"灾晦缠身，有犯太岁。",76],[5202,"春光花柳媚，相看乐忘忧。",15],[5203,"寒鸦枯木日沉西，门外青山事与非。",63],[5204,"相度太平时，花酒又一杯。",59,60],[5205,"曲水行舟多费力，有时顺着有时逆。",73,74],[5206,"兄弟九人，数有五贵。"],[5207,"四子水木土金，若生火年不是子。"],[5208,"朋友有知己，相处乐平安。",76],[5209,"虽是苦奔驰，钱财积有余。"],[5210,"将乐好光阴，不用求谋福自臻。",55,56],[5211,"幼年丧严亲，人子太不幸。",7],[5212,"官至翰林学，衣锦回乡归。"],[5213,"昼长人静草芊芊，景色融花正妍妍。",17,18],[5214,"自有渔人指路岐，从此营谋遂机遇",51],[5215,"春来万物生，天地造化融。"],[5216,"治家操作，女中丈夫。"],[5217,"园木日暖百花香，蝴蝶纷纷过红墙。",39,40],[5218,"数有八子，二子送老。"],[5219,"数有九子，二子送老。"],[5220,"财来财往，终身难有积蓄。"],[5221,"寸心今日得安康，内外公私百事休。",61,62],[5222,"借问一声身外事，遇兔之年是归期。"],[5223,"流年之庆，晚景安康。",69,70],[5224,"翰林拜相，驰驿回乡。"],[5225,"勿得因人累，变迁已后悔无边。",28],[5226,"春入画堂中，阳和物色浓。",29,30],[5227,"科甲及第。",61],[5228,"鸟啼绿柳织成愁，丝絮纷纷万事休",59,60],[5229,"丧门照命，孝服之忧。",49],[5230,"福骈臻至，积财有余。",59,60],[5231,"生子之年。",78],[5232,"数有四子，三子送老。"],[5233,"好运已转，人能造福。",35,36],[5234,"东坡向禅寺，云龙山上色。"],[5235,"此时不利，啾唧自知。",47,48],[5236,"粟储有余，有实无虚。",43,44],[5237,"钦命典试。",57,58],[5238,"务本力田，朝夕安然。"],[5239,"有理蛇救蚁，德未知初起。"],[5240,"忧转还喜，散面后聚。"],[5241,"数有五子，三子送老。"],[5242,"见龙在田，天下文明之象。",27],[5243,"大泽龙蛇，末得风云际会。"],[5244,"女配乘龙客，即姿金马才。"],[5245,"花开花落春早起，妒时有兴运仍低。",15,16],[5246,"悉魔活却病魔除，福禄悠悠得安居。",51,52],[5247,"活计得周旋，行藏胜往年。",41,42],[5248,"深思未报，严君幽冥。",12],[5249,"忧怀未可对人言，外强欢笑内忧煎。",52],[5250,"所求必得，无烦叹息。"],[5251,"数有六子，三子送老。"],[5252,"事欲乘时破局来，若颠若倒若徘徊。",41,42],[5253,"姊妹四人，同父不同母。"],[5254,"人欲周全天欲差，红悔消瘦不成花。",31,32],[5255,"公私而得间，欢喜得相随。",67,68],[5256,"行人渡岭，步步平途。",55,56],[5257,"真假五子，四子送福。"],[5258,"数有六子，三子送终。"],[5259,"缟带衣冠不怕粗，阴极阳盛主丧服。",49,50],[5260,"为人正直，豪气千云。"],[5261,"瑞气融融护画堂，十为九成运相当。",41,42],[5262,"家业欢乐，春风融融。",51],[5263,"阴不阴时阳不阳，同林寂莫鸟声藏。",55,56],[5264,"日照中庭，花木更新。",23,24],[5265,"月缺花残，寿穷数尽。",76],[5266,"运来正亨通，家门瑞气隆。",41,42],[5267,"谋事虽成，忧之未已。",37],[5268,"数有七子，三子送老。"],[5269,"衣禄丰盛，家室安康。",53,54],[5270,"勋勒鼎彝臻，富贵于白发。"],[5271,"黄菊引晦来，一年多忧闷。",40],[5272,"颜子欠二春，三子送老。",30],[5273,"数有八子，三子送老。"],[5274,"推车未能上高岗，一步高来一步低。",47,48],[5275,"自有高人轻惜力，一身财禄永无忧。",1],[5276,"相逢可与言，换得眉头有笑颜。",47],[5277,"虽不高飞，断不在后。"],[5278,"万物得宜心境宽。",45],[5279,"钦命典试，状元可取。",57,58],[5280,"数有九子，二子送老。"],[5281,"武曲照命，当宴膺扬。",51,52],[5282,"弓马入泮。",53,54],[5283,"夫登黄甲。",59,60],[5284,"行藏不必问行藏，阴道骖迟驷马行。",55,56],[5285,"妻配龙命，方能白头到老。"],[5286,"瓜绵绵，长生根本。"],[5287,"呼聚喝声，威权至重。"],[5288,"六出奇才，呼风成阵。"],[5289,"计事无功破局多，十无一就其奈何。",21,22],[5290,"武曲照命，三场中选。",55,56],[5291,"青云得路，天赐佳儿。",27,28],[5292,"解神相见喜和同，凶曜消除福正隆。",25,26],[5293,"闺中未消停，重云敝日闷沉沉。",41,42],[5294,"事事称心怀，无日不精神。",28],[5295,"年来寿运增，好景清净吉。",49,50],[5296,"名登金榜。",62],[5297,"南北东西无不通，往来无事福相从。",46],[5298,"流萤有光，可以照路。",52],[5299,"惜民财以克已，立刑法以行宽。"],[5300,"数有五子，四子送老。"],[5301,"兄弟二人，同父不同母。"],[5302,"如花不久，徒增父母悲。",5],[5303,"名登金榜。",19],[5304,"扫尽风云一占无，中天高照有金星。",57,58],[5305,"飞来横祸恼人怀，恨未无情有破财。",55,56],[5306,"仕途变幻，官讼莫加。",56],[5307,"心事安闲，家室康宁。",77,78],[5308,"方当壮年，及时猛进。",27,28],[5309,"灯光明朗照人行，步步周旋事不惊。",55,56],[5310,"衣服饶足，心安意稳。",59,60],[5311,"好树扶疏衬绿阴，行人至此慢消停。",27,28],[5312,"数该生子。",44],[5313,"数有六子，四子送老。"],[5314,"进退维谷，祸相逐阻。",43,44],[5315,"妻配兔命，方得偕老。"],[5316,"是非虽有财也有，等闲一梯上高楼。",33,34],[5317,"年值半旬，啾唧不免。",5],[5318,"数有七子，四子送老。"],[5319,"五子原全属五行，二土二金一火真。"],[5320,"十月怀胎，我多一月。"],[5321,"数有八子，四子送老。"],[5322,"祖宗植根深，子当发富贵。"],[5323,"曳裾豪门，兼收名利。"],[5324,"一树梨花白玉开，妒风吹下落楼台。",59],[5325,"婚宜迟迟乃堪配，若早配时定克伤。"],[5326,"荣膺朝野称元老，奎理阴阳作相人。"],[5327,"陌头杨柳绿，画堂春草生。",15,16],[5328,"数有九子，四子送老。"],[5329,"早子虚迟子实。"],[5330,"数有十子，四子送老。"],[5331,"数有六子，四子送老。"],[5332,"竭力朝迁，踊跃往前。"],[5333,"一曲凤求凰，花烛乐鸳鸯。",19],[5334,"退而结网自踌躇，不必临渊羡有鱼。",27,28],[5335,"扰扰怀多事，得五而退十。",43,44],[5336,"科甲及第。",63],[5337,"年来与甲岁不同，内外熙熙乐意浓。",49,50],[5338,"当谐鸾凤，如鱼得水。",21],[5339,"红鸾相照，洞房花烛。"],[5340,"一手有偏，先天定数。"],[5341,"横积资财，事事多阴。",31,32],[5342,"真假六子，送老四儿。"],[5343,"早岁颠连，必作填房。"],[5344,"子产河东，典列分飞各树楼。"],[5345,"水年妻丧，土年再娶属土命。"],[5346,"数有七子，五子送老。"],[5347,"堂前画荻恨无人，读到蓼莪自狎情。",43,44],[5348,"注定三子属水土，儿若值木不为福。"],[5349,"饮酒食肉，天与之福。",77,78],[5350,"菽水承欢萱草茂，熏虎并奏桥梓贤。"],[5351,"血带斑斑，先天定数。"],[5352,"日落幸逢关可渡，寻得桃源可避泰。",93,94],[5353,"春风秋月见，无不欢欣颜。",49,50],[5354,"安如磐石，谋望亨通。",53,54],[5355,"年至八八，卦尽无零。",64],[5356,"明月下弦，其光渐减。",82],[5357,"虽无衣锦赶金阙，喜得财源富老年。",83,84],[5358,"日下数年时过薄，那堪思就子陵般。",49,50],[5359,"一切有影如梦幻，于今灯火显光明。",55],[5360,"先花后果，数中注定。"],[5361,"椿庭丰茂，萱堂在萎。"],[5362,"善事翁姑，贤能莫及。"],[5363,"鸦鹊报凶又报吉。",33,34],[5364,"好树扶疏绿映浓，吹嘘之力在东风。",29,30],[5365,"寿城司签九十年，寿星昨夜现中天。",89,90],[5366,"数有六子，得以送老。"],[5367,"四时佳处莫如春。",3,4],[5368,"妻配虎命，方能白首到老。"],[5369,"数有九子，五子送老。"],[5370,"兄弟十人，中断离群。"],[5371,"春雨花枝茂，枝枯而复荣。",59,60],[5372,"命犯孤刑，未出嫁而克夫。"],[5373,"数有八子，五子送老。"],[5374,"金谷园中列绮罗，山珍海味列于前。",75,76],[5375,"高椿之树正复苏，不料狂风吹折枝。",18],[5376,"寿曰于此矣。"],[5377,"乐事喜相逢，东林鸦噪不为凶。",49,50],[5378,"行船走马防风浪，不是人差命亦差。",35,36],[5379,"红鸾照命。",27],[5380,"愁怀不可释，勉强度晨昏。",35],[5381,"风雨消停春日长，千红万紫乐湘江。",49,50],[5382,"天德相照，可免灾耗。",41,42],[5383,"手扳丹桂枝，繁华满目前。",55],[5384,"彼为名所伤，虚来耗去不寻常。",20],[5385,"朝夕无忧，不岐不求。",9,10],[5386,"扰攘未有宁，内外不息忧。",47,48],[5387,"有个渔郎来指引，天台路上人可疑。",49,50],[5388,"花遇清明遍锦从，坤人无日不春风。",55,56],[5389,"风中流莺栖未稳。",33,34],[5390,"淹沉何事，谋策何如。",33,34],[5391,"数有七子，六子送老。"],[5392,"灾后又有灾，风遇雨又来。",56],[5393,"欲进且盘恒，青丝宝马未有鞍。",21,22],[5394,"人旺财兴，家室安宁。",55,56],[5395,"阳气盘桓晦又生。",68],[5396,"上古三十而有室，君今一二亦相宜。",31,32],[5397,"寿至六十七。",67],[5398,"西宫见孛嗟嘘日，惟期神力保无虞。"],[5399,"破财不利，问利无益。"],[5400,"生来岁月亨，万物色更新。",29,30],[5401,"径路荆棘，行人难定。",57,58],[5402,"有始无终，其事难济。",39,40],[5403,"人事顺利，且安且宁。",56],[5404,"黄花逢老景，犹有晚节香。",63,64],[5405,"喈喈鸟鸣声，春风赖有情。",19,20],[5406,"黄花逢老景，犹有晚节香。",63,64],[5407,"命带关煞，焉能长五年。",5],[5408,"谋事难成，作十九失。",53,54],[5409,"知进知退，能刚能柔。"],[5410,"乖戾不和，事多舛错。",47],[5411,"项庄舞剑，意在沛公。"],[5412,"凄凉苦雨，行人忧心。",37,38],[5413,"真假七子，四子送老。"],[5414,"千里行人未息肩，得乘良马再加鞭。",63,64],[5415,"仕途变幻，官讼交加。",47,48],[5416,"才大力厚，任重道远。"],[5417,"徒弟四人，得以送老。"],[5418,"数有八子，六子送终。"],[5419,"好花离枝，妒雨相催。",36],[5420,"六旬加八载，一去料不回。",68],[5421,"日圆月缺恨无常，人事浮沉没主张。",23,24],[5422,"妻命属土金年娶，其后已丧在水年。"],[5423,"醉酒寻花，赏心乐事。",50],[5424,"一别亲朋万古愁，青山绿水空悠悠。",50],[5425,"春光明媚，物色更新。"],[5426,"劝君勤习读诗文，莫将技艺浪青春。"],[5427,"柳媚花明，赏心乐事。",13,14],[5428,"一点银灯暗处飞，若明若暗照庭门。",35,36],[5429,"化纸为宝，无所祈祷。",69],[5430,"不足于心，有余在口。"],[5431,"灾晦相侵，流年之咎。",63,64],[5432,"数有十子，六子送老。"],[5433,"家业兴隆，运至时通。",46],[5434,"山川之毓秀，莹润掌中珠。",1],[5435,"守定钱库，毫厘不失。"],[5436,"雁许河东过齐田，入梦相让退一环。"],[5437,"蹑足高楼上，更上一层楼。",45,46],[5438,"双双鸿雁翱翔飞，一生立在松顶尖。"],[5439,"短命之儿已有友，其后土年倾。"],[5440,"历险崎岖路坦夷，前程指引可行车。",51,52],[5441,"不疾不徐，从容马啼。",57,58],[5442,"数有八子，七子送终，"],[5443,"乌云一卷见青天，日色融融花正妍。",49,50],[5444,"结交非其人，不但初心负。"],[5445,"莲花映日色，自是不寻常。",11],[5446,"功名事就，福享余年。",71,72],[5447,"好运初转，人能造福。",25,26],[5448,"驿丞之职，数内先知。"],[5449,"旭花天时便凋残，恨杀无情风雨催。",22],[5450,"有翁先死，大数已定。"],[5451,"谋事顺意，动止安详。",35,36],[5452,"始终好事得周旋，今年行事理先年。",57,58],[5453,"行船走马防风浪，不是人差命亦差。",35,36],[5454,"寿享八旬，悠悠而往。",80],[5455,"云开山色丽，风静竹枝安。",42],[5456,"南北东西无不通，往来有利得相从。",49,50],[5457,"妻当出家，数内先知。"],[5458,"子许一丁先抱女，原来有数定先知。"],[5459,"老骥伏枥，志在千里。",68],[5460,"数有九子，七子送老。"],[5461,"森森玉树庭前立，满院桂花晚节香。"],[5462,"绿树阴浓夏日长，凉亭轩爽芰荷香。",29,30],[5463,"曾戴日月山，家本不了局。"],[5464,"金木土火成五子，惟是水命不宜儿"],[5465,"数有九子，六子送老。"],[5466,"萱花阴庇得长年，椿树风吹定在先。"],[5467,"皓月澄清，千里一碧。",30],[5468,"天心来复转三阳，黄道初出日渐长。",21,22],[5469,"细雨微微霏，似有似无泾人衣。",24],[5470,"乐事人怀，祯祥福来。",56],[5471,"无是无非，三春花柳。",59,60],[5472,"景色快人情，垂杨遍绿阴。",17,18],[5473,"复任守备。"],[5474,"子丧严亲，随母从人。",5],[5475,"数中不幸，父母死于非命。"],[5476,"运有乖违，花枝风雨催。",39,40],[5477,"禅门自有春光景，寒气侵人未及回。",19,20],[5478,"老骥伏枥，志在千里。",71,72],[5479,"月光千里照人行，夜色灯青到处明。",25,26],[5480,"水火相刑，落水复生。"],[5481,"萱花经霜萎，妒雨又相催。",29],[5482,"春到南枝，白有微阳相应熙。",23,24],[5483,"天哭催人，老母虽故而有寿。",60],[5484,"秋声听鹿鸣，又兆熊罴庆。",35,36],[5485,"为问仕途人，不知林下泉。",61,62],[5486,"数有不幸，母嫁作尼姑。"],[5487,"如花开处锦披霞，院宇精华是丽华。",37,38],[5488,"弄折桂枝，子今同恨。",55,56],[5489,"权望照命，巡职甚任。",31,32],[5490,"整顿笙歌会，春暖日融融。",31],[5491,"数该生子。",56],[5492,"飞狂为思又为灾，啾唧无端水破财。",41,42],[5493,"凶星不侵，流年之庆。",17,18],[5494,"朱雀绕户，破害相侵。",43,44],[5495,"人生七十古来稀。",70],[5496,"数生九子，七子送老。"],[5497,"水年科甲。"],[5498,"晦气侵人，禅房冷淡。",17,18],[5499,"快足无求，老景悠悠。",71,72],[5500,"无意栽花花正发，易成易立不消停。",13,14],[5501,"断弦之悲。",38],[5502,"终日持竿不得鱼，江中风雨草萎萎。",47,48],[5503,"走遍江山又是关，道途涉事又艰难。",73],[5504,"南柯太守梦正长。",49,50],[5505,"不明不暗，有情无遂。",13,14],[5506,"大数已定，何必复问。",51],[5507,"一程又一程，无处不阳春。",31],[5508,"三阳回万象，幽谷自生春。",12],[5509,"锦似河阳院里花，春风到处映荣华。",29,30],[5510,"名花锦色，可堪人意。",19,20],[5511,"酒醉复醒，忧乐同行。",51,52],[5512,"行乐顺境，吉利相得。",45,46],[5513,"所求不遂，进当复退。",31,32],[5514,"初授狱官，事宜斟酌。"],[5515,"花开遇雨无颜色，月明还被黑云遮",53,54],[5516,"初阳出云表，曜色照堂前。",18],[5517,"谋未成时天欲催，成成如寄福白云。",21,22],[5518,"土年配夫金年克。"],[5519,"南极吉星临，喜气到门庭。",59,60],[5520,"翩翩五子属金星，若中海金终须去。"],[5521,"此刻生人，萱花犹茂。"],[5522,"姐象慈母，方合此刻。"],[5523,"赋性刚直，仁心仁慈。"],[5524,"福来不必求，安然得悠悠。",31,32],[5525,"屈贾于长沙，时之未遇时。",19,20],[5526,"昔日徘徊有不前，今日快马再加鞭。",37,38],[5527,"入山樵木，得地得财。",49,50],[5528,"命主刑夫，出家而能寿。"],[5529,"子有四位木火土，纵有炉火生而去。"],[5530,"蝶宿花房愁难语，自怜春去几时回。",48],[5531,"青去得路，天赐佳儿。",23,24],[5532,"喜自天来，无心之处得逢财。",59,60],[5533,"怡情泽畔心如镜，栖迟衡门每赋诗。",51,52],[5534,"进三退四却为何，眼下迟疑反覆多。",27,28],[5535,"春花正好游，饮酒乐忘忧。",61,62],[5536,"春花冉冉，物色更新。",21,22],[5537,"难之又忽易，转便饶生计。",22,23],[5538,"子早妻早，人生大幸。"],[5539,"意外烦恼之忧。",57,58],[5540,"春色无恨锦丛中，花鸟相亲事不同。",56,57],[5541,"喜有五子火土金，若生木命主灾运。"],[5542,"官至参政，仕途变幻。"],[5543,"珠玉金屋，享福过人。",61],[5544,"兄弟俱出家，原来有数定先知。"],[5545,"借用无成，时之未遇。",27,28],[5546,"大运既亨，相时而动。",30],[5547,"圆转而用环不穷，一歌一曲笑春风。",41],[5548,"一子不见，数由前定。"],[5549,"问子三旬外，得之始方贵。",36],[5550,"枯苗得雨，勃然而兴。",60],[5551,"此年数尽。",58],[5552,"静中心地泰，春色上眉端。",51],[5553,"莫道秋容花冷淡，春风遥送暗香来。",69,70],[5554,"时不至兮运不通，拾得黄金变作铜。",27,28],[5555,"只好安闲家里坐，岂知门外闹声嚣。",79,80],[5556,"八旬未足，何竟归西。",79],[5557,"职居丞驿，禄多事烦。"],[5558,"福禄无空，终须常有。",55,56],[5559,"财破而免灾，不幸中有幸。",13,14],[5560,"城墙之上挂灯笼，诸事亨兮财自亨。",39,40],[5561,"云中月，雨中花。",37],[5562,"镜与人去，镜归人不归。",40],[5563,"才大难为用，婆婆两鬓明玉梦。"],[5564,"丰衣足食，锦绣之花。",7,8],[5565,"生子之年。",39],[5566,"家室康宁，平安之庆。",23,24],[5567,"借问一生身外事，遇鸡之年是归期。"],[5568,"芳草萋萋春正深，遍郊红绿称人怀。",57,58],[5569,"三军司令威权重，细柳营中主帅明。"],[5570,"无物不从容，乐于管弦中。",51,52],[5571,"徒弟四人，二人送老。",58],[5572,"清闲无事，啸傲林中。",51,52],[5573,"一团冷气透菩提。",69,70],[5574,"牡丹开得正荣华，胜意当年千万家。",27,28],[5575,"夫命属土，配年火丧夫年木。",76],[5576,"羡君今日促离妆，惟向当年快有常",79],[5577,"春花秋月，无不欢欣。",29,30],[5578,"四儿原来水火土，金木纵饶不与数。",55,56],[5579,"赤日空红色逐，绿柳深处得停车。",23,24],[5580,"不图宫殿扳丹桂，只效肖曹更名扬",39,40],[5581,"嫡母所生方合此刻。"],[5582,"红灯照路，行人去复无徘徊。",55],[5583,"不幸严君先辞世，幸逢母命寿元长"],[5584,"国有绵长庆，民增纯嘏休。",81],[5585,"秋风落叶，暗自消然。",59,60],[5586,"不劳其心力，安享其冰福。",51],[5587,"风风雨雨恨无凭，桃红柳绿损精神。",20],[5588,"乡试中选。",32],[5589,"有子传家真富足，闲评棋局醉春风。",57,58],[5590,"灾晦相侵，流年不利。",19,20],[5591,"闷然不乐，雷雨交加。",49],[5592,"清晨鸦鹊噪，凶报不可闻。",39],[5593,"夏雨初晴看白莲，亭亭欲立小池边。",5,6],[5594,"惟笑时光，春风海棠。",33,34],[5595,"马未铺鞍，高低盘桓。",67,68],[5596,"弹断瑶琴丝，其限有刑伤。",78],[5597,"花开遇雨，人生有难。",19],[5598,"兄弟五人，数有三贵。"],[5599,"兵甲于胸中，经论于掌上。",51,52],[5600,"车帷暂驻，其栽遥临。",29,30],[5601,"畅快宽舒，往来垣夷。",65,66],[5602,"曲道推车，进退两难。",55],[5603,"马到嵬坡，车必出辙。"],[5604,"丹桂花香，秋风扫落。",81],[5605,"异路功名，数由前定。"],[5606,"豺狼当道，不宜前进。",57,58],[5607,"马走危途，回道蹉跎。",20],[5608,"福寿绵绵九十八，试看往脚少三春。",95],[5609,"九九之年数已尽，幽冥魂魄入泉中。",81],[5610,"既载以功，车服以庸。",29,30],[5611,"冯驭未老，买信有期。"],[5612,"命犯孤鸾奈若何，甘心淡薄为尼姑。"],[5613,"兄弟四人，一人过房。"],[5614,"土命水命子其后，木年水年去。"],[5615,"异路功名，吏员可喜。"],[5616,"官至监司，数已注定。",29,30],[5617,"五台星照，任推尚书。",57],[5618,"无物不从容，乐于管弦中。",42],[5619,"昨夜朔风高，江山千里过琼瑶。",66],[5620,"人有偏财，命有福禄。"],[5621,"藤有蔓延花，破财两相牵。",41,42],[5622,"婉转随时，得合中意。",26],[5623,"父当出家，数内先知。"],[5624,"有梯有板，高楼直上不难。",21,22],[5625,"停步东风里，郊原处处香。",5,6],[5626,"凶神得解福星狭，祸自消除福自来。",12],[5627,"朝云朝来，财聚财散。",29,30],[5628,"数到头来总是空，金银财宝化为铜。",52],[5629,"脱绝牵绳，举步轻便。",51,52],[5630,"六旬欠二人冥乡，虽效孔明礼斗难。",58],[5631,"耕田贸易两相宜，运好两般皆生计。"],[5632,"运至时通，事皆得意。",25,26],[5633,"风清月朗，情怀畅怀。",45,46],[5634,"龙泉利器，淬锋未试。",27,28],[5635,"决外烦恼忧，赖有吉神解。",57,58],[5636,"三子送老，贤愚不等。"],[5637,"春风绮罗，翻翻得意。",15,16],[5638,"松筠节操，天赐其麻。",53,54],[5639,"戊戊之年，名登金榜。"],[5640,"双喜临门，弄璋采芹。",21,22],[5641,"杨花飞柳花飞，春深寂莫鸟不啼",12],[5642,"无祸无灾，安居福来。",55,56],[5643,"饱暖无求乐，轻风送小舟。",45,46],[5644,"锦乡堂中列绮筵，暖风相送鸟声和。",27,28],[5645,"彩云照耀，画堂春色。",51,52],[5646,"仁心仁慈，尽善尽美。",23,24],[5647,"此命出于偏房方合。"],[5648,"天理常存，年岁始尽。",88],[5649,"再任知州。"],[5650,"富极无高，以尽人间福。",61,62],[5651,"出门无所求，求之皆遂意。",41,42],[5652,"生子之年。",40],[5653,"晦里照命，室中有损。",57,58],[5654,"甲辰之年，名登金榜。",41,42],[5655,"子许三丁先抱女。"],[5656,"大耗小耗，破财遇盗。"],[5657,"财帛福具备，子孙满画堂。",77,78],[5658,"三春杨柳正绿阴，又防风雨打枝头。",25,26],[5659,"玲珑台阁备，壮丽之观景。",65,66],[5660,"晴风暑气消，日头上梢头。",35],[5661,"月缺恐难圆，浮云蔽目前。",79],[5662,"兄弟死于非命。",79],[5663,"娶妾之年。"],[5664,"赌搏中年改，福禄自天来。",40],[5665,"借问一生身外事，遇龙之年是归期。"],[5666,"崎岖误行人，东西南北不差分。",41,42],[5667,"得授序班，何等光辉。",46],[5668,"一字切忌日白，当止则止。"],[5669,"年当耳顺，佐理国政。",61,62],[5670,"暖风正熏人，桃李正妍新。",13,14],[5671,"中馈人忘，心怀寂寞。",51],[5672,"花遇阳春逢泰运。",29,30],[5673,"行年不惑，大限已终。",40],[5674,"滞而不明，萎花蒙尘。",21,22],[5675,"寒滞侵入，流年欠顺。",49,50],[5676,"无祸无灾，明星灿灿。",27,28],[5677,"财帛难入手，从有便消磨。"],[5678,"安享祖荫，恩隆把总。"],[5679,"前妻生一子。"],[5680,"鸿雁一群展双翅，听听抢得一巢栖。"],[5681,"一朵萱花晓色寒，霜飞冷落玉栏杆。",22],[5682,"常因妻忧，快然安舒。",35,36],[5683,"真假八子，四子送老。"],[5684,"居安思危，思则有备。"],[5685,"富贵之有余，春风模样丽人居。",47,48],[5686,"静中心地泰，人事得安舒。",49,50],[5687,"风吹椿树折，三年泣血。",15],[5688,"其人之亡，定在四月。"],[5689,"名登金榜，老来之荣。",65],[5690,"明月上弦，其光渐圆。",11],[5691,"妻配牛命，可许谐老。",21],[5692,"兔走鸟飞，背衿换布衣。",35,36],[5693,"和气近人，雅至相得。"],[5694,"庚辰年科甲及第。"],[5695,"真假四子，三子送老。",47,48],[5696,"数该生子。"],[5697,"道尔兹基，不如乘时耕作。"],[5698,"父寿白头，孝子上山。",76],[5699,"丰衣足食，家中乐意。",55,56],[5700,"明月照闺中，家庭承露浓",45,46],[5701,"气象温和，量大度阔。"],[5702,"乐事从容，处处风光。",49,50],[5703,"来来往往，难期一遇。",55,56],[5704,"坦道无碍，驰驰可前。",15,16],[5705,"职居固山，一旗之主。"],[5706,"守定根基启后人，后人昌盛旧还新。"],[5707,"大小咸臻祸不侵。",61,62],[5708,"班马文章才独擅，实从理学渊源家。"],[5709,"事就且高歌，饮酒舞婆娑",51,52],[5710,"严亲早丧，人子不幸。"],[5711,"事事从容怀抱宽，金风一阵倏生寒",61,62],[5712,"异路功名，得授典史。"],[5713,"财积如山福自生，春风花满洛阳城。",49,50],[5714,"步履皆平坦，何必问风波。",35,36],[5715,"用心凿石才成玉，着意淘沙始见金。",29,30],[5716,"乐意称人怀，祯祥福自来。",63,64],[5717,"萱花时遇光，浓雨又来催。",59],[5718,"气宇宏深，神机伟俊。"],[5719,"无日不春风，胸中事不穷。",15],[5720,"锦绣喜重重，花开满园红。",57],[5721,"妻早子早名利迟。"],[5722,"椿萱并茂在堂前，他日终然父命坚。",79],[5723,"以监面选县丞。"],[5724,"盘桓而进，守以中正。",57,58],[5725,"财帛积有余，安然得安居。",55,56],[5726,"青宫沉马，致仕还乡。"],[5727,"数该生子。",54],[5728,"儿孙满目绕堂前，寿如松柏福南山。",79,80],[5729,"挺眉幸有人，人可差强人。",59,60],[5730,"火罗入限，流年有咎。",25,26],[5731,"流年灾不侵，内外得安居。",45,46],[5732,"白虎在门，灾毒不免。",13,14],[5733,"再娶生一子。"],[5734,"甲戌之年，名登金榜。"],[5735,"官至知府，不能高摧。"],[5736,"颠倒无常今有常，行人一夜过羊肠。",49,50],[5737,"笃志寒窗年又年，名利黄宫谢平安。"],[5738,"人如醉梦醒，方觉其外还。",71],[5739,"学识两全，犹如渊源。"],[5740,"云收雨过，日月光明。",21,22],[5741,"事得所欲，无为不足。",55,56],[5742,"当谐鸾风，如鱼得水。",23],[5743,"恶曜攻身，须防危险。",63],[5744,"真假五子，得以送老。"],[5745,"飞符夹死符，啾唧总不宜。",67],[5746,"时进时退，天道循环。",45],[5747,"喜事可以，逍遥悠悠。",13,14],[5748,"半夜潮生犬不惊，但得财聚又成名。",41,42],[5749,"该生一子。",64],[5750,"苦功用尽脑，泮水自生香。"],[5751,"福禄褪人，健旺精神。",79,80],[5752,"椿树已成风木恨，难免三年泣血悲。",13,14],[5753,"谋事有人成，得意马蹄轻。",47,48],[5754,"事事从容怀抱宽，金风送暑得清凉。",51,52],[5755,"东西路可通，行船遇顺风。",45,46],[5756,"浮云卷尽月重明，灾晦消除福自生。",23,24],[5757,"坚木皎结，舟倾中流。",38],[5758,"恶曜攻身，须防危险。",78],[5759,"浓霜连夜落，萱花被凋残。",30],[5760,"居官不如居家，治国不如治家。",63,64],[5761,"事得所欲，无所不足。",56],[5762,"硕人堪赋，裘马翩翩。",49,50],[5763,"父先母后，抱天之恨。"],[5764,"名登黄甲。",66],[5765,"祖业不靠，自创家园。"],[5766,"数定室入难共老，琵琶拨断听弦声。",53],[5767,"孤舍猿啼，令人恐惊。",59,60],[5768,"我生不辰，今年丧父。",17],[5769,"正妻从未得结子，娶得偏房许生儿。"],[5770,"百日竿头，如日中天。"],[5771,"马走高低路，反复多回轩。",27,28],[5772,"才得圆时又复亏，循环不一。",25,26],[5773,"犬吠皇皇，名进宫墙。"],[5774,"子规啼落楼台月，一枕鸳鸯梦不成。",56],[5775,"纸窗因迪破，名花恨雨催。",65,66],[5776,"不遇之遇，物饶生趣。",21,22],[5777,"参领一旗，干城之选。"],[5778,"娶得妻时即便离，命是刑克有何医。"],[5779,"前妻生二子。"],[5780,"福禄来时不用求，在前在后总悠悠。"],[5781,"花甲已凋尘世隔，不能回产见阳人。",60],[5782,"禅室庆长春，无奈多风雨。",23,24],[5783,"大小长健，春光无限。",72],[5784,"恩星照命，官职高升。",61,62],[5785,"春满洛阳城，高低锦绣丛。",39,40],[5786,"有得有失，事多反覆。",17,18],[5787,"空门无虑谷，不免是非来。",51,52],[5788,"山路崎岖，一步高来一步低。",25,26],[5789,"全不费精神，生涯得称心。",43,44],[5790,"言行不谨慎，是非而破财。",47,48],[5791,"配得金水之夫，方合此刻。"],[5792,"太平无事，悠悠顺意。",57,58],[5793,"时通时蹇，或进或退。",50,51],[5794,"所谋不合，图之何益。",35,36],[5795,"而今燕喜连绵至，柳絮栎花共一园。",17,18],[5796,"经谈松树下，得意月长明。",49,50],[5797,"有经营之才，无经营之运。",21,22],[5798,"风云一时新，桃花柳絮青。",29,30],[5799,"泽萼桃蕊初，春风草欲青。",1,2],[5800,"过步而周旋，春风备马鞭。",43,44],[5801,"幼年失怙，父母双亡。"],[5802,"破耗虽不幸，失中方人得。",59,60],[5803,"将军功成，耀祖扬宗。"],[5804,"幼年行乐，无日不悠。",21,22],[5805,"协领之职，数由前定。"],[5806,"严父早折，母又重婚。"],[5807,"日色融融，几度清风。",49,50],[5808,"借问一生身外事，遇猴年是归期。"],[5809,"玉折兰催，古今同根。",20],[5810,"一字切忌曰金，利在其中。"],[5811,"乡科中选。",16],[5812,"一盏余灯烟未消，金风依旧异香飘。",65],[5813,"妻配鼠命，方能白首飞。"],[5814,"莲花晓日色，自是不寻常。",11,12],[5815,"一片白云飞转过，蟹未行见晴明。",27,28],[5816,"忧疑自转，欢喜中来。",37,38],[5817,"前妻生三子。"],[5818,"年年事事通，内外喜欢福自隆。",53,54],[5819,"佩玉锵锵，童年厚福。",3,4],[5820,"一父三母，独继香灯。"],[5821,"牡丹吐秀，有女如男。"],[5822,"事得谐合，不劳心力便成功。",42],[5823,"富贵黄金比石崇，鼎新事业福兴隆。"],[5824,"乍合乍离，愧见鸳鸯鸟。",27,28],[5825,"意外调和，鼓舞婆娑。",77,78],[5826,"暖气洋洋溢，春风色融融。",55,56],[5827,"太岁有情，自然逢凶化吉。",67,68],[5828,"闺中又无求，快乐得悠悠。",55,56],[5829,"初授县丞之职。"],[5830,"十月怀胎，生我欠一。"],[5831,"外似风光内实愁，许多不足在心头。",33,34],[5832,"名登科甲。",67],[5833,"前妻生四子。"],[5834,"枯荣得失皆前定，何必尤怨不如人。",61,62],[5835,"名之不可求，求之彼阻悔无休。",55,56],[5836,"超升知县。"],[5837,"灼灼桃花天，丽色如锦绣。",15,16],[5838,"日正当午，光明浩大。",25,26],[5839,"数该生子。",53],[5840,"拙守有不足，韩信未遇时。",29],[5841,"镘钵花开，菩提叶茂。",42],[5842,"再娶生二子。"],[5843,"补任半吉实难凭。",25,26],[5844,"补授知府之职。"],[5845,"数到头来不自由，白云千岁空悠悠。",25],[5846,"得意防失意，辗转无凭据。",45,46],[5847,"数有五子，得以送老。"],[5848,"虑事而动，动而不藏。",21,22],[5849,"袜履悠悠，家门清吉。",45,46],[5850,"一生衣禄足，富厚享荣华。"],[5851,"一夕金风，烦暑顿除。",31],[5852,"乡试中式。",37],[5853,"人事和平，画堂彩色。",50],[5854,"月光初缺处，稍稍减夜明。",60],[5855,"光曜三台，高升禄位。",25,26],[5856,"此刻生人，堂前双亲并茂。"],[5857,"何时志忧疑，然后亨安舒。",25],[5858,"昔日根基今日消，根基非倚旧时依。"],[5859,"前妻生五子。"],[5860,"事无牵累，终日悠悠得意。",51,52],[5861,"心力交瘁，空叹奈何。"],[5862,"光风霁月，鼓舞婆娑。",45,46],[5863,"勾滕照命，牵害交加。",53,54],[5864,"出则安居，入则安舒。",69],[5865,"再娶生二子。"],[5866,"时雨遍效原，万物尽沾恩。",51,52],[5867,"发妻伴终身，福禄怡怡随。"],[5868,"其从之亡，定在六月。"],[5869,"正满九旬，大数已定。",90],[5870,"千里风光，万里悠悠。",39,40],[5871,"数该三子。",73],[5872,"宝撞重磨，依旧光辉。",30],[5873,"辉煌之害，衍业之荣。",31,32],[5874,"嫩竹独竿已透墙，会看指日拂云长。",11,12],[5875,"前夫生木子，后夫生金儿。"],[5876,"大往小来，君子未遇。",30],[5877,"儿孙满目，席前舞斑斓。",87],[5878,"红鸾相照。",20],[5879,"财帛虽有余，到老多劳苦。"],[5880,"中年戒淫，晚年安舒。"],[5881,"兄土年生方合此刻。"],[5882,"春花秋月，无不堪夸。",25],[5883,"机会不来，进三退四。",25,26],[5884,"再任州官。"],[5885,"运来有笑容，处处遇春风。",31,32],[5886,"破耗不能噤，皆因耗入运。",28],[5887,"人生不幸，泣血三年。",13],[5888,"百花解云，万卉争妍。",25,26],[5889,"丁未之年，进士及第。"],[5890,"财在场中去，耗星突然来。"],[5891,"醉鬼无时间。"],[5892,"吹花遍碎锦，拂起簇烟波。"],[5893,"财帛破耗，急急回头。",27,28],[5894,"流年顺利，春花笑日。"],[5895,"姐水年生方合此刻。"],[5896,"小水滩头阻去舟，徒然费力莫追求。",31],[5897,"鬼怪出相侵，凡事三思休可疑。"],[5898,"宽洪其性，温柔莫并。"],[5899,"云开日现，风静波平。",31,32],[5900,"仍然不守温公训，致令场中散货财。"],[5901,"若问寿元事，六旬加四是归期。",64],[5902,"此刻生人男可拈花，女可惹草。"],[5903,"更漏残报已开明，月落星疏早晓行。",27,28],[5904,"小富得从动处积，数注其人得黄金。"],[5905,"升选知州。"],[5906,"五六有破财，运去耗星徘。",30],[5907,"无心福自来，春风有意好花开。",16],[5908,"辛丑之年，名登黄甲。"],[5909,"清波有舟，而登彼岸。",11,12],[5910,"异路功名，再授主簿。"],[5911,"心间得安舒，欣然福自如。",65,66],[5912,"居安思危，思则有备。",59,60],[5913,"燕子分飞，春深桃李。",30],[5914,"虚名虚利百无成，浪迹萍踪已半生。"],[5915,"官至州判，不能高擢。"],[5916,"祸患而自取，举尔有虚惊。",35,36],[5917,"南楼惟报三更月，半夜子规尚且啼。",17],[5918,"洛阳三月景，楼台柳阴丛。",49,50],[5919,"徒弟五人，四人送老。"],[5920,"物色更新，锦乡上林。",41,42],[5921,"财去财来不可悲。",31],[5922,"再任把总。",37],[5923,"耗星入限，不赌何散。",37],[5924,"整顿离妆，渺渺茫茫入故乡。",47],[5925,"否极秦来，造化还转。",37,38],[5926,"再娶生四子。"],[5927,"轻暖轻寒，紫色无边。",45,46],[5928,"乡科中选。",48],[5929,"事体多端，心中未宽。",57,58],[5930,"心中带有疑，问神又占卜"],[5931,"裘马翩翩，往来金玉。",45,46],[5932,"破星入限，流年大破财。",31],[5933,"禄勋星现特，封一品之举。",51,52],[5934,"小人谋财，君子谋道。",32],[5935,"碧天云静，月转琉璃。",50],[5936,"花开将尽香犹在，菊残犹有傲霜枝。",91,92],[5937,"东西不辨，空徒驱逐。",31,32],[5938,"命带指皆杀，恩泽反为伊。"],[5939,"朝谋夕算，明日东西",33,34],[5940,"寿止命尽。",47],[5941,"举事斟酌，大有所获。",41,42],[5942,"小人谋财，君子谋道。",33],[5943,"前后有阻，居止无所。",59,60],[5944,"风物如桦柏，岁寒节更坚。",95,96],[5945,"钱财如粪土，人意值千金。",33],[5946,"无益之言休著口，不当已事莫当头。",55,56],[5947,"花发满林春日长，东风料峭晚凝香",37],[5948,"不怕尘埃何怕寒，不愁风雨不愁霜。",42],[5949,"红日东升，自有光明。",13,14],[5950,"人生一世，草木一春。",60],[5951,"恩父不见，泣血三年。",16],[5952,"财帛难免散耗。",34],[5953,"杨柳花飞已暮春，上下楼台物色新。",69,70],[5954,"鱼下碧潭随浪舞，马滕青嶂插寒飞",45,46],[5955,"财滚滚兮财自旺，喜匆匆也福自隆",55,56],[5956,"杨柳含烟堤上绿。",49,50],[5957,"因贪反成害，财帛席上耗。",34],[5958,"辛丑之年，名登黄甲。"],[5959,"人逢喜事精神爽，花遇春风瑞气香",57,58],[5960,"是年别故偶，将红来比素。"],[5961,"财去财来，天道回环。",35],[5962,"月明无暇玉，光辉日渐生。",9],[5963,"履道坦坦，君子贞洁。",42],[5964,"一尘不染，四大本空。",13,14],[5965,"菊吐秋天千万朵，梅一腊月几千枝",47,48],[5966,"得选仓宫，前数已定。"],[5967,"不费工夫事有成，福来相凑喜相逢。",51,52],[5968,"元亨利贞，百事吐吉。",29,30],[5969,"招妻在本年。"],[5970,"入场妄想，反耗其财。",35],[5971,"官至同知，不能高擢。",51,52],[5972,"破星入限，耗财损人。",36],[5973,"赌星入限，频频破财。",38],[5974,"当有五母之称。"],[5975,"春花带雨，流年不美。",21,22],[5976,"赌星入限，破财伤人。",36],[5977,"可惜当年事无穷，今朝低首向西风。"],[5978,"耗星入限，破财之源。",38],[5979,"安常处顺，得意之时。",28],[5980,"乙丑之年，名登黄甲。"],[5981,"不利不利，破耗破耗。",30],[5982,"一掷千金浑身胆，家无四壁不知贫。",35,36],[5983,"老当益壮，宁知白首之心。",77,78],[5984,"龙嘘气直上，五色云呈祥。",52],[5985,"事起从心头，内外得意浓。",63,64],[5986,"当年凶星照命，赌钱不利终日愁。",27],[5987,"课雨占晴，天意顺人。",55,56],[5988,"欲左欲右，光明度日。",23,24],[5989,"黄莺在谷，载好佳音。",35,36],[5990,"是非无挂念，逍遥出自然。",15,16],[5991,"淑贤内助得安康，衣禄无忧福寿长。"],[5992,"东西南北，无往不利。",33,34],[5993,"三阳回万象，幽谷自生春。",12],[5994,"数有不幸，天死非命。"],[5995,"破财不利，此年有咎。",39],[5996,"限中一似雨中雷，难成事业败如云。"],[5997,"今日晴时明日阴，情伤颠倒是迷途。",39],[5998,"官至吏部尚书，不能拜相。"],[5999,"卜君阳年，终于九六。",54],[6000,"一字切忌曰青，用不得。"]]}
