{"volume":"丑集","verses":[[2001,"斯年有小利，未可大营谋。"],[2002,"好物不牢坚困难，用久邵子曰尽数。",53,54],[2003,"有余不足，守旧为高。"],[2004,"人总一名，各出一姓。"],[2005,"若能守中正，仅可免灾忧。",45,46],[2006,"口舌哓哓，不听为高。",27,28],[2007,"戒之有德，安分守命。",53,54],[2008,"衣食不关心，克亨其家人。",37,38],[2009,"人事有不足，日月有盈亏。",25,26],[2010,"好事逢人行，吉利又相从。",55,56],[2011,"母腹结双子，我生并蒂莲。"],[2012,"先日贺麟祥，谁知一旦亡。"],[2013,"子入翰林县处正职），恩承诰命。",58],[2014,"其年萱花落，难免泣血悲。",14],[2015,"文章得意，名列榜首。",18],[2016,"添新纵喜，生甲可悲。"],[2017,"泮水之游，芹香可美。",17],[2018,"先娶未有子，再娶降麟儿。",17],[2019,"堂萱草萎，孝所何辞。",54],[2020,"一得一失，未可得意。"],[2021,"如临深渊，如履薄冰。",51,52],[2022,"数中不当招祖业，纵然富贵也消磨。"],[2023,"春色东风，料峭生寒。",45,46],[2024,"雨阻前途未可行，晓开霁色放光明。",43,44],[2025,"石上有苔，君宜谨慎。",21,22],[2026,"莫求难滞，运未通时。",29,30],[2027,"锦色瑞气，洋溢管弦。",41,42],[2028,"子息虽有益，少损多数犯天刑。"],[2029,"田园君置虽然有，干盅如君有九人。"],[2030,"身赴琼林，名登黄甲。",20],[2031,"后母之相依，稍释泣血悲。"],[2032,"啾啾而唧唧，四壁寒恐飞。",55,56],[2033,"家中四壁不知贫，各自分飞宿荆林。"],[2034,"鹊噪南楼，频频报喜。",23,24],[2035,"逆水行舟，前后徘徊。",21,22],[2036,"驱饥雁而猎兔，有彼无我。",29,30],[2037,"月老传书，妻配三旬。"],[2038,"人心如此如此，天理未然未然。",33,34],[2039,"五子合土之纳音，六子合金水之年。"],[2040,"红色肃落，春色日丽。",57,58],[2041,"守旧吉，妄动凶。",21,22],[2042,"思鲋得鲂，未知所愿。",23],[2043,"进士及第。",26],[2044,"春江水涨舟，虽重而顺流。",51],[2045,"妻配二旬，余配未迟。"],[2046,"父作子述，家声大振。"],[2047,"金榜成名。",20],[2048,"天地有不足，人亦如之。",60],[2049,"十暴十寒，月光渐少。",77,78],[2050,"少年无灾晦，平安之福寿。",17,18],[2051,"今时还是旧时人，人事如今又一新。",52],[2052,"父母生于水年，终于土年方合。"],[2053,"行止非人所能，造物还须有主。",37,38],[2054,"连年不如意，老来享平安。",59,60],[2055,"喜鹊营巢久，鸠居却有迁。",43,44],[2056,"平安二字，不必问行藏。",17],[2057,"享平安之福，克享其成。",33,34],[2058,"夫臂之痛，唯有伤疾。"],[2059,"常忆故园惟自叹，将何鱼雁寄流离。",45],[2060,"福自适人，平安之吉。",64],[2061,"烟霞晓未收，江头未可试鱼钩。",33,34],[2062,"兄弟三人，俱当荣贵。"],[2063,"恍恍惚惚，不但人嗔且有鬼。",29,30],[2064,"云行雨施，品物流行。",45,46],[2065,"先甲三日幸乃吉，后甲三日幸乃昌。",37,38],[2066,"曰畅曰焕，庶草蕃鞠。",25,26],[2067,"田翁乃积丰稔岁，不枉春犁带雨耕。",49,50],[2068,"父母生于水年，终于水年方合。"],[2069,"兄弟四人，俱当荣耀。"],[2070,"小宋应熊，二子当先。",39,40],[2071,"饥其体腹，劳其筋骨。",29,30],[2072,"叠叠重重刑尔室，旬迟配得和谐。"],[2073,"流年涂朱雀，谨防是非来。"],[2074,"愿言孔孟师，青云有运期。"],[2075,"纳采得成名，马足追风得意呜。",65],[2076,"乡科及第。"],[2077,"妻命属水生，木年娶妻方合。"],[2078,"皇都之市，金紫如棉。",45,46],[2079,"久居芝兰室，而不知其香。"],[2080,"蜃气楼台，空中望阁自光浑。",65,66],[2081,"海阔天空，往来自如。"],[2082,"生子之年。",31],[2083,"听流泉石壁，下水流如怒。",57,58],[2084,"官至知县，不为斗米而折腰。"],[2085,"命照文昌，大魁天下。"],[2086,"守口如瓶嘴，无意之中舌自生。",37,38],[2087,"蛟然大旱，沛然雨下。",43,44],[2088,"运至时行，吞君获庆。",30,31],[2089,"生有善缘，胎内食素。"],[2090,"长河有意，一息千里。",33,34],[2091,"雨问晴天，意时行乐。",73,74],[2092,"母先故于土年方合此刻。"],[2093,"公正有余为，一方之表率。"],[2094,"好成人之事，偏惹事生非。"],[2095,"人夜秋志声，愁人离绪恨。",37,38],[2096,"命带羊刃，数注五旬配妻。",50],[2097,"半步颠连未有成，南园种柳北园开。"],[2098,"房考之年。",57,58],[2099,"父母生于木年终于金年。"],[2100,"飞雁一只，历过南楼。"],[2101,"啾唧哭碌碌，疾病挠相促。",51],[2102,"龙德星高，灾星并磨。",25,26],[2103,"朝三暮四急，忙忙度流年。",48],[2104,"寒窗相对，正是万难时。",32],[2105,"银汉相隔，闰房少乐。"],[2106,"闭门自守可无虞。",28],[2107,"不幸良人先叶世，空余银烛伴黄昏。",54],[2108,"数注郎官天上客，风吹金带麝阑香。"],[2109,"其人数尽，定在八月。"],[2110,"寒犬明月，自费精神。",22],[2111,"白虎当头有一惊，回头及早把门关。",65,66],[2112,"无灾无害，老景安闲。",63,64],[2113,"心中有事，难言逢人强为欢。",49,50],[2114,"行到水湾处，摇橹舟子呼。",61],[2115,"闻不闻见不见，暗中须防人放箭。",33,34],[2116,"其人之亡，定在八月。"],[2117,"凤失其凰，难于呈祥。",61,62],[2118,"父金命先死于火年，母木命后死于金年。"],[2119,"诗书纵习步青云，命无科甲两榜荣。"],[2120,"纵有栋渠，未得工师之选。",19,20],[2121,"父母同日生，生也姻缘死也缘。"],[2122,"名登榜首。",27],[2123,"数注辟雍成名早，椿萱并茂享荣花。"],[2124,"反笑伏吟，骨肉相刑。",17,18],[2125,"丧门相照，哭泣之哀。",62],[2126,"母先故于水年，父生于金年方合。"],[2127,"母故之年，自叹何恃。",52],[2128,"内助不相和，狮吼是非多。"],[2129,"取此东风候，扁舟渡万山。",61],[2130,"大生两口，任君详之。",63,64],[2131,"人不遂黄金，黄金转遂人。",33,34],[2132,"相照有丧门，衣裳白一番。",31],[2133,"并蒂双莲出，奇哉两朵开。",1],[2134,"玉衣锦裳，千仓万箱。"],[2135,"三场未幸登科甲，一贡承恩可牧民。"],[2136,"图得东来缺了西，还是君家运未济。",22],[2137,"注定步青云，金年中举人。"],[2138,"终日乾乾，若厉无咎。",42],[2139,"双亲俱去世，母先辞别父难留。"],[2140,"再任黄堂，数皆前定。"],[2141,"补授照磨，数由前定。"],[2142,"穷通得失皆前定，何必怨天又尤人。",45,46],[2143,"木年母先终，方合此刻。"],[2144,"此时生人，父母不睦。"],[2145,"官至钦命，知县前定。"],[2146,"窥见室家之好，牢拴穴隙之情。"],[2147,"小车无辙，其何以行。",42],[2148,"子产三丁，乐奏几般音。"],[2149,"禄马荣花，得阶八座之荣。",61],[2150,"欣欣向荣，春光明媚。",45,46],[2151,"己酉之年，武魁及第。"],[2152,"人事无求，安然自优。",53,54],[2153,"恩难图易，四方有济。"],[2154,"其人之亡，定在五月。"],[2155,"太岁当头，灾星不减病相缠。",11,12],[2156,"思病不可测，不但人嗔亦有鬼。",31,32],[2157,"兄弟四人，数有三贵。"],[2158,"木年火年，生子无损。"],[2159,"陟岵兴嗟，趋庭之训。",44],[2160,"福德相扶，官职高位。",53,54],[2161,"江山新雨遍，人在锦丝中。"],[2162,"人春犹是无多日，寒气侵入未及回。",29,30],[2163,"母故于木年，父尚春将茂。"],[2164,"滂沱风紧莫行舟，跃马檀溪到豫州。",40],[2165,"禀生结局。"],[2166,"兄弟七人，秦楚不同盟。"],[2167,"破巢之祸。",25],[2168,"奔走东西未有定，劳劳碌碌不安康。",47,48],[2169,"乡科及第。",53],[2170,"鸿飞冥冥，忙了弋人。",33],[2171,"不利不利，时运未至。",11],[2172,"金年母先终方合此刻。"],[2173,"贤淑大度，庭训所然。"],[2174,"初任百总之职。"],[2175,"经之营之，忙度岁月。",53,54],[2176,"丙戌之年，乡科及第。"],[2177,"不正而正，桃花开过艳阳明。"],[2178,"此数生来格局奇，明经出仕耀门庭。"],[2179,"耆硕衙望，龙锡宾筵。"],[2180,"虎落平源，壮志难舒。"],[2181,"积得黄金多少，太阳一照渐消磨。",21,22],[2182,"嫩蕊霜欺，倏然变色。",15],[2183,"兄弟七人，乐奏几般音。"],[2184,"惟盼东君归有期，落花流水两相催。",34],[2185,"掘井渠泉，不解其渴。",34],[2186,"多晦多忧，常蹙眉头。",49,50],[2187,"中运恢复，正当自立。"],[2188,"厌见江南未曾收，朦胧一渡过年速。",57,58],[2189,"春深桃节，到处成荫。",23,24],[2190,"兄弟九人，数有一贵。"],[2191,"猛如烈火，偏不让强。"],[2192,"细雨薰风，唯解烦气。",53,54],[2193,"一点丹青仿得真，能垂不配付名人。"],[2194,"有士子之职，无甲第之荣。"],[2195,"补授博士之职。"],[2196,"千里马未逢伯乐，双龙剑难遇张华。",32,33],[2197,"热晦天气，微雨度阴云。",55,56],[2198,"旭日升林，同见太阳之象。",57,58],[2199,"钦命典试。",57],[2200,"宝玉发祥光，良马伯乐逢。",13,14],[2201,"凿井耕田，先民乐趣。"],[2202,"愁之复忧，牧羊山坡。",51],[2203,"帝里风光，三月新春。",7,8],[2204,"脱却机关，又当蹉跎。",49],[2205,"齿德俱尊，宾筵藉重。"],[2206,"躁急招悔，不思省悟。"],[2207,"谢却病来愁水缠，几回不敢向人言。",60],[2208,"南山爽气欲投衿，怪鬼持戈正逐人。",33,34],[2209,"先男后女，命中注定。"],[2210,"孤鸿带月影披离，南北东西未有依。",11],[2211,"活计无恁，山高水深。",57,58],[2212,"骨月凋残人事难，泪痕洒竹染成斑。",20],[2213,"童年一二岁，春光满眼浓。",1,2],[2214,"春光满面，一腔啾唧自家知。",34],[2215,"奎星初照，一举拨前茅。",31],[2216,"惆怅多逆风，操辑费着力。",60],[2217,"星宫见孛，损多益少结一枝。"],[2218,"燕子双飞绕画堂，春色几度断肝肠。",41],[2219,"马陷沙中，跃之不起。",36],[2220,"次第春风上苑红。",11,12],[2221,"行人不知，马失其足。",39,40],[2222,"秋分交错，水充花落。",51],[2223,"吟就月中诗，风卷见碧空。",37,38],[2224,"天时人事喜相逢，不成之得也成功。",63,64],[2225,"其人寿绝，定在七月。"],[2226,"一年又一年，颠倒不如前。",42],[2227,"分有嫡母，生母继母。"],[2228,"挣得家业无恙，身遭心多磨障。",35,36],[2229,"有妻若无妻，其实靠首妻。"],[2230,"池塘拳寸湿，春水漾金麟。",12],[2231,"求之十九，成之十一。",39,40],[2232,"浮云卷尺碧天空，春风融和瑞气祥。",37,38],[2233,"颠颠沛沛，怀儿撞碎。",42],[2234,"好花将开，风雨又来。",27,28],[2235,"东西少有忧，云照屋檐头。",22],[2236,"室家相宜，夫妻乐趣。"],[2237,"命犯呻吟杀，当有身不遂。"],[2238,"烦恼无忧，谋来可忧。",24],[2239,"恍恍惚惚，不但人嗔且有鬼。",14],[2240,"身姿妩娜，临风之柳。"],[2241,"前后有阻，并无安土。",48],[2242,"牛羊恐破财，未免是非多。",67,68],[2243,"爵与齿俱高，有德为达尊。",69,70],[2244,"生姿气禀钟灵出，他日龙门必占先。"],[2245,"是个朝阳补衲僧，高山流水出红尘。"],[2246,"舟车往来，关津有阻。",37],[2247,"金年水年，父母早去方合此刻。"],[2248,"血盆星临，产死其妻。"],[2249,"夫妻本是同林鸟，不幸雄者意先飞。",55],[2250,"壮年劳劳碌碌，成家无安度闲日。",20],[2251,"人事纠缠，费尽工夫也破钱。",25],[2252,"兄弟三人，数有二贵。"],[2253,"月上乱云收，青光照彩楼。",23,24],[2254,"福禄频加，享受荣华。",73,74],[2255,"七七之年当断弦。",49],[2256,"满面春风人道好，多少不足自家知。",23,24],[2257,"凶神遇解神，灾祸不相侵。",44],[2258,"道路从征飞暗尘，隔江风雨起秋新。",51],[2259,"圣门弟子，个个飞腾。"],[2260,"重山之处问黄金，逐逐泥途有一惊。",41],[2261,"逐野兽以前，驱失足以陷。",40],[2262,"快乐秋鸟，高飞见忧。",16],[2263,"黄昏天气暗，月色渐光明。",16],[2264,"天赐祯祥纳庆多，花前月下听高歌。",55,56],[2265,"岸花红滴露，秋树绿含烟。",57],[2266,"暗路逢人，南北莫辨。",26],[2267,"房考之年。",59,60],[2268,"事不称心，枉费精神。",36],[2269,"花开车枝满园红，不料根皮一树浓。",48],[2270,"命不招祖，自创家园。"],[2271,"暗道流萤.一点余光。",45,46],[2272,"鹿呜照耀，天以善人。",23,24],[2273,"劝君相助本阴人，迷恋阴人必丧身。"],[2274,"数有四子，三子送老。"],[2275,"数内往来格局高，官扬福显姓名香。"],[2276,"有酒且高歌，人生有几何。",68],[2277,"荷花出水，亭亭玉立。",16,17],[2278,"一点浮云掩中天，太阳一现渐渐明。",44],[2279,"晦气不可争，争必有人侵。",55,56],[2280,"半夜浮云掩月，五更云散复明。",23],[2281,"蝉在柳梢叫，若笑而厌倦。",54],[2282,"人闲心不闲，有事来相关。",33,34],[2283,"春风送暖，除旧迎新。"],[2284,"衣食有余，少当带疾。"],[2285,"绿荫之下有婆娑，羊触藩篱奈若何。",39,40],[2286,"谋望不何，镜花空开。",33],[2287,"滚滚财源如水，洋洋家计如春。"],[2288,"安享之福，无日不足。"],[2289,"灾晦相侵，流年凶星。",19,20],[2290,"月宫板丹桂，何乐如仙阁。",35,36],[2291,"苍松翠柏耐岁寒。",82],[2292,"多福多寿，前世所修。"],[2293,"徒弟三人，一人送老。"],[2294,"掘泥砌石，寒暑难堪。",45,46],[2295,"板桥滑湿戒人行，前提免被水没身。",55,56],[2296,"室中安乐，天意从人。",53,54],[2297,"数中十子，得以送老。"],[2298,"南山虎啸长风，得取休祥之庆。",47,48],[2299,"马足迟迟，幸被颠晦。",35,36],[2300,"生母当属虎。"],[2301,"身闲无事，安休之庆。",73,74],[2302,"人有刑伤，愁锁眉头泪几行。",51],[2303,"年逢百外有二春，忧然无事往西行。",102],[2304,"亲把兵权，威镇三军。"],[2305,"山风遇虎豹，朝暮当谨慎。",19,20],[2306,"十几年庚滞，小试终不利。"],[2307,"一天星斗甚光明，东西云生夜不分。",41],[2308,"紫微聚三台，三场捷报来。",55],[2309,"兄弟七人，数有二贵。"],[2310,"数有十人，送老八人。"],[2311,"汲水烹茶，清闲之福。",81],[2312,"奇木游天下，未遇知己人。"],[2313,"万斛之舟起便风，飘然飞渡过江东。",43,44],[2314,"数该生子。",33],[2315,"斗柄已移数己改，喜气频频送过来。",51],[2316,"寻个优优致，咏笑傲乾坤。",59,60],[2317,"行断江头渺茫茫，行人欲渡意彷徨。",49,50],[2318,"征帆顺水，瞬息千里。",31],[2319,"长歌春酒，乐以忘忧。",91],[2320,"兄弟十一人，中断惜离群。"],[2321,"萱花椿树萎何时，他日父先母后逝。"],[2322,"祸患不可测，不但人嗔且有鬼",53,54],[2323,"终身飘泊未有依，明月飞来未有栖。"],[2324,"大作怪主，人当有灾。",57,58],[2325,"黄金久掩在泥沙，有日开藏世共夸"],[2326,"数该生子，谁道蚌珠老。",75],[2327,"明月中末，文人之盛。",39,40],[2328,"据于蒺藜，且招耻辱。",27],[2329,"四壁有灾，寒虫飞出。",79,80],[2330,"人无姊妹，苦不堪言。"],[2331,"陇头消息报春来，点缀梅花次第开。",15,16],[2332,"持家有法，必专大权。"],[2333,"得意之中还得意，财源之上发财源。"],[2334,"兄弟十一人，同父不同母。"],[2335,"半夜飞霜彻夜寒，园中百草必有殃。",54],[2336,"衣锦藏珠，家门欢趣。",66],[2337,"名登黄甲。"],[2338,"渐沥秋声，悲衰何堪。",69],[2339,"姊妹六人，数有不爽。"],[2340,"前程亨通安泰，朝阳正上三竿。"],[2341,"兄弟二人，数有一贵。"],[2342,"流年坎坷，多少蹉跎。",52],[2343,"洞庭月色近中秋，好暗佳人可邀游。",45,46],[2344,"几番风雨好，依旧花鲜明。",37,38],[2345,"夏天风嘉鼓吹，或时笑或时哭。"],[2346,"囹圄之中有忧疑，金马徒劳有所思。",54],[2347,"代婿经营，贤能莫及。"],[2348,"真假六人，逆老三枝。"],[2349,"时有指南车，攸往无不利。",50],[2350,"壮年劳劳碌碌，老年成家无安闲。",80],[2351,"斯年无小利，不若且消停。",33,34],[2352,"骏马交驰，不能安逸。",33,34],[2353,"一江风雨暗，平地起波涛。",31,32],[2354,"奇谋奇策千般遂，于橐万贯金。"],[2355,"观池得水时，则龙鱼变化。"],[2356,"贵人指引，前程利就名成。"],[2357,"炎气薰人，凉风自至。",43,44],[2358,"优闲皆无事，不必羡神仙。",45,46],[2359,"桂兰香里自含胎。",87,88],[2360,"花边宝马跃金鞍，剪剪轻风阵阵寒。",23,24],[2361,"流星殒落，应乎其凶。",38],[2362,"宝鼎起青烟，线线行行薰翠袖。",26],[2363,"妻生木火之子，妾生水火之儿。"],[2364,"命多印绶，两外翁姑。"],[2365,"蹑足高楼，更上一层。",53,54],[2366,"谋事无成，马头烟雨。",37,38],[2367,"井中水涸，汲者兴嗟。",57],[2368,"灾晦陡至不自知，幽魂早已入黄泉。",36],[2369,"梧落金井运，秋风起日愁。",63],[2370,"姊妹四人，二人早亡。"],[2371,"兄弟三人，数有二贵。"],[2372,"圆月到五更生魄，其光渐减成昏昏。",54],[2373,"萱草有刑，孝服相侵。",57],[2374,"山高石倾，行人有惊。",60],[2375,"名销利关最缚人，长亭云暗掩风尘。",45,46],[2376,"车马并集，门庭热闹。",36],[2377,"其手拘挛，前生果报。"],[2378,"驾鹤乘云去，飘然竟不归。",76],[2379,"此刻读诗书，土年应入学。",7],[2380,"中夜起舞，乐也何如。",69,70],[2381,"劫杀凶人，家室有害。",55,56],[2382,"寒窗苦读书，终生为世用。",16],[2383,"白玉藏废土，琢玉放光豪。"],[2384,"花落鸟啼，指深惆怅。"],[2385,"初配不终老，半道而别离。",55,56],[2386,"病余痨疾症，因花露沾衣。"],[2387,"无忧季子运不前，欢针遂意后十年。"],[2388,"作事不成功，奇谋反成拙。",38,39],[2389,"将星天定，三军司令。"],[2390,"苍天赐我一青无，寂寞寒窗又十年。"],[2391,"玉笛之声，反成落梅之曲。",40],[2392,"妻配鸡命，可免其刑。"],[2393,"休嗟行路难，虎笑入渡关。",15,16],[2394,"安常处顺，猿啼余闷。",35,36],[2395,"夫命属水，配夫年属木。"],[2396,"一领青衿，得却防失。"],[2397,"一霄风雨，梧桐凋谢。",69],[2398,"作是反成非，奇谋反成拙。",17,18],[2399,"天罗地网，昏昏暗中有灾厄。",60],[2400,"人事变错，虎头蛇尾。",23,24],[2401,"迷离烟雨生滩头，今日晴明同上钩。",51],[2402,"病符相照，灾意外来。",17,18],[2403,"收成一子属木，凡遇金水终当去。"],[2404,"马乘其辔，车行千里。",31,32],[2405,"万顷波涛驾巨舟，吞天沐日过江头。",53,54],[2406,"疏灯夜雨，一隙之光。",45],[2407,"执鞭之士，我独为之。",38],[2408,"吹落黄花弄笛声，愁人听后思难禁。",1],[2409,"暖日薰人，门前色新。",37],[2410,"自知力少，勿谓任重。",21],[2411,"故有相与日，慷慨自无究。",63],[2412,"寒虫苦唧唧，助人之叹息。",74],[2413,"洋洋喜庆如春至，滚滚财源似水流。"],[2414,"兄弟八人，乐奏几般音。"],[2415,"衡门之下可栖迟，今日徒劳狂费思。",53,54],[2416,"猛虎怒威，人见有忌。",21],[2417,"祖业守成兴复发，财源有分去还来。"],[2418,"始生木命，方合此刻。"],[2419,"景物阳和，胜赏甚多。",15,16],[2420,"此年名利双收。",50,51],[2421,"得近帝王之身。",52,53],[2422,"名登黄甲。",66,67],[2423,"花逢春景千般艳，月到中秋分外明。"],[2424,"离乡别井，创立成家。",19,20],[2425,"根基似浮萍，水面随风转。"],[2426,"前妻金水之子，后妻土木之儿。",27,28],[2427,"演武及第。"],[2428,"一轮明月高，阴气渐消磨。",69,70],[2429,"无忧运未通，转行遇顺风。",65,66],[2430,"和气乖离，因小致大。",25],[2431,"问名未成，问利有益。"],[2432,"此刻注定读书人，得时便可上青云。",27,28],[2433,"际遇得周全，牛背横吹过得村"],[2434,"酉戌二科，武举联捷。"],[2435,"暗里飞箭来，须防有个伤。",29,30],[2436,"五方鬼现，兔走鸟飞。",64],[2437,"风飘万点正愁人，又见春来春色新。",25,26],[2438,"入山樵童喜，得地又得时。",47,48],[2439,"晚景安康，可乐余年。",61],[2440,"月有圆缺，人有离别。",17,18],[2441,"反复蹉跎，即是宰仙可柰何。",39],[2442,"家室吉庆，大小咸宜。",65,66],[2443,"前为社稷之臣，今为林下之客。",73,74],[2444,"一线如丝，结乱如麻。",57,58],[2445,"欲上高楼未有梯，不能举走莫能扶"],[2446,"此刻注定贵人基，木年水年夫得贵。"],[2447,"其年有刑伤，骨肉伤凄凉。",64],[2448,"灾之未已，伤之有失。",55,56],[2449,"就之出自无穷，寻之见而可喜。",47],[2450,"山前山后皆明月，江北江南总是春。",26],[2451,"扁舟江风挂帆来，千里程途顷刻回。",47],[2452,"入泮之喜，少年得意。",12],[2453,"此刻定明经，金年初步木年成。"],[2454,"禄马往来，常多庆吉。",11,12],[2455,"凭高远望，东指西顾。",66],[2456,"一颗明珠夜有光，主人会袭夜行藏。",85,86],[2457,"兄弟三人，数有三贵。"],[2458,"归来之外，非亲非戚。"],[2459,"鸟困于樊笼，神喜而不旺。",21,22],[2460,"天台迷路，渔郎问津。",41],[2461,"一天风雨任黄昏。"],[2462,"枕边之人曾见忧，半年床足半年头。",20],[2463,"幼年失母，继母相依。"],[2464,"应尽崎岖道路遥，登山涉水恨无桥。",65,66],[2465,"乡科及第。",39],[2466,"好个春光，偏恨妒风嫉雨。",47,48],[2467,"事欲速反，坚守乃得。",27,28],[2468,"晴天忽有暗云生，蓦地雷鸣恐一惊。",43,44],[2469,"冤仇相报，贵人解救。",51],[2470,"可恨灾星不可逃，阴阳愆度祸相招。",39,40],[2471,"数有五子，一子送终。"],[2472,"其人之亡，定在八月。"],[2473,"两妻已死讵料，三妻上午而亡。"],[2474,"杏花生艳，雨露初晴。",42,43],[2475,"堪嗟姊妹缘分浅，数中纵有也分离。"],[2476,"万事成空。",76],[2477,"丈夫得志日，方逐男志时。",37,38],[2478,"中流多风雨，操辑费着力。",47,48],[2479,"再养浩然之气，且加克已之功。",23,24],[2480,"招风惹柳，曾作出墙红杏。"],[2481,"线财人手难为得，破耗忧愁不可言。"],[2482,"数有十二男，送老二子。"],[2483,"夫妻本是同林鸟，不幸雄者竟先飞。",55,56],[2484,"山下过时逢猛虎，不伤人身也惊人。",53,54],[2485,"花枝凋零怕东风，秋雨吹残满地中。",27,28],[2486,"生木火年，终于金水年方合。"],[2487,"中年生子，莫嫌迟。",40],[2488,"东蒿黄菊，桂绽秋香。",63,64],[2489,"有酒盈樽，及时行乐。",67,68],[2490,"暗中行路迷，途有流萤引。",43,44],[2491,"父母同年生同年死。"],[2492,"兄弟三人，数注前定。"],[2493,"灾晦缠身，眉头愁蹙未开颜。",42],[2494,"草木零落月秋，一阳初动水痕收。",59,60],[2495,"老来得子，双喜临门。"],[2496,"深山迷路，樵童指引东西。",67,68],[2497,"好运催人，吉利相从。",39,40],[2498,"几点疏星落，南楼见太阳。",45,46],[2499,"再升巡府。"],[2500,"朝三暮四，苦心度日。",46],[2501,"数该生子。",38],[2502,"行人得中，邑人之咎。",61,62],[2503,"为人丰姿俊雅气，轩昂行藏谨慎事。"],[2504,"胸藏绵绣腹蕴珠，文进黄贾学周程。"],[2505,"坐于暗定，幸有流萤之光。",37,38],[2506,"江上早潮，因风相送。",42],[2507,"此刻受二妻，土命金年娶。"],[2508,"高飞促征雁，千里带霜回。",65],[2509,"迟日桃源春正浓，莺啼燕语媚流香。",30],[2510,"闺中调雅乐，彻幽人之致。",20],[2511,"春风若到，春色依旧满皇州。",23,24],[2512,"读尽诗书命不宜，宛然拙守托相知。",48],[2513,"前妻生木水之子，后妻生金火之儿。"],[2514,"相安无事日，屋漏鬼欺人。",41],[2515,"良霄有酒无人赏，空余红烛伴黄昏。"],[2516,"凛冽虎帐似春风，一片浮云在碧空。",35,36],[2517,"有商贾之望，无功名之分。"],[2518,"一庭红紫斗芳菲，昨夜西风吹折枝。",29,30],[2519,"有梯有板，高楼直上不难。"],[2520,"靖固四方，无疆场之患。",23,24],[2521,"进退有所制，若惊又若恐。",30],[2522,"三番四覆自家知，根长东来叶落西。"],[2523,"将星照命，武举可必。",32],[2524,"一胎二子，数中不爽。"],[2525,"居安思危，思则有备。"],[2526,"苍蝇有翅翼，风起飞腾不远来。",27],[2527,"岁聿已云暮，惟愿一阳生。",79,80],[2528,"数中生七子，二子送老。",89,90],[2529,"心之劳竭，做事不成。"],[2530,"正妻木年已克，次妻火年娶方合。"],[2531,"劳劳为苦读，学而时习之。",16,17],[2532,"太岁当头，不测自来。",38],[2533,"寂寞相如病茂陵，卢医再出便回生。",68],[2534,"跨著蹇驴，踯躅道途。",24],[2535,"栖移三转，一枝可栖。",45,46],[2536,"落日微风动，帘开引燕来。",39,40],[2537,"横槊赋诗，虽武而娴雅儒术"],[2538,"双双燕侣两分飞，不想夫君命不归。",54],[2539,"星斗乱鸦啼，处处见朦胧。",59,60],[2540,"鱼跃于渊。"],[2541,"柳外莺嘀闹落花，兰房寂寞日西斜",49],[2542,"天性豁达良知敏，气质清纯礼义通"],[2543,"和风雨日时时乐，进喜添财事事通。"],[2544,"武曲当头，弓马入泮。",15,16],[2545,"厨下火起，灾及室人。",51],[2546,"一掷千金浑身胆，家徒四壁不知贫。",31,32],[2547,"云开雨霁，万里光华。",66],[2548,"进甚难退甚易，乾乾而夕惕。",53,54],[2549,"生得多雅丽，益子荣夫发家起。"],[2550,"罢却人爵修天爵，治国不如齐家高",65,66],[2551,"无边红紫，大地阳春",25,26],[2552,"荆棘塞道路，遑遑莫问津",22],[2553,"三年换东风，律转换荣华。",45,46],[2554,"风雨暴至，长途泥滑。",25,26],[2555,"冰清玉洁实堪夸，益子荣夫发大家。"],[2556,"德重乡党允，称学门大耆。"],[2557,"阡陌田园百亩桑，三公不换此风光。"],[2558,"门前喜鹊噪，喜事逐门来。",43,44],[2559,"名列庠序，弓马入泮。",19,20],[2560,"兄弟九人，秦楚不同盟。"],[2561,"凶相欺吉，神皆拥护。",57,58],[2562,"与人无求，快然自乐。",27,28],[2563,"克勤克俭，利有攸往。",43,44],[2564,"若迫若缓，徘徊不前。"],[2565,"渔舟一叶半江中，饮酒相看乐意浓。",31,32],[2566,"名进宫墙，弓马入泮。",13,14],[2567,"鬼神无情，灾毒不息。",43,44],[2568,"复西又复东，踪迹若飘蓬。",43,44],[2569,"名高先歌唱，秋风赴宴鸣。",33],[2570,"日照样光簇锦纹，高歌白雪与阳春。",45,46],[2571,"牡丹花开早，双双产白眉。"],[2572,"剪发延宾能内助，断机教子早登科。"],[2573,"咬牙切齿虚，在人生之忧。",52],[2574,"一片丹心，报孝社稷。",29,30],[2575,"一愿惟知匡社稷，无如年来古稀时。",69,70],[2576,"一树梅花破玉开，风吹几点是妆点。"],[2577,"婚姻多议禄，不合招极迟。"],[2578,"挣挫度桥来，前境已半陷。",67],[2579,"醉而不醒，昏昏沉沉度日过。",29,30],[2580,"霏霏细雨逐轻尘，阳台关上送行人。",69],[2581,"叔夜无心撮，被孙登之诮。",63,64],[2582,"有妻似无妻，娶妻靠有妻。"],[2583,"风吹浮萍，随波上下。",43,44],[2584,"负倜傥之才，终须小试。"],[2585,"春光度莨草，庭前遍绿荫。",13,14],[2586,"日夜迎宾宴客回，犬吠主人心有悔。"],[2587,"雁行无伴，挺卓自持。"],[2588,"尘埋镜露光，不与用时同。",43,44],[2589,"命有偏才，偏房必要。"],[2590,"真假三子，二子送老。"],[2591,"奔驰千里路，登高而伫足。",61],[2592,"消闲无事，安享其福。",77,78],[2593,"细雨并无逾，征夫怪夜驱。",43,44],[2594,"阳和明景，事业更新。",53,54],[2595,"行过山兮水又兮，相看前陌有长堤。",57,58],[2596,"崎岖交变，处置诚难。",59],[2597,"未行而先止，脚收其益知。",13,14],[2598,"牡丹初发，其根已萎。",14],[2599,"发财可喜。"],[2600,"好树枝疏覆绿阴，行人至此漫消停。"],[2601,"三春花茆，半在风雨中。",53,54],[2602,"风吹白玉梅花飞，骚人相约叩柴扉。",70],[2603,"和气洋溢，事皆相宜。",48],[2604,"兄弟八人，乐奏几般音。"],[2605,"虽曰三时休苦，其实耕稼为先。"],[2606,"身居烟火地，愁暑不愁人。"],[2607,"画堂终夜烛生花，药彩光摇透绛纱。",52],[2608,"名登黄甲。",30],[2609,"长江虽有浪，一苇渡行人。",42],[2610,"收养一子实属金，总然土木难成人。"],[2611,"命带文昌，正当入泮。",15,16],[2612,"四人位导二，耕读君为先。"],[2613,"远近青山，回环千里。",34],[2614,"可惜是个女流辈，也有良人不似他。"],[2615,"鹊噪新睛，帘前佳音。",47],[2616,"隔江风起秋阴早，晚征夫子仔细行。"],[2617,"午夜以报，食而以空。",25],[2618,"挨排度日，未见笑颜。"],[2619,"兄弟四人，数注皆贵。"],[2620,"马无缰辔，未可以行。"],[2621,"名利两成，身游泮水。",17,18],[2622,"独坐黄错谁是伴，紫蔬花对紫薇郎。",23,24],[2623,"招得一子金，二子木。"],[2624,"书窗春缓，桂籍生香。"],[2625,"乡榜题名。",30],[2626,"年来时又高，饮酒乐富豪。",31],[2627,"副魁而司教，铎食禄天朝。"],[2628,"三子生年属金，四子生年属木。"],[2629,"此刻生人，妻宫带疾。"],[2630,"登月宫扳丹桂，饮鹿鸣会嫦娥。",39,40],[2631,"不从文武科中出，命有小人吏员行。"],[2632,"兄弟十一人，数有六贵。",51,52],[2633,"招得水火之子，妻巧金土方合。"],[2634,"得进黉门，少年可喜。",14],[2635,"红炉不断燧皇火，羽扇频摇少女风。"],[2636,"巷衢鼓舞乐尧天。",77,78],[2637,"小桥泮藜，书香门第。",7,8],[2638,"名登黄甲。",29,30],[2639,"生金水之子，妻配土木方合。"],[2640,"兄弟十二人，数有六贵。",51,52],[2641,"晚潮失早潮兴，夹岸苍海水平。"],[2642,"丰年粮足，家室宁康。",25,26],[2643,"多艺多能，衣食足用。"],[2644,"傲物气高，多所不合。"],[2645,"以监而选知县，数由前定。"],[2646,"屈指计前程，程程查不成。",55,56],[2647,"蔓荆当道，步步纠缠。",56],[2648,"灾晦相侵，流年不宁。",45,46],[2649,"初授知县，必有变迁。"],[2650,"吉神切莫对凶神，对敌祸深而福浅。",69,70],[2651,"命带文昌，正当入泮。",23,24],[2652,"兄弟五人，数有二贵。"],[2653,"索绚成盛，亟时早图。",39,40],[2654,"罗网内张，外来无良。"],[2655,"无男无女，在家出家。"],[2656,"鸿飞冥冥笑，薮泽之戈人。",37,38],[2657,"波浪虽高，弧舟系得住。",59,60],[2658,"数有十二子，一子送老。"],[2659,"风平浪息，正好行舟。",49],[2660,"言慎行微，未可傲物。"],[2661,"太岁无情，凶多吉少。",51],[2662,"事不劳心，谋略凑合。",53,54],[2663,"乐得足优闲，多为情义士。"],[2664,"兄弟六人，数有二贵。"],[2665,"问艺岂能成大业，笙歌空误少年行。"],[2666,"当忧不忧，吉神解救。",65,66],[2667,"倚窗吟寂正愁人，风动帘笼暗有惊。",46,47],[2668,"清宵鹤唳，凄凉为怪物。",53,54],[2669,"一泓清水碧琉璃，鱼跃波纹惊若疑。",71],[2670,"风雨明晦，昼夜不分。",11,12],[2671,"医星高照，悬壶得名。"],[2672,"四字切忌：锲而不舍。"],[2673,"木火之年当得贵，此刻生人定不差。"],[2674,"度过藤桥路径通，人声掩映绿阴中。",41],[2675,"朝夕奔驰，愁怀莫释。",29],[2676,"劫神操权，威镇三军。",39,40],[2677,"天祜吉人闲，中福寿康宁。",44],[2678,"白豕负涂，灾入室中。",50],[2679,"此刻生人，死于土方年方合。"],[2680,"腰间虽有黄金甲，犬头鼠脚也惊人。",61],[2681,"行径盘恒，进退未安。",21],[2682,"锦堂开寿域，儿孙称贺福绵绵。"],[2683,"主张和有人，进取尚有益。",25,26],[2684,"兄弟十人，数有一贵。"],[2685,"到处有逢迎，马足几千里。",55,56],[2686,"钥琐相连不须疑，丹桂须扳第一枝。"],[2687,"富贵荣华称寿考，尺壁寸金木为宜。"],[2688,"暖衣饱食，可以永日。",49,50],[2689,"比武举而选千总，数由前定。"],[2690,"人事蹉跎惆怅多，怎能消遣可如何。",53,54],[2691,"雷振东南，不及掩耳。",64],[2692,"天地宠耀，位至三公。"],[2693,"鬼神赫怒，天降之祸。",55],[2694,"连建不世奇功，合当世爵。"],[2695,"东风有信，长安十里杏花香。",26],[2696,"背灯一部书，未可言得意。"],[2697,"相亲不相见，相见不相知。"],[2698,"醉起舞婆娑，安然乐意多。",87,88],[2699,"小桥扶藜，曲转绿杨溪。",12,13],[2700,"鸥鸟自相亲，橹声摇曳不为惊。",17],[2701,"五福咸臻，儿孙绕室。",27,28],[2702,"驱牛烦热最难当，放下阴处可纳凉。"],[2703,"先花后果，早子逢凶。"],[2704,"春色恼人闷，眉头锁不开。",17,18],[2705,"骨肉伤情，多病人心。"],[2706,"晦气消除人事通，谋为皆善合相逢。",25,26],[2707,"命中偏才，偏房可立。"],[2708,"丧门相照，忧及严亲。",56],[2709,"妻配犬命生，不至中途分。"],[2710,"恩命天来，敕受封赠。",23,24],[2711,"潭溪一转，流水溶溶。"],[2712,"多仓多箱，福禄无疆。",25,26],[2713,"笔走龙蛇高万丈，一举扬名应富豪。",45],[2714,"暑气薰人，待时可解。",25,26],[2715,"不以年迈自而诿，惟知赤心报国家。",67,68],[2716,"兄弟七人，数有六贵。"],[2717,"雨雪霏霏，长途泥滑。",55,56],[2718,"乡科及第。",28],[2719,"万事得周全，夕阳东下水流西。",75],[2720,"禄耀职照，官升职显。",45],[2721,"自约出家，前缘所报。"],[2722,"可限灾星不可逃，阴阳愆度更相遭。",47],[2723,"奎星高照，一举冠群英。",21,22],[2724,"余寒犹未减，何必问东风。",65,66],[2725,"数有五子，一子送老。"],[2726,"逾垣而进，守以中正。",52],[2727,"牛羊相触，祸伏萧墙。",37],[2728,"盈盈花落，泪及红妆。",40],[2729,"江头昨夜报潮生，来往奔驰势未能。",25,26],[2730,"况而复滞，百般巧计。",41,42],[2731,"此年多灾星，宝镜被尘埋。",29,30],[2732,"一生享用多丰足，万事无求福自来。"],[2733,"晋升知县。"],[2734,"早花方秀丽，风雨又相催。",23,24],[2735,"即鹿无虎，徒枉取难。",45,46],[2736,"稀更稀今朝，长别待何时。",77],[2737,"不得其志，渊明东归。",57,58],[2738,"谋事无成破损多，凡为无遂怎如何。",27],[2739,"效该生子。",17],[2740,"隆隆三伏暑，金风一夜爽人怀。",22],[2741,"时运颠倒，行人暂停。",42],[2742,"通都大邑，万物咸备。",58,59],[2743,"前程有厄，退之为得。",30],[2744,"南园风烈烈，昨夜桂花风吹折。",31],[2745,"虽得东风便，一夜渡扁舟。",45,46],[2746,"真假二子，得以送老。"],[2747,"阴阳调和，沾濡雨露。",55,56],[2748,"利用咸宜，东西南北也相宜。",35,36],[2749,"出谷黄莺，最好佳音。",32],[2750,"求之不得生，浊浪卷浮云",21],[2751,"命犯天囚决配，徒流出外州"],[2752,"早失双亲根柢孤，生涯又薄少良图。"],[2753,"四方之利，白手兴家。"],[2754,"科甲及第。",31],[2755,"皓月十分圆，光明千里遍山川"],[2756,"已知其足，自然无欲",35,36],[2757,"秋水照龙门，春风吹桃李。"],[2758,"木火之年俱生子，无奈金水尽克去。"],[2759,"此刻注定有贵子，土木之年得功名。"],[2760,"东风拂寒来，其年事多端。",33,34],[2761,"春酒已熟，无日不足。",19],[2762,"常怀共忧虑，日后享安舒。",67,68],[2763,"中奎辕上碧琉璃，万里光明路不迷。",59,60],[2764,"此刻注定贵妇人，土木之年夫大发。"],[2765,"淡云色青青，春梦正悠悠。",15,16],[2766,"夕阳西下，牧人忘牛。",55],[2767,"豕惊踯躅，灾晦相侵。"],[2768,"年来颇相得，日里耕夜织",49,50],[2769,"祸福无常，内外交错。"],[2770,"蛩声唧唧，妇叹于室。"],[2771,"东君犬吠，吃着一惊。",90],[2772,"破却家财出外州，贵人相助不须忧。"],[2773,"人事问兴，然乐意浓。",59,60],[2774,"披襟凉亭上，渐渐爽气来。",22],[2775,"命薄红颜一树花，春风已抱曲琵琶。"],[2776,"运至时行，家道渐兴。",39,40],[2777,"兔狡脱间，雉取罹罗。"],[2778,"夫别阳间去，干愁泪两行。",35],[2779,"经营早晚苦劳心，脱却劳心幸有成。"],[2780,"马蹄逐尘，驰驱千里。",39,40],[2781,"细雨霏霏，前途泥滑。",55],[2782,"五子土六子水。"],[2783,"从容乐意，自适余年。",82],[2784,"此年事不宁，灾晦又相侵。",69],[2785,"同舟共乐，前有风波。",41],[2786,"律法精明人品异，案头文卷逐条彰。"],[2787,"过了崎岖路，尽是舟渡行。",25,26],[2788,"科甲及第。",54],[2789,"屠行并非美业，放下屠刀成佛。"],[2790,"得失无关，安然进步。",65,66],[2791,"中年得子莫嫌迟，惟喜迟儿庆有余。",50],[2792,"劳心又劳力，挑担未有人。",55,56],[2793,"乱落桃花舞风时，春来去少三五枝。",35,36],[2794,"数有四子，三子送老。"],[2795,"时授府左，堂郎官列。"],[2796,"桃李带雪满园开，红红白白报春来。",23,24],[2797,"乔木来仪，文明之象。",53,54],[2798,"扬子江头一小舟，轻风相送顺流行。",21],[2799,"春色十分浓，水流花落鸟威风。",14],[2800,"前去有风波，行人仔细过。",48],[2801,"安闲岁月，无事不悦。",50],[2802,"风吹禅灯，半明半暗。",46],[2803,"庭前草色，红绿交加。",45],[2804,"如醉初醒，人事开展。",17,18],[2805,"秋风萧然，满地黄花。"],[2806,"日照楼台，浮云渐开。",51],[2807,"辛苦拮据，白手成家。"],[2808,"灵符相照，绵绵浮灾意外来。",52],[2809,"赏花有年，风吹孝服三年忧。",58],[2810,"事业不专，进三退四。",17,18],[2811,"房孝之年。",61],[2812,"梦之未醒，或颠或倒。",27,28],[2813,"大数已停，好花开尽。",70],[2814,"妻命火年生方合。"],[2815,"朱衣点头马，所威北山陬。",57],[2816,"忧之复喜，先难后易。",31],[2817,"晓望山前霁色开，俄然风起雨又来。",55,56],[2818,"前后拥护，履之不意。",83,84],[2819,"焚香晨诵法，点烛夜谈经。"],[2820,"德惠流芳，兰蕙生香。",69,70],[2821,"雪摊兰关，独疑不前。"],[2822,"非僧非道，优游逸民。"],[2823,"夫妻应偕老，琴瑟得和鸣。"],[2824,"人事今朝得畅怀，春风丽日好花开。",53,54],[2825,"云收雨散，可问行藏。",25,26],[2826,"走到半途路若迷，其中一着点先机。",23,24],[2827,"名登黄甲。",40],[2828,"空中伏火烟，笼中紫燕飞。",25],[2829,"无意多运穷，人做小勾连。",32],[2830,"花落又花开，春风次第来。",39,40],[2831,"其年不利，官事勾连。",51],[2832,"山川火发，殃及千人。",30],[2833,"徒弟十人，送老五人。"],[2834,"谋事方齐，春风又送子规啼。",31,32],[2835,"晦气及人，减却精神。",45,46],[2836,"交错声笛，梅花开落。",59],[2837,"到此数难留，整顿别离愁。",50],[2838,"兄弟五人，数当尽贵。"],[2839,"流年驳杂事，纷纷紫竹敲。",53,54],[2840,"谋事未通行，船遇打头风。",35,36],[2841,"有食有余，乐于晚年。",71,72],[2842,"春光虽好，风雨堪悲。",19,20],[2843,"山头饥虎蹲，行人须仔细。",63,64],[2844,"双亲俱有寿，母先赴瑶池。"],[2845,"身在公门寻活计，运来自有贵人扶。"],[2846,"晦气相侵，狂风骤雨。",12,13],[2847,"声名显宇宙，皇都得意回。",25],[2848,"进退咸无位，不如守其中。",19,20],[2849,"兰膏已尽，一室昏暗。",18],[2850,"初任主事之职。"],[2851,"五行最有刑，出胎便丧母。"],[2852,"开门似水，信哉磨磷。",45,46],[2853,"外错不知，忧之如何。",27,28],[2854,"否之既进，忧之复来。",42],[2855,"风外康节，祯祥之福。",49,50],[2856,"可得螟伶之子。"],[2857,"兄弟十人，数有三贵。"],[2858,"生涯不若破家业，破耗一似绵张风。"],[2859,"洛阳为报十分春，杨柳依依绿荫。",19,20],[2860,"虎怒成风，山木皆惊。",63,64],[2861,"罗列高堂，汪然渺茫。"],[2862,"湘江烟火荛波涛，二雁高飞任去来。"],[2863,"童运未坚，早入黄泉。",43],[2864,"行事无阻，行舟顺风。",33],[2865,"生计已尽，梦入华胥。",38],[2866,"知已将来不用求，龙泉磨利射斗牛。",42],[2867,"一胎生三子，世上罕有事"],[2868,"科甲及第。",33],[2869,"恶曜攻身，须防危险。",71],[2870,"生涯寂寞，凄凉无诊。",25,26],[2871,"有日似刀锋，原来性不凶"],[2872,"相见有悲啼，一夜凄凉泪别情。",58],[2873,"画虎于墙，有惊无灾。",51],[2874,"六阴极处水凝冰，造物分明未有形。",12],[2875,"事事多趄語,静听自得宜",49,50],[2876,"一杯春酒一杯水，坚守为高事可宜。",49],[2877,"为着别故人，空作有年计。",75],[2878,"兄弟十人，数有三贵。"],[2879,"居上克昨，为下克忠。",42],[2880,"十年以前事纷纷，此后图谋事遂心。",57,58],[2881,"镜中之花，遇而不遇",21],[2882,"春水鱼儿游，一跃而变化。",29],[2883,"谋事费工夫，反覆几蹉跎",21],[2884,"一天星斗甚光明，十里长亭一夜行。",24],[2885,"有心领青衿，已知一生届"],[2886,"招得金水土之子，方合此刻。"],[2887,"出转回溪便连当，夹岸绿杨更已新。",43,44],[2888,"美运辐，财帛相臻。",55,56],[2889,"所为皆合，谋事有益。",65],[2890,"今朝来喜太平年，解放眉头开笑颜。",55,56],[2891,"围炉烘火，暖气薰人。",25],[2892,"一步崎岖，高低不平。",53,54],[2893,"画饼充饥，谋悉成虚。"],[2894,"霜霜霏霏，长途泥滑。",25,26],[2895,"德裕经邦，才优济世。",41,42],[2896,"昏迷朦胧，未分东西。",27,28],[2897,"春夏秋冬，寒暖相迁事不同。",13,14],[2898,"遍舟一叶渡，东南风正狂。",27,28],[2899,"风雨霏霏，长途崎岖。",65,66],[2900,"浮云飞去，依旧晴明。"],[2901,"科甲及第。"],[2902,"流年凶星，灾晦相侵。",41,42],[2903,"土年母终。"],[2904,"喜之未已，忧之又随。",90],[2905,"冷落离披，雨中桃李。",39,40],[2906,"炉烟消尽化成灰，一缕云生化气回。",26],[2907,"璞出于石，无人识别。"],[2908,"谋事难成，徒劳心力。",27,28],[2909,"进士及第。",35],[2910,"祖业不靠，白手成家。",25,26],[2911,"妻生一子，亲生二子。"],[2912,"通霄风雨，十分春色便珊珊。",41,42],[2913,"习业儒读萧何略，身在公门乐意多。"],[2914,"太岁相冲，纵喜也凶。",25,26],[2915,"有征无战，光王之师。",39,40],[2916,"前去路迢迢，何须问变化。",49,50],[2917,"事业问萧曹，功名亦可得。",53,54],[2918,"乡科及第。"],[2919,"却空篱落，探春回还。",5],[2920,"利不可求，动而见忧。",25,26],[2921,"妻命属猪，中途而去。"],[2922,"名登黄甲。",34],[2923,"青青草色，又得一番风雨滋。",31,32],[2924,"黄昏不辨，幸逢朗照。",25,26],[2925,"兄弟八人，数有一贵。"],[2926,"多少未了事，件件挂心怀。",49,50],[2927,"马在山南，人在山北。",53,54],[2928,"束装西归，鸿唱送离歌。",77],[2929,"耿耿不寐，搔首谁语。",27,28],[2930,"马头羊尾，跋涉多风雨。",51,52],[2931,"千里寄书来，疑吉又疑凶",43,44],[2932,"塞外风物滥关情。"],[2933,"蛇绕虹腾民，仰中天法曜。",57,58],[2934,"改换门闾事更新，锦衣玉食福仍臻。"],[2935,"腰横金作带，符剑玉为邻。",57,58],[2936,"阳数满难回，定作黄泉客。",77],[2937,"炎热已蒸人，爽气已侄秋信至",57,58],[2938,"忧情种种人无殊，获屈蛇蝎志未舒。",39,40],[2939,"授九童之诰命，统百万之雄兵。"],[2940,"蟮蜃吻虽黄，破处重重讼。",29],[2941,"大车无辙，小车无轨。",59,60],[2942,"破财耗散，事多变迁。",49,50],[2943,"洞房之喜，定在此年。",15,16],[2944,"小人相欺，夫端降害。",29,30],[2945,"黄薤淡饭可疗饥，竹筲茅舍乐有余，",39,40],[2946,"明月见星，说法谈经。",25,26],[2947,"苦雨入凄风，令人不堪闻。",16],[2948,"秋寒苦旱，沆然下雨足精神。",23],[2949,"红妆冷落，秋草焦枯。",53,54],[2950,"数有六子，四子送老。"],[2951,"财帛丰盈，一世我忧。"],[2952,"双飞紫燕两分飞，夫君不幸命先归。",56],[2953,"喜气宠袭，终难一遇。",28],[2954,"新竹破苍苔，成竿指日来。",25,26],[2955,"皓月正当空，清光自不同",44],[2956,"孝服三年，于此不免。",57],[2957,"此刻孔门人，金年当入泮。"],[2958,"富贵两全，人间之福。",67,68],[2959,"复任知县。"],[2960,"病符照命，灾意外来。",55,56],[2961,"母终于金年方合。"],[2962,"事业不专，半进半退。",15,16],[2963,"天高地迥，不可叹穷愁。",45,46],[2964,"夕阳初下，数已尽矣。",77],[2965,"钱财陡发，驷马驰来。",31],[2966,"当有三母之称。"],[2967,"瑞气融融，门庭喜庆。",29,30],[2968,"药飞片片，寒冬趣煎。",45,46],[2969,"一江春水送行舟，万里云山极目游。",43,44],[2970,"孝服相侵，流年肖咎。",44],[2971,"六亲少靠，骨肉寡缘。"],[2972,"父母生来，独自一个。"],[2973,"心之忧寂，最难度日。",45,46],[2974,"富裕且康，惟田惟桑。",55,56],[2975,"花蕊初红，暴风疾雨。",15,16],[2976,"连遭时不利，欲进不能行。",23,24],[2977,"精修玄妙法，子里仰纯阳。"],[2978,"生辰八字造化，五行生克卜荣枯。"],[2979,"优闲岁月，斯为多福。",43,44],[2980,"晓烟迷杨柳，长堤远溟蒙。",33,34],[2981,"前途应有渔郎渡，不必停骖去问津。",17],[2982,"兴至三杯酒，闲时一局棋。",55,56],[2983,"传得松筠，新逢桃节花。",63,64],[2984,"雪与梅花并，又见一番香。",41,42],[2985,"有针无线用，欲空无成衣。",23,24],[2986,"升迁理刑郎，官列宿命宫。"],[2987,"朝功暮课，种得清净福。",53,54],[2988,"园中花畔闻啼鸟，此时天命非久长。",67,68],[2989,"著新结排，列大规模。",51,52],[2990,"弃偏途而就正道，来日尽光明。"],[2991,"观颜察色分贫富，验气凝气神识英雄。"],[2992,"三星在户，喜事频来。",30],[2993,"鼓舞之福，安然终朝。",52],[2994,"欲成来生佛，早晚须诵经。"],[2995,"乐事从心，眉头喜生。",44],[2996,"早涉风霜苦，运来发财自兴家。"],[2997,"大厦要扶持，还须得一本。",29,30],[2998,"已得静中趣，安然与世殊。",61,62],[2999,"为人素有刚柔性，处世机亲出从伦。"],[3000,"钗于奁内，玉在框中。"]]}
