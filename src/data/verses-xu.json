{"volume":"戌集","verses":[[11001,"可怜不见严亲面，刻木人今羡古人。"],[11002,"克昌厥后，绥我眉寿。"],[11003,"夫妻同甲子，姻缘定数。"],[11004,"兄弟五人，鼎列分承。"],[11005,"休道事无讹，其中进退多。",31,32],[11006,"三复白圭诗，今日之南容。"],[11007,"妻妻子子，田歌之寿。"],[11008,"啾唧不能免。",3,4],[11009,"待得时业君展翅，万花相映马嘶蹄。"],[11010,"虽是年来多不利，吉多凶少莫慌张。",23,24],[11011,"熟识君闺范，夫家风度勤。"],[11012,"可惜平生四十六，哀哀老幼徒知哭。",46],[11013,"夫妻同丙子，姻缘定数。"],[11014,"弟命鼠年生方合。"],[11015,"少年蹉跎事不利，中年恍惚老年奇。"],[11016,"不历一番寒彻骨，怎得梅花扑鼻香。"],[11017,"福寿两齐，敬佛上事。",62],[11018,"虽是朦胧眼，红花出水鲜。",1],[11019,"望月休从帘下立，踏花偏向草中寻。",21],[11020,"寿元足矣。"],[11021,"病符入鼠年，灾晦来相缠。"],[11022,"张李结于官族，易数先知。"],[11023,"夫妻同戊子，姻缘定数。"],[11024,"弟命牛年生方合。"],[11025,"一派顺风吹，云散月华明。",13,14],[11026,"九岁喜匆匆，十龄始吉祥。",9,10],[11027,"一池新水今朝雨，满地桃花昨夜风。",69,70],[11028,"连日雨沉沉，今日始见晴。",7],[11029,"二岁之儿，如花不久。"],[11030,"椿枝已折，三年泣血。",29],[11031,"寿元有一百零四，君今少二春。",102],[11032,"青年刑二室，数中不幸。",22],[11033,"夫妻同庚子，姻缘前定。"],[11034,"弟命虎年生方合。"],[11035,"中秋月朗十分明，万里无云一色天。",61,62],[11036,"良马始因离险路，梅花今已发阳春。",47,48],[11037,"不于己事休开口，合意人情只点头。",45,46],[11038,"一梦归阴府，飘然入华胥。",46],[11039,"一尘不染，幽室味长。",41,42],[11040,"乡科中解元，易数注定。"],[11041,"一夕风奋平地起，犬生两中过门来。",73,74],[11042,"青年刑二室，不幸之悲。",23,24],[11043,"夫妻同壬子，姻缘注定。"],[11044,"弟命兔年生方合。"],[11045,"甲子拜师，天上大吉。"],[11046,"凶星到丑年，疾病来相侵。"],[11047,"妻死之年，幼儿不幸。",15],[11048,"喜而不喜，忧中妨灾。",29,30],[11049,"数注其人，经营湖海。"],[11050,"虽忧未忧，时运未至。"],[11051,"老年运既否，莫惹是和非。",91,92],[11052,"青年刑二室，人之大不幸。",25,26],[11053,"夫妻同乙丑，姻缘注定。"],[11054,"弟命龙年生方合。"],[11055,"师命丙子生。"],[11056,"今年花胜去年红，可羡明年花更浓。",24],[11057,"时来行好运，一路吉祥亨。",45,46],[11058,"童年方四岁，嫩竹映光辉。",4],[11059,"吏修生涯，性廉情淡。"],[11060,"静境修德，心诚则灵。"],[11061,"淡淡轻烟迷芍药，微微细雨润芙蓉。",47,48],[11062,"青年刑二室，不幸之悲。",27,28],[11063,"夫妻同丁丑，先天定数。"],[11064,"弟命蛇年生方合。"],[11065,"师命戊子生。"],[11066,"童子一周三四岁，四时寒热光入侵。",3,4],[11067,"光阴不幸随人生，物外悠悠独自行。",63,64],[11068,"有事定然反复去，只须忍耐免虚惊。"],[11069,"运乖有解凶成吉，信是松柏耐岁寒。",67,68],[11070,"一去三年不回顾，此情只待成追忆"],[11071,"九十年来运正佳，清晨疾病免咨嗟。",9,10],[11072,"前妻丧未久，后妻今又亡。",29,30],[11073,"夫妻同己丑，先天定数。"],[11074,"弟命马年生方合。"],[11075,"师命庚子生。"],[11076,"凶星到虎年，疾病来相缠。"],[11077,"饮酒茹荤无我份，数中注定一僧人"],[11078,"过此迷津外，滔滔乐太平。",57,58],[11079,"此刻生人命亦奇，虽为待获禄相依。"],[11080,"寿元一百零二春，悠然一梦往西行。"],[11081,"老年获美景，身健子孙贤。",91,92],[11082,"前妻死未久，后妻今又亡。",31,32],[11083,"夫妻同辛丑，姻缘注定。"],[11084,"弟命羊年生方合。"],[11085,"师命壬子生。"],[11086,"灾星到兔年，啾唧不安然。"],[11087,"饮酒茹荤无我份，数中注定一僧人。"],[11088,"有子健奇才，宏伟命中来。"],[11089,"一盘算尽人间事，得失荣枯总在天。"],[11090,"老骥伏枥，志在千里。",65,66],[11091,"未出胎而克父，是为贵腹子。"],[11092,"前妻死未久，后妻今又亡。",33,34],[11093,"夫妻同癸丑，数定先天。"],[11094,"弟命猴年生方合。"],[11095,"师命乙丑生。"],[11096,"妻招金火子，招金水方合。"],[11097,"恶晦临龙年，疾病来相缠。"],[11098,"花当春放好妍媚，月到天心分外明。"],[11099,"一片白云头上过，钓斜秋月雨中明。",27,28],[11100,"妻丧期年儿受克，数犯刑伤。"],[11101,"松竹争夸耐寒冰，孤标劲节出儒林。",87,88],[11102,"前妻既死，后妻又亡。",35,36],[11103,"夫妻同甲寅，姻缘前定。"],[11104,"弟命鸡年生方合。"],[11105,"师命丁丑生，先天定数。"],[11106,"猿鹤相依天外客，逍遥物外玉栏杆。"],[11107,"凶神到蛇年，疾病应多赘。"],[11108,"父死妻亡，流年不利。",15,16],[11109,"一岁父死，刑伤莫大。"],[11110,"贞静幽闲，囤中毓秀。"],[11111,"天哭照命，母有刑伤。",65],[11112,"前妻死未久，后妻今又亡。",37,38],[11113,"夫妻同丙寅，先天前定。"],[11114,"弟命狗年生方合。"],[11115,"师命己丑生，先天定数。"],[11116,"庆羡无他说，惟说遐龄岁八旬。",80],[11117,"扶人霄汉上，救人于水火。"],[11118,"父亡妻亡，不幸之甚。",17,18],[11119,"鸿雁飞腾和，声断衡阳浦。",53,54],[11120,"阴阳不识，乾坤难辩。"],[11121,"凶星到马年，身体不安然。"],[11122,"前妻已死，后妻又亡。",39,40],[11123,"夫妻同戊寅，姻缘注定。"],[11124,"弟命猪年生方合。"],[11125,"师命辛丑生，先天注定。"],[11126,"三嫁甲子之夫，方得相宜。"],[11127,"父母死于土木之年方合。"],[11128,"风折椿枝，琴瑟又断。",19,20],[11129,"驾鹤腾云去，飘然竟不回。",72],[11130,"老来丧母之年。",66],[11131,"无母何恃，欲食难存。",40],[11132,"困于蔟藜，三刑其妻。",41,42],[11133,"夫妻同庚寅，先生注定。"],[11134,"春日春花红又绿，秋江秋水碧还青。",33,34],[11135,"师命癸丑生。"],[11136,"三嫁丙子之夫，方得相宜。"],[11137,"妻命生于金年方合。"],[11138,"二孝临身，父死妻亡。",21,22],[11139,"钦命典试。",63,64],[11140,"木火之年进庠，金水之年食廪。"],[11141,"雨近山川春别样，时来万里月光明。",51,52],[11142,"前妻已死，后妻又亡。",43,44],[11143,"夫妻同壬寅，先天注定。"],[11144,"菊花景好耐风霜，柏树春深日日长。",75,76],[11145,"师命甲寅生。"],[11146,"良人有刑，三嫁戌子之夫。"],[11147,"命带刚烈性，果敢有为人。"],[11148,"父死妻亡，二度刑伤。",23,24],[11149,"人生五福寿为先，世上难逢百岁缘。",99,100],[11150,"丧母之年。",67],[11151,"财如皎月家家见，福似春深处处红。",25,26],[11152,"前妻已死，后妻又亡。",45,46],[11153,"夫妻同乙卯，姻缘前定。"],[11154,"凶星坐羊年，疾病来相缠。"],[11155,"师命丙寅生。"],[11156,"命有刑克，三嫁庚子之夫。"],[11157,"龙下碧潭添秀色，虎逢山谷转精神。",39,40],[11158,"不幸椿枝折，认知又断弦。",25,26],[11159,"千里暮云悉未尽，一江秋水恨无穷。",37,38],[11160,"妻命属木命，先天定数。"],[11161,"从前一路平安过，今年明日又迷途。"],[11162,"前妻已死，后妻又亡。"],[11163,"夫妻同丁卯，先天注定。"],[11164,"姊妹属凰，数有前定。"],[11165,"师命戊寅生。"],[11166,"命有刑克，三嫁壬子之夫。"],[11167,"木火父母生年，金火父母死年方合。"],[11168,"父死妻亡，二度刑伤。",37,38],[11169,"病符相照，猴年祈保得安然。"],[11170,"丧母之年。",66],[11171,"今岁来年是一津，花前无故犬吠人。",13,14],[11172,"困于蒺藜，上刑其妻。",49,50],[11173,"夫妻同己卯，姻缘前定。"],[11174,"姊妹属牛，数有前定。"],[11175,"师命庚寅生。"],[11176,"命有刑克，三嫁乙丑之夫。"],[11177,"五岁母亡，人之不幸。"],[11178,"父死妻亡，刑伤莫大。",29,30],[11179,"鼓盆之岁，三见于此。",21,22],[11180,"病符到鸡年，保护灾可退。"],[11181,"渺渺烟霞起，恹恹愁闷费精神。",35,36],[11182,"前妻已死，后妻又亡。",61],[11183,"夫妻同辛卯，缘分所注。"],[11184,"姊妹属虎，数有前定。"],[11185,"师命壬寅生。"],[11186,"命有刑克，主嫁丁丑夫"],[11187,"双亲辞世许多年，椿树先枯萱后凋。"],[11188,"父死妻亡，二度刑伤。",21,22],[11189,"三刑其妻，人之不幸。",23,24],[11190,"丧母之年，泣血悲伤。",69],[11191,"奴婢有染，数有前定。"],[11192,"前妻已死，后妻又亡。"],[11193,"夫妻同癸卯，先天注定",53,54],[11194,"姊妹属兔，数有前定。"],[11195,"师命乙卯生。"],[11196,"命有刑克，再嫁己丑夫。"],[11197,"五岁母亡，人子不幸。",25,26],[11198,"父死妻亡，刑伤莫大。",33,34],[11199,"困于蒺藜，主刑其妻。",25,26],[11200,"一片彩云秋水至，时来风月一番新。"],[11201,"青衿从此得，方显少年强。",14],[11202,"前妻已死，后妻又亡。",55,56],[11203,"夫妻同甲辰，姻缘注定。"],[11204,"姊妹属龙，数有前定。"],[11205,"师命丁卯生。"],[11206,"命有刑克，主嫁辛丑夫。"],[11207,"事或能断，无乐又堪忧。",25,26],[11208,"父死妻亡，同在一年。",35,36],[11209,"困于蒺藜，主刑其妻。",27,28],[11210,"一片彩云秋水至，时来风月一番新。"],[11211,"父母生于木火年，同死于金水年。"],[11212,"丧门相照，两刑其妻。",57,58],[11213,"夫妻同丙辰，先天注定。"],[11214,"姊妹属蛇，数有前定。"],[11215,"师命己卯生。"],[11216,"命有刑克，主嫁癸丑夫。"],[11217,"数注紫衣人指引，财禄功名自有期。"],[11218,"椿枝已折，琴治无音。",31,32],[11219,"鼓盆之戚，三见于斯。",29,30],[11220,"刑妻于水年，娶继室于木年。"],[11221,"二龙争一珠，一得一失。",27,28],[11222,"困于蒺蒺，两刑其妻。",59,60],[11223,"夫妻同戊辰，姻缘前定。"],[11224,"姊妹属马，数有前定。"],[11225,"师命辛卯生。"],[11226,"主嫁甲辰之夫。"],[11227,"父死于木火之年，母死于金水之年。"],[11228,"丧门兼白虎，父死妻又亡。",39,40],[11229,"鼓盆之戚，三见于斯。",31,32],[11230,"瓦砾之下，白虹于耀。",33,34],[11231,"可惜平生四十六，哀哀父母徒知哭。",46],[11232,"处处雉鸟两分飞，折断佳人不齐眉。",61,62],[11233,"夫妻同庚辰，姻缘注定。"],[11234,"姊妹属羊，数有前定。"],[11235,"师命癸卯生。"],[11236,"命有刑伤，主嫁丙寅夫。"],[11237,"静坐有经消白日，闲来无事伴红尘。"],[11238,"父死妻亡，一年二孝。",41,42],[11239,"三刑其妻，命犯刑伤。",33,34],[11240,"妻命属水年生方合。"],[11241,"晚运胜于中年运。"],[11242,"前妻已死，后妻又亡。",63,64],[11243,"夫妻同壬辰，姻缘前定。"],[11244,"姊妹属猴，数有前定。"],[11245,"师命甲辰生。"],[11246,"良人有刑，主嫁戊寅夫。"],[11247,"父母死于金水之年方合。"],[11248,"父死妻亡，二度刑伤。",43,44],[11249,"困于蒺藜，三刑其妻。",35,36],[11250,"雁来嘹亮黄花发，好个声名处处闲。"],[11251,"中年而亡，前生注定。",32],[11252,"前妻已死，后妻又亡。",65,66],[11253,"夫妻同乙巳，姻缘注定。"],[11254,"姊妹属鸡，数有前定。"],[11255,"师命丙辰生。"],[11256,"良人有刑，主嫁庚辰夫。"],[11257,"对酒邀明月，杯中酒不空。",47,48],[11258,"父死妻亡，两度刑伤。",45,46],[11259,"三刑其妻，命带刑克。",36,37],[11260,"丧母之年。",18],[11261,"二十欠一春，胡为寿不深。",19],[11262,"前妻已死，后妻又亡。",63,64],[11263,"夫妻同丁巳，前生注定。"],[11264,"姊妹属狗，数有注定。"],[11265,"师命戊辰生，"],[11266,"主嫁壬辰之夫。"],[11267,"父母死于火土之年方合。"],[11268,"父死妻亡，一年两伤。",43,44],[11269,"困于蒺藜，三刑其妻。",39,40],[11270,"大限已停，纵有名医药不灵。"],[11271,"虚名虚利两不成，浪迹萍踪已半生。"],[11272,"鼓盆之戚，又见于斯。",69,70],[11273,"夫妻己巳，姻缘前定。"],[11274,"姊妹属猪，数有前定。"],[11275,"师命庚生。"],[11276,"主嫁乙卯之夫。"],[11277,"天夺其算，为寿不稳。",33],[11278,"父死妻又亡，一年两度伤。",49,50],[11279,"三刑其妻。",41,42],[11280,"丧母之年。",42],[11281,"父母生合木火之年，死于水土之年。"],[11282,"琴弦已续，不是年年之曲。",21,22],[11283,"夫妻同辛巳，缘分所注。"],[11284,"姊妹属鼠，数有前定。"],[11285,"师命壬辰生。"],[11286,"良人有刑，主嫁丁卯夫。"],[11287,"禀膳名香甫，得皇家之禄。",21,22],[11288,"父死妻亡，一年二伤。",51,52],[11289,"困于蒺藜，三刑其妻。",43,44],[11290,"幼年失母，苦了何时。",9],[11291,"当年方进步，此岁寿元终。",31,32],[11292,"当年之曲不堪闻，弹出新声另有声。",23,24],[11293,"夫妻同癸巳，姻缘已定。"],[11294,"姊妹属牛，数有前定。"],[11295,"师命乙巳生。"],[11296,"良人有刑，主嫁己卯夫。"],[11297,"名当补禀幸，食皇家之禄，",23,24],[11298,"父死妻亡，两度刑伤。",53,54],[11299,"困于蒺藜，三刑其妻。",45,46],[11300,"一字记之曰汝，用不得。"],[11301,"阡陌春色浓，常思良人在天涯。"],[11302,"洞房荣乐事，花谢又花闲。",25,26],[11303,"夫妻同甲午，姻缘前定。"],[11304,"姊妹属虎，数有前定。"],[11305,"师命丁巳生。"],[11306,"良人有刑，主嫁辛卯夫。"],[11307,"喜逢黄道日，禀膳姓名香",25,26],[11308,"父死妻亡，两度刑伤。",55,56],[11309,"困于蒺藜，三刑其妻。",47,48],[11310,"三岁母死，终天愁恨。"],[11311,"去往犹如梁上燕，谋为却是水中月。",61,62],[11312,"破镜已分，鸳鸯再整。",27,28],[11313,"夫妻同丙午，姻缘注定。"],[11314,"姊妹属兔，数有前定。"],[11315,"师命己巳生。"],[11316,"良人有刑，主嫁癸卯夫。"],[11317,"喜逢黄道日，禀膳姓名香。",27,28],[11318,"父死妻亡，两度刑伤。",57,58],[11319,"困于蒺藜，三刑其妻。",49,50],[11320,"丧星照门，此年灾晦。",23],[11321,"萱花已落，三年泣血。",43,44],[11322,"鸳鸯浮水面，花谢又花开。",29,30],[11323,"夫妻同戊午年，姻缘注定。"],[11324,"姊妹属龙，数有前定。"],[11325,"师命辛巳生。"],[11326,"主嫁丙辰之夫，方免其刑。"],[11327,"喜迎黄道日，禀膳姓名香。",29,30],[11328,"父死妻亡，两度刑伤