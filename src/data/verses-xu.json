生子。",31],[11670,"母赴瑶池，三年泣血。",61],[11671,"杜鹃飞夜月，蝴蝶怨残红。",39],[11672,"盗贼相侵，流年不利。",47,48],[11673,"兄弟九人，一人入泮。"],[11674,"妹命水年生方合。"],[11675,"母赴瑶池，三年泣血。",25],[11676,"良人有刑，主嫁乙亥夫。"],[11677,"火星入宅，回禄之灾。",55,56],[11678,"月出不堪云淡淡，花开无奈雨淋淋。",9,10],[11679,"偏房生子。",33],[11680,"母赴瑶池，三年泣血。",64],[11681,"长眼幽室尘埃净，静对寒潭心境空。",41,42],[11682,"盗贼相侵，流年不利。",49,50],[11683,"盐梅妙有调羹才，到老还堪作钓竿。",93,94],[11684,"妹命火年生方合。"],[11685,"云散一天星斗换，风拔四海浪波平。",27,28],[11686,"良人有刑，主嫁丁亥夫。"],[11687,"火星入宅，流年有失。",57,58],[11688,"五品大夫归故里，不摇金扇自然凉。"],[11689,"侧室生子。",35],[11690,"数声鹏鸟啼，血泪洒西风。",49],[11691,"人事正当萧索处，春光又在风雨中。",43],[11692,"盗贼相侵，流年不利。",51,52],[11693,"秋高气爽，心平气和。",49],[11694,"妹命土年生方合。"],[11695,"老年泣血，萱堂寿终。",61],[11696,"主嫁乙亥夫，方许白发"],[11697,"回禄之灾，是年难免。",59,60],[11698,"财帛浑如新柳发，人情好似蚤花开。",21,22],[11699,"偏房生子。",34],[11700,"杜鹃啼落楼台月，寒鸦噪破夕阳春。",45],[11701,"恶有恶报，善有善报。",30],[11702,"盗贼相侵，流年不利。",53,54],[11703,"行年到此愁日暮，时光易迈远山空。",89,90],[11704,"不肖子弱智，儿前恶报生。"],[11705,"少年优悠到此境，白发犹是逞风流",81,82],[11706,"良人有刑，主嫁辛亥夫"],[11707,"火星入宅，回禄之灾。",61,62],[11708,"阴功祈善保，怨字无心一在头。",47,48],[11709,"侧室生子。",35],[11710,"母赴瑶池，三年泣血。",35],[11711,"大数已定，一樽美酒送行程。",53],[11712,"盗贼入室，大小齐惊",55,56],[11713,"行年一百生荆棘，西风吹落子猷舟。",97,98],[11714,"菩提本是树明镜，亦非台前处尘埃"],[11715,"母赴瑶池，三年泣血",57],[11716,"良人有刑，主嫁癸亥夫。"],[11717,"回禄之灾，是年难免。",63,64],[11718,"月出不堪云淡淡，花红无奈雨淋淋。",17,18],[11719,"妾氏生子。",36],[11720,"流年不顺，西风吹面青。",6],[11721,"大数已定，水向东流不复。",95],[11722,"窃盗相侵，流年不利。",57,58],[11723,"来年童运好，云开月正明。",12],[11724,"贩卖度日过华年，公平交易便兴家。"],[11725,"母赴瑶池，三年泣血。",58],[11726,"行运只防太岁冲，不能相克亦能空。",41,42],[11727,"娥眉懒画新时月，螺鬓常梳旧日容。",71,72],[11728,"花因雨滞容无色，草为春寒绿不明。",9],[11729,"侧室生子。",37],[11730,"无风起浪浪头高，纵欲停舟也见惊。",37],[11731,"六岁无母，莫大刑伤。",6],[11732,"盗贼相侵，流年有失。",59,60],[11733,"辛苦泥瓦匠，衣食得丰荣。"],[11734,"东坡向禅寺，云龙山上色。"],[11735,"一鞭快马岩前过，半叶孤舟浪里行。",29,30],[11736,"枯枝遭雨打，槁叶被霜残。",99,100],[11737,"三四岁冲缝一阴，扬子江头苦叫天。",3,4],[11738,"庭帏昼永春如海，帘幕风悠月似钩。",23,24],[11739,"偏房生子。",38],[11740,"房考之年。",63,64],[11741,"中年夫妻，和气到老赛儿子。",40],[11742,"盗贼相侵，破家之祸。",61,62],[11743,"尧天舜日，往来皆亨。",6],[11744,"文昌拱照，科甲及第。"],[11745,"其年丧母，世上古稀。",70],[11746,"招来火之子，配金水之妻方合。"],[11747,"家自福兮隆，老来晚景乐融融。",67,68],[11748,"离祖宗而事迁移，数由前定。"],[11749,"侧室生子。",39],[11750,"十岁欠三春，母赴瑶池。",7],[11751,"数定幼年而亡，泣血西风泪几行。",6],[11752,"盗贼相侵，破家之祸。",63,64],[11753,"迁他乡遂，创为始祖。"],[11754,"勤俭持家，衣禄无亏。"],[11755,"自天佑之，无往不吉。",25,26],[11756,"良玉深藏未，可量其蓄积。"],[11757,"幼年防灾厄，恰似临深渊。",8],[11758,"年滞菱花藏袖里，金莲休向井中行。",25,26],[11759,"侧室生子。",40],[11760,"笑杀芝前总是痴，今朝作别待何如。",8],[11761,"闺中顺利，无是不悠悠。",85,86],[11762,"盗贼相侵，破家难免。",65,66],[11763,"抚院职权，一省之事。"],[11764,"翩翩黄鸟，集于泮林。",15,16],[11765,"招得土木之子，配贤才之妻。"],[11766,"家业财源生瑞气，绮罗席上日融融。",11,12],[11767,"母赴瑶池，三年泣血。",56],[11768,"数注中年而亡方合。",45],[11769,"侧室生子。",41],[11770,"花放随风情切切，水流叶落恨汪汪。",40],[11771,"母赴瑶池，三年泣血。",30],[11772,"盗贼相侵，被家难免。",65,66],[11773,"泮池之年。",7,8],[11774,"幼年入泮，身沐皇恩。",17],[11775,"官事缠身，流年之晦。",21,22],[11776,"花开当午日，犹如嫩柳遇春风。",69,70],[11777,"那有期颐寿，五福之中屈一指。",69,70],[11778,"不是儒生，实是吏员。"],[11779,"侧室生子。",42],[11780,"异路而选经历，数由前定。",38],[11781,"困于蒺藜，难免刑妻。",25],[11782,"盗贼相侵，流年有咎。",69,70],[11783,"乍雨乍晴云里月，半开半路雨中花。"],[11784,"性悟不知身外事，不期恩命自天来。"],[11785,"命犯朱雀，官事监事。",33,34],[11786,"父子同黄甲，天发慈善门。"],[11787,"谈经留月夜，说法有清风。"],[11788,"其年有纳宠之喜。",31],[11789,"夫死之年，悲莫大焉。",31],[11790,"卜商之叹，见于此年。",45,46],[11791,"困于蒺藜，不见其妻。",26],[11792,"宜家贞吉，闺门顺遂。",25],[11793,"庭前春色，景致宜人。"],[11794,"名进贤关，身洒皇恩。"],[11795,"科考之年，名当高列。",39,40],[11796,"良人有刑，再嫁癸未。"],[11797,"人情莫道春光暖，只恐秋来月夜寒。",53,54],[11798,"是年纳宠之喜。",33,34],[11799,"夫年之死，女之不幸。",32],[11800,"卜商之叹，定见此年。",47,48],[11801,"母赴瑶池，三年泣血。",34],[11802,"斯时无所求，闲中自优游。",31],[11803,"盗贼相侵，破家之灾。",33,34],[11804,"出于幽谷，迁于乔木。",15],[11805,"科岁之年，考必高列。",41,42],[11806,"良人有刑，再嫁甲申夫。",21,22],[11807,"门内起干戈，家庭内不和。"],[11808,"冰冻三尺，非一日之寒。"],[11809,"夫死之年，妇之不幸。",33],[11810,"卜商之叹，定见此年。",49,50],[11811,"困于蒺藜，难免刑妻。",28],[11812,"相安相乐庆流年，闺中人事幸无牵。",23],[11813,"壬癸无情，闺中被溺。"],[11814,"名登甲科。",21],[11815,"科考之年，名列超等。",43,44],[11816,"良人有刑，再嫁丙申。",23,24],[11817,"天不变，道义不变，道之大原出于天。"],[11818,"天高皇帝远，人穷志气短。"],[11819,"丧门相照，夫君难留。",34],[11820,"卜商之叹，其年定见。",81,82],[11821,"数该刑妻之年。",29],[11822,"斯时无所求，终日得优游。",24],[11823,"东坡向禅寺，云龙山上色。"],[11824,"九州鼎沸，四海平安。"],[11825,"科考之年，名必高列。",45,46],[11826,"门内起干戈，家庭内不和。",25,26],[11827,"大椿八千岁，庄子游仙境。"],[11828,"椿庭萱堂寿为仙。"],[11829,"夫死之年，人之不幸。",35],[11830,"卜商之叹，定见此年。",53,54],[11831,"数注其人难到老，琵琶拔山断肠声。",30],[11832,"闺中和顺，快乐优游。",27],[11833,"春色惨淡，栏杆黯然。",24],[11834,"中馈人亡，未免寂寞。",52],[11835,"命犯朱雀，官事难免。",33,34],[11836,"门内起干戈，家庭内不和。",27,28],[11837,"清风为友，明月相知。",29,30],[11838,"万里无云天一色，长江水静浪无痕。"],[11839,"夫死之年，人之不幸。",36],[11840,"卜商叹财，君今亦然。",55,56],[11841,"不是忧愁，就是疾病。"],[11842,"破家之祸，罗陀入限。",41,42],[11843,"半夜有人酬夙债，两年无事入公门。",53,54],[11844,"名登庠序，光宗耀祖。",24],[11845,"命犯朱雀，官事临身。",25,26],[11846,"门外起干戈，家庭内不和。",29,30],[11847,"杨花飞点点，保慎越前溪。",55,56],[11848,"十岁父亡，为命不坚。"],[11849,"侧室生子。",49],[11850,"母赴瑶池，三年泣血。",41],[11851,"母赴瑶池，三年泣血。",29],[11852,"破家之祸，火星入限。",43,44],[11853,"不及调和盐梅，乃为商贾之客。"],[11854,"名进贤关，身沐皇恩。",25],[11855,"命犯朱雀，官事临身。",37,38],[11856,"门庭起干戈，家庭总不和。",31,32],[11857,"家肥屋润般般遂，子秀荣华事事昌。",53,54],[11858,"喜庆重重得，登科兆熊罴。",45,46],[11859,"侧室生子。",50],[11860,"幼年丧母，人生不幸。",13],[11861,"三月残花，花落花开。"],[11862,"蹉跎之年，破家之祸。",45,46],[11863,"钦命典试。",65,66],[11864,"出于幽谷，迁于泮林。",26],[11865,"命犯朱雀，官事临身。",39,40],[11866,"门庭起干戈，家内事不和。",33,34],[11867,"时也通运也通，恰如杨柳遇春风。",19,20],[11868,"乡科及第。",40],[11869,"妾氏生子。",51],[11870,"土木之年刑妻方合。"],[11871,"细雨霏霏逐暗尘，阳台关上送行人。",59],[11872,"晦气之年，破家之祸。",47],[11873,"娶女为室，数由前定。"],[11874,"名登庠序。",27],[11875,"命犯朱雀，官事难免。",41,42],[11876,"门外起干戈，家庭总不和。",35,36],[11877,"五六年来多晦咎，七八岁内亦如之。"],[11878,"金木之年进庠，水火之年出贡。"],[11879,"侧室生子。",52],[11880,"祖宗寿有残，数注有其中。"],[11881,"晚年夫妻，难免其悲。",69],[11882,"晦气之年，破家之祸。",49,50],[11883,"桃花带路，灼灼宜人。"],[11884,"名登庠序。",28],[11885,"命犯朱雀，官事临身。",43,44],[11886,"门内起干戈，庭内家不和。",37,38],[11887,"王侯之位，五福俱备。"],[11888,"喜也生子，不幸妻亡。",19],[11889,"妾氏生子。",53],[11890,"年方十岁，其数已完。",10],[11891,"落花春去矣，飞絮景萧然。",83],[11892,"晦气之年，破家之祸。",51],[11893,"乡科及第。",41],[11894,"名登庠序。",29],[11895,"命犯朱雀，官事难免。",45,46],[11896,"门内起干戈，家庭事不和。",39,40],[11897,"家庭赓关雎之化，内助叶麟趾之休。",53,54],[11898,"金水之年进庠，木火之年补廪。"],[11899,"妾氏生子。",54],[11900,"夫命属水，命中注定。"],[11901,"母赴瑶池，三年泣血。",37],[11902,"蹉跎不利，破家之祸。",53,54],[11903,"从此数年无阻碍，殷勤教子得前贤。",65,66],[11904,"出于幽谷，迁于泮林。",34],[11905,"命犯朱雀，官事临身。",47,48],[11906,"门内起干戈，家庭事不和。",41,42],[11907,"数注其人，针工之业。"],[11908,"志学丧慈亲，终天之恨。",15],[11909,"侧室生子。",52],[11910,"演武及第。",49,50],[11911,"人生七十古来稀，胡为六九竟归期。",69],[11912,"盗贼相侵，破财之象。",57,58],[11913,"连理枝头花正开，有女入泮来。"],[11914,"出于幽谷，迁于泮林。",31],[11915,"命犯朱雀，官事缠身。",49,50],[11916,"门内不和，家室口舌。",41,42],[11917,"梅向腊中呈玉蕊，菊从霜下绽金英。",63,64],[11918,"幼年生疑忌，俄惊月夜霜。",7],[11919,"妾氏生子。",56],[11920,"大数已定，何必复查。",78],[11921,"命岁不坚，八岁登仙。",8],[11922,"乱年破家，一生难顺。",5],[11923,"命逢美运滔滔好，耿耿长明不夜天。",8],[11924,"出于幽谷，迁于泮林。",32],[11925,"命犯朱雀，官事难免。",51,52],[11926,"门内不和平，口舌起干戈。",45,46],[11927,"三岁无母，人生不幸。"],[11928,"将至古稀，一梦入华胥。",68],[11929,"妾氏生子。",57],[11930,"幼年破家，一生不幸。"],[11931,"八岁无恃，母赴瑶池。",8],[11932,"盗贼破家，钱财难留。",59,60],[11933,"童年小恙，乍雨乍风。",9,10],[11934,"名登庠序。",33],[11935,"命犯朱雀，官非本侵。",53,54],[11936,"门内起干戈，家庭事不和。",47,48],[11937,"水大有船休过渡，月明无伴勿登程。",59,60],[11938,"安然无事，家室康宁。",25,26],[11939,"侧室生子。",58],[11940,"喜也生子，不幸妻亡。"],[11941,"闺中愁怀，无计消解。",25,26],[11942,"此年丧母，人生不幸。",19],[11943,"夜雨洗开翁促眼，西风摇动伯牙琴。",75,76],[11944,"出于幽谷，迁于泮林。",24],[11945,"命犯朱雀，官非难免。",55,56],[11946,"门内干戈，家庭不和。",49,50],[11947,"终日昏昏，酒醉人间。"],[11948,"有弄璋弄瓦之喜。"],[11949,"侧室生子。",59],[11950,"百年一岁，万物总空。"],[11951,"十事心头总未全，幽魂早已入黄泉。",34],[11952,"荫荣千总，数由前定。"],[11953,"早晨已过无此事，帘幕风生锦绣香。",19,20],[11954,"泮池之年。",78],[11955,"命犯朱雀，官非难免。",57,58],[11956,"门内干戈，家庭不和。",51,52],[11957,"花甲云周风飞西。",61],[11958,"家庭迪吉，喜气盈门。",25,26],[11959,"妾氏生子。",60],[11960,"母赴瑶池，三年泣血。",38],[11961,"大椿八千岁，庄子游仙境。"],[11962,"喜也生子，不幸妻亡。"],[11963,"饮酒茹劳无我份，数中注定学道真。"],[11964,"出于幽谷，迁于泮林。",36],[11965,"命犯朱雀，官事临身。",59,60],[11966,"家庭不和，门内干戈。",53,54],[11967,"招木金之子，配水之妻方合。"],[11968,"喜中之喜生憔悴，灾处生灾事不成。",27,28],[11969,"妾氏生子。",61],[11970,"流年九岁，母赴瑶池。",9],[11971,"风急漫行江上艇，雨寒休向客中居。",19,20],[11972,"马行不觉逢中陷，宿鸟宁知暗里弓。",77,78],[11973,"屋连三五座，闲立一庭园。"],[11974,"名登庠序。",37],[11975,"只念弥陀不脱尘，在家修道一俗人。"],[11976,"门内干戈，家庭不和。",55,56],[11977,"房考之年。"],[11978,"祖亚不靠，自创家园。"],[11979,"侧室生子。",62],[11980,"母赴瑶池，三年泣血。",12],[11981,"驾鹤乘云去，飘然竟不回。",83],[11982,"桃嫩不禁三月雨，杜鹃啼血五更天。",89,90],[11983,"菊花霜威重，苍天雨露浓。",78],[11984,"名登庠序。",38],[11985,"中年食素，前生善报。"],[11986,"家庭不和，门内干戈。",57,58],[11987,"义女为役，前生注定。"],[11988,"此数甚奇，定国安邦。"],[11989,"侧室生子。",63],[11990,"幼年丧母，人之不幸。",4],[11991,"父子同登科，天发善门兴。"],[11992,"一周二岁多疾厄。"],[11993,"闺中春暖，兰馨处处挂沉香。",23,24],[11994,"名进贤关，身沐皇恩。",39],[11995,"不觉一番风雨至，不关情处也关情。",39,40],[11996,"门内起干戈，家庭内不和。",59,60],[11997,"忙来不觉春风暖，吹落冰霜满华堂。",95,96],[11998,"童年一二岁，杨柳风寒水面生。",1],[11999,"妾氏生子。",64],[12000,"一字记之曰忍，忍之海阔天空。"]]}
