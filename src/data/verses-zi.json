{"volume":"子集","verses":[[1001,"一树残花，有枝复茂。",47],[1002,"寄人廊庙，何如自立门户。"],[1003,"家业消耗，独守为难。"],[1004,"苦雨连宵，行人为难。",21,22],[1005,"日照纱窗紫艳明，柳阴枝上报新春。",11,12],[1006,"家室亨通，心安意稳。",63,64],[1007,"有意外之虞，含哺而笑。",35,36],[1008,"得人轻借力，便是运通时。",29,30],[1009,"卜君之寿，未满六旬。"],[1010,"时亨运又通，镇日笑春风。",41,42],[1011,"元贞无咎，固之所宜。",37],[1012,"荣受职任，定在此年。",17,18],[1013,"半夜西风，晚开霁色。",51,52],[1014,"斯年头带白，难免孝孤忧。",19,20],[1015,"为人不实，指东话西。"],[1016,"正妻无子，副妻有儿。"],[1017,"名登痒序，弓马入泮。",17,18],[1018,"亲近贵人，不有饶益。",19],[1019,"荣任职务，此年大幸。",20],[1020,"运未至时，未可施为。",27,28],[1021,"乾元用九，动而有成。",30],[1022,"能刚断而往事，决不类流俗。"],[1023,"无端生非，破财难免。",35,36],[1024,"偏房不结子，正室产麟儿。"],[1025,"暖到春回日，百花正及时。",27,28],[1026,"中流行舟，仔细掌舵。",52],[1027,"平康正直，问利有余。",43,44],[1028,"名登痒序，身赴儒林。",21],[1029,"日到中天，何期云雾掩其光。",25,26],[1030,"小运既通，所为稍利顺。",15,16],[1031,"年当大有，富丽时光。",40],[1032,"生平功名遂，辟雍得荣身。",19],[1033,"路旁之处见山坡，前有长须挈杖扶。",65,66],[1034,"不得失却前程在，财散免灾病中苦。",40],[1035,"拖泥带水，征途崎岖。",55],[1036,"母赴瑶池，三年泣血。",54],[1037,"命薄不由人，一世奔波苦劳心。"],[1038,"人和安乐，价值千金。",52,53],[1039,"平安年吉，人乐尧天。",59,60],[1040,"镜中之花，只可对玩。",33,34],[1041,"人事从容，所为顺利。",53,54],[1042,"功名成就，国学名香。",17,18],[1043,"托祖宗之德，初授百总之职。"],[1044,"不辛数尽。",48],[1045,"一曰元亨，再曰利贞。",55,56],[1046,"命带大凶，妄想无本全利难。"],[1047,"官拜运司而致任。",35,36],[1048,"妻生一子，妾亦如之。"],[1049,"夫妻应偕老，数注半路各分离。",39],[1050,"持弓欲射虎，无奈虎负隅。",22],[1051,"移花接木，艰难培植。",45,46],[1052,"蛟龙困于渊，未可再施为。",21,22],[1053,"数有一子送老。"],[1054,"流年运不通，冷落晚风来。",51,52],[1055,"月到云边，其光掩蔽。",67,68],[1056,"水流花落，事总难施。",23,24],[1057,"黄金埋土，未得使用。",27,28],[1058,"深山有伏蛇，行人须仔细。",56],[1059,"操江之任，立送屈原。"],[1060,"人有支离，不如守拙。",15,16],[1061,"一字君记卜之曰守。",43,44],[1062,"李陵误入太后国，高筑云台丰溪忧。",59],[1063,"生子之年。",51],[1064,"束身修德，自无蹇难之虞。",29,30],[1065,"拂度菱花垢，静而光自现。",41,42],[1066,"和气景象，人有乐意。",35,36],[1067,"绛帐橘泉名列客，不是儒林即杏林。"],[1068,"鸟囿于樊笼，神旺而不喜。",23,24],[1069,"钦命典试。",45,46],[1070,"高山流水，幸有佳音。",33,34],[1071,"良骥无差，未受如人之利。",31,32],[1072,"流年至此，事顺安吉。",39,40],[1073,"犬生两口，请君详之。",21,22],[1074,"言公接踵迟，囹圄之叹惜。",60],[1075,"风云际会功名遂，姓字沾恩雨露深。",35],[1076,"生吝才愚，一毛不拔。"],[1077,"花柳如絮，春乐宜人。",33,34],[1078,"行乐度流年，万事得安然。",37,38],[1079,"湘江游遍，衣食仅足。"],[1080,"荒江叶乱露初冷，独掉孤舟夜上流。",61,62],[1081,"婚姻早临，天喜当头。",13,14],[1082,"先培根本，枝叶畅茂。",21,22],[1083,"其人品自宏，深衿怀安乐。"],[1084,"风钦通神人共仰，伏遇提携与成家。"],[1085,"清间薄利与微名，做个都市卖卜人。",52,53],[1086,"万恨千愁，一朝尽释。",43,44],[1087,"一曰吉利，再曰亨通。",33],[1088,"告君记四字：待兔守株。",45,46],[1089,"草色逢春，始发萌芽。",19,20],[1090,"流年顾利，何事可为。",47,48],[1091,"时哉时哉，力图大用。",43,44],[1092,"耿介独立，名之曰辟。"],[1093,"平安二字，亨用之时。",75,76],[1094,"泰山秃梁木，坏天丧斯文。",64],[1095,"吉人偕同行，牵引无颠陷。",59,60],[1096,"光天化日，可以勇为。",73,74],[1097,"大道乐尧天，天佑吉利人。",65,66],[1098,"恶曜攻身，须防危险。",77],[1099,"倜倘之才，终须小试。"],[1100,"人事如愿囊中有，余钱仓中有余粟。",59,60],[1101,"临渊羡鱼，不如退而结网。"],[1102,"五彩绳牵月老话，画眉京兆许张郎。"],[1103,"奔走重山，生计他乡可兴发。",20],[1104,"架上有书堪教子，囊中无物不生财。"],[1105,"只令统指犹未得；相安无事。",55,56],[1106,"春色侵入，韶光明媚。",35,36],[1107,"险象横生，大难不死。",37,38],[1108,"颠沛无常，见闻多闷。",29,30],[1109,"六十有七，不觉文星殒矣。",67,68],[1110,"数定按台宫，至临察御史。",87],[1111,"如履虎尾，翼翼小心。",23],[1112,"金匮相扶，喜气频频而至。"],[1113,"大理为九寺之职，守三章约法之重。",41,42],[1114,"斯年四个宇，自在安乐。",53,54],[1115,"关山函谷鸡鸣早，冯缓西秦贺孟堂。",57,58],[1116,"妻生二子，妾亦如之。"],[1117,"见机而作，可以无患。",23,24],[1118,"江边风雨滩头急，钓得鱼来失却钩。",21,22],[1119,"绿暗红稀春色老，即随流水去不归。",61],[1120,"金章颁北阙，广棘寺深思。"],[1121,"斯年就有，孝服之忧。",17,18],[1122,"妻生二子，妾生二儿。"],[1123,"子陵钓于富春江，悠然自得。",49,50],[1124,"六阴之象，事不安宁。",57,58],[1125,"云连山径，树色模糊。",29,30],[1126,"父死之年，人子不幸。",20],[1127,"数有偏祜，妻生翳目。"],[1128,"数定明刑宫，至大理寺卿副省级）。",45,46],[1129,"鸟得其所，饮啄自如。",49,50],[1130,"中秋月色，分外光明。"],[1131,"知己论心解，我心傲重喜。",55,56],[1132,"马遇康庄，可以驰驱。",43,44],[1133,"命带暗疾，一目不明。"],[1134,"鸦鹊同行，吉凶自分。",13,14],[1135,"微雨洒暗天，正恼人时候。",37,38],[1136,"谢安选胜东山，终日饮酒。",63,64],[1137,"妻生二子，妾生一儿。"],[1138,"玉洞桃花，锦绣炫目。",69,70],[1139,"无兄只一弟，庶母而生。"],[1140,"风散云收，月色千里。",23,24],[1141,"逆旅穷途，得一知己喜洋洋。",49,50],[1142,"门中交争，分明破财。",21,22],[1143,"未能长驱，车脱其轮。",56],[1144,"日落西沉，人在暗中行。",33,34],[1145,"走过他乡，茫然无处归宿。",39,40],[1146,"为人多性良，一生无大患。"],[1147,"圣武恢张四海安，皇恩远庇九州庆。"],[1148,"青春柳眼眉，春光美十分。",17,18],[1149,"幸得室家欢聚，阴阳有鬼主刑妻。",57],[1150,"夕阳西下，一片彩霞。",63,64],[1151,"生涯惟有几行书，常伴青毡度岁时。"],[1152,"好运正当兴，玉出荆山色自明。",25,26],[1153,"财源恩星，从此而曜。",57,58],[1154,"事积如麻，且招其祸。",41,42],[1155,"丰年穰穰，衣食饶裕。",51,52],[1156,"不山不水问渔樵，踪迹无常谓子虚。"],[1157,"阳春布暖，天气晴明。",35,36],[1158,"日昃之离，鼓缶而歌。",81,82],[1159,"美玉无瑕玷，晴天细雨飞。",33,34],[1160,"南楼花影度栏杆，寂寞柴门夜色寒。",23,24],[1161,"托祖宗庇护，甘心守法律。"],[1162,"蔽日烟尘，行道塞滞。",27,28],[1163,"盘根错节之时，坚持利器。",19,20],[1164,"东西南北，处处有逢迎。",55,56],[1165,"小小经营成家富，微微立业创成基。",51,52],[1166,"有正已格物之风，笃人臣事君之义。"],[1167,"花发上林，锦乡夺目。",35,36],[1168,"披剪荆棘，为力之难。",41,42],[1169,"谋定无忧，贵人点头。",45,46],[1170,"耳顺欠二年，椿庭入黄泉。",58],[1171,"蓝关雪拥，马不能前。",52],[1172,"寒窗飞暗雨，万事系人怀。",57,58],[1173,"鸟栖于树，绿阴正长。",37,38],[1174,"尘封宝镜，晦滞之中应有份。",39,40],[1175,"杨花滚雪，北国风光。",26],[1176,"江州司马多情，青衫泪湿沾衣。",31],[1177,"无意之中得意，有意之中失意。",53,54],[1178,"小往大来，诸吉悉至。",51,52],[1179,"眼目不明，前生所定。"],[1180,"波纹初定，微风水面劲吹来。",53,54],[1181,"福兮祸所倚，祸兮福所伏。",27,28],[1182,"灾星相侵，大小不宁。",59,60],[1183,"进之未安，退之不可。",57],[1184,"时有寒冷，坚冰未解。",33,34],[1185,"一叶扁舟载明月，芦花两岸水盈盈。",33,34],[1186,"内有明谋，幸得贵人解脱。",41,42],[1187,"扫净风烟光会见，无名带励栋梁材。",41,42],[1188,"鱼游春水，洋洋而纵。",63,64],[1189,"母赴瑶池，三年泣血。",17],[1190,"薏苡被谤，可以思瑕。",59,60],[1191,"舍近求远，劳而无功。",39,40],[1192,"人面春风，融融乐意。",11,12],[1193,"太白饮窗下，快乐自足意。",69,70],[1194,"兄弟三人，同父不同母。"],[1195,"国学名成，光耀其身。",19,20],[1196,"国学荣身，见于此年。",31],[1197,"海棠初带雨，红泪点栏杆。",22],[1198,"门前榆柳已成蹊，绿映王孙衬马蹄。",25],[1199,"丧门相照，防有哭泣之哀。",14],[1200,"田宅竟相争，兄弟转成仇。"],[1201,"春水乐流，付之往事。",79,80],[1202,"杏花深处里，折取一枝来。",31],[1203,"此岁相亲遇贵人，北山猿笑易成人。",48],[1204,"幸得贤郎成鼎志，晚来亨福乐余年。",79],[1205,"柳絮初晴，珠帘点雪。",25],[1206,"作事漫停，重云蔽日闷沉沉。",77,78],[1207,"双生之子，一死一生。"],[1208,"衣食最艰辛，生涯猛浪度青春。",31,32],[1209,"福履绥之，子孙昌吉。"],[1210,"和风日暖，俄然风起雷声。",23,24],[1211,"鬼伏床头，飞灾相触。",29,30],[1212,"一生维绍福且隆，安然享福保其终。"],[1213,"路旁梅花，杨妃之美。",18,19],[1214,"南山松柏，岁寒之赠。",67,68],[1215,"太阳东升，阴气渐消。",27,28],[1216,"病符相照，势如黄叶迎风。",49,50],[1217,"赤兔黑鸟，室家有忌。",50],[1218,"忠厚待人，人偏相侮。",47,48],[1219,"一生近贵，名利皆有。"],[1220,"数该生子。",20],[1221,"壮志步青云，幼年为寒士。",13,14],[1222,"行到此年，数已尽矣。",21],[1223,"幽闲无事纳祯祥，几朵梅花扑鼻香。",59,60],[1224,"知君寿数高，一百还有余。"],[1225,"喜之未安，忧之又随。",27,28],[1226,"福自天来事，为求而自合。",19,20],[1227,"掘井九轫，而不及泉。",29],[1228,"立世刚而好古，一言逆而不容。"],[1229,"临风回首，揽辔三叹。",27,28],[1230,"凶神夹党，居安思危。",55,56],[1231,"行走有力，凿路可通。",47,48],[1232,"湘江雁阵，一只先投入网。"],[1233,"杨柳渐逢春色暖，松柏不怕雪霜寒。",65,66],[1234,"辛苦经商，途中遇雨贵人扶。"],[1235,"六害三刑命相触，头男长女须防哭。",31,32],[1236,"少年吉利，中途蹉跎。",15,16],[1237,"莫游盘盂中，不正自苟合。",51],[1238,"兄在东，弟在西。"],[1239,"流年顺境，家室胥庆。",35,36],[1240,"一周无过，流年顺遂。",47,48],[1241,"月照楼台，怡时行乐。",33,34],[1242,"临事慷慨，喜气融和。"],[1243,"行迈靡靡，载驰载驱。",23,24],[1244,"三党情疏，六亲意绝。"],[1245,"黄花开遍，晚节有荣。",85,86],[1246,"走遍他乡，难逢知己。"],[1247,"春风入户，棠梨上苔。",13,14],[1248,"丰年可乐业，穗足断无忧。",51,52],[1249,"枕席之畔，不测哭来。",21],[1250,"湘江雁阵，二只先伤。"],[1251,"四子送老，皆庶所出。",49,50],[1252,"贵人指引在重山，重山之外得黄金。",37],[1253,"湘江雁阵，三只先伤。"],[1254,"生涯半世一虚名，奔走徒劳费精神。"],[1255,"别境鸟啼，益我岑寂。",47,48],[1256,"腐草之余，复荣之茂。",51,52],[1257,"湘江雁阵，四只先伤。"],[1258,"抱子挈足，优游而多福。",69,70],[1259,"其子再来相遇，直遭横祸。",31,32],[1260,"授任之年。",53,54],[1261,"催官星拱照，恩自九重来。",57,58],[1262,"其年运自亨，雨润春花见清明。",23,24],[1263,"老年生子，人之大幸。",69],[1264,"拥炉围火，暖气熏人。",59,60],[1265,"此年灾祸，艰难又忧心。"],[1266,"乾龙伟度，奎壁奇姿。"],[1267,"悲似喜，喜似悲。",29,30],[1268,"寒暖无常，留心动静。",85,86],[1269,"勿以有女见嫌，数中原无子息。"],[1270,"梦之未醒，尚在颠倒他乡。"],[1271,"一阳初动，梅花几点绽寒头。",26,27],[1272,"人事称心，图谋得合。",29,30],[1273,"乡科及第。",57],[1274,"荣身之年。",27,28],[1275,"汉子于无声，君子展大成。"],[1276,"湘江雁阵，五只先伤。"],[1277,"贯索相寻，是非有日。",31,32],[1278,"谋事得合。",65],[1279,"反被小利相缠，终身不得扬眉。"],[1280,"点灯当中，以抓其烟。",53,54],[1281,"生不逢时，壮士几经挫折。"],[1282,"陆地行舟，枉费心机。",40],[1283,"一生几成几败，幸余筋骨。"],[1284,"大数已停，一樽美酒送行程。",56],[1285,"五更鸡鸣早，姓字达天聪。"],[1286,"涸泽鲋鱼，涵咏升斗之水。",55,56],[1287,"室中伏火猪，噬鼠而能焰。",31,32],[1288,"千里之才，终朝一遇。",31,32],[1289,"淡然守固，不以得失动心。",45,46],[1290,"和悦处众，内外皆称。"],[1291,"流年不宁，父死泪沾襟。",61],[1292,"高山虎威，君子得志之时。",37],[1293,"斯年灾星难免，幸得阴功可保。",45,46],[1294,"白玉投于泥沙，未得圭璋之选。",33,34],[1295,"浮云到此，其光渐掩。",69,70],[1296,"仕途恐有变，举止当谨慎。",49,50],[1297,"能酒能诗兴最谊，将来事业付儿曹。"],[1298,"狼狈一生，名利无成。"],[1299,"事业重关锁，进退两无可。",67],[1300,"虽得祖业，中途消耗。"],[1301,"数该生子，天赐老人。",71],[1302,"奴仆成行，前生所生。"],[1303,"其年该破财，官非口舌逼人来。",41,42],[1304,"非儒又非吏，浪迹为活计。"],[1305,"恁高之外有惊恐，得个贵人来指导。",17,18],[1306,"山风转过，尚有岐途。",23,24],[1307,"踪迹莫蹉跎，攸往可如非。",23,24],[1308,"奴婢成行，其人有缘。"],[1309,"贵人提挈，必成大器。"],[1310,"孝服之忧，阖门哭也。",23],[1311,"身入宫门，可以谋食。"],[1312,"朝东暮西，年来辛苦强支持。",39,40],[1313,"老于鸡夜下，白手费吟哦。"],[1314,"仕途变幻，流年不宁。",49],[1315,"数有五子，送老一枝。",79,80],[1316,"学多成少，心杂不一。"],[1317,"大运转生，福来无地。",36,37],[1318,"傍贵成家，触贵祸侵。"],[1319,"病符相照，切忌淫灾。",43,44],[1320,"阳和美景，春色逼人。",27,28],[1321,"到处交情容易报，春风车马易追求。",35,36],[1322,"不为梁上君子，定做牖下小人"],[1323,"智术能巧，弄巧反成拙。",47,48],[1324,"羞涩一文钱，巴巴结结度流年。",49,50],[1325,"文运亨通，其人锦程。",37,38],[1326,"人情好合，偏于疏处得相亲。"],[1327,"踪迹若浮萍，动止总无定。",47,48],[1328,"财星到命，数注成家皆兴隆。"],[1329,"一片江帆，千里暮云。",55,56],[1330,"四岁有灾，饮食慎重。",4,5],[1331,"终身飘荡恨无家，牛背羊头日转斜。"],[1332,"花开不结子，风雨又相催。",35,36],[1333,"生不逢时何所为，进退艰难多徘徊。",31,32],[1334,"动辄有诽谤，不合于斯世。"],[1335,"天生聪明，过目不忘。",25,26],[1336,"文章观上国，应知帝座彻金莲。",50,51],[1337,"从政孚民，万姓讴歌。"],[1338,"一妻一妾又一妻，三度见佳期。",27,28],[1339,"根基无定，早年风卷杨花。"],[1340,"慎之慎之，是非难免。",47,48],[1341,"禹门雷风动，波浪起龙吟。",20],[1342,"一点灯花报喜来，游人骑马到阳台。",63,64],[1343,"紫微星照，特开敕命之荣。",51,52],[1344,"头面有亏，前生孽报。"],[1345,"血刃交回，脓疮之灾。",90],[1346,"云破月生光，还被云遮掩。",87,88],[1347,"凶神相见欺，吉神相扶持。",55,56],[1348,"贵显高门，祖宗遗阴。"],[1349,"花将开时雨，水炉纵荣而不茂。",29,30],[1350,"名进黉门，半甘半苦度平生。",55,56],[1351,"名进黉门，半甘半苦于乡井。"],[1352,"积多金于子孙，不如积德以延寿。"],[1353,"深谋远虑，多作敢为。",39,40],[1354,"早丧严慈可奈何，蓼莪三复泪滂沱。"],[1355,"天地罗网，切忌横飞之灾。",49],[1356,"历尽辛苦，六亲骨肉总无缘。"],[1357,"龙吟虎啸，大魁天下。",58],[1358,"暮否朝泰，生计无恁。",47,48],[1359,"庭前芳草正萋萋，一夜风霜花色萎。",17,18],[1360,"功名蹭蹬，见犬吐气。"],[1361,"半夜残灯，鬼怪现形。",39],[1362,"一周二岁有关津，病晦相侵有一惊。",1],[1363,"桃子争妍，春风峭寒。",27,28],[1364,"风折椿枝，三年泣血。",62],[1365,"秦楚不和，兵连祸结。",33,34],[1366,"乡科及第。",41],[1367,"周道如砥可，无争挫之虞。",52],[1368,"深山大泽有伏蛇，吩咐行人心仔细。",68],[1369,"终身奔驰，财源耗去。"],[1370,"鸡鸣山谷，接踵高飞。",35,36],[1371,"不作生涯不耕田，还从笔里度流年。"],[1372,"花际阳春争秀色，人逢美景益精神。",31],[1373,"际遇蹉跎莫问天，还从笔里度流年。",55,56],[1374,"薏茨被谤，不可不退。",37,38],[1375,"三春柳絮，风惨西堂。",24],[1376,"一步一回头，恐有差错事。",59,60],[1377,"命有三子，得以送终。"],[1378,"家室未有安，两眉正交操。",57,58],[1379,"祸患不可测，不但人嗔且有鬼。",27,28],[1380,"妻早子早，人生最妙。"],[1381,"客阻关山，寂莫风雨。",75,76],[1382,"水年招妻，前生注定。"],[1383,"世上难逢百岁人，如今在岁有二春。",102],[1384,"雁阵同飞，突然失去五只。"],[1385,"囊中有物宜收拾，暗有群邪合伴谋。",65,66],[1386,"人事缓相求，黄河水逆流。",18],[1387,"月转西边五更天，子规啼处不堪闻。",57,58],[1388,"巩上下两江锁钥，奠东南半壁金汤。"],[1389,"人事纷纷，鹊噪鸦呜。",41,42],[1390,"晓烟遮柳，远近瞑朦。",17,18],[1391,"真假六子，四子送老。"],[1392,"疾风暴雨，倾墙及室。"],[1393,"真假五子，三子送老。"],[1394,"劳劳碌碌流年，已得安闲日又偏。",63,64],[1395,"山坡曲径处，到处有人家。",43,44],[1396,"南山风雨过，烦热消除爽气来。",35,36],[1397,"眉头交蹙，心事不足。",31,32],[1398,"以贡授职，荣禄高迁。"],[1399,"数定三分贵，恩奉九重来。"],[1400,"长途踯躅，朝入燕来暮入秦。"],[1401,"一村又一村，前村未有可停骖。",47,48],[1402,"灾星相侵，门庭闹乱。",35,36],[1403,"筑之东墙，倾之西壁。",25,26],[1404,"数有偏枯，妻目不明。"],[1405,"思患预防，乃克有济。",33,34],[1406,"买臣贡薪而行歌，其才干未可试着。",53,54],[1407,"水穷之处，坐看云生。",23,24],[1408,"太仓之粟，鼠雀耗之。",47,48],[1409,"不入泮林，定列辟雍。",21,22],[1410,"科名显达，定列文扬。",27,28],[1411,"官非相侵，闭户难禁。",39,40],[1412,"五湖水顺流，水顺好行舟。",55,56],[1413,"财帛陡发，勃不可遏。",47,48],[1414,"一门和气霭阳春，祥光拱户几色云。",65,66],[1415,"数该生子。",42],[1416,"妇性仁慈，助夫益子。"],[1417,"粪土之墙强涂朱，外面光华内里腐。",87,88],[1418,"少乐多忧，长处不足。",63,64],[1419,"祸患逼人，幸人解神。",41,42],[1420,"桑榆晚景，常享安舒。",85,86],[1421,"一举冠群英，名著当今殊。",28],[1422,"聚散无常，浮云飘荡。",40],[1423,"栏翠金钗十二行，金田良土福无疆。",77,78],[1424,"徒弟二人，一人送老。"],[1425,"沟渠淤港，冲起流通。",63,64],[1426,"梅花几片苦为情，梦断孤山起土魂。",27,28],[1427,"入于幽谷，进而倍暗。",53,54],[1428,"牡丹正当好时节，鹿鸣宴上又簪花。",28],[1429,"傲物气高，顺下逆上。"],[1430,"数该生子。",52],[1431,"黄菊东篱正色芳，俄然二朵层秋霜。",89,90],[1432,"晨昏相伴休中道，乐得清闲一位禅。"],[1433,"枯雨得雨，勃然而兴。",39,40],[1434,"古稀荣任，天发善人。",70],[1435,"七里滩头一钓翁，几经苦雨几经风。",49,50],[1436,"荷叶荡荡圆，圆后碎复圆",11,12],[1437,"妻子皆早，人生大幸。"],[1438,"功允不退，被之戮辱。",57,58],[1439,"舟在中流，帆桅顺风转悠悠。",49,50],[1440,"好梦初醒，报喜报晴。",35,36],[1441,"其人之亡，定在三月。"],[1442,"子规啼血楼，头鼓打三更。",47,48],[1443,"谋事乖离，东转西驰。",37,38],[1444,"兄弟十人，数有五贵。"],[1445,"一轮红日下西山，远出主人尚未还。",65,66],[1446,"马首载辔，驰骤千里。",49,50],[1447,"杨花成阵阵，点点着人衣。",27,28],[1448,"明月转东楼，朱衣暗点头。",29],[1449,"崎岖已应历，今已见亨通。",75,76],[1450,"千里暮云路，迢迢莫问津。",55,56],[1451,"好花枝落，结子篱边。",50],[1452,"命当短促，徒增父母之悲。",5],[1453,"荫祖父基业，不止而守成。"],[1454,"麟儿生下，无刑克之伤。"],[1455,"三径黄花落，渊明解印时。",51,52],[1456,"黄鸟出谷，已迁乔木。",23,24],[1457,"懿哉荫泽之博施。",43,44],[1458,"少年壮而老，总无安闲心。"],[1459,"心性虽急而无毒。"],[1460,"东风入画堂，和气生满室。",65,66],[1461,"品优性温，事难决断。"],[1462,"花色更新，春色几时。",56],[1463,"几番雨打柳花球，一阵风吹上舞楼。",41],[1464,"月照楼台，及时行乐。",81],[1465,"愁愁闷闷，多少离人恨。",25,26],[1466,"性急而雄躁，扶弱而抑强。"],[1467,"兄弟三人，先损其二。"],[1468,"日照桑榆，犹足三千里。",61],[1469,"晦气侵入，朦胧度日。",45,46],[1470,"步步回头，坎坷已过。",63,64],[1471,"犹之复喜，得意失意。",17,18],[1472,"少壮而老，发愤无穷。"],[1473,"大数已到，发福无穷。"],[1474,"蓉菊初开，晚霞始落。",41,42],[1475,"兄弟三人，数有一贵。"],[1476,"家室康宁，流年之庆。",50],[1477,"莫嫌花色淡，黄花晚节香。"],[1478,"柳岸花飞春欲尽，愁人寂寞倚栏杆。",21,22],[1479,"数至太史官，至修撰东迁。"],[1480,"始舍圉圉，因而未纵。",23,24],[1481,"既乘其时，可以有为。",17,18],[1482,"经营湖海，仅值千金。"],[1483,"兄弟四人，三死非命。"],[1484,"欲是高楼未有梯，不能举步上扳跻。",11],[1485,"路当坦途，可以安步。",55,56],[1486,"花开尽矣。",59],[1487,"杀重身轻，须延其寿。"],[1488,"妾生三子，妻生一儿。"],[1489,"沙边鸥鸟，相依忘仇。",19],[1490,"鸾坡视草官，至侍读荣身。"],[1491,"利见大人，无往不利。",21,22],[1492,"手中持拮据，争奈不求人。"],[1493,"且将心事付诸虚，纵有强梁不用忧。",35,36],[1494,"其年有刑，丧骨肉叹凄凉。",41,42],[1495,"老年丧子，人生不幸。",61,62],[1496,"东篱黄菊正芬芳，相看白衣送酒归。",67,68],[1497,"根浅风狂，树将吹倒。",14],[1498,"班师皆相庆，人民诵西平。",45,46],[1499,"兄弟三人，数奏几般音。"],[1500,"枯木逢春，岁月峥嵘。"],[1501,"钦命典试。",47,48],[1502,"兄弟七人，数有三贵。"],[1503,"道路崎岖，行人不辨东西。",45,46],[1504,"早运沉淹志未伸，纵然才大也难成。"],[1505,"春花开时锦绣丛，风月晴和人意浓。"],[1506,"其年孝孤，蹙在眉头。",47],[1507,"鬼伏前途，朝暮仔细。",45],[1508,"梦兆飞鸿，官禄高擢。",30],[1509,"一道恩光下九理，封侯庙堂立奇功。",73,74],[1510,"扶杖过危桥，心机又恐慌。",68],[1511,"秋庆春常卿，月照庙堂彩。"],[1512,"麟经第一，凤翥无只。",31,32],[1513,"身冒知石，险阴无虞。",63,64],[1514,"享皇家之乐，济黎庶之忧。",21,22],[1515,"祖宗之业不守，子孙之基有余。"],[1516,"杨花扑面，三年泣血守亲帏。",63],[1517,"秩秉三来。"],[1518,"兄弟三人，乐奏几般音。",27,28],[1519,"天授衡士，归子司命。"],[1520,"老虎无牙，得解得脱。",24],[1521,"妻生一子.妾生一儿。"],[1522,"恩难图易，事巧有济。",47],[1523,"权重天关，山高日寺。"],[1524,"万里晴空，天开眼目。",53],[1525,"落花能结子，无弗又嫌迟。"],[1526,"龙吟苍海，云起飞腾。",55],[1527,"文星守命，官至主侍读荣身。"],[1528,"渡江风正好，欢聚趁潮来。",51],[1529,"流年驳杂是非多，三番四覆。",21,22],[1530,"到老有精神，黄花晚节新。",99,100],[1531,"事乖似花枝，零落东风里。",54],[1532,"名利两悠悠，春去又复秋。",27,28],[1533,"营谋笔墨到公门，熟读萧曹有异名。"],[1534,"课雨占晴茅，檐仅可逍遥。"],[1535,"可恨灾星不可逃.阴阳愆度祸相遭。",63,64],[1536,"不见舟人未有来，大江风雨船难开。",29,30],[1537,"幄幄从容，韶光明媚。",29,30],[1538,"田园丰阜，家室安宁。",63,64],[1539,"头生两角，事多差错。",55,56],[1540,"官至布政，恩照万民。",49],[1541,"武曲照命，弓马入泮。",23,24],[1542,"凉风吹落叶，飘飘在墙角。",78],[1543,"少年登科第，皇都得意回。",39],[1544,"中馈人亡，未免寂寞。",50,51],[1545,"兄弟二人，秦楚干戈。"],[1546,"谨慎才富，束兵爱民。",43,44],[1547,"屈子于长沙，时之未遇机。",25,26],[1548,"雨中荷叶，风到珠落。",11],[1549,"槽中有马宜收拾，一走长征去路遥。",43,44],[1550,"葭萌飞灰，功名取之如反掌。",20],[1551,"勋齐宗伯皇，风杨孔乐辉。"],[1552,"兄弟三人，数当尽贵。"],[1553,"点灯相照，往来大道。",29,30],[1554,"仁声四达，昭于群生。",45,46],[1555,"椿庭已折，泣血三年。",67],[1556,"举人授任，爵禄荣迁。"],[1557,"财利有余，事事得意。",37,38],[1558,"开辟抑提衡之任，一人资秉笔之司。"],[1559,"兄弟四人，乐奏几般音。"],[1560,"数有五子，三子送终。"],[1561,"荆棘黄华，勾庐在位。"],[1562,"西园春老，桃李无颜。",47,48],[1563,"上下得和同，家门喜气多。",45,46],[1564,"巴巴急急，争个度日。",23,24],[1565,"明月照前堤，征夫露湿衣。",23,24],[1566,"数定天符星，尚主寺卿职。"],[1567,"大限已定，卢衣乐之。",62],[1568,"一轮明月出扶桑，瑞气盈盈出画堂。",25,26],[1569,"老景安康，身强力健。",67,68],[1570,"勾索相逢，交争扰害。",41,42],[1571,"姊妹一人，先损一丁。"],[1572,"将军之箭最难当，此岁身亡。",63],[1573,"富有千钟，更添好景。",23,24],[1574,"东转西行是山蹊，得遇樵人指路迷。",25,26],[1575,"婚姻早配，琴琴未离弦。"],[1576,"披麻无情，姑命当顾。",41,42],[1577,"无荣无辱，斯为多福。",21,22],[1578,"凉风已近，一解烦焦爽气来。",25,26],[1579,"数应行使，官至行人之职。",49,50],[1580,"披胜相侵，晦气无情。",30],[1581,"桐叶初落，秋色已动。"],[1582,"退思有得，进则有失。",25,26],[1583,"博古通今，官至有司之职。"],[1584,"失尾却晚，群鬼见之而走。"],[1585,"异路而选照，磨数由前定。"],[1586,"薏苡被谤，仕途有阴抑之非。",45,46],[1587,"几点寒星，明明复灭。",80],[1588,"五行无驳杂，一举冠群英。",39],[1589,"久居簪缨之班，益峻梅羹之望。"],[1590,"富有千钟，安亨无穷。"],[1591,"觅得金鳞替钓丝，江头月落醉眠时。",53,54],[1592,"杨花扑面，泣血三年。",69],[1593,"一病相侵，半身晦气。"],[1594,"方懋服德，天与荣身。",69],[1595,"老来无子，以族子为儿。"],[1596,"六害无情，骨肉有刑。",29],[1597,"名进黉宫，弓马入泮。",31,32],[1598,"数定赞画官至五，府察院内庆荣迁。"],[1599,"父殆于水，欲见无由。",21],[1600,"得外来之财，因而起家。"],[1601,"柳絮摇新绿夹岸，晓烟收挂主平安。",17,18],[1602,"柳花带雪，满园开放。",55,56],[1603,"双挂珠绿，洞房花烛。",19,20],[1604,"数定赞画官至都，府察院内照荣升。"],[1605,"其人之亡，定在正月。"],[1606,"登高远望，无边景色。",67,68],[1607,"披发相侵，口舌交争。",27,28],[1608,"生子之年。",18],[1609,"寿数将满百，竟作天仙客。",98],[1610,"凿井得泉，亦能解渴。",49,50],[1611,"松柏有常青，耐寒岁月稠。",69,70],[1612,"尊至九重之上，万岁称呼。"],[1613,"阴蛴不分，晚有景色。",49,50],[1614,"桃花五千树，锦色若绵绵。",15,16],[1615,"文运天开，科名高第。"],[1616,"周年应有灾，雾色片云迷。"],[1617,"数有二子，得以送老。"],[1618,"演武及第。",31,32],[1619,"兄弟五人，秦楚不盟。"],[1620,"绿荫婆婆丝，行人喘息未安舒。",49,50],[1621,"鬼怪出世，破财多失。",27],[1622,"数有六子，送老得二。"],[1623,"高山之调，未遇子期。",33,34],[1624,"数至赞画官至都，府察院内讨荣衔。"],[1625,"朝霞布锦，画堂形色。",23,24],[1626,"三代遗民，不复多见。"],[1627,"命带刑伤，克夫无子。"],[1628,"门前柳色报芳菲，裘马翩翩踏紫微。",52,53],[1629,"缘木求鱼，难得其利。",23,24],[1630,"数该生子。",52,53],[1631,"耳须之年晚景奇，皇都得意在春闱。"],[1632,"官居都堂，爵高禄厚。",60],[1633,"虽一女子，女中丈夫。"],[1634,"大限如何，逍遥门外之欢乐。",73],[1635,"兄弟六人，数有五贵。"],[1636,"春风大户来，和气畅人家。",33,34],[1637,"烟锁池塘柳，阴暗迷人走。",39,40],[1638,"曲道推车，进退两难。",45],[1639,"宿雨初收，春山润色。",47,48],[1640,"东风解冰，依旧春色。",23,24],[1641,"周公流言底，谨慎而退避。",43,44],[1642,"鱼化为龙，庆云相从。",41],[1643,"瞽一目跛一足，前生孽报。"],[1644,"枝头惫鸟，可以退避。"],[1645,"恶曜攻身，当有恶报。",79,80],[1646,"晚来风紧，花枝披离。",45,46],[1647,"春酒今朝熟，欣然醒北邻。",57,58],[1648,"庙堂知重器，宝鼎玉居先。",51,52],[1649,"芙蓉金菊正秋容，雅淡春生乐意浓。",55,56],[1650,"兄弟六人，中断离群。"],[1651,"疏复反复，命有羊刃。"],[1652,"溺爱不明，兄弟明争。"],[1653,"祸侵无常，只闻多闷。",39,40],[1654,"一年三迁，春风得意。",27,28],[1655,"此刻生人，金水之年必遇险。"],[1656,"天官首卿，班列太宰。"],[1657,"病符星照命，数定获缠绵。",19,20],[1658,"克宽克明，布仁彰信于兆民。",47,48],[1659,"柔而无断酿，家门之阴祸。"],[1660,"文昌为八座，名位列中台。"],[1661,"青灯自守命犯孤。"],[1662,"生子之年。",42],[1663,"妻生一子，妾生二儿，"],[1664,"一日不利，再曰蹇滞。",30],[1665,"简在宸衷，抉命铨部。"],[1666,"明月钓嫦娥，清风洒泪多。",27,28],[1667,"不必问行藏，老运不安康。",59,60],[1668,"农业兴隆，运至时通。",33],[1669,"寿比颜回多一旬。",42],[1670,"病符逼人，恍惚忧惊。",33,34],[1671,"数难回头，实定一铨。"],[1672,"丧门照命，哭泣之哀。",45,46],[1673,"宝镜未磨，滞中有明。",45,46],[1674,"勿以轻舟渡海易，旁人先戒飓风号。",57,58],[1675,"一卷青囊，普照万家风雨。"],[1676,"黄甲传宣，春闱奏捷。",23],[1677,"或泣或歌，室中伏祸。",23,24],[1678,"心忙身劳，只见儿女情长。"],[1679,"姻缘奇配，夫步青云。",50,51],[1680,"寒毡冷落几黄昏，风雨潇潇早闭门。"],[1681,"分有嫡母，我生是庶。",11,12],[1682,"马到嵬坡，前有所阻。",37,38],[1683,"君子不锁，握有铨曹。"],[1684,"凉风初楚王台，烦热消除爽气来。",53,54],[1685,"己知其足，自然无辱。",59,60],[1686,"眉端不挂烦恼，安舒自如。",57,58],[1687,"分有嫡母，我生继母。"],[1688,"闭塞其户，四壁有光。",67,68],[1689,"命照武曲，弓马入泮。",33,34],[1690,"崇天朝宥密之府，阶元老伛偻之任。"],[1691,"冠裳还是旧冠裳，龙虎相逢姓字香。"],[1692,"人生不幸，老年丧夫。",64,65],[1693,"求炎必得，得之必失。",35,36],[1694,"道洽正治，泽润万民。",33,34],[1695,"近贵不如近帝好，操心那及道心高。"],[1696,"若问功名，国学名翔。",33,34],[1697,"如何塞北独无春，二月中旬草不生。",19,20],[1698,"阴极一阳，天道还转。",51,52],[1699,"解印荣归，平安之福。",61,62],[1700,"官拜巡抚，荣归画堂。"],[1701,"苇杭客可渡，光涌有奔泉。",56],[1702,"不因人依谤，赖有骨肉情。"],[1703,"锋然守于吝，中无为之时。",47,48],[1704,"枯木逢春芽特达。",29,30],[1705,"命主刑夫，应作妾室。"],[1706,"相如病千金，马际曾佳期。",56],[1707,"吉凶并主。"],[1708,"兄弟二人，秦楚不同盟。"],[1709,"昔提弹夹食无鱼，今年弹夹出有车。",41,42],[1710,"外物不可必，听之斯有得。",53,54],[1711,"大开轩窗，高下八方。",60],[1712,"叠断其路，往来不通。",79,80],[1713,"反复又反复，或时笑或时哭。",19,20],[1714,"吞陷与亡神，并力相侵扰。",65,66],[1715,"海棠沾露，泪洒红襟。",38],[1716,"先生不是等闲人，龙跃于渊屈可伸。",37,38],[1717,"胆大如天，破家之祸。",59,60],[1718,"鸟在檐前啼，谋为事事宜。",47,48],[1719,"高堂椿树正扶苏，不料狂风吹折枝。",68],[1720,"既乘其时，当人其用。",25,26],[1721,"屡进屡退，事多反覆。",43],[1722,"可恨姻缘不到头，此年应有所担忧。",59],[1723,"玉洞梅花，含笑春风。",31],[1724,"云深峰顶黑，山杂岭头高。",58],[1725,"仕途还有梦，举止当慎重。",57,58],[1726,"南柯梦入华胥回，忆昔英雄笑语中。",61],[1727,"时运不通，谋事掣肘。",43],[1728,"五轮光满至，十月有清寒。",27,28],[1729,"老蚌生珠，修德报不爽。"],[1730,"天禄有情，纵然官讼害。"],[1731,"人事有恍惚，朝夕有忧疑。",72],[1732,"身在公门心在道，多逢吉庆少逢凶。",63,64],[1733,"劳神劳形，仅能糊口。"],[1734,"扁舟设钓儿，顷刻有招非。"],[1735,"和悦近人，到处恰心。"],[1736,"运未来时，只好悠悠坚守。",41,42],[1737,"性急不容多好胜。"],[1738,"风动辟雍，万姓安康。",51,52],[1739,"补掖行人之职。"],[1740,"逸而有始终，延年而获寿。",81],[1741,"灾生不急，晦气缠绵。",37],[1742,"牡丹花开，春园姿容。"],[1743,"用人不疑，疑人不用。",39,40],[1744,"温温恭人，维德之基。"],[1745,"舟在波浪，操楫着力。",58],[1746,"片帆无恙，长江一夕遇春风。",27,28],[1747,"惟山崔嵬，马劳偃病。",14],[1748,"花径深秋有苍苔，竹杖相扶仔细来。",58],[1749,"晚烟迷漫，满江风雨。",24],[1750,"秋色蘼芜转晚凉，只余黄菊满庭芳。",65,66],[1751,"燕子含泥春正长，经营费尽枉无功。",32],[1752,"经恩济人，反招其怨。"],[1753,"夕阳古道行，人生正徘徊。",57,58],[1754,"江流水势涌，且把钓鱼竿。",49,50],[1755,"马足奔波，车不可行。",33,34],[1756,"风火烈性，决无成心。"],[1757,"椿庭一病成回首，笑语依稀梦中逢",44,45],[1758,"乘其机会，进取有功。",35,36],[1759,"牧牛丰草地，可以守之余"],[1760,"马至中途，逢坎失足。",61,62],[1761,"早运淹沉中运通，成家立业自兴隆。"],[1762,"行人指迷津，回头杳无音。",75],[1763,"南轩新霁色，人帘钓鱼机。",61,62],[1764,"千里蟾光彻夜明，碧空湛湛净无尘",45,46],[1765,"泪流满面，愁积腔怀。",35,36],[1766,"阴山积雪丈，穹空无阳气。",21],[1767,"银灯照复残，掩映照愁怀",19],[1768,"寿元足矣。",90],[1769,"官至黄堂，不能高握。",49,50],[1770,"醉乡深处，鞭乐莫为。",43],[1771,"有酒盈樽，春风一面",21,22],[1772,"暖风春回，芳草生机。"],[1773,"操切太急，祸在萧墙。",37,38],[1774,"劳苦成家，晚享佳福。",53,54],[1775,"独行踽踽，御侮无人。"],[1776,"守其硗田，庶几无失。",33,34],[1777,"万花谷中，日接不暇。",53,54],[1778,"南楼杜鹃，更尽无声。",44],[1779,"真假四子，二子送老。"],[1780,"几多无了事，只恨一无常。",39],[1781,"傍个贵人得成家，次第分明有好处。"],[1782,"谋事成而又败，不如守拙为高。",39,40],[1783,"路中有伏蛇，虽惊而无害。",63,64],[1784,"送终一子，身带残疾。"],[1785,"兄弟六人，数有三贵。"],[1786,"武陵溪畔有渔塘，指引云衢达仙乡。",49,50],[1787,"薏苡被谤，难免流言。",53,54],[1788,"度秦岭关，葛藤缚足。",79,80],[1789,"朝囊夕飧，克享成福。",63,64],[1790,"问名无成，问利不益。"],[1791,"灾晦缠身，有犯太岁。",81],[1792,"命中多舛，家业消耗。",53,54],[1793,"夜色风色繁，寒气正愁人。",57,58],[1794,"顺风江上好扬帆，不料江头有石滩。",45,46],[1795,"气顺和悦，宜其家室。"],[1796,"赋性仁慈，持躬淑慎。"],[1797,"太阳正东升，江山气象新。",57,58],[1798,"神祖扶庇，登甲钦点一翰林。"],[1799,"小顺大逆，苟全性命。",29,30],[1800,"切莫问功名，费心总无成。"],[1801,"性禀优柔，难以决断。"],[1802,"据般若姿，仡然未动。",79,80],[1803,"时运未至，欲前却后。",43,44],[1804,"钦选黄堂太守。"],[1805,"道途正崎岖，行止费踌躇。",17],[1806,"性质高谊何，其命宿孤寒。"],[1807,"心多好胜，恃而凌人。"],[1808,"行舟浅水，却费推移。",55],[1809,"丹桂一枝开，秋风得意回。",35],[1810,"草木逢春，千村雨顺。",38,39],[1811,"时逢恩星，富贵之期。",37,38],[1812,"荡澜轻舟，顺风顺水。",13,14],[1813,"流年驳杂，烦恼难舒。",31,32],[1814,"车辙满泥沙，转动多费力。",41,42],[1815,"夜行舟道，坦然无阻。",45,46],[1816,"菱荷香处，亭畔披襟。",55,56],[1817,"不从文武科中出，命有总督一将官。"],[1818,"烟波渺渺，舟人厌倦。",72],[1819,"灶法荣归，家声大振。",63,64],[1820,"一阵轻风，南轩爽快。",75,76],[1821,"平平稳稳，无喜无忧。",11,12],[1822,"倚楼邀明月，掩映至南轩。",55,56],[1823,"斗转星移，日出扶桑照曜明。",59,60],[1824,"家业千金，未可量陶朱堪比。",55],[1825,"不从文武科中出，命在营伍大丈夫。"],[1826,"所谋不合，命途多险。",41,42],[1827,"兄弟十一人，乐奏几般音。"],[1828,"官居臬司，不能高抬。"],[1829,"祥光宜见，古曜相扶。",57,58],[1830,"喜偏房之多娶。"],[1831,"大数已尽，痛切泪涟。",49,50],[1832,"萧墙之内，暗伏凶神。",53,54],[1833,"持家之妇，姻缘前定。"],[1834,"解组林下，心逸身闲。",51,52],[1835,"鸟展其翅，乘风南徙。",51],[1836,"有人相欺，囊中有天。",67],[1837,"父死之年。",56,57],[1838,"富贵之期，世上仰之。",39,40],[1839,"布政风威，为人师表。"],[1840,"上山多费力，有树可扳枝。",21,22],[1841,"老年丧父，世上难逢。",71],[1842,"虽然妻已死，犹恐晚年孤。",70],[1843,"万里晴空，明月一轮。",53,54],[1844,"水出芙蓉更新鲜，鸠鸣唤雨色如烟。",17,18],[1845,"日之夕矣，山阴道上未曾归。",48],[1846,"洞房之喜，定在此年。",20],[1847,"数有不幸，母适他家。"],[1848,"明月上初弦，其光渐渐圆。",25,26],[1849,"时逢恩星，当贡之期。",33,34],[1850,"杏蕊未全红，浮云飞去月朦胧。",31,32],[1851,"恩星照命，一贡成名。",21,22],[1852,"半吉半凶，一喜一忧。",49,50],[1853,"行在急流处，其舟有破漏。"],[1854,"一朵名花果出奇，嫉风骤雨又相催。",39,40],[1855,"梦在颠倒，得人唤醒。",31,32],[1856,"当贡之期。",35,36],[1857,"禹门雷风动，波浪起龙吟。",31,32],[1858,"骨月凋残可奈何，半生穷途半生孤。"],[1859,"舟行浅滩，午潮正落。",35,36],[1860,"道路有坎坷，行人便仔细。",43,44],[1861,"勿谓轻舟易行，谁知车折其福。",57,58],[1862,"月转初旬，缺而渐回。",51,52],[1863,"龙起飞腾会，飞腾上九天。"],[1864,"呼之转应，天从人愿。",27,28],[1865,"文星照命，功名显达。"],[1866,"暮夜须防疏生人。",61,62],[1867,"黄花开晚节，翠竹茂松林。",67,68],[1868,"乡科及第。",40],[1869,"将星照命，威镇三军。"],[1870,"兄弟四人，中断离群。"],[1871,"数有五子，三子送老。"],[1872,"奔走尘埃前，高低任意行。",57],[1873,"高堂之树正扶苏，不料狂风吹折枝。",57],[1874,"谋之无不利，是畅怀所来。",77,78],[1875,"入幽谷中，进而倍暗。",21,22],[1876,"恩星相照，当贡之期。",29],[1877,"风平浪静，恰好行舟。",79,80],[1878,"意气待人，忌之牛口之下。",31,32],[1879,"福来佑人，逢凶大吉。",35,36],[1880,"飞霜落瓦，形影凄然。",37,38],[1881,"霁色似初晴，东方仿佛明。",90],[1882,"武场捷报。",33,34],[1883,"大鹏有健翅，东风便飞升。",35,36],[1884,"无意栽花卉，山上林锦绣。",29,30],[1885,"老夫老妻，难免其悲。",67],[1886,"碧水桃花下，红雨点罗襟。",24],[1887,"烟尘蔽日，人物糊涂。",59],[1888,"薰风东来，和气满怀。",55],[1889,"兄弟成群，非一母所生。"],[1890,"得意马蹄，踏遍长安春色。",32],[1891,"操守有方，举止不苟。"],[1892,"百花如锦绣，春色正芳菲。",53,54],[1893,"梦入南柯境，不必问遐龄。",51],[1894,"有笼罩古今之才，无科甲两榜之荣。"],[1895,"此刻乃得贵妇人。"],[1896,"此年运小，吉凶常寻。",55,56],[1897,"功名卜有分，还须自厚培。"],[1898,"两岁而亡，如花不久。",2],[1899,"花径阴移，恍惚生恐。",33,34],[1900,"东边日出西边雨，一朝几度怨无端。",19,20],[1901,"凄凉苦雨，寂莫愁人。",19,20],[1902,"乍暗乍明云里月，半开半落雨中花。",53,54],[1903,"高山嵯峨，无门卜筮。",52],[1904,"天怨人怨阴阳愆，事不遂谋鬼又缠。",49],[1905,"泪痕未干，镜破残妆。",30],[1906,"爵位方伯之尊，亦是外台极品。",61],[1907,"东西料峭，白云生寒。",35,36],[1908,"风暖鸟儿碎，日高花影移。",3,4],[1909,"一夫又一夫，命里犯刑孤。"],[1910,"严父数已尽，难留在画堂。",65],[1911,"图名逡图利，易可却名而问利。"],[1912,"一群女行人，一双先伤失。"],[1913,"山高水深，虽有舟车不易行。",63,64],[1914,"诗书未缘，白首是穷年。"],[1915,"数该生子。",30,31],[1916,"财源滚滚来，家室安康在。",27],[1917,"此刻生入，流年有咎。"],[1918,"鹞入林中，鸟雀有恐。",19],[1919,"秋风先有信，丹桂一枝开。",58],[1920,"兄弟十人之外方合。"],[1921,"父母拮据而起家，子孙能守其成功。"],[1922,"身心不快，知已难老。",59,60],[1923,"房考之年。",47,48],[1924,"老来有刑伤，父母泪两行。",66,67],[1925,"兄弟十二人，数有二贵。"],[1926,"烟光渐起，江山依旧。",95,96],[1927,"徒弟二人，得以送老。"],[1928,"皇都恩波，赐我一贡。",25,26],[1929,"数有几妾，死于非命。"],[1930,"吉凶并行。",57,58],[1931,"恶曜攻身，有犯太岁。",76],[1932,"古稀之年父死矣。",70],[1933,"兄弟六人，数有四贵。"],[1934,"星夜平分，更饶物色。",51,52],[1935,"少年登贡，祖宗庇荫。",17,18],[1936,"圆月如环用不穷，祸自消除福自隆。",39,40],[1937,"春光布暖，万物滋荣。",66],[1938,"渠花生水，却脱泥淤。",43,44],[1939,"作事刻薄，骨肉目侧。"],[1940,"暖风迟日正熙春。",5,6],[1941,"陇头报消息，春色一枝梅。",51,52],[1942,"命中一子，如龙如虎。"],[1943,"呼童携行李，不必问东君。",64],[1944,"可知扑鼻梅花香，直待严寒争春来。",59,60],[1945,"天育其秀，迥出异常。"],[1946,"有妻生活，离缘不相宜。"],[1947,"国学名香。",19,20],[1948,"疾风又怒电，浊浪卷波平。",61],[1949,"新篁始解，节老便成竿。",13,14],[1950,"绸缪不少，快意无多。",37,38],[1951,"皇都得意，一贡成名。",23],[1952,"男女总无缘，到老艰辛不可言。",79,80],[1953,"偏不如意，多招怨悔。"],[1954,"芦花明月两悠悠，一点渔灯古渡头。"],[1955,"若问寿元何日止，六旬加九是归期。",69,70],[1956,"秋天月色，上下清光。",53,54],[1957,"风光行处好，云物望中生。",5],[1958,"此刻生人，父亡于木年方合。"],[1959,"画虎于墙，见者惊而无害。",51,52],[1960,"兄弟十人，秦楚不同盟。",52],[1961,"寿元七旬，大数已尽。",70],[1962,"暗中行路，无人点火相助。",31,32],[1963,"小舟水上行，转换一帆风。",21,22],[1964,"岂是聪明果让人，谋略左右恨无穷。",45,46],[1965,"兄弟六人，乐奏几般音。"],[1966,"托祖宗之业，可以守成。"],[1967,"前路崎岖未可行，不如守拙且消停。",49,50],[1968,"寿元何日止，七旬加五是归期。",75],[1969,"竹风摇履鸟，花露腻衣裳。",7,8],[1970,"无端风雨到南楼，惟有红妆落在秋。",43,44],[1971,"补授评事，清安之职。"],[1972,"华堂日暖，花锦丛多。",49],[1973,"三岁逢条神，提携须防忌。",3],[1974,"若问岁元何日止，六旬加五是归期。",65],[1975,"哀哉母亲，何以长逝。"],[1976,"当有三母之称。"],[1977,"经营千里走，马囊遍黄金。"],[1978,"双目朦胧，前生注定。",13],[1979,"梨花风阵阵，片片白云飞。"],[1980,"两耳虽有竟不听，随人说短与谈长。"],[1981,"其人之亡，定在三月。"],[1982,"寿元何日止，六旬加六是归期。",65,66],[1983,"淑人君子，其德不回。"],[1984,"满招损，谦受益。",23,24],[1985,"命途多蹇，家业少聚多散。"],[1986,"君子豹变，文明之家。",23,24],[1987,"板桥滑湿，行人有成。",29,30],[1988,"小宋应熊罴，二子可得之。",27,28],[1989,"本是天家云路客，暂守青毡度岁时。"],[1990,"日照桑榆，马足犹堪三千里。",61,62],[1991,"苦雨连霄，凄凉之象。",51,52],[1992,"临事能任，其性急躁。"],[1993,"托祖宗之德，授百总之职"],[1994,"少年登贡，人生大幸。",19,20],[1995,"红鸾相照，洞房花烛。",29,30],[1996,"母病入膏肓，扁鹊医不长。",20],[1997,"山高尽处，转之路通。",31,32],[1998,"当贡之期。",21,22],[1999,"知命短少年，大限入黄泉。",49],[2000,"大数已尽矣。",73]]}
