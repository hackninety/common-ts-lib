{"volume":"寅集","verses":[[3001,"韶光明媚，瑞气融融。",67,68],[3002,"行径盘恒，居止未利。",21,22],[3003,"数有不幸，母死于非命。"],[3004,"子登科甲。",35,36],[3005,"乍雨乍晴，春光不定。",42,43],[3006,"官至史部，解级林下。"],[3007,"千仓万箱，当寿且康。",61],[3008,"自立自持，鸿雁孤飞。"],[3009,"官至总督，仕高爵厚。"],[3010,"至此数完，何必复行。",31],[3011,"许子不禅，劳而不功。",23,24],[3012,"不求人自足，图个清闲福。",99],[3013,"一字切记：曰五住不得。"],[3014,"力能拮据成家业，中运平平老景隆。"],[3015,"父命木年生方合。"],[3016,"谈笑之言凑机会，一路升平得意回。",41,42],[3017,"顺受其正，厥德日新。",55,56],[3018,"老年康健，福禄荣高。",71,72],[3019,"兄弟五人，数有二贵。"],[3020,"满目照光观不尽，一旦无常作故人。",39],[3021,"鹊巢鸠占，愁绪无边。"],[3022,"千里经商抵海涛，命逢驿马数中该。"],[3023,"太岁到鼠年，天下太平安。"],[3024,"前妻生二子，后妻生三儿。"],[3025,"正欲挥戈向日，俄而天阙坠其星。",54],[3026,"得意时东下齐城。",72],[3027,"杨花飞絮来，丧服数中该。",13,14],[3028,"叹明月举案，齐眉知何时。"],[3029,"家无不足，虫鼠耗之。",57,58],[3030,"平安为福，不实生危。",27,28],[3031,"只可守株等兔，不可缘木求鱼。",44],[3032,"抛别妻儿万古愁，青山绿水空悠悠。",40],[3033,"祖阴隆厚，化险为夷。",2,3],[3034,"子占科名。",83,84],[3035,"兄弟四人，乐奏几般音。"],[3036,"剑遇张华贵，马逢伯乐高。",43,44],[3037,"正驾高帆游大海，忽然一阵打头风。",39,40],[3038,"白虎入牛年，速解免困顿。"],[3039,"一湾流水，源源不绝。",23,23],[3040,"母命木年生方合此刻。"],[3041,"五母鸡二母猪，享田园之乐。",57,58],[3042,"水尽山穷处，万事总成空。",43],[3043,"佩玉幸遇良工讷，免令终岁隐于山。",27,28],[3044,"春色侵人，吉利可恁。",30],[3045,"富贵从此到，福禄自天来。",43,44],[3046,"兄弟六人，数有二贵。"],[3047,"有灾复有灾，厄畔有忧来。",49,50],[3048,"白虎在寅年，祈福免灾厄。"],[3049,"日月得悠悠，寻常不用求。",69,70],[3050,"一枕黄粱万事空。"],[3051,"水尽山空命不坚，渺渺茫茫别春天。",42],[3052,"赖有祖父栽培，根基永固。"],[3053,"风景独好，已近黄昏。"],[3054,"孔子遭於匡，因貌似阳虎。",46],[3055,"廉颇未老，威镇三关。"],[3056,"难进易退，退步为高。",19,20],[3057,"披息浪平，行舟得利。",33,34],[3058,"太岁犯兔年，解送免灾厄。"],[3059,"天上玉书召，地下失英雄。",69],[3060,"背水一战，夷从险生。"],[3061,"寿穷数尽不堪悲。",43],[3062,"惟德动天，利贞吉亨。",55],[3063,"子当入泮。",33],[3064,"积有钱财，发家致富。"],[3065,"春风吹柳絮，新绿映人怀。",18],[3066,"生子之年。",61],[3067,"草木得红，根叶滋培。",33,34],[3068,"太岁犯龙年，预解免灾缠。"],[3069,"平地起风波，人在浮沉里。",57,58],[3070,"知进知退，可保忧虞。",27,28],[3071,"鸦鸣鹊噪，吉凶相伴。",35,36],[3072,"雪点红炉，祸患潜消迎百福。",60],[3073,"牧牛南亩，山下祸起。",41],[3074,"官至尚书，荣归华堂。"],[3075,"姐妹四人，婚姻奇配。"],[3076,"获芦佛子江能渡，莲华佩人海可航。",39,40],[3077,"虎帐之尊，惟威惟赫。"],[3078,"母日云亡，孝为相当。",24],[3079,"太岁犯蛇年，急解免灾缠。"],[3080,"左右逢酒，随心所欲。"],[3081,"子占科名。",57,58],[3082,"太岁犯马年，宜避凶灾。"],[3083,"父母双荣荫庇长，子孙犹得食天仓。"],[3084,"坦道扬鞭驰骏马，负好掉杆驾高帆。",43,44],[3085,"兄弟六人，数有二贵。"],[3086,"凶多吉少，流年不利。",55,56],[3087,"佩玉不相识，淘沙始见金。",35,36],[3088,"求谋事不成，身闲心不闲。",21,22],[3089,"脱却尘埃，悠然物外永无回。",61,62],[3090,"门庭喜气，金玉辉煌。",57,58],[3091,"人事逢佳景，肠断去年春。",75,76],[3092,"美羡添丁高，原来一场虚。"],[3093,"行乐度流年，百事从容福自然。",70],[3094,"兄弟二人，数有二贵。"],[3095,"夫妻同庚，先天定数。"],[3096,"山中卜筮占周易，悔吝灵困是亢龙。",23,24],[3097,"子占科名。",81],[3098,"自成自立自撑持，骨肉亲门事事虚。"],[3099,"太岁犯羊年，祈保得安然。"],[3100,"且喜从容事事长，一歌一曲乐无疆。",15,16],[3101,"兄弟二人，数有一贵。"],[3102,"至哉坤元，万物资生。",53,54],[3103,"杨柳迷离，所为欠顺。",33],[3104,"喜气如春，财源似水。"],[3105,"岁月云亡，无庭之训。",28],[3106,"白虎入猴年，宜解免灾缠。"],[3107,"科场得意，冲天大幸。",18],[3108,"子登科选。",41,42],[3109,"一树之凤，生财有路。"],[3110,"生决由来不聚财，农田乐事称人怀。"],[3111,"志气丈夫日，功名人尽知。"],[3112,"滕王阁上，说尽千古英雄。"],[3113,"一日晴明一日暗，明暗无定好忧心。",43,44],[3114,"乡科题名。",21],[3115,"穷达皆由命，文章果误人。",57,58],[3116,"月缺休将镜来补，花残莫把线来穿。",41,42],[3117,"行大道，乐尧天。",57,58],[3118,"太岁犯鸡年，宜预避灾缠。"],[3119,"三春风雨顺，春色上栏杆，"],[3120,"三春之晕，游子归梓。",15,16],[3121,"暑气逼相侵，藤萝十亩不利口。",41,42],[3122,"报田余二略，传家富六韬。",53,54],[3123,"子占高魁。"],[3124,"好事催人至，求谋事不如。",34],[3125,"父死于非命。",28],[3126,"风卷浮云月又圆，圆圆复碎又相连。",39,40],[3127,"得名于庙，得财于市。",18],[3128,"云散月明，风静波至。",45,46],[3129,"母日云亡，少义方训。",48],[3130,"水满春塘，鱼游踊跃。",32],[3131,"太岁犯犬年，祈福免灾缠。"],[3132,"科名应有份，春元指掌中。"],[3133,"子占高科。",51,52],[3134,"虽是桑榆景暮，还留一脉春光。",21],[3135,"独木桥心休跨马，千层浪里莫行舟。",39,40],[3136,"大道之途，天下为公。",41,42],[3137,"木雕老虎当门立，虽不伤人却有惊。",57,58],[3138,"子占高魁。",49,50],[3139,"前妻生三子，后妻生两儿。",57,58],[3140,"子登科第。"],[3141,"喜气隆隆，福寿自臻。",13,14],[3142,"佳人咏关雎，内外多麟趾。"],[3143,"守气不如守志好，无奈心急马行迟。",47,48],[3144,"眉头开展，喜气祥光。",49,50],[3145,"前妻生二子，后妻生一儿。"],[3146,"月明千里好，浪静片帆轻。",35,36],[3147,"堤边杨柳依依绿，惟有年华色更新。"],[3148,"皓皓光明月，朗朗吉星临。",41,42],[3149,"知君妻子早，生才发达迟。"],[3150,"运至南方，功名成就。"],[3151,"太岁犯猪年，祈保得安然。"],[3152,"一周克母，劳弗可报。"],[3153,"有子庆贵，贵者非次。"],[3154,"当依巩期，不负窗前之苦。",67,68],[3155,"时来得遇荆山玉，主人作美珍。",35,36],[3156,"濯足沧浪，洗尽尘埃。"],[3157,"近贵不如近市好，求名莫似求财高。"],[3158,"土木之年父先去方合。"],[3159,"花发园中万树红。",85,86],[3160,"蹇马陷泥沙，步步回头看。"],[3161,"数有七子，五子送老。"],[3162,"泮水生香。",17,18],[3163,"此夜色满，碧洗尘埃。",64],[3164,"名登金榜，少年发达。",17],[3165,"一字切记曰屠，交不得。",86],[3166,"兄弟十人有五贵。"],[3167,"际遇有乖远，日月有盈亏。",39,40],[3168,"子占科名。",55,56],[3169,"祥光得照，正畅所怀。",56],[3170,"推车上道，举步盘桓。"],[3171,"徒劳田上苦，仓库未能盈。",60],[3172,"妻生三子，妾生二儿。"],[3173,"得过且过，莫急其功。",31],[3174,"财帛喜称心，流年皆顺利。",27,28],[3175,"溪水向东流，涌涌未肯收。",61],[3176,"兄弟三人，终断离群。"],[3177,"子登科甲。",45,46],[3178,"欢笑且相亲，堂中物色新。",71],[3179,"马骋其辔，腾跨万里。",21,22],[3180,"久雨淋漓，交争有是非。",21,22],[3181,"鹊叫鸦鸣，吉凶不一。",63,64],[3182,"妻生二子，妾亦如之。"],[3183,"离乡背井，随风近俗。"],[3184,"风雪扬花卷作球，丧门相照服来忧。",37,38],[3185,"佳气融融入画堂，相照相庆富无疆。",61,62],[3186,"荷花出水，亭亭玉立。",27,28],[3187,"眼见功成事事宜，春风无限乐怡怡。",45,46],[3188,"童年三四岁，皎皎碧玉枝。",3,4],[3189,"行至顺境，保事可为。",61,62],[3190,"万水千山，长途行难。"],[3191,"青云扶足上，丹桂得意报。",24],[3192,"日月斗蚀，宇宙晦色。",21],[3193,"当依贡期。",69],[3194,"前途可趋，宛转山曲。",41],[3195,"芍叶雕栏喜静风，幽香无限锦从中。",59,60],[3196,"子占高魁。",63,64],[3197,"美运未来，反似颠倒。",25,26],[3198,"头长连胎必要虚，四旬之外子入数。"],[3199,"悬空待月，仿佛清芬。",51,52],[3200,"年不与旧岁不同，人物熙熙乐意浓。",82],[3201,"检点上林花正发，千红万紫实堪夸。",41],[3202,"壮志凌云汉，隆恩拜紫薇。",59,60],[3203,"欲访武陵人，渔郎好问津。",60],[3204,"瑞气隆隆，快活之象。",43,44],[3205,"理恨新愁，蹙在眉头。",20],[3206,"严穴之下，指顾艰难。",51,52],[3207,"一轮新皎月，巧被黑云遮。",27,28],[3208,"十分春色遍长安，阡陌行人着路看。",33,34],[3209,"乡科题名。"],[3210,"福禄日更新，相逢大吉人。",51,52],[3211,"一子生年属木方合此刻。"],[3212,"此卦值重阳，三朝七日命不长。"],[3213,"鲲鹏插翅，扶摇直上。",30],[3214,"无事开心，万物悠悠。",17,18],[3215,"当依贡期。",71,72],[3216,"愁容顿释，笑容开颜。",33,34],[3217,"光天化日，可以安舒。",88],[3218,"兄弟八人，数有二贵。"],[3219,"时贫时贵皆由运，不是心肠输事人"],[3220,"四野晴光，太阳长明。",23],[3221,"一就功成，拱手安居。",55,56],[3222,"日上中天，江山有象。",45,46],[3223,"虽然不是黄门客，也是乡间一富翁。"],[3224,"云散雨收，日月光明。",33,34],[3225,"命当过房育成人。"],[3226,"少年登科第，风云际会时。",19],[3227,"挫折虽多，志不可屈。"],[3228,"困于丛林，居心不安。",19,20],[3229,"高卧无忧，同时并进。",21,22],[3230,"朝霞簇簇，景画堂明。",64],[3231,"头长连胎终是空，三十五外子入数。"],[3232,"兄弟六人，同父不同母。"],[3233,"父先亡母后逝，易数先知。"],[3234,"祸患相攻，疾风暴雨少从容。",19,20],[3235,"事事求谋蹭蹬多，难成难就费吟哦。",71,72],[3236,"苦尽甘来，从此大庆。",45,46],[3237,"姐妹六人，各自分飞。"],[3238,"周虑回顾，克济其美。",23],[3239,"一人得意，九族升天。"],[3240,"老年母服，也是前数。",71],[3241,"姐妹四人，姻缘各配。"],[3242,"一生立业在行市，交易公平至近人"],[3243,"兄弟四人，易数先详。"],[3244,"尚复忧疑事不通，前山已与后山同。",43,44],[3245,"东风报好，生机已见。"],[3246,"兄弟四人，中断离群。"],[3247,"撑过小舟，忽遇风波。",26],[3248,"日月将优游，寻常不用求。",21],[3249,"南极吉星临，其年瑞气多。",75,76],[3250,"但恐有哭耗，中堂泪几行。",25,26],[3251,"姊妹六人，婚姻奇配。"],[3252,"官拜胪卿而致仕。"],[3253,"兄弟十人，数有九贵。"],[3254,"路当险处有彷徨。",71],[3255,"饮醇餐精，安然之乐。",86],[3256,"君国于民，皇道荡荡。",49,50],[3257,"门庭吉庆，事业兴隆。",25,26],[3258,"虎笑文声，许采芹香。"],[3259,"灾星在内未得安。"],[3260,"此刻生人，双亲犹在。"],[3261,"妻命属木。"],[3262,"当有二母之命。"],[3263,"当依贡期。",73,74],[3264,"花期消息发，根道好晴明。",35,36],[3265,"祸从天降，桃源避秦。"],[3266,"愁肠百结，何计方除。",51,52],[3267,"钦命典试。",67,68],[3268,"乡榜题名。",21,22],[3269,"政简刑清，月照公庭。",55,56],[3270,"喜气盈门，整顿笙歌。",59,60],[3271,"母命属火。"],[3272,"事事各和谐可在，南楼赏玩好妆台。",41,42],[3273,"二亲辞世是何时，他日母先父后期。"],[3274,"童年一二岁，葵花向阳开。",2],[3275,"哀裒泣泣，刑伤之忧。",25,26],[3276,"已带暗杀子，当死于非命。"],[3277,"今朝喜，相公到。"],[3278,"踊跃自如，事事可为。",25,26],[3279,"十行九空，西行复东。",27,28],[3280,"双亲归世是何日，注定父先母后归。"],[3281,"当依贡期。",75,76],[3282,"耗神会破神，虚费不留人。",29,30],[3283,"技艺不寻常，提携福白张。"],[3284,"吐秀丹桂，正放之时。",15],[3285,"数有六子，四子送老。"],[3286,"公讼来勾连，不伤也破钱。",37,38],[3287,"二子送老，俱是庶出。"],[3288,"屈贾于长沙，时之未遇耳。",28],[3289,"满胸热血不平事，异日终须一笑颜。"],[3290,"兄弟三人，数中注定。"],[3291,"好事倍相从，财源到此通。",37,38],[3292,"慎于财赋，束兵爱民。"],[3293,"凶神不攻，吉神相救。",55,56],[3294,"兄弟五人，同父不同母。",71,72],[3295,"云开山色丽，风静竹枝安。",30],[3296,"隐居暗室，灾耗相亲有事非。",27,28],[3297,"日月相照，光明四海。",25,26],[3298,"根基敦厚，可以守成。"],[3299,"文场之内一声鸡，领得青衿换布衣。"],[3300,"创高厦置田庄，门庭光彩客观光。"],[3301,"前面有光明，移步转回头。",29],[3302,"八九数已尽。",72],[3303,"姊妹九人，婚姻奇配。"],[3304,"世事无关心意足，梦魂不拢兴偏长。",23,24],[3305,"一湾流水，游鱼踊跃。",17,18],[3306,"当依贡期。",77,78],[3307,"数有八子，一子送老。"],[3308,"暗中摸索处，一路有光明。",33,34],[3309,"求名不可求利遇。",47,48],[3310,"姊妹七人，同父不同母。"],[3311,"种田无利，不如生意。",41],[3312,"主家兴业，再整规模。",53,54],[3313,"姊妹七人，姻缘奇配。"],[3314,"印绶逢财富，立嗣于伯父。"],[3315,"整顿愁怀病又攻，却向东风泪两行。",19,20],[3316,"猴年得子。"],[3317,"猩猩度泥途，逢人便叫呼。",64],[3318,"年来时不同，水流鸟呼风。",72],[3319,"有福之妇，先夫先决。"],[3320,"曲道推车，难以驰驱。",22],[3321,"再得金命之妻。"],[3322,"姊妹八人，婚姻奇配。",55,56],[3323,"犬生二口，请君详之。"],[3324,"父母故于猴年。"],[3325,"泽民济物之怀，宛然甘霖之沛。",65,66],[3326,"运待时发，桑榆之枝。",33,34],[3327,"嫉风妒雨日不停，愁人寂寞自沉吟。",55,56],[3328,"当依贡期。",79,80],[3329,"登科名熊罴叫梦。",47,48],[3330,"题名乡榜。",21],[3331,"大鹏将飞，尚留枯木。"],[3332,"前妻一子，后妻一儿。"],[3333,"年限将喜，事自相饶。",43,44],[3334,"得领青衿，已足谢愿。"],[3335,"梅花带雪满园开，白点人衣有服来。",21,22],[3336,"子能拜圣，景之荣幸。",21,22],[3337,"春风吹遍洛阳城，到处花开锦绣明。",69,70],[3338,"子占高魁。",65,66],[3339,"升腾之景象，贵喜榜中人。",13,14],[3340,"绿柳扶疏茂荫多，行人休息慢经过。",74],[3341,"项庄舞剑，意在沛公。"],[3342,"数有六子，送老难齐。"],[3343,"无是无晨，安然乐意。",45,46],[3344,"妻命属土方合此刻。"],[3345,"福禄随人至，事事皆亨通。",45,46],[3346,"兄弟二人，损了一个。"],[3347,"师傅涅槃，寻衣临身。",33,34],[3348,"妻生三子，妾生一儿。"],[3349,"注定犹子承宗祖，已生命子亦当无。"],[3350,"头长连胎终是虚，三旬之外子入数。"],[3351,"数该生子。",62],[3352,"萤火依稀照暗室。",67,68],[3353,"分有嫡母，继母生吾。"],[3354,"岩头走马，谨慎无虞。",27,28],[3355,"兄弟五人，损了一丁。"],[3356,"寿足九旬，大限入黄泉。",90],[3357,"乡科得意。",27],[3358,"官至兵备。"],[3359,"官星相照，官高职显。",55,56],[3360,"大兴土木，家业兴隆。",57,58],[3361,"年过古稀，父丧天报。",71],[3362,"天与人合，财谋自至。",55,56],[3363,"姊妹五人，姻缘奇配。"],[3364,"阴雨绵绵，四野安然。",33,34],[3365,"勤读诗书，动辄亲贤近贵。"],[3366,"玉马高风布，革棠之善政。",60],[3367,"满门和气，祥云自集。",21,22],[3368,"当风之烛，光辉不定。",14],[3369,"寒雪尽消，衣暖日荣。",56],[3370,"运至时行，无往不利。",23,24],[3371,"子当高第。",71,72],[3372,"金榜题名。",28],[3373,"一字记曰佛，修行宜善。"],[3374,"新月上纱窗，依稀渐有光。",23,24],[3375,"所谋皆左，其间欠顺。",51,52],[3376,"花前月下唱高歌，乐极悲生奈若何。",31,32],[3377,"恍惚无恁，人皆莫测。",59],[3378,"虽然有憔悴，喜有吉人扶。",7,8],[3379,"职司通政，衣锦还乡。"],[3380,"东风送暖，榆柳好生。",27,28],[3381,"垂翼受伤，飞鸟彷徨。",14],[3382,"风浪未定，轻舟渡河。",49,50],[3383,"晚来福禄有余波。",63,64],[3384,"孝服临门，哭泣哀哉。",35,36],[3385,"家业资财妻带，妻能助夫欠谐。"],[3386,"扶桑日出锦绣成，倚借东风千百样。",55,56],[3387,"登高有路，扶级而上。",61,62],[3388,"东风劲吹草萋萋，绿遍园林草色深。",46],[3389,"钦命典试。",69,70],[3390,"财禄日隆，田园必增。",53],[3391,"妻命纳音水，娶妾纳音金。"],[3392,"兄弟五人，数有四贵。"],[3393,"朝夕无忧，恰似童年。",77],[3394,"催官星拱，恩赐九重。",55,56],[3395,"弓马入泮。",19,20],[3396,"兄弟七人，中断离群。"],[3397,"木屐无钉，泥滑难行。",13,14],[3398,"数该生子。",55],[3399,"东西奔驰，事事成虚。",29,30],[3400,"心机用尽须眉老，志气难舒强自伸。",83,84],[3401,"海棠有雨，泪湿红妆。",29],[3402,"若问子孙贵与同，两枝先自斗芳芬。"],[3403,"居安家人欢，乐乐有余庆。",31,32],[3404,"不犯上不见灾，尤广称人怀。",67,68],[3405,"暮境安然，清平之福。",61,62],[3406,"兄弟九人，数有五贵。"],[3407,"犹如机会失，自取彷徨。",31,32],[3408,"前妻生二子，后妻亦然。"],[3409,"终朝鼓舞，安享清福。",83],[3410,"妻命属水命。"],[3411,"迷路茫然，不知所遇。",27],[3412,"先天后得，自强不息。",45],[3413,"父母故于马年方合。"],[3414,"杨柳春色上林花，遍处荣华富可夸。",69],[3415,"子登科第。",37,38],[3416,"千里征途暗复阳，行前自有点红妆。",41,42],[3417,"弓马入泮。",21,22],[3418,"清明皎洁，光风雾月。",75],[3419,"后扈一曲，醉泪千行。"],[3420,"兴至三杯酒，闲来一局棋。",85,86],[3421,"未死琵琶别抱琴。"],[3422,"交争事多端，处事不稳重。",37,38],[3423,"板桥滑湿，赖杖相扶。",92],[3424,"千古高魁。",52],[3425,"一朝烟雨一朝晴，晴不多时雨又淋。",55,56],[3426,"宜尔难老，寿正八旬。",80],[3427,"无荣无辱，安分知足。",71],[3428,"中年虚耗，晚景荣华。"],[3429,"文学辉煌，圣主物色。",43,44],[3430,"补授驿马。"],[3431,"生逢太白入天财，绫罗锦色惯剪裁。"],[3432,"出于清雨，玉浩冰清。"],[3433,"名登科甲。",31],[3434,"荣华归晚岁，安乐值高秋。",77,78],[3435,"天数生成止于此，寿数何须必古稀。",69],[3436,"尚有松筠操，还留海鹤姿。",73,74],[3437,"童年如此，藉庇安康。",9,10],[3438,"乡试中选。",41,42],[3439,"官至礼部。"],[3440,"妻命属火方合。"],[3441,"天赐其庥，咸庇祯祥。",84],[3442,"满园芍药放，荣华自可乐。",73,74],[3443,"一宇记曰忍。"],[3444,"檐前鹊噪两三声，渐有清风月色明。",35,36],[3445,"兄弟九人，数有三贵。"],[3446,"水远山遥，眼力不彰。",50],[3447,"鱼得其水，一跃远游。",26],[3448,"一声玉笛半夜来，吹到梅花九曲春。",76],[3449,"子占高魁。",61,62],[3450,"阴鬼弄人，晦病缠身。",15,16],[3451,"刚柔能将相，未遇且收藏。"],[3452,"运入风波地，皆因数是遍。",53,54],[3453,"英雄豪杰汉，展翅自高翔。"],[3454,"便觉春风喜气生。",20],[3455,"暮景足福禄，无日不逍遥。",65,66],[3456,"驾鹤归西去，人间一寿星。",73],[3457,"绿林豪客，草野英雄。"],[3458,"攀龙附凤，身居高处。"],[3459,"卧龙饱学经纶士，三顾驰驱自见动。"],[3460,"老骥伏枥，一朝得志。",68],[3461,"危桥度过又高山，赖个拄杖得往还。",75,76],[3462,"东床半子，递老数定。"],[3463,"春到千家杨柳绿，秋来万顷稻禾香。",63,64],[3464,"水隔之处，曲转可通。",63,64],[3465,"灾晦缠身，眉头交蹙不可言。",57,58],[3466,"进取无功，不如退步。",29,30],[3467,"吉庆临门，乐间浓浓。",33,34],[3468,"姐妹二人，婚姻奇配。"],[3469,"官星照命。",47,48],[3470,"用意图谋百事难，轻风拂卷紫云关。",57,58],[3471,"子亡女送终。"],[3472,"贤如孟光配梁鸿，不比寻常妇女看。"],[3473,"数有二子，得以送老。"],[3474,"浮云自散，依然日影透玲珑。",75,76],[3475,"姐妹三人，婚姻奇配。"],[3476,"正室无子，偏房生子。"],[3477,"兄弟八人，中断离群。"],[3478,"耕种虽然苦，仓库得丰盈。"],[3479,"待到分时，中原鹿肥。"],[3480,"卜君享寿是何日，古稀加一入黄泉。",71],[3481,"春风在户，乐意浓浓。",49,50],[3482,"举网得鱼，大有所获。",25,26],[3483,"徒步身轻，晚年安泰。"],[3484,"时雨沾濡草，荣枯而畅茂。",43,44],[3485,"荡除尘埃，浑身爽健自分明。",61,62],[3486,"耕田得利，贸易生意可致富。"],[3487,"无是无非，一团和气。",59],[3488,"兄弟六人方合。"],[3489,"阳春渐到，冰冻得消。",43,44],[3490,"鼠穿墙屋，耗之无续。",53,54],[3491,"财帛骤发，及时加增。",49,50],[3492,"兄弟十人，数有四贵。"],[3493,"六根清静，四大皆空。",17,18],[3494,"可恨灾星不可逃，阴阳愆度祸自招。",59,60],[3495,"山穷水尽水桥通，四转绿阴杨树浓",57,58],[3496,"父命属土。"],[3497,"虽失东北一隅，还得尚元一峙。"],[3498,"妻生一子，妾生一儿。"],[3499,"事事可人怀，及时行乐莫消停。",79],[3500,"母命属水。"],[3501,"老幼笑颜，朝夕欢乐。",51,52],[3502,"姐妹四人，数由前定。"],[3503,"破局不知年，讲来大有缘",37,38],[3504,"天地一番新，阳和一景明。",24],[3505,"锦绣丛丛，花开满院。",13,14],[3506,"姐妹九人，易数注定。"],[3507,"子登科甲。",45],[3508,"春光融融日渐高。",21,22],[3509,"好向玄门瞻礼法，子孙紫绶与金章。"],[3510,"逆水行舟，且前且后。",29,30],[3511,"数该生子。",31,32],[3512,"寒谷回春，欣欣之色。"],[3513,"数该生子。",29,30],[3514,"奎星指南，揽辔登车。",24],[3515,"半作生涯半作农，中运拮据老运隆。",13,14],[3516,"亨福无求，百事悠悠。",57,58],[3517,"兄弟七人，方合此刻。"],[3518,"楼阁高月清，中夜好分明。",42],[3519,"山径黄菊偏晚香。",77,78],[3520,"春风依旧遍江山，绿柳桃花处处红。",57],[3521,"四字须记，暗箭伤人。"],[3522,"日进其财，福禄骈臻。",57,58],[3523,"兄弟八人，中断离群。"],[3524,"兄弟五人，我居中。"],[3525,"兄弟九人，数有二贵。"],[3526,"管文教武，重大威权。"],[3527,"乡榜题名。",35],[3528,"官至黄堂。"],[3529,"中途遇雨，无处借蓑笠。",49,50],[3530,"伏尸猖獗，不明之象。",33,34],[3531,"数当促寿，徒增父母悲。",12],[3532,"生涯恁稔岁，谷麦自丰盈。"],[3533,"官星拱照，恩自九重。",27,28],[3534,"叔父视我，作为犹子。"],[3535,"乡扬捷报。",22],[3536,"病符相照命，骨肉有刑伤。"],[3537,"行径淹留，难展眉头。",77,78],[3538,"欢娱度日，好花常开。",45],[3539,"道路平坦，可以驰驱。",69,70],[3540,"鼎心结构，引相规模。",59],[3541,"一湾曲水环江村，怀抱转回自有情。",43],[3542,"数定将满百，竞作归西客。",69],[3543,"灯花结蕊，喜事重来。",73,74],[3544,"芙蓉照水，隐隐红妆。",17,18],[3545,"徒弟六人，二人送老。"],[3546,"用心凿石方成玉，着意淘沙始见金。",45,46],[3547,"官至守备，必有变迁。"],[3548,"禄马扶持，常多吉庆。",71],[3549,"兄弟八人，方合此刻。"],[3550,"淋淋夜雨，淹淹晦带。",21],[3551,"进士及第。",26],[3552,"病符相照，浮灾外来。",61],[3553,"花迎夜雨叶离披，一阵风来片片飞。",37,38],[3554,"登山疲于足，力难同步迟。",59],[3555,"双亲共乐享余年，他日父先母后期。"],[3556,"阴阳不和，天灾反覆。",23,24],[3557,"为事犹淹留，当时费讲求。",37,38],[3558,"莫问荣枯，天数有定。",63,64],[3559,"祥光见神人，无日不依依。",24],[3560,"燕尔新婚，落笑语声。"],[3561,"秋光发浩，天高云淡。"],[3562,"秋光发浩气，万宝可收藏。",70],[3563,"喜珠挂于眉，端大获财宝。",63,64],[3564,"抱琴未遇好知音，流水高山有子朋。",52],[3565,"弃旧废新，咸池见嗔。"],[3566,"子规啼落楼头月，泪流血尽声哽咽。",12],[3567,"喜神相照，灾毒无侵。",62],[3568,"上苑奇花呈富贵，亭前瑞草报平安。",57,58],[3569,"舜年百十岁，君今欠一春。",99],[3570,"贵人指引，利有攸往。",49],[3571,"根基如复田，修成有新名。"],[3572,"一年好事一年春，常见君家道太平。",72],[3573,"金土之年，中举方合。"],[3574,"有口难言，前生所致。"],[3575,"官至都司，必有变迁。"],[3576,"大小安然，福禄绵绵。",87,88],[3577,"能文知字，女中丈夫。"],[3578,"一母一母又一母，前有母后有母。"],[3579,"迁向西方，随遇而安。"],[3580,"朦胧如醉，作事乘时。"],[3581,"春来万物生，天地造化融。",27],[3582,"宇宙祥和，万民欢乐。"],[3583,"丙辰之年，进士及第。"],[3584,"数注其人，四方为家。"],[3585,"木火之年，入学方合。",7],[3586,"雷震山川若有惊，云收雨散太阳升。",65,66],[3587,"台谏之臣，山林之乐。",79,80],[3588,"兄弟八人，数有四贵。"],[3589,"母死水火年，父尚犹茂。"],[3590,"浪游失业，东西南北。"],[3591,"其年恶曜侵，数定不寻常。",67],[3592,"求谋不如意，参酌费心机。",46],[3593,"花开五朵，晚景福多。"],[3594,"真假二子，一子送老。"],[3595,"洛阳春色正芳菲，万紫千红景色新。",58],[3596,"及得透雨，大泽腾龙。"],[3597,"父母死于水土年。"],[3598,"赌无兴家，君必记之。"],[3599,"乡科有名。",25],[3600,"家室未宁，非侵病攻。",45,46],[3601,"破釜沉舟，可以反败为胜。"],[3602,"先男后女，先天定数。"],[3603,"检点林花会，千红万紫华。",33,34],[3604,"春去秋来未有安，南枝送暖此风寒。",35],[3605,"雪压罗巾白，丧门是披星。",33,34],[3606,"许多烦闷恨难言，一旦高飞恨未捐。"],[3607,"妻当带疾病，数由天注定。"],[3608,"母先故于火年方合。",37],[3609,"内助贤良，勤俭妇女。",25,26],[3610,"富中贫贱莫怨天，少年恋赌掷金钱。"],[3611,"纳价成名，先人著述。"],[3612,"父先母后易数明知。",39,40],[3613,"幼年过纪，方合此刻。"],[3614,"数有七子，四子送老。",78,79],[3615,"东妆别去往西行，水远山长迥不回。"],[3616,"日蹉黄道，天定三阳。",75,76],[3617,"孤身立曾，手足相扶。"],[3618,"将晦之月已无明。",77,78],[3619,"祸患不可测，不但人嗔且有鬼。",25,26],[3620,"桥头甚朽，行人有咎。",38],[3621,"马到山岭，风光无涯。"],[3622,"得田上水利，取湖中之财。"],[3623,"白发萧萧，年老归来守林皋。",75,76],[3624,"火星相侵，流年有咎。",63,64],[3625,"结发夫妻白头老。"],[3626,"兄弟三人，数当尽贵。"],[3627,"朝晴夕落酒征人，泥滑黄昏次第行。",63,64],[3628,"闭门拙守，横灾外来。",37,38],[3629,"只手为人，贵人勋业。"],[3630,"数有七子，二子送老。"],[3631,"迷恋烟花，岂不知有妨名节。",26,27],[3632,"画水无声空有浪，乡花虽美不闻香。",57,58],[3633,"终须一梦到华胥，寿数几人有古稀。",70],[3634,"事业峥嵘，玉堂吉庆。",65,66],[3635,"崎岖山路，总有忧疑。",25],[3636,"丧门相照，忧及于师。",31,32],[3637,"风尘劳苦上长安，博得州官列宦班。"],[3638,"锦乡映人，春光可人。",43,44],[3639,"悬丝自缢高楼上，飘魂落魄恨难言。"],[3640,"禅院忽生非，破财难免灾。",23,24],[3641,"此刻生人，足有不便。"],[3642,"烦恼无端，言之难堪。",57,58],[3643,"大运将至，福来无地。",55,56],[3644,"其年有灾星，病符来相照。"],[3645,"周年无母，刑伤太重。",2,3],[3646,"壮志凌云，九天揽月。"],[3647,"少年登科。",17],[3648,"兄弟十人方合此刻。"],[3649,"命带财星福禄厚，旺夫益子喜无穷。"],[3650,"真假五子，一子送老。",83,84],[3651,"横进资财，凑合开来。",53,54],[3652,"黑云密布，恨天不雨。",63,64],[3653,"乡科中选。",34],[3654,"春花取次看，马蹄得意回。",27],[3655,"草森萌芽，春风转绿。",52],[3656,"兄弟九人，方合此刻。"],[3657,"兄弟七人同父不同母。"],[3658,"马化龙狗，功名显达。",28],[3659,"知进知退，为人恭谨。"],[3660,"恶曜相照，斯年有疾。",47],[3661,"十年寒窗，终可扬眉。"],[3662,"出水芙蓉，鲜色莫并。",33,34],[3663,"夜雨连霄，愁人寂莫。",17],[3664,"数该生子。",37],[3665,"天然之乐，安享清平。",21,22],[3666,"子登科甲。",67,68],[3667,"所谓无不遂，谋略之皆成。",33,34],[3668,"以监而选县丞，数由前定。"],[3669,"杀犯雷霆，犯天之怒。"],[3670,"承天之休，恪恭尽职。",43,44],[3671,"中途遇雨，步履不安。",23],[3672,"打算为活计，经纪作生涯。"],[3673,"子息五旬外，得之方始。"],[3674,"占卜之时，未有洞房之喜。"],[3675,"水火相刑，死在舟中。"],[3676,"子登科名。",30],[3677,"此年游远道。"],[3678,"数注当坏一足。",71,72],[3679,"灾晦缠身，有犯太岁。"],[3680,"父母替日，数由前定。"],[3681,"吩咐东君好护持，奇花遭雨坏离披。",15,16],[3682,"官至知县，以道终身之乐。",65,66],[3683,"白雪纷飞，高低路岐。",35,36],[3684,"好鸟鸣春，东风快人。",19,20],[3685,"十里青山火已流，沛然下雨晚凉收。",55,56],[3686,"父子不和，家门伏祸。"],[3687,"取用有余，快然无恨。",57],[3688,"一身闲似水，逍遥出世尘。",28],[3689,"红妆簇簇锦云路，十里池塘菱荷香。",65,66],[3690,"官至理卿而致仕。"],[3691,"云归故岫碧天空，光照逢门日色洪。",67,68],[3692,"日中斗观，灾毒渐生。",76],[3693,"一日愁天百事多，心中烦恼乱如麻"],[3694,"西方自有人携引，苦守三时滞乃通。",17,18],[3695,"得亲知己气相求，从此营谋不用忧。",66],[3696,"灾晦交侵，眉头交蹙。",79,80],[3697,"谋为近成锦，绣映入耳目。"],[3698,"室至守府，不能高擢。"],[3699,"树根基浅，为风所拔。",15],[3700,"兄弟六人，数有二贵。"],[3701,"掌朝廷大政，声名播四海。",56,57],[3702,"少年失母，方合此刻。",12,13],[3703,"经德化民，是感不应。"],[3704,"一只扁舟直早潮，布帆初挂在江阜。"],[3705,"夜雨初晴连日笑。",12],[3706,"细寸飞丝，滞而不明。",13],[3707,"愁多没处排，春风次第来。"],[3708,"花开遭风雨，寒气伤心扉。"],[3709,"叩门急是非，一见官归根",47,48],[3710,"狂风飘落叶，何处是归根。",68],[3711,"春色有脚还未去，鹤报东君喜信来。",17,18],[3712,"左右得人扶，险处可无妨。",11,12],[3713,"一瓶一钵，到处生涯。",19,20],[3714,"朦胧皎月，云去云来。",53,54],[3715,"钦授知县，修政爱民。"],[3716,"幼年生子，世上难逢。",14],[3717,"前生过逼，举止皆错。",18],[3718,"数有四子，一子送老。"],[3719,"东边日出西边雨，一朝几度尤怨言。",67],[3720,"随缘度日，猿鸟相亲。",19,20],[3721,"奔奔碌碌，忧之如何。",27,28],[3722,"是非相寻，无日得安。",23,24],[3723,"万恶淫为首，当戒酒声气。"],[3724,"喜事相遇，乐边鸦噪又逢凶。",19,20],[3725,"钓得鱼儿已上钩，俄然跃起水中游。",23,24],[3726,"一重欢喜一重惊，道是无情却有情。",23,24],[3727,"谈禅风拂座，听经石点头。",19,20],[3728,"太阳相照，好事临头。",65,66],[3729,"项庄舞剑，意在沛公。"],[3730,"火星入宅，不安之象。",37],[3731,"正妻无子，妾生一儿。"],[3732,"切莫睹中行，虚子利有名。"],[3733,"千古科名。",73,74],[3734,"天嗣天经，子当正副。"],[3735,"姊妹九人，同父不同母。"],[3736,"运逢转处，春花依旧向阳开。",77,78],[3737,"吉里有灾耗，喜运未称心。"],[3738,"守静为吉，动而见忧。",47,48],[3739,"运逢阳九，利见大人。",31,32],[3740,"草木久遗霜，太阳一照自春光。",36],[3741,"错于事理，投之皆乘。",29,30],[3742,"其人之亡，定在十二月。"],[3743,"九子生年水，十子生年金方合。"],[3744,"拂拭尘镜半又明，天长依旧又昏沉。",47,48],[3745,"谢却人间礼法正，晨钟暮鼓福无双。"],[3746,"妻生一子，妾生一儿。",41,42],[3747,"前夫死于木火之年方合。"],[3748,"金水之年，克夫方合。"],[3749,"数有偏估，身带暗疾。"],[3750,"科场选举。",18,19],[3751,"数该生子。",27,28],[3752,"乡榜题名。",22],[3753,"天罗地网正非常，使人消磨不可当。",39,40],[3754,"妻宫多报，子有前后。"],[3755,"种田原正作，但苦谷不丰。"],[3756,"金木相克，悬梁而死。",49,50],[3757,"善夺夫权，治家能归。"],[3758,"房考之年。",67,68],[3759,"桃李成蹊，万性沾福花之惠。",61,62],[3760,"颠倒流离，穷苦自如。",27,28],[3761,"五子生年属土金。"],[3762,"和气映画常，桂兰乐安康。",83,84],[3763,"苍松一生，现有青山。",60],[3764,"妻生一子，妾生三儿"],[3765,"兄弟七人，数注五贵。"],[3766,"万绪千端，宝镜当磨仔细看。",51,52],[3767,"优闲无事纳祯祥，几朵梅花扑鼻香。",89,90],[3768,"初授令尹。"],[3769,"中途险过，稳步宫墙。",40,41],[3770,"陷于泥沙，难以举步。"],[3771,"可恨灾星不可逃，阴阳愆度祸相遭。",67,68],[3772,"南山鸟鸣，北山张罗必有惊。",15,16],[3773,"辛苦经商，四海家业足一生。"],[3774,"不及二七数，惜乎亡矣。",13],[3775,"半世虚名末有成，原来数定晚年兴。"],[3776,"手扳弱柳，不可着力以致伤。",44],[3777,"铮铮然中由性质，拘拘然中子规模。"],[3778,"兄弟六人，数有四贵。"],[3779,"福禄无常，人子有变。",53],[3780,"狐欲渡河濡，实难济顺舟。",18],[3781,"田土之乐利，一生常有贵人扶。"],[3782,"三子生年属金木方合。"],[3783,"红日已出云又暗，长诳迢迢何时旦。",35,36],[3784,"长子木年生，次子土年生方合。"],[3785,"云观五色，喜事光临。",25,26],[3786,"新竹成竿，扶摇直上。",11,12],[3787,"花满池塘，香气异常。",13,14],[3788,"水年母终方合此刻。"],[3789,"佳节年华三月天，红红绿绿快人心。",11,12],[3790,"子登科名。",34],[3791,"坦然一往总无惊，驾驭驰驱有驷马。",51,52],[3792,"檐前鹊噪定，是来报喜事。",54],[3793,"天刑人数眼中来，海中仙果结子迟。"],[3794,"老景多啾唧，斯年少吉利。",81,82],[3795,"爵初高迁，恩自九重。",51,52],[3796,"数该生子。",74],[3797,"老年夫妇，不免凄凉之悲。",73],[3798,"父故于水年，母尚茂木年。"],[3799,"春色皇州次第花，开到中秋自然息。",34],[3800,"钦命典试。"],[3801,"身荣八品职，略遂平生志。"],[3802,"初年入泮。",7,8],[3803,"年至耳顺，政治劳民。",59,60],[3804,"言公而不寻，一见便生嗔。",25,26],[3805,"事多得合，可以施为。",36],[3806,"乡科题名。",59],[3807,"前途步步可扬眉，日日春光马足催",27,28],[3808,"踏遍江山草色浓，春花胜似去年红。",54],[3809,"此刻生人，双亲俱全。"],[3810,"烟霞玉洁，水日常明。",19,20],[3811,"松堂日永，正好参详。",21,22],[3812,"吉祥有庆，鹊噪檐前。",53,54],[3813,"虽有麟儿，亦是虚花。"],[3814,"名登科甲。",25],[3815,"艰难之路不堪行，风来细雨又黄昏",37],[3816,"臣心惟皎洁，天地满阳春。",59,60],[3817,"子当登科。"],[3818,"愁怀未解，不足于心。",73,74],[3819,"数有八子，送老不齐。"],[3820,"花开逢夜雨，未得发舒展。",13,14],[3821,"八岁母亡，幼被刑伤。",8],[3822,"水淹没舒，天所定也。"],[3823,"连连滞滞，不得通津。",13,14],[3824,"数该生子，我亦喜哉。",26],[3825,"须眉似白还未老。",59,60],[3826,"八宫刑刀，岁恐刑妻。"],[3827,"子亡数定。"],[3828,"老年父过，人子日长。",66],[3829,"七子土年生，八子木年生。"],[3830,"无兄弟方合此刻。"],[3831,"禄马盘旋手应心，平波之处总无惊。",53,54],[3832,"寿至从心，高升一品。",69,70],[3833,"动静有常，虽危无咎。",27],[3834,"花结三朵，其数不偏。"],[3835,"子占科第。",65,66],[3836,"优游安乐福相随，疏竹清风日日吹。",87,88],[3837,"兄弟二人，中断离群。"],[3838,"官至六卿，荣显堪夸。"],[3839,"春风正可人，花落水精神。",19],[3840,"一树菩提茂，忽然被风吹。",21,22],[3841,"柳媚花明，阳和天气。",27,28],[3842,"叔侄进士，天发善门。"],[3843,"一世英雄，千古留芳。",72],[3844,"子登科甲。",53,54],[3845,"日色阳和丽，新景照乾坤。",47,48],[3846,"前番费力枉徒然，自后相逢大有年。",37,38],[3847,"姊妹六人，同父不同母。"],[3848,"运无不利，祯祥叶吉。",57,58],[3849,"行人底事忙且迟，且缓正彷徨。",34],[3850,"眉头带蹙恨无端，最恨北风料峭寒。",44],[3851,"兄弟四人，先亡一丁。"],[3852,"兄弟九人，数有二贵。"],[3853,"介在难易间，祸患丛集中。",37,38],[3854,"笋芽初出没，指日便成竿。",19,20],[3855,"进士及第。",22],[3856,"命带三刑，二岁丧父。",2],[3857,"梦到高堂事已飞，蝉声叫断夕量微。",84],[3858,"南岭暗飞烟，杨柳摆风前。",55,56],[3859,"无病而终，幽魂骑鹤归天府。"],[3860,"乡科中选。"],[3861,"祸从天上追君急，远避南方莫恨迟。"],[3862,"兄弟八人，数有五贵。"],[3863,"帆挂秋天一夕风，鸿毛轻拂若朦胧。",11,12],[3864,"半夜鬼推门，灾星又相侵。",51,52],[3865,"兄弟十三人，素有六富贵。"],[3866,"房考之年。"],[3867,"屈指光阴有几何，愁肠郁郁奈若何。",49,50],[3868,"利有余囊羞涩钱，青毡一片度流年。"],[3869,"红紫如锦映楼台，满眼祥光喜气来。",58],[3870,"此刻生人，无兄弟方合。"],[3871,"命犯流霞，产厄其母。"],[3872,"老椿归西去，人子泣血时。",38],[3873,"妻命纳音属木方合。"],[3874,"斯年顺遂事和同，营谋无处不春风。",53,54],[3875,"外台极品，高官厚禄。",53,54],[3876,"数该生子。",58],[3877,"时运不济，命途多姊。",47,48],[3878,"奇艺随身，胜似颠运俯仰人。"],[3879,"兄弟八人，数有五贵。"],[3880,"富足无求，受君之益。"],[3881,"天人以定，四时为顺。"],[3882,"依稀日影弄睛天，到处花开着眼看",31,32],[3883,"数该生子。",43],[3884,"相度从杂路，秦关百里有忧民。"],[3885,"宫至县丞，不能同捷。"],[3886,"乡科及第。",29],[3887,"桃花带路，灼灼宜人。",59],[3888,"父母如瑟琴，相和有定数。"],[3889,"安亨不寻常，终身得安康",75,76],[3890,"己卯拜师，方合此刻。"],[3891,"数有士一子，九子不送老。"],[3892,"雷电阴云布，须臾日有光。",45,46],[3893,"大小俱合吉，凡事得安康。",77,78],[3894,"子息五旬安家室。"],[3895,"下民祗若，福寿咸臻。",65,66],[3896,"以授补学，清平之职。"],[3897,"母先故于金，父后没于水。"],[3898,"灾何不息，恼着老人。",69,70],[3899,"其人之亡，定在二月。"],[3900,"一腔愁情谁识得，独留明月自家知。",49],[3901,"终身有功名方合此刻。"],[3902,"克勤克俭，性格谨慎。"],[3903,"有子当贵，贵者是次。",27],[3904,"剑遇张华文彩现，马逢伯乐姓名香。"],[3905,"大小鬼，不同姓。"],[3906,"孤鸾再有刑，一朝削发为僧人。"],[3907,"天哭侵扰，破耗无害。",13,14],[3908,"家室相足，拥其厚福。"],[3909,"鼠入城墙不用猜，当时恩自九重来。",63,64],[3910,"精通阴阳理数，专行造福于人。"],[3911,"子能拜金，巷景之荣。",57],[3912,"整顿桅帆，顺风乘流直向前。",41,42],[3913,"大兴土木工，不顾贫穷累。",53,54],[3914,"面有破相。"],[3915,"科场得意。",25],[3916,"春去又复秋，财源似水流。",45,46],[3917,"文星照命，大登桂籍作夫人。"],[3918,"陈前决事不须疑，鸟马沙场功最奇。",61,62],[3919,"公道贡间为白发，贵人头上不曾饶。"],[3920,"诗礼传家一门书，孔孟之道济世人。",41,42],[3921,"是年曾入险，谨慎事为宜。"],[3922,"道途有高低，无心住马蹄。",60],[3923,"有宜非得贵人扶。"],[3924,"苦雨连霄今日晴，扬鞭直指马蹄轻。",47,48],[3925,"人和人和，原来值钱多。",36],[3926,"妻宫杀伤，离合无恁。"],[3927,"丧门照命，师为归西。",27,28],[3928,"子占科名。",78,79],[3929,"皎发苍苍，孤子之服。",59],[3930,"其人活计，四海生涯。"],[3931,"阱头杨皙青，阁中人断魂。"],[3932,"是非交加，方知烦恼。"],[3933,"父命早去恨，无义方之训。"],[3934,"不幸严君寿太悭，早年先已别阳关。",3],[3935,"黄鸟如棱织得愁，三春花柳温相求。",47,48],[3936,"画堂春色满，幽人安乐中。",37,38],[3937,"满面春风，二度之喜。"],[3938,"一子土年生，二子金年生。"],[3939,"水年夫当入泮，方合此刻。"],[3940,"春来万物生，天地造化融。"],[3941,"曾向沧浪一叶惊，谁知亦自有神明。",75,76],[3942,"早年家业尽消磨，晚岁凄凉奈若何。"],[3943,"子当登科。",39,40],[3944,"年逢太岁，不测灾来。",65],[3945,"终日为人谋，何不自为计。"],[3946,"生来无义方之训。"],[3947,"风夜度行程，明朝风又生。",33],[3948,"秋草藤芜，严霜所苦。",75,76],[3949,"恍恍惚惚，不但人嗔且有鬼。",33],[3950,"灯花结蕊，喜事重来。",15,16],[3951,"一身活计在湖边，衣食无亏身不安。"],[3952,"身荣翰林，人生大幸。"],[3953,"新荷出水，亭亭直上。",21,22],[3954,"际遇淹留，只多烦恼。",23],[3955,"土木之年，荣任知县。"],[3956,"好树滋培，会成梁材。",27],[3957,"数有七子，一子送老。"],[3958,"枯苗无雨色如焦，一旦滂沱勃然秀。",43,44],[3959,"阳和风动，万物发荣。",32],[3960,"子占高魁。",59,60],[3961,"克恭克俭，自然天祜吉人。",41],[3962,"名列宫墙，文明之象。",21],[3963,"少上白发志不哀。"],[3964,"错足前途三十里，回来度倦又重新。",39,40],[3965,"晚年为孤子，世上堪难得。",72],[3966,"母日云亡，守制孝堂。",31],[3967,"疾病每相侵，流年处有疵。"],[3968,"金水之年点翰林。"],[3969,"撑之东墙，倾之西墙。",29,30],[3970,"灾杀相侵，人子纠缠。",52],[3971,"子当登科。",52],[3972,"路上有艰难，平阳莫问津。",57,58],[3973,"子占科名。",46],[3974,"乡试中式。",30],[3975,"雨顺风调，大有之庆。",39],[3976,"黄烛独月色，光明正在天。",59,60],[3977,"数定其妻，死于非命。"],[3978,"徒弟四人，三人送老。"],[3979,"作入幕宾，损德无益。"],[3980,"隐居青云路，马头带剑回。",50],[3981,"烛泪淋漓，哭夫早逝。"],[3982,"数该生子。",34],[3983,"花蕊放红，怎堪风雨。",4],[3984,"连年晦滞今朝释，自今更换又重新。",49,50],[3985,"斯年春闹大捷。",31],[3986,"七二称衰年，人生一大奇。",72],[3987,"子中科名，善之所至。",44],[3988,"月朗梅争秀，风和柳吐青。",42],[3989,"吉星照耀，官职高升。",63,64],[3990,"安然老景胜中年。",79,80],[3991,"早运迟迟后运美，梅花只到雪时奇。",57,58],[3992,"数定生子，阴阳中来。",50],[3993,"子当登科。",79,80],[3994,"兄弟七人，数有四贵。"],[3995,"数有三子，依次金木水。"],[3996,"远近依依物有情，花好开向值清明。",57,58],[3997,"老树萌芽，人生长寿。",72],[3998,"斯时妻安，亦是安然。",71],[3999,"终于一百零四年，拍掌大笑变登仙。",104],[4000,"有哀悲之忧。",57,58]]}
