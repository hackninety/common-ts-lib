{"volume":"申集","verses":[[9001,"花前谐私盟到底，鸳鸯得成合。"],[9002,"图谋顺利，运至时亨。",27,28],[9003,"父命鼠年生方合。"],[9004,"勇往直前，行之无阻。",33,34],[9005,"同榜进士，天发善门。"],[9006,"进退皆五位，兴师出中凶"],[9007,"夫小一年，姻缘前定。"],[9008,"借问欲栖林树鹊，何年却向帝城飞"],[9009,"甲子之年，武举及第。"],[9010,"利牝马之贞，冲人之吉。",29,30],[9011,"为福又为祥，得到又得安。",57,58],[9012,"君今欲渡为何事，如此风波未可行。",43,44],[9013,"父命丙子年生方合。"],[9014,"今带地因好，相邀无本生。"],[9015,"天公散人长，花前醉酒乡。"],[9016,"土计犯木星，注有牢刑灾。",15,16],[9017,"夫小二年，姻缘注定。"],[9018,"元亨利贞，大有所获。",57,58],[9019,"丙子之年，武举及第。"],[9020,"祖坟应出身，五七童儿忧。",6,7],[9021,"一字避忌曰火。"],[9022,"妻小一年，姻缘定数。"],[9023,"父子戊子年生方合。"],[9024,"父母同属鼠。"],[9025,"孝服弥门，披麻照命。",39,40],[9026,"火罗入水星，难免狱中刑罪苦。",17,18],[9027,"小小经营，自能白手成家。"],[9028,"桂子丛中双结实，数中注定。"],[9029,"戊子之年，武科中选。"],[9030,"柳花扑面，孝服之忧。",13,14],[9031,"笑把粉香归绣户，坐垂帘幕避尘埃。",27,28],[9032,"妻小二年，姻缘注定。"],[9033,"父子庚子年生方合。"],[9034,"父属鼠母属牛，数由前定。"],[9035,"名登黄甲，身赴琼林。",26],[9036,"气星照命，注定牢灾刑罪苦。"],[9037,"夫小四岁。"],[9038,"无妄之灾，其年不利。",37,38],[9039,"庚子之科，武举题名。"],[9040,"夫妻同庚。"],[9041,"人立危桥下，舟行起恐情。",66],[9042,"取四方之市利，积后福而悠悠。"],[9043,"父子壬子年生方合。"],[9044,"父鼠母虎，先天注定。"],[9045,"月照楼台，以外光明。",29,30],[9046,"木星照命，定为牢灾刑罪苦。",21,22],[9047,"夫小五岁。"],[9048,"际会和平，无边光景。",65,66],[9049,"壬子之年，宴会鹰扬。"],[9050,"墙边杨柳依依绿，若问年华处处闻。",27,28],[9051,"闭户静生，是非临门。",47,48],[9052,"早运迟迟晚运美，梅花只到雪时奇。"],[9053,"父子丑年生方合。"],[9054,"父母属兔，先天注定。"],[9055,"无本手艺虽然好，失多得少见阴功。"],[9056,"金木相克，难免狱中刑罪苦。",23,24],[9057,"夫小六岁。"],[9058,"大小安然，福禄绵绵。",21],[9059,"温柔而能刚，不类颂仲山。"],[9060,"一字避忌曰水。"],[9061,"数定幼年不学艺，去邪归正发财源。"],[9062,"妻小五岁，命中注定。"],[9063,"父子丁丑年生方合。"],[9064,"父鼠母龙，数由前定。"],[9065,"命带天雄犯计星，无本生理好难免。"],[9066,"天囚化马难免监，破财之悔逢盛年。",23,24],[9067,"夫小七岁。"],[9068,"好读奇书字博士，孙杨不遇枉然。"],[9069,"学得一般好手艺，刚而能温柔。"],[9070,"乍暖梅花犹半吐，初开柳眼未全舒。",19,20],[9071,"命犯恶曜，有耳不闻言。"],[9072,"早运迟晚运美花，结子福悠悠。"],[9073,"父命己丑年生方合。"],[9074,"父鼠母蛇，数由前定。"],[9075,"依嫩竹成竿，赖祖宗庇佑。",3],[9076,"计如相刑，难免牢中刑罪苦。",27,28],[9077,"夫小八岁。"],[9078,"洞房之年。",30],[9079,"多箱多仓，福禄且康。",63,64],[9080,"乙卯之年，宴饮鹰扬。"],[9081,"窥春柳眼微微绿，笑日梅花淡淡红。",9],[9082,"妻小七岁，姻缘注定。"],[9083,"父命辛丑年生方合。"],[9084,"父鼠母马，先天定数。"],[9085,"科甲及第。",37],[9086,"罗星入命，数注牢中刑罪苦。",29,30],[9087,"夫小九年方合。"],[9088,"知进知退，居安虑危。",47,48],[9089,"画水无声山有浪，绣花虽美不闻香。",39,40],[9090,"丁卯之年，武场中选。"],[9091,"赖祖宗庇佑，能方成大业。"],[9092,"妻小八岁。"],[9093,"父命癸丑年生方合。"],[9094,"父鼠母未，数内先祥。"],[9095,"数有五子，四子送终。"],[9096,"天囚到鼠厄，定为牢灾刑罪苦。"],[9097,"夫小十岁。"],[9098,"梅花始发，万卉稳妍。"],[9099,"梨花带雨，柳絮随风。"],[9100,"己卯之年，宴饮鹰扬。"],[9101,"落日平原寂，苍苍薄雾飞。",19,20],[9102,"妻小九年。"],[9103,"父命寅年生方合。"],[9104,"父鼠母猴，先天注定。"],[9105,"风吹碧桃落尘埃，花开无子出虚胎。"],[9106,"亲厄犯罗星，难免牢灾刑罪苦。",33,34],[9107,"夫小十一岁。"],[9108,"柳树怕经寒夜雨，梅花带雪隔年春。",29,30],[9109,"虽喜未为喜，逢凶不是凶。",67,68],[9110,"辛卯之年，武场得志。"],[9111,"蒙蒙云迷月，霏霏雨湿花。",50],[9112,"妻小十岁。"],[9113,"父命戊寅年生方合。"],[9114,"父鼠母鸡，先天注定。",33,34],[9115,"出胎便无母，幼时失所恃。"],[9116,"流年犯白虎，注定牢灾刑罪苦。",35,36],[9117,"夫小十二岁。"],[9118,"妻生三子，妾生二儿。"],[9119,"坤命元亨，夫明子秀。",27],[9120,"癸卯之年，武场捷报。"],[9121,"轻轻风雨拂沉沉，红已消疏绿未明。",47,48],[9122,"妻小十一岁。"],[9123,"父命庚寅年生方合。",33,34],[9124,"父鼠母犬，先天注定。"],[9125,"雷声虽大全无雨，放下心肠且自修",31],[9126,"罗计相犯，定主牢刑罪苦。",37,38],[9127,"夫小十三年。"],[9128,"桂子兰孙天，家庭和气兴。"],[9129,"须知两雁同飞下，一只先投入网中。"],[9130,"吉凶同途，宜慎则慎。",35],[9131,"命犯流霞，数注伤其手。"],[9132,"妻小十二岁。"],[9133,"父命壬寅生方合。"],[9134,"父鼠母猪，先天定数。"],[9135,"一字切忌曰羊，信不得。"],[9136,"火罗流年，定主牢狱刑罪苦。",39,40],[9137,"夫小十四年。"],[9138,"乡科及第，天赐佳儿。",21,22],[9139,"行为害人反害己，子息有亏报无穷。"],[9140,"祥光相照神，人足畅所怀。",31,32],[9141,"望梅止渴，究难宴济。",51,52],[9142,"妻小十三年。"],[9143,"父命甲寅年生方合。",57,58],[9144,"父母同牛，先天定数。"],[9145,"罗计相争，有损死于水火厄。"],[9146,"金水相犯，难免牢狱刑罪苦。",41,42],[9147,"夫小十五年。"],[9148,"进士及第，人生大幸。",38],[9149,"自思运未转，谋事反成凶。",29],[9150,"柳絮怕惊新岁雨，桃花随风逐水流。",83,84],[9151,"其乐杜康，顺境相忘。"],[9152,"妻小十四岁。"],[9153,"父命卯年生方合。"],[9154,"父牛母鼠，先天定数。"],[9155,"一字切忌曰狗，信得过。"],[9156,"水土相犯，牢灾刑罪之苦难。",33,34],[9157,"君老矣何当重任。",33,34],[9158,"曾皙之子得一面。"],[9159,"风月无边有，人间好事无。",83,84],[9160,"妻生一子，妾生五儿。"],[9161,"穿僧家衣服为俗，家事业辱我梵王。"],[9162,"妻小十五年。"],[9163,"父命丁卯年生方合。"],[9164,"父牛母虎，先天数定。"],[9165,"乐水乐山育圣书，礼忏焚香念道经。",29],[9166,"天囚入命，莫醉刑罪牢狱苦。",45,46],[9167,"生子之年。",26],[9168,"注定先天少雁行，到底兄弟不成双。"],[9169,"先做香花，后入禅林。"],[9170,"名登黄甲。",58],[9171,"幼年出家，中年还俗。"],[9172,"妻小十六年。"],[9173,"父命辛卯年生方合。"],[9174,"父牛母兔。"],[9175,"妻擅夫权，狮吼之风。"],[9176,"天狗犯岁厄，注有牢灾刑罪苦。",47,48],[9177,"欲得心事胜天公，散人长受花前醉。",53,54],[9178,"神人律管换年华，次第开时有好花。",30],[9179,"红袖影孤鹰境破，玉箫声断凤台空。",45,46],[9180,"妻生一子，妾生四儿。"],[9181,"庇荫之下，祖宗阴德。",19,20],[9182,"妻小十七岁。"],[9183,"父命辛卯年生方合。"],[9184,"父牛母龙，先天定数。"],[9185,"红绿交新，大称心怀。",25,26],[9186,"水火相犯，注定牢中刑罪苦。",49,50],[9187,"不如意事常八九。",27],[9188,"老夫少妻，相差十载。"],[9189,"兄在东时弟在西，一双鸿雁两分飞。"],[9190,"火在水上，未济之象。"],[9191,"幼年出家，先天注定。"],[9192,"妻小十八岁。"],[9193,"父命乙卯年生方合。"],[9194,"父牛母蛇，先天定数。"],[9195,"琴瑟和鸣细，拨朱弦和凤再舞。",39,40],[9196,"岁厄犯木星，命招牢狱刑罪苦",51,52],[9197,"安乐之象。",5],[9198,"新竹无端破，荟苔满绿阶。",6],[9199,"父母生年虽不同，注定同亲寿元终。"],[9200,"淹留岁月，混沌乾坤。",87,88],[9201,"千万身家，毁于一旦。"],[9202,"妻小十九年。"],[9203,"父命龙年生方合。"],[9204,"父牛母马，数定无差。"],[9205,"一林又一林，撑过前途好稍停",49,50],[9206,"天囚入岁厄，注定牢狱刑罪苦。",53,54],[9207,"钦命典试。",33,34],[9208,"早运淹沉志未伸，不如待等好运临。",18],[9209,"莺因雨久声犹滞，月为云遮不放光。",27],[9210,"六阴之象，事不安康。"],[9211,"早年妻离子散，中年数当出家。"],[9212,"妻小二十年。"],[9213,"父命丙辰年生方合。"],[9214,"父牛母羊，先天定数。"],[9215,"寻花问柳，千红万紫乐意浓。",33,34],[9216,"金星犯天囚，数定牢中刑罪苦。",53,54],[9217,"名登黄甲。",40],[9218,"万里春风布暖，一天秋月扬辉。",23,24],[9219,"一字切忌曰香，百业兴隆。"],[9220,"云里明月，雨中鲜花。"],[9221,"父母生年合土，死于水年方合。"],[9222,"休说六韬三略，只从远路扬名"],[9223,"父命戊辰年生方合。"],[9224,"父牛母猴，先天定数。"],[9225,"时未至兮君宜守，何必徒劳费精神。",19,20],[9226,"天囚犯流霞，难免牢中刑罪苦。",56,57],[9227,"功名成就日，一旦姓名扬。",32],[9228,"前生凤缘，数当披剃。"],[9229,"钓于渭水，时运未遇。",27,28],[9230,"披麻无情，门庭闹乱。",45,46],[9231,"中年出家，数由前定。"],[9232,"妻小二十二岁。"],[9233,"父命庚辰年生方合。"],[9234,"父牛母鸡，先天定数。"],[9235,"虽是出家僧，常作俗家事。"],[9236,"金木相犯，主有牢中刑罪苦。",69,70],[9237,"天配水火子，招金土方合。"],[9238,"撑过山时又是关，缓辔徐行兔见伤。",21],[9239,"五福寿为先，平安乐天年。",91,92],[9240,"与人慈悲，可以成佛。"],[9241,"名登金榜。",38],[9242,"禅房却被雪花侵。",33,34],[9243,"父命壬辰年生方合。"],[9244,"父牛母犬，先天定数。"],[9245,"修造殿宁旺释家，日新佛像旺僧门。"],[9246,"天囚入岁厄，定招牢中刑罪苦。",61],[9247,"雨妍桃花，云迷秋月。",31],[9248,"百岁有几人，天赐我百零。",120],[9249,"乍雨乍晴春无定，花开花落雨无情。",19],[9250,"拮据不遑之象。",39,40],[9251,"名登黄甲。"],[9252,"妻小二十四岁。"],[9253,"父命蛇年生方合。"],[9254,"父牛母猪，先天定数。"],[9255,"篱中金菊耐霜寒。",93,94],[9256,"命带天囚星，难免牢中刑罪苦。",65,66],[9257,"明花满庭，时时乐意。",51,52],[9258,"衣帛食肉，不负天年。",19],[9259,"半帘秋叶碧，满园春花寂。",21,22],[9260,"屯蒙之象，事不安宁。",95,96],[9261,"若问寿元何日止，花甲将周是归期，"],[9262,"水满池塘花满枝，青青叶里自闻香。",27,28],[9263,"父母丁巳年生方合。"],[9264,"父母全属虎，先天定数。"],[9265,"查得寿元足矣。",93,94],[9266,"天内人命，定招定中刑罪苦。",65,66],[9267,"乡科捷报，天赐佳儿。",33,34],[9268,"七夕有云天淡淡，中秋无月夜蒙蒙。",19],[9269,"木年死子方合。"],[9270,"满眼儿孙多富贵，福如东海寿南山。",95,96],[9271,"春风吹雨遍残枝，无数花飞水一池。",33,34],[9272,"万恨愁人方易老，春回依旧生芳草。",43,44],[9273,"父命己巳年生方合。"],[9274,"父虎母鼠，先天定数。"],[9275,"招得土木之夫，木火之子方合。"],[9276,"命犯天囚，注定牢中刑罪苦。",67,68],[9277,"苦命阳年何日止，七锂加五是归期。",75],[9278,"喜怒不形，物我无问。"],[9279,"不知气力寒多少，但觉新愁夜上楼。",53,54],[9280,"无语对斜晖，万恨千悉只处知。",35,36],[9281,"甲午之年，宴食鹰扬。"],[9282,"黄叶无风落，秋云雨长阴。",37,38],[9283,"父命辛巳年生方合。"],[9284,"父虎母牛，先天定数。"],[9285,"数该生子。",79,80],[9286,"天囚入命，定招牢狱之苦。",69,70],[9287,"借流荧之光，若隐又若现。",53,54],[9288,"潦金大运地，当入宫墙时。",23],[9289,"文武科中出，命有千总升。"],[9290,"黄金不为贵，老安值钱多。",97,98],[9291,"丙午之年，武扬捷报。"],[9292,"不必问荣枯，荣枯未有期。",53,54],[9293,"父命癸巳年生方合。"],[9294,"父虎母兔，先天定数。"],[9295,"逐鹿还失鹿，求名未得名。",57,58],[9296,"老来借三春，以足八旬数。"],[9297,"锦绣堂中列绮罗，春风八户鸟声和。",27,28],[9298,"生子之年。",77],[9299,"事遇从容怀抱安，金风一阵夜生寒。",29,30],[9300,"沐恩三十年，子贵妻荣。"],[9301,"戊午之年，宴饮鹰扬。"],[9302,"灾晦相侵，流年不利。",11,12],[9303,"父命午年生方合。"],[9304,"父虎母龙，先天定数。"],[9305,"夫大一年，婚姻前定。"],[9306,"数有偏枯，子当瞽目。"],[9307,"名登黄甲。"],[9308,"不幸双亲俱欠寿，自成自立苦伶仃。"],[9309,"人道流年美，梨花一枝春带雨。",11],[9310,"美景良辰君莫负，老来行乐享天年。",97,98],[9311,"庚午之年，宴饮鹰扬。"],[9312,"八旬欠一是归期，算来易数已先知。",79],[9313,"父命午年生方合。"],[9314,"父虎母蛇。"],[9315,"夫大二年，先天注定。"],[9316,"佳期在即。",18],[9317,"衣食饶足，家门迪吉。",46,47],[9318,"犹如秋雨夜雨，一点一声愁。",45,46],[9319,"一日暴未乾，何堪十日寒。",25,26],[9320,"六阴之象，事不能安。",27,28],[9321,"壬午之年，宴食鹰扬。"],[9322,"本是同林鸟，雄者恨先飞。",68],[9323,"父命戊午年生方合。"],[9324,"父虎母马，先天定数。"],[9325,"夫大三年，姻缘注定。"],[9326,"齐眉称举案，戒蛙有鸡鸣。"],[9327,"饱食暖衣，无求之乐。",29,30],[9328,"年逢十岁亦堪夸，风前之烛雨中花。",10],[9329,"坐临活水襟怀净，卧坐淡云世虑深",92],[9330,"名登黄甲。",53],[9331,"因木而择垒，松树耐岁寒",57,58],[9332,"远蚰出云催薄雾，微风细雨弄轻烟。",35,36],[9333,"父命庚午年生方合。"],[9334,"父虎母羊，易数先详。"],[9335,"夫大四年，姻缘注定。"],[9336,"松树清风堪说法，竹林明月任谈经",47,48],[9337,"空看雨涨秋池水。"],[9338,"风折梅花，雨打梨花。",15],[9339,"近贵日久，亦可荣身"],[9340,"勤俭持家，只深惆怅。",23,24],[9341,"位尊五品，得结一生之局"],[9342,"月光当头可奈何，头男长女泪痕多"],[9343,"父命壬年生方合。"],[9344,"父虎母猴，先天定数。"],[9345,"夫大五年，姻缘注定。"],[9346,"前途未定，八千里路云和月。"],[9347,"人事得周全，春花秋月满目前。",53,54],[9348,"流年交一旬，灾晦未相侵",10],[9349,"兄妹四人，我居幼。"],[9350,"取用有余，闺中快乐",24],[9351,"名登黄甲。",55],[9352,"欢娱正好愁夜短，洗脱东风志不迁。",51,52],[9353,"父命羊年生方合。"],[9354,"父虎母鸡，先天定数"],[9355,"夫大六年，姻缘注定。"],[9356,"往事如烟，白了少年头。"],[9357,"欲图黄卷春风暖，须耐青灯夜雨寒。"],[9358,"招得金水年，死于水火年。"],[9359,"名子补入蟾宫里，十里杏花堪跨马。"],[9360,"动有悔成尤，不动方有益。",64],[9361,"戊子拜师，方合此刻。"],[9362,"身字意稳，动用不竭。",19,20],[9363,"父命丁未年生方合。",39],[9364,"父虎母犬，先天定数。"],[9365,"夫大七年，前生注定。"],[9366,"老夫少妻，久旱逢雨。"],[9367,"好个春光遍，恨妒风疾雨。",37,38],[9368,"幼年不堪，犹如雨中花。",13],[9369,"无分嫡庶，总叶熊罴。"],[9370,"露冷莲房，粉痕欲坠。",45],[9371,"展开凤阁消残梦，静对开花满目中。",35,36],[9372,"名登金榜。",55],[9373,"父命己未年生方合。"],[9374,"父虎母猪，前天定数。"],[9375,"夫大八年，前生注定。"],[9376,"兄弟二人，乐奏几般音。"],[9377,"高枕北窗下，谨慎勿妄动。",57,58],[9378,"离卦中虚之象。",63,64],[9379,"妻生一子，妾生一儿。"],[9380,"阴雨连绵，闺中愁怨。",47,48],[9381,"莫道春花好，风雨又相催。",53,54],[9382,"红杏出墙，流水风吹。"],[9383,"父命辛未年生方合。"],[9384,"父母同属兔，先天定数。"],[9385,"夫大九年，前生注定。"],[9386,"月暗风涌，篱花落落。"],[9387,"一树梨花白玉开，丧门照命有忧来。",47,48],[9388,"驾鹤乘云去，飘然竟不回。",87],[9389,"子结二枝，正副同产。"],[9390,"福自降兮禄自臻，衬时称赏庆芳辰。",19,20],[9391,"水涨渔翁泊柳桥，披蓑戴笠过江臬。",67],[9392,"黄金埋土，未得施为。",23],[9393,"父命癸未年方合。"],[9394,"父兔母鼠，先天定数。"],[9395,"夫大十年，姻缘注定。"],[9396,"性急偏向虎山行。"],[9397,"桂子丛中，初结实数中注定。"],[9398,"官至都司，不能高擢。"],[9399,"元旦不传云外信，三春空结雨中愁。",69,70],[9400,"不读诗书千万卷，只求榛粟数株多。"],[9401,"乍雨乍晴春易老，闲愁闲闷日偏长。",31],[9402,"操持未久鬓斑竹，一点雄心尚未阑。"],[9403,"父命猴年生方合。"],[9404,"父兔母牛，先天定数。"],[9405,"夫大十一年，婚姻注定。"],[9406,"一字记住曰刚。"],[9407,"丧门相照，有哭泣之哀。",49,50],[9408,"流年不宁，临灾不免。",13],[9409,"园圃春长在，闺门吉庆多。",23,24],[9410,"喜气盈门，事事从容。",22],[9411,"妻生四子，妄亦如之。"],[9412,"月字当头，子女定有损耗。"],[9413,"父命丙申年生方合。"],[9414,"父兔母虎，先天定数。"],[9415,"夫大十二年，婚姻注定。"],[9416,"兄妹四人，我为兄。",33],[9417,"勤俭持家，内助良人游国学。"],[9418,"人事无关心意足，梦魂不扰兴偏长。",59,60],[9419,"父母同年生，享寿自不同。"],[9420,"顺遂韶光，安闲获福。",25,26],[9421,"粗茶淡饭，闺房欢乐。"],[9422,"人口平安家财旺，海棠不与旧时同。",28],[9423,"父命戊申年生方合。"],[9424,"父兔母龙，先天定数。"],[9425,"粗袈淡食消，白昼养禅心。"],[9426,"妻生二子，妾生四子。"],[9427,"六阴之象，事不安宁。",35,36],[9428,"福禄随天降，财源逐日新。",26],[9429,"细雨沾花不发，淡云迷日还沉。",13],[9430,"世上难逢百岁人，君今百岁有二春。",102],[9431,"秋风萧飒，闺阁凄然。",42],[9432,"日正光辉月下正圆，眼前美景乐无边。",29],[9433,"父命庚申年生方合。"],[9434,"父兔母蛇易数无差。"],[9435,"夫大十四年，婚姻注定。"],[9436,"衣食有余，禅门享福。"],[9437,"一些闲福享不得，碌碌营生独自辛。"],[9438,"犹如秋夜雨，一点一声愁。",52,53],[9439,"玉楼烟锁一春寒，满园桂子发秋香。"],[9440,"一肩风雨任平生。"],[9441,"门庭多吉庆，财福自天来。",29],[9442,"一点福星当牖户，满庭春色蔼闾门。",45,46],[9443,"父命壬申年生方合。"],[9444,"父兔母马，先天定数。"],[9445,"夫大十五年，婚姻注定。"],[9446,"秋风露滴迎花月，孤雁湘江任来去。"],[9447,"乙酉之年，宴饮鹰扬。"],[9448,"借流萤之光，或隐或现。",61,62],[9449,"时人不识予心乐，将谓偷闲学少年。",10,11],[9450,"时来风送滕王阁，君家百事任施为。",33],[9451,"运迷皎月无人赏，雨打梨花结不成。",49,50],[9452,"子有三凤夺，锦标以扬名。"],[9453,"父命鸡年生方合。"],[9454,"父兔母羊，先天定数。"],[9455,"夫大十六年，命中注定。"],[9456,"一字切忌曰猴，疏不得。"],[9457,"丁酉之科，武扬得意。"],[9458,"其人住居，香花僧院。"],[9459,"抢攘未有宁，内外俱焦心。",61],[9460,"家业兴隆，喜子又昌。"],[9461,"琅琊竹报平安日，锦绣花开满目中。",29],[9462,"日正端阳，吉祥之中又吉庆。",47,48],[9463,"父命丁酉年生方合。"],[9464,"父兔母猴，先天定数。"],[9465,"夫大十七年，婚姻注定。"],[9466,"兄妹四人，我居次。"],[9467,"己酉之年，宴饮鹰扬。"],[9468,"灾晦相侵，流年不利。",65],[9469,"心中多少忧愁事，冷落凄凉人自知。",24],[9470,"桃红柳绿，大称心怀。",33],[9471,"上苑春回花正发，云静新秋月正明。",41],[9472,"人从运转，福自天来。",27,28],[9473,"父命乙酉年生方合。"],[9474,"父兔母鸡，先天定数。"],[9475,"夫大十八年，婚姻注定。"],[9476,"哑巴得一，心满意足。"],[9477,"辛酉之科，宴饮鹰扬。"],[9478,"子多惹事，一枝足矣。"],[9479,"先迷后得，利有攸往。"],[9480,"宁可修德避难，不可行险以求。"],[9481,"田园广阔声名重，家业兴隆气象新。",39,40],[9482,"数注良人难共老，一朝辞世别阳关。",53],[9483,"父命辛酉年生方合。"],[9484,"父兔母犬，先天定数。"],[9485,"夫大十九年，婚姻注定。"],[9486,"有子虽多，易数仅知其一。"],[9487,"癸酉之年，武扬捷报。"],[9488,"满眼春花好，一天秋月明。",42],[9489,"泽上有水，困厄之象。",24],[9490,"一百零三春，安然往西行。",103],[9491,"房考之年。",32,33],[9492,"三子送老。"],[9493,"父命癸酉年生方合。"],[9494,"父兔母猪，先天定数。"],[9495,"作事常存思孝道，妻亲不失孩儿心。"],[9496,"兄弟四人，非一母所生。"],[9497,"花絮叶落，五女送终。",73,74],[9498,"运行光明地，时当几机为。",33,34],[9499,"不中不庸，其道坦荡。",37,38],[9500,"夫妻六冲，一刚一柔皆到老。"],[9501,"夜深明月更添愁。",46],[9502,"天涯海角任飘蓬，数注驿马在命中。"],[9503,"父命戌年生方合。"],[9504,"父母俱属龙，数定在其中。"],[9505,"夫大二十一年，命中注定。"],[9506,"醉倒杏花村，一字记之酒。"],[9507,"天哭催人，难免孝服。",51,52],[9508,"和风丽日时，财兴喜气多。",46],[9509,"寿域弘开，福常厚享。",107],[9510,"日暖桃花放，泥融燕子飞。",40],[9511,"玉楼烟锁三春冷，桂子秋生八月香。"],[9512,"乙丑之年，名登黄甲。"],[9513,"命父丙戌生方合。"],[9514,"父龙母鼠。"],[9515,"夫人二十二年，婚姻注定。"],[9516,"理数算来原有定，七十有三是归程。",73],[9517,"其形如石，其姓如朱。"],[9518,"双双燕侣两分飞，自恨不齐眉。",59],[9519,"二旬之外，得子结实。"],[9520,"日暖东园花绽锦，雨晴北岸柳摇金。",46,47],[9521,"田园广阔声名重，喜气峥嵘子又昌",53,54],[9522,"丁丑之年，名登黄甲。"],[9523,"父命戊戌年生方合。"],[9524,"父龙母牛，先天定数。"],[9525,"夫大二十三年，婚姻注定。"],[9526,"花木深时香自满，尘绿空处性常明。",49,50],[9527,"名登金榜。",44],[9528,"柳发何愁堤岸峭，桃开正喜日光融。",60],[9529,"雨后江山争秀丽，风前花柳正繁华。",52],[9530,"木年克子，火年又克。"],[9531,"九九还有一年寿。",82],[9532,"己丑之年，名登黄甲。"],[9533,"父命庚戌年生方合。"],[9534,"父龙母虎，先天注定。"],[9535,"发财创业兴家富，湖海经营有路通。"],[9536,"人生八八，荷叶凋谢。",64],[9537,"数有偏枯，长子瞽目。"],[9538,"桃红柳绿三春景，日暖风和二月天。",60],[9539,"名登金榜，天赐佳儿。",30],[9540,"轻之半步难动，重之千里易行。",55,56],[9541,"以秀才而辞监，数自前定。"],[9542,"辛丑之年，名登黄甲。"],[9543,"父命壬戌年生方合。"],[9544,"父龙母兔，先天定数。"],[9545,"夫大二十五年，婚姻注定。"],[9546,"一字切记曰红，吉利矣。"],[9547,"良人先去世，独自守黄昏。",57],[9548,"主持闺门风光好，内外心闲乐意多。",31,32],[9549,"喜气人增彩，财源日日昌。",61,62],[9550,"人生七十古来稀，更添四载是归期。",74],[9551,"暗天雷鸣，无风浪生。",49,50],[9552,"癸丑之年，进士必得。"],[9553,"父命亥年生方合。"],[9554,"父龙母蛇，先天定数。"],[9555,"夫大二十六，婚姻前定。"],[9556,"全凭神力成终始，自有麟儿结实来。"],[9557,"兄妹五人，我居长。",45],[9558,"相夫子以富贵，厉甘苦以辛勤。",21,22],[9559,"得意须防失意，无心务要留心。",27,28],[9560,"老妻少夫，方合此刻。"],[9561,"君知先天数，有子不如徒。"],[9562,"命不由人，次子瞽目。"],[9563,"父命丁亥年生方合。"],[9564,"父龙母马，先天定数。"],[9565,"夫大二十七年，婚姻前定。"],[9566,"为人孝悌，为人忠厚。"],[9567,"天降财源盛，人谋福道昌。",66],[9568,"春光多富贵，皎月正光辉。",63,64],[9569,"柳絮随风舞，桃花逐水流。",76],[9570,"易消易长沟中水，时卷时舒天上云。",35],[9571,"旧恨新苦，蹙在眉尖。",25,26],[9572,"命虽薄而遇好境，生平及禄贵人家。"],[9573,"父命己亥年生方合。"],[9574,"父龙母羊，先天定数。"],[9575,"幽室雪侵，菩提惨淡。",57,58],[9576,"汲水烹茶，优游多福。",47,48],[9577,"不用谋衣食，饱暖足无求。",45],[9578,"烹之硬砍之，空世上奇人"],[9579,"寿元花甲外，前生注定。",69],[9580,"知君老至精神旺，还言晚景子又昌",65,66],[9581,"嫩竹成林，指日畅茂。",11,12],[9582,"三子不成人，前生注定。"],[9583,"父命辛亥年生方合。"],[9584,"父龙母猴，先天注定。"],[9585,"丧门照命，师当归西。",37,38],[9586,"及水烹茶，优游多福。"],[9587,"乡科及第，又兆熊罴。"],[9588,"莫道秋容冷淡，自然晚景光辉。"],[9589,"日暖桃花放，呢喃燕子飞。",29,30],[9590,"事事称人怀，少年行乐欢。",13,14],[9591,"无灾无难，流年之庆。",11,12],[9592,"居安思危，思则有备。"],[9593,"父命癸亥年生方合。"],[9594,"父龙母鸡，先天定数。"],[9595,"夫大三十，婚姻注定。"],[9596,"妻生三子，妾生三儿。"],[9597,"有禄有财过晚景，无忧无虑乐平平。"],[9598,"灾晦不生，平安之福。",13],[9599,"寿元花甲外，一生得安然。"],[9600,"不幸少灾殃，自新喜气临。",14],[9601,"少年得意，一生成气。",13,14],[9602,"诸事徘徊人，深闺美容开。",53,54],[9603,"甲辰之年，敕赐进士。"],[9604,"父龙母犬，先天定数。"],[9605,"母命子年生方合。"],[9606,"有子虽多，易数仅知其三。"],[9607,"缓辔徐行自驾程，月沉东海日东升。",23,24],[9608,"喜逢身外地，连年卜卦宜。"],[9609,"杨柳维新，万家舒泰。",68],[9610,"春回花正发，雨后草长生。",14],[9611,"上苑奇花呈富贵，庭前翠竹发新枝。",33,34],[9612,"中馈有主，频繁可托。"],[9613,"丙辰之年，得中进土。"],[9614,"父龙母猪，先天定数。"],[9615,"母命丙子年生方合。"],[9616,"木年克妻，金年再娶。"],[9617,"好花栽满园，绿竹影长亭。"],[9618,"时来堪富贵，安享福盈盈。",14],[9619,"丧门相照，师不能延。",39,40],[9620,"闺中福禄，无常深恼。",55,56],[9621,"上苑花发，待续东宫。"],[9622,"万里春光先布暖，一天秋月正扬辉。",15],[9623,"戊辰之年，进士必得。"],[9624,"父母全属蛇，先天数不差。"],[9625,"母命戊子生方合。"],[9626,"兄妹五人，我居幼。"],[9627,"火年妻故，一命归天。"],[9628,"双目不明，前生注定。"],[9629,"风和日暖梅花吐，水润泥融燕子居",82],[9630,"岁寒之时，松柏独秀。",69],[9631,"幼年造化奇，一天星斗正光辉。",16],[9632,"虽然富足，子孙难招。"],[9633,"庚辰之年，进士必得。"],[9634,"父蛇母鼠，先天定数。"],[9635,"母命庚子年生方合。"],[9636,"科甲及第。",46],[9637,"绸缪不少，快意无多。",74,75],[9638,"一字须记曰忍，忍之海阔天空。"],[9639,"兄弟虽多，易数只有其二。"],[9640,"夜月彩花影，春风报佳音。",15],[9641,"桃红柳绿，大称心怀。",18],[9642,"佳儿佳妇，老有所养。"],[9643,"壬辰之年，进士注定。"],[9644,"父蛇母牛，先天定数。"],[9645,"母命壬子年生方合。"],[9646,"七六大造化，腾云又揽月。",42],[9647,"数注偏枯，父当瞽目。"],[9648,"一朵名花果出奇，不因风雨两相催",17,18],[9649,"眉头不挂别烦恼，无闷心闲竟安舒。",16],[9650,"风里落花谁是主，丁香空结雨中愁。",79,80],[9651,"不劳于事，自合其宣。",19],[9652,"门外流莺啼，落花兰房寂寞人。",52,53],[9653,"乙未之年，进士及第。"],[9654,"父蛇母虎，先天定数。"],[9655,"母命牛年生方合。"],[9656,"老师得道日，何怕雪夜侵。",42],[9657,"一子送老，先天注定。"],[9658,"安享福自然，神人内助总无牵。",17,18],[9659,"风卷灯花暗，扶摇风雨影纵横。",15,16],[9660,"明月春风，挥洒自如。"],[9661,"嫩蕊初吐秀，好运又及时。",19],[9662,"此卦招妻水命生，金木之年寿元终。"],[9663,"丁未之年，进士及第。"],[9664,"父蛇母兔，先天注定。"],[9665,"母命丁丑生方合。"],[9666,"命照武曲星，招来壮土作夫人。"],[9667,"二子送终，先天注定。"],[9668,"花落万事愁，家计事事忧。",23,24],[9669,"颠沛流漓，穷愁自苦。",25,26],[9670,"莫信时运好，须防有灾侵。",79,80],[9671,"好景须记之，梅黄橘绿时。",20],[9672,"房孝之年。",32],[9673,"己未之年，进士必得。"],[9674,"父蛇母龙，先天定数。"],[9675,"母命己丑年生方合。"],[9676,"一心闲处心，如水万法空。",62],[9677,"三子送老，先天注定。"],[9678,"乾坤有道门庭旺，福禄无亏造化亨。",23],[9679,"洛阳花发春光艳，玉井莲开夏景浓。",21],[9680,"不贪美酒，则祸无生。"],[9681,"天赐其庥，福祉直臻于绣户。",29,30],[9682,"运来何必劳心力，人旺财兴事业增。",39,40],[9683,"辛未之年，进士必得。"],[9684,"父蛇母马，先天注定。"],[9685,"母命辛丑年生方合。"],[9686,"未娶妻先立妾，数有前定。"],[9687,"四子送终，先天注定。"],[9688,"室中欢笑，事事呈祥。",15,16],[9689,"日烘春色侵衣艳，风送衣来扑鼻香。",25,26],[9690,"门庭多吉庆，人事倍精神。",23],[9691,"南极祥光照我身，此年幸得吉星临。",69,70],[9692,"事可以称心，交友可称信。"],[9693,"癸未之年，进士必得。"],[9694,"父蛇母羊，先天定数。"],[9695,"母命癸丑年生方合。"],[9696,"一朝春尽红颜老，花落人亡两不知。"],[9697,"五子送终，先天注定。"],[9698,"龙在山中，心向贵人。",47,48],[9699,"旺夫益子，精神湛玉壶。",45,46],[9700,"夫大三岁，百依百顺。"],[9701,"夫妻仝暮景，兰桂喜芬芳。"],[9702,"钦命典试。",31],[9703,"甲戌之年，进士必得。"],[9704,"父蛇母猴，先天定数。"],[9705,"母命虎年生方合。"],[9706,"恩爱夫妻，时有且吾。"],[9707,"六子送终，先天注定。"],[9708,"兄妹五人，我居次。",47],[9709,"满门诸事喜，闺中富自来。",55,56],[9710,"运际其亨，闺中吉庆。",49,50],[9711,"眉尖开扬，事得施张闺中祥。",65,66],[9712,"利牝马之贞，享安然之福。",17,18],[9713,"丙戌之年，进士必得。"],[9714,"父蛇母鸡，数定不差。"],[9715,"母命丙寅年生方合。"],[9716,"数有偏枯，欠子不幸短命。"],[9717,"数有七子，得以送终。"],[9718,"福自天申人财旺，事遂谋为子又昌。",53,54],[9719,"依然无事纳祯祥，几朵梅花扑鼻香。",67,68],[9720,"芦花红绿晚花秋，催得芙蓉点鬓周。",63,64],[9721,"灾晦不侵，平安之福。",67,68],[9722,"深院锁黄昏，阵阵芭蕉雨。",65,66],[9723,"戊戌之年，进士必得。"],[9724,"父蛇母犬，先天注定。"],[9725,"母命戊寅年生方合。"],[9726,"有子虽多，易数仅得其三。"],[9727,"八子送终，先天注定。"],[9728,"花沾春色园林茂，月布秋天绣幔光。",19,20],[9729,"阳春万象然，新闺满春院。",69,70],[9730,"流年吉又祥，淑贤内助得安康。",49,50],[9731,"梅花含却杏花新，一日白来一日红。",35,36],[9732,"绿竹林中花出色，白莲池上蕊生香。",23,24],[9733,"庚戌之年，进士必得。"],[9734,"父龙母猪，先天定数。"],[9735,"母命庚寅年生方合。"],[9736,"寂寞妆台夜气寒，朦胧月色度栏杆。",39,40],[9737,"九子送终，先天注定。"],[9738,"庭前细雨飘无迹，雨后清风爽气生。",57,58],[9739,"好将事事传儿辈，乐我余年尽素心。",59,60],[9740,"百花未发，争鲜沟艳。"],[9741,"洛阳花发春光艳，玉井莲开夏景浓。",33,34],[9742,"夫君难共老，先我数春秋。",61],[9743,"壬戌之年，进士必得。"],[9744,"父母同属马，先天数不差。"],[9745,"母命壬寅年生方合。"],[9746,"朝夕勤劳，支持度日。",33,34],[9747,"十儿送老，先天注定。"],[9748,"灾晦相侵，闺中欠顺。",16,17],[9749,"画水无声空有浪，绣花虽美不闻香。",17,18],[9750,"清风拂拂雨沉沉，红折消疏绿未明。",37,38],[9751,"绣户深无语，叶上数声雨。",59,60],[9752,"利名终有望，寒门绿出头。"],[9753,"身带暗疾，定数先详。",52],[9754,"父马母鼠，先天注定。"],[9755,"母命兔年生方合。"],[9756,"时限运阻碍，人物不安宁。",27,28],[9757,"往往皆如意，春光处处全。",37,38],[9758,"分有嫡母，我生庶母。"],[9759,"池上春归何处去，日残花絮逐人飞。",62,63],[9760,"水火性情发则焚，燎原静则渊潮平。"],[9761,"妻大一年，姻缘前定。"],[9762,"妻生一子，妾生二儿。"],[9763,"欲赴瑶池会，无奈色心何。"],[9764,"父马母牛，先天定数。"],[9765,"母命丁卯年生方合。"],[9766,"沉疴不起，一命归西。",71],[9767,"妻命甲子生，姻缘注定。"],[9768,"数载饥鬼道，不能拜禅林。"],[9769,"父亡生子，一忧一喜。",16],[9770,"一胎生二子，定在此年。",21],[9771,"妻大二年，姻缘前定。"],[9772,"子死立妾，同在此年。",50],[9773,"同房之年。"],[9774,"父马母牛，先天定数。"],[9775,"母命己卯年生方合。"],[9776,"猴马忘机，日满帘明。",45,46],[9777,"妻命丙子生，姻缘定数。"],[9778,"岁至花甲，还有一纪。"],[9779,"父亡生子，一忧一喜。",17],[9780,"一胎生二子，见于此年。",20],[9781,"妻大三年，姻缘前定。"],[9782,"子登科甲。"],[9783,"马妻亡，再娶羊妾。"],[9784,"父马母蛇，先天定数。"],[9785,"母命辛卯年生方合。"],[9786,"兄妹二人，我居二。"],[9787,"妻命戊子生，先天注定。"],[9788,"驾鹤乘云去，飘然竟不回。",87],[9789,"父亡生子，忧喜全至。",18],[9790,"一胎生二子，定在此年。",23],[9791,"妻大四岁，命中注定。"],[9792,"同本双莲出，奇开两朵花。"],[9793,"一生二妻，一母所生。"],[9794,"父马母龙，数定其中。"],[9795,"母命癸卯年生方合。"],[9796,"解印荣归，享生平福。",71,72],[9797,"妻命庚子生，前缘注定。"],[9798,"人生过花甲，加二见阎君。",72],[9799,"父亡生子，忧喜全至。",19],[9800,"一胎生二子，定于此年。",24],[9801,"妻大五岁，姻缘前定。"],[9802,"兄弟二人，瞽瑟琴和乐有助。"],[9803,"同房之年。",33,34],[9804,"父马母蛇，易数不差。"],[9805,"母命龙年生方合。"],[9806,"八卦减三爻，花甲加一见阎君。",61],[9807,"妻命壬子生，姻缘注定。"],[9808,"问子息六旬外，得之方实际。",63],[9809,"父亡生子，忧喜全见。",20],[9810,"一胎生二子，见于此年。",25],[9811,"妻大六岁。"],[9812,"果然春去花无色，静结栏杆更暗然。",30],[9813,"钦命典试。",21],[9814,"父马母羊，易数先详。"],[9815,"母命丙辰年生方合。"],[9816,"谢却人间事，常纳祯祥福。",55,56],[9817,"妻命乙丑生，姻缘注定。"],[9818,"玉人有刑，再娶甲子。"],[9819,"父亡生子，一忧一喜。",21],[9820,"一胎生二子，见于此年。",26],[9821,"妻大七岁，姻缘前定。"],[9822,"可惜挥金如粪土，乐山乐水误功名。"],[9823,"父亥年生方合。"],[9824,"父马母猴，先天注定。"],[9825,"母命戊辰年生方合。"],[9826,"寸心常伴白云间。",55,56],[9827,"妻命丁丑生，先天注定。"],[9828,"玉人有刑，再娶丙子。"],[9829,"父亡生子，一忧一喜。",22],[9830,"一胎生二子，见于此年。",27],[9831,"妻大八岁，命中注定。"],[9832,"雁门品字方成阵，二凤标名万国中。"],[9833,"菩提已种前生福，乐得优游静室中。"],[9834,"父马母鸡，先天注定。"],[9835,"母命庚辰年生方合。"],[9836,"兄妹五人，我居四。"],[9837,"妻命己丑生，姻缘注定。"],[9838,"玉人有刑，再娶戊子。"],[9839,"父亡生子，忧喜同至。",23],[9840,"一胎生二子，见于此年。",28],[9841,"妻大九年，先天定数。"],[9842,"花开并蒂，先天之数。"],[9843,"倚杖听鸣泉，写经翻贝叶。",37,38],[9844,"父马母犬，先天数定。"],[9845,"母命壬辰年生方合。"],[9846,"有子虽多，易数仅得其四。"],[9847,"妻命辛丑生，前缘注定。"],[9848,"玉人有刑，再娶庚子。"],[9849,"父亡生子，一忧一喜。",24],[9850,"一胎生二子，定于此年。",29],[9851,"师傅当归，一命西天。",43,44],[9852,"当庭月色空，时到三阴中。",59,60],[9853,"一父一母，兄妹三人。"],[9854,"父马母猪，先天注定。"],[9855,"母命蛇年生方合。"],[9856,"兄妹六人，我居长。"],[9857,"妻命癸丑生，姻缘注定。"],[9858,"玉人有刑，再娶壬子。"],[9859,"父亡生子，一忧一喜。",25],[9860,"一胎生二子，定于此年。",30],[9861,"妻大九岁，命中注定。"],[9862,"一夫一妻，举案齐眉。"],[9863,"兄弟一人，数中注定。"],[9864,"父母全属羊，数内先祥。"],[9865,"母命丁巳年生方合。"],[9866,"兄妹六人，我居次。"],[9867,"妻命甲寅生，姻缘注定。"],[9868,"玉人有刑，再娶乙丑。"],[9869,"父亡生子，一忧一喜。",26],[9870,"一胎生二子，定于此年。",31],[9871,"妻大十岁，结缘夫妻。"],[9872,"三十而立，过二得妻。",32],[9873,"兄弟二人，数中注定。"],[9874,"父羊母鼠，先天定数。"],[9875,"母命己巳年生方合。"],[9876,"兄弟虽多，易数只得其三。"],[9877,"妻命丙寅生，先天注定。"],[9878,"玉人有刑，再娶丁丑。"],[9879,"父亡生子，忧喜同至。",27],[9880,"一胎生二子，定于此年。",32],[9881,"妻大十一岁，姻缘注定。"],[9882,"粗絮淡饭，清白而养禅心。"],[9883,"兄弟三人，数中定数。"],[9884,"父羊母牛，易数先知。"],[9885,"母命辛巳年生方合。"],[9886,"兄弟虽得，只得其二。"],[9887,"妻命戊寅生，先天注定。"],[9888,"玉人有刑，再娶己丑。"],[9889,"父亡生子，一忧一喜。",28],[9890,"一胎生二子，定在此年。",33],[9891,"妻大十一岁，父母结缘。"],[9892,"数有四女，婚配不同。"],[9893,"兄弟四人，数中注定。"],[9894,"父羊母虎，易数前定。"],[9895,"母命癸巳年生方合。"],[9896,"超身物外，享乐无边。",61,62],[9897,"妻命庚寅生，数由前定。"],[9898,"玉人有刑，再娶辛丑。"],[9899,"父亡生子，忧喜同至。",29],[9900,"一胎生二子，见于此年",34],[9901,"妻大十二岁，父母结缘。"],[9902,"妻有六甲之喜。"],[9903,"兄弟五人，数中注定。"],[9904,"父羊母兔，易数先知。"],[9905,"母命马年生方合。"],[9906,"因作东床婿，富贵一朝夫。"],[9907,"妻命壬寅生，姻缘注定。"],[9908,"玉人有刑，再逢癸丑。"],[9909,"父亡生子，一忧一喜。",30],[9910,"一胎生二子，见于此年。",35],[9911,"占人之时，双亲已逝。"],[9912,"丧门相照，正当雪衣。",45,46],[9913,"兄弟六人，数中注定。"],[9914,"父羊母龙，数注其中。"],[9915,"母命丙午年生方合。"],[9916,"老年丧母，亦是悲伤。",64],[9917,"妻命乙卯生，姻缘注定。"],[9918,"玉人有刑，再娶甲寅。"],[9919,"父亡生子，忧喜全至。",31],[9920,"一胎生二子，定在此年。",36],[9921,"一父二母，我为嫡出。"],[9922,"兄弟六人，方合此刻。"],[9923,"兄弟七人，一定之数。"],[9924,"父羊母蛇，数定无差。"],[9925,"母命戊午年生方合。"],[9926,"兄妹六人，我居三。",60],[9927,"妻命丁卯生，姻缘前定。"],[9928,"玉人有刑，再娶丙寅。"],[9929,"父亡生子，一忧一喜。",32],[9930,"一胎生二子，定在此年。",31],[9931,"一死一生，独子送老。"],[9932,"发财创业自家富，湖海经营有路通。"],[9933,"兄弟八人，数中载定。"],[9934,"父羊母马，易数无差。"],[9935,"母命庚午年生方合。"],[9936,"天上玉书诏，地下失英雄。"],[9937,"妻命己卯生，姻缘注定。"],[9938,"玉人有刑，再娶戊寅。"],[9939,"父亡生子，一忧一喜。",30],[9940,"一胎生二子，定在斯年。",38],[9941,"红白相同悲复喜。",27],[9942,"丧门相照，忧及于师。",47,48],[9943,"兄弟九人，数中注定。"],[9944,"父羊母猴，易数不差。"],[9945,"母命午年生方合。"],[9946,"兄妹虽多，易数只得其四。",64],[9947,"妻命辛卯生，前缘注定。"],[9948,"玉人有刑，再娶庚寅。"],[9949,"父亡生子，忧喜全至。",31],[9950,"一胎生二子，定于此年。",39],[9951,"揩官得子，家门之幸。"],[9952,"作事常有思孝道，事亲不失孩儿心。"],[9953,"兄弟十人，数定其中。"],[9954,"父羊母鸡，先天注定。"],[9955,"母命羊年生方合。"],[9956,"佳儿佳妇，未来无忧。"],[9957,"妻命癸卯生，数中注定。"],[9958,"玉人有刑，再娶壬寅。"],[9959,"父亡生子，一忧一喜。",35],[9960,"一胎生二子，见于此年",40],[9961,"数尽八人，一命归西。",64],[9962,"幽思雪侯，苦修惨淡。"],[9963,"兄弟十一人，乐奏几般音。"],[9964,"父羊母犬，先天所注。"],[9965,"母命丁未年生方合。"],[9966,"失臂独立难支柱。"],[9967,"妻命甲辰生，先天注定。"],[9968,"玉人有刑，再娶乙卯。"],[9969,"父亡生子，一忧一喜。",36],[9970,"一胎生二子，见于此年。",41],[9971,"聘妻未识妻，其妻已死"],[9972,"自典探花，数中前定。"],[9973,"兄弟十二人，乐奏几般音。"],[9974,"父羊母猪，先天定数。"],[9975,"母命己未年生方合。"],[9976,"命途多蹇人缠累。家业消磨不可当。"],[9977,"妻命丙辰生，姻缘注定。"],[9978,"玉人有刑，再娶丁卯。"],[9979,"父亡生子，忧中有喜。",37],[9980,"一胎生二子，定于此年。",42],[9981,"子贵妻荣，花絮叶茂。"],[9982,"一字须记曰淫，做不得。"],[9983,"兄弟十三人，天发其祥。"],[9984,"父母同属猴，易数先祥。"],[9985,"母命辛未年生方合。"],[9986,"双眉锁愁容终日。"],[9987,"妻命戊辰生，姻缘定数。"],[9988,"玉人有刑，再娶己卯。"],[9989,"父亡生子，一忧一喜。"],[9990,"一胎生二子，定于此年。",42],[9991,"独自蚊龙人不识，风云际会自有为。"],[9992,"人带破相，方合此刻。"],[9993,"兄弟十四人，一门之盛。"],[9994,"父猴母鼠，先天注定。"],[9995,"母命癸末年生方合。"],[9996,"父母如宾，自吾无妨。"],[9997,"妻命庚辰生，先天定数。"],[9998,"玉人有刑，再娶辛卯。"],[9999,"父亡生子，忧喜全至。",39],[10000,"一胎生二子，定见此年。",44]]}
