:0},{"id":"shiri","name":"十日","nameTrad":"十日","pinyin":"Shírì","aliases":["扶桑十日"],"category":"deity","tags":["日","扶桑"],"brief":"栖于汤谷扶桑树的十个太阳：九日居下枝，一日居上枝，轮流升空；羲和所生。后羿射日神话即由此展开。","chapter":"haiwaidong","locationId":"tanggu","image":null,"imageCount":0},{"id":"yushiqie","name":"雨师妾","nameTrad":"雨師妾","pinyin":"Yǔshīqiè","aliases":[],"category":"deity","tags":["雨神","操蛇"],"brief":"海外东方司雨之神（一说国名），其人通体黝黑，两手各操一蛇，左耳挂青蛇、右耳挂赤蛇。","chapter":"haiwaidong","locationId":"yushiqie-guo","image":"yushiqie-hu","imageCount":2},{"id":"xuangu","name":"玄股国","nameTrad":"玄股國","pinyin":"Xuángǔ Guó","aliases":[],"category":"nation","tags":["黑股"],"brief":"海外东方之国，其民大腿以下漆黑，穿鱼皮衣、食鸥鸟，使两鸟夹侍。","chapter":"haiwaidong","locationId":"xuangu-guo","image":null,"imageCount":0},{"id":"maomin","name":"毛民国","nameTrad":"毛民國","pinyin":"Máomín Guó","aliases":[],"category":"nation","tags":["身生毛"],"brief":"海外东方之国，其民周身生毛；《大荒北经》谓其依姓、食黍，为禹之后裔。","chapter":"haiwaidong","locationId":"maomin-guo","image":"maomin-hu","imageCount":2},{"id":"laomin","name":"劳民国","nameTrad":"勞民國","pinyin":"Láomín Guó","aliases":["教民国"],"category":"nation","tags":["面目手足尽黑"],"brief":"海外东方之国，其民肤色黝黑，采食果实草籽，终日操劳不休。","chapter":"haiwaidong","locationId":"laomin-guo","image":"laomin-tushu","imageCount":1},{"id":"shuhai","name":"竖亥","nameTrad":"豎亥","pinyin":"Shùhài","aliases":[],"category":"deity","tags":["步测天下"],"brief":"善行神人。天帝（一曰禹）命竖亥自东极步测至西极，得五亿十选九千八百步；右手执算筹，左手指向青丘之北。","chapter":"haiwaidong","locationId":"dongji","image":null,"imageCount":0},{"id":"xiaoyang","name":"枭阳","nameTrad":"梟陽","pinyin":"Xiāoyáng","aliases":["赣巨人","山都"],"category":"nation","tags":["反踵","见人则笑"],"brief":"海内南方之国，其民人面长唇、黑身有毛、脚跟反生，见人发笑它也笑，笑时长唇掩面。《海内经》又称南方赣巨人。","chapter":"haineinan","locationId":"xiaoyang-guo","image":"xiaoyang-tushu","imageCount":1},{"id":"bashe","name":"巴蛇","nameTrad":"巴蛇","pinyin":"Bāshé","aliases":["修蛇"],"category":"snake","tags":["食象","巨蛇"],"brief":"能吞食大象的巨蛇，三年才吐出象骨；君子服食其骨可无心腹之疾。传羿断修蛇于洞庭，积骨成巴陵。","chapter":"haineinan","locationId":"baling","image":"bashe-tushu","imageCount":1},{"id":"diren","name":"氐人国","nameTrad":"氐人國","pinyin":"Dīrén Guó","aliases":["互人"],"category":"nation","tags":["人面鱼身"],"brief":"建木以西之国，其民人面鱼身而无足；炎帝之孙互人之国，能上下于天。","chapter":"haineinan","locationId":"diren-guo","image":"diren-tushu","imageCount":1},{"id":"jianmu","name":"建木","nameTrad":"建木","pinyin":"Jiànmù","aliases":[],"category":"plant","tags":["天梯","众帝所自上下"],"brief":"都广之野的通天神木，高百仞无枝，上有九欘、下有九枸，其实如麻、其叶如芒；大皞（伏羲）缘之上下，黄帝所栽护。","chapter":"haineinan","locationId":"duguang","image":null,"imageCount":0},{"id":"kaiming","name":"开明兽","nameTrad":"開明獸","pinyin":"Kāimíng Shòu","aliases":[],"category":"beast","tags":["昆仑守门","九首"],"brief":"昆仑之墟的守门神兽，身大如虎而九首，皆人面，向东立于昆仑之上，守卫百神所在的九门。","chapter":"haineixi","locationId":"kunlun","image":"kaiming-wang","imageCount":2},{"id":"erfu","name":"贰负","nameTrad":"貳負","pinyin":"Èrfù","aliases":[],"category":"deity","tags":["人面蛇身","杀窫窳"],"brief":"人面蛇身之神。与其臣「危」合谋杀死天神窫窳，天帝将危（一说并贰负）梏于疏属之山，桎其右足、反缚双手系于山上大树。汉宣帝时上郡石室曾掘得反缚械人，刘向以为即其遗迹。","chapter":"haineixi","locationId":"shushu-shan","image":"erfu-tushu","imageCount":1},{"id":"zouwu","name":"驺吾","nameTrad":"騶吾","pinyin":"Zōuwú","aliases":["驺虞"],"category":"beast","tags":["瑞兽","日行千里"],"brief":"林氏国珍兽，大如虎，五彩毕具，尾长于身，乘之日行千里；即古籍中仁德不食生物的瑞兽驺虞。","chapter":"haineibei","locationId":"linshi-guo","image":"zouwu-tushu","imageCount":1},{"id":"quanfeng","name":"犬封国","nameTrad":"犬封國","pinyin":"Quǎnfēng Guó","aliases":["犬戎国"],"category":"nation","tags":["状如犬"],"brief":"海内北方之国，其民状如犬；盘瓠化犬得帝女的传说与之相涉。国中出文马吉量，乘之寿千岁。","chapter":"haineibei","locationId":"quanfeng-guo","image":null,"imageCount":0},{"id":"daxie","name":"大蟹","nameTrad":"大蟹","pinyin":"Dàxiè","aliases":[],"category":"fish","tags":["海中巨物"],"brief":"海中巨蟹，郭璞注谓广千里；古人以之想象海中庞然巨物。","chapter":"haineibei","locationId":"daxie-hai","image":null,"imageCount":0},{"id":"lingyu","name":"陵鱼","nameTrad":"陵魚","pinyin":"Língyú","aliases":["鲮鱼","人鱼"],"category":"fish","tags":["人面鱼身"],"brief":"海中人鱼：人面、有手足而鱼身，为后世人鱼／鲛人想象之祖。","chapter":"haineibei","locationId":"lingyu-hai","image":"lingyu-tushu","imageCount":1},{"id":"bingyi","name":"冰夷","nameTrad":"冰夷","pinyin":"Bīngyí","aliases":["河伯","冯夷"],"category":"deity","tags":["河神","乘两龙"],"brief":"黄河之神河伯，人面，乘两龙，常居从极之渊（深三百仞）。后世河伯娶妇、洛神传说皆自此衍出。","chapter":"haineibei","locationId":"congji-yuan","image":"bingyi-jiang","imageCount":2},{"id":"leishen","name":"雷神","nameTrad":"雷神","pinyin":"Léishén","aliases":[],"category":"deity","tags":["雷泽","龙身人头"],"brief":"雷泽中的雷神，龙身人头，鼓其腹则雷鸣。传华胥履其足迹而生伏羲。","chapter":"haineidong","locationId":"leize","image":null,"imageCount":0},{"id":"wanghai","name":"王亥","nameTrad":"王亥","pinyin":"Wánghài","aliases":[],"category":"human","tags":["商先公","服牛"],"brief":"商人先公，驯牛始祖。两手操鸟方食其头；托牛于有易，为有易之君绵臣所杀——甲骨卜辞中「高祖亥」即其人。","chapter":"dahuangdong","locationId":"youyi","image":null,"imageCount":0},{"id":"yinglong","name":"应龙","nameTrad":"應龍","pinyin":"Yìnglóng","aliases":[],"category":"dragon","tags":["有翼之龙","杀蚩尤","致雨"],"brief":"生翼神龙。佐黄帝杀蚩尤与夸父于冀州之野，力竭不得复归天上，遂居大荒东北隅凶犁土丘；应龙不上天，下界屡旱，旱时人们扮应龙之状求雨。","chapter":"dahuangdong","locationId":"xiongli","image":"yinglong-qing","imageCount":2},{"id":"kui","name":"夔","nameTrad":"夔","pinyin":"Kuí","aliases":[],"category":"beast","tags":["一足","雷兽"],"brief":"东海流波山神兽，状如牛，苍身无角一足，出入水必有风雨，光如日月、声如雷霆。黄帝得之，以其皮蒙鼓、以雷兽之骨为槌，鼓声五百里，威震天下。","chapter":"dahuangdong","locationId":"liubo","image":"kui-wang","imageCount":3},{"id":"xihe","name":"羲和","nameTrad":"羲和","pinyin":"Xīhé","aliases":[],"category":"deity","tags":["日母","帝俊之妻"],"brief":"太阳之母：帝俊之妻，生十日，在东南海外甘渊为十个太阳沐浴。后世「羲和驭日」即由此演化。","chapter":"dahuangnan","locationId":"xihe-guo","image":"xihe-tushu","imageCount":1},{"id":"nvwa","name":"女娲","nameTrad":"女媧","pinyin":"Nǚwā","aliases":[],"category":"deity","tags":["创世","人面蛇身"],"brief":"创世女神。《大荒西经》记「女娲之肠」化为十神，处栗广之野——郭璞注：女娲，古神女而帝者，人面蛇身，一日中七十变。","chapter":"dahuangxi","locationId":"liguang","image":"nvwa-jiang","imageCount":2},{"id":"changxi","name":"常羲","nameTrad":"常羲","pinyin":"Chángxī","aliases":["常仪"],"category":"deity","tags":["月母","帝俊之妻"],"brief":"月亮之母：帝俊之妻，生月十二，在大荒之西为月亮沐浴；嫦娥奔月传说之远源。","chapter":"dahuangxi","locationId":"riyue-shan","image":"changxi-jinzhang","imageCount":1},{"id":"yanzi","name":"弇兹","nameTrad":"弇茲","pinyin":"Yǎnzī","aliases":[],"category":"deity","tags":["西海之神","人面鸟身"],"brief":"西海海渚中之神，人面鸟身，耳挂两青蛇、足踏两赤蛇。","chapter":"dahuangxi","locationId":"xihai-zhu","image":null,"imageCount":0},{"id":"xiahoukai","name":"夏后开","nameTrad":"夏后開","pinyin":"Xiàhòu Kāi","aliases":["夏启"],"category":"deity","tags":["乘两龙","得九歌"],"brief":"即夏启（汉人避景帝讳改「开」）。耳挂两青蛇，乘两龙，三次宾于天帝，得《九辩》《九歌》以下人间，在天穆之野始演《九招》。","chapter":"dahuangxi","locationId":"tianmu","image":"xiahoukai-tushu","imageCount":1},{"id":"jiufeng","name":"九凤","nameTrad":"九鳳","pinyin":"Jiǔfèng","aliases":[],"category":"bird","tags":["九首","神鸟"],"brief":"大荒北极天柜山之神鸟，九首人面鸟身；楚人所祀九头神鸟，后世「九头鸟」传说之祖。","chapter":"dahuangbei","locationId":"beiji-tiangui","image":"jiufeng-qingcai","imageCount":2},{"id":"qiangliang","name":"彊良","nameTrad":"彊良","pinyin":"Qiángliáng","aliases":["强良"],"category":"deity","tags":["衔蛇操蛇","虎首人身"],"brief":"北极天柜山之神，虎首人身，口衔蛇、手操蛇，四蹄长肘。","chapter":"dahuangbei","locationId":"beiji-tiangui","image":"qiangliang-tushu","imageCount":1},{"id":"nvba","name":"女魃","nameTrad":"女魃","pinyin":"Nǚbá","aliases":["黄帝女魃","旱魃"],"category":"deity","tags":["旱神","天女"],"brief":"黄帝之天女。蚩尤请风伯雨师纵大风雨，黄帝下天女魃止雨，遂杀蚩尤；魃神力耗尽不得复上天，所居之地不雨，即后世「旱魃」。","chapter":"dahuangbei","locationId":"xikun","image":null,"imageCount":0},{"id":"chiyou","name":"蚩尤","nameTrad":"蚩尤","pinyin":"Chīyóu","aliases":[],"category":"deity","tags":["战神","作兵"],"brief":"发明兵器、伐黄帝的战神。请风伯雨师纵大风雨战应龙，终为黄帝（一说应龙）所杀；所弃桎梏化为枫木。后世尊为兵主战神。","chapter":"dahuangbei","locationId":"xikun","image":null,"imageCount":0},{"id":"yanwei","name":"延维","nameTrad":"延維","pinyin":"Yánwéi","aliases":["委蛇"],"category":"deity","tags":["两头蛇神"],"brief":"苗民之地的蛇神，人首蛇身，长如车辕，左右有首，衣紫衣戴旃冠；人主得而飨食之，可伯天下——即《庄子》齐桓公所见之「委蛇」。","chapter":"hainei","locationId":"miaomin","image":null,"imageCount":0},{"id":"gun","name":"鲧","nameTrad":"鯀","pinyin":"Gǔn","aliases":[],"category":"deity","tags":["治水","窃息壤"],"brief":"禹之父。洪水滔天，鲧不待帝命窃取天帝息壤以堙洪水，帝令祝融杀之于羽郊；鲧腹三年不腐，剖之以吴刀，化生大禹。","chapter":"hainei","locationId":"yujiao","image":null,"imageCount":0}]
