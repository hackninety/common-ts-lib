ī","aliases":[],"category":"deity","tags":["化为大鹗","兆兵"],"brief":"与鼓同杀葆江获罪的天神，被诛后化为大鹗，状如雕而黑纹白首；现身则有大战。","chapter":"xishan","locationId":"zhongshan-mt","image":null,"imageCount":0},{"id":"wenyaoyu","name":"文鳐鱼","nameTrad":"文鰩魚","pinyin":"Wényáoyú","aliases":["飞鱼"],"category":"fish","tags":["兆丰","夜飞"],"brief":"泰器山观水中的飞鱼，鱼身鸟翼，苍纹白首赤喙，夜间成群飞行于西海东海之间；现身则天下大丰收。","chapter":"xishan","locationId":"taiqi","image":"wenyaoyu-tushu","imageCount":1},{"id":"yingzhao","name":"英招","nameTrad":"英招","pinyin":"Yīngsháo","aliases":[],"category":"deity","tags":["司帝之平圃"],"brief":"槐江山之神，马身人面，虎纹鸟翼，巡行四海传布天帝旨意；掌管天帝悬圃。","chapter":"xishan","locationId":"huaijiang","image":"yingzhao-tushu","imageCount":1},{"id":"luwu","name":"陆吾","nameTrad":"陸吾","pinyin":"Lùwú","aliases":["肩吾"],"category":"deity","tags":["昆仑守护","司天九部"],"brief":"昆仑丘之神，虎身九尾，人面虎爪，掌管天之九部与天帝园圃时节，为帝之下都的守护神。","chapter":"xishan","locationId":"kunlun","image":"luwu-tushu","imageCount":1},{"id":"tulou","name":"土蝼","nameTrad":"土螻","pinyin":"Tǔlóu","aliases":[],"category":"beast","tags":["食人"],"brief":"昆仑丘食人兽，状如羊而生四角。","chapter":"xishan","locationId":"kunlun","image":"tulou-hu","imageCount":2},{"id":"qinyuan","name":"钦原","nameTrad":"欽原","pinyin":"Qīnyuán","aliases":[],"category":"bird","tags":["毒鸟"],"brief":"昆仑丘毒鸟，状如蜂而大如鸳鸯，螫鸟兽则死，螫树木则枯。","chapter":"xishan","locationId":"kunlun","image":"qinyuan-tushu","imageCount":1},{"id":"changsheng","name":"长乘","nameTrad":"長乘","pinyin":"Chángchéng","aliases":[],"category":"deity","tags":["天之九德"],"brief":"蠃母山之神，状如人而生豹尾，是「天之九德」所生。","chapter":"xishan","locationId":"luomu","image":null,"imageCount":0},{"id":"xiwangmu","name":"西王母","nameTrad":"西王母","pinyin":"Xīwángmǔ","aliases":[],"category":"deity","tags":["司天厉五残","昆仑"],"brief":"玉山之神，人形豹尾虎齿善啸，蓬发戴胜，掌管灾厉与五刑残杀之气；有三青鸟为其取食。后世演为瑶池金母。","chapter":"xishan","locationId":"yushan-xi","image":"xiwangmu-qing","imageCount":2},{"id":"jiao-beast","name":"狡","nameTrad":"狡","pinyin":"Jiǎo","aliases":[],"category":"beast","tags":["兆丰"],"brief":"玉山异兽，状如犬而豹纹，头生牛角，吠声如犬；现身则其国五谷丰登。","cha